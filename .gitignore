# dependencies
node_modules/

# build output
dist/

# environment variables
.env
.env.*
!.env.example

# Vercel CLI (local project link — never commit)
.vercel/

# editor / IDE
.vscode/
.idea/
.cursor/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Astro
.astro/

# TypeScript
*.tsbuildinfo

# Logs & local command output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Market data — stored in Neon DB, never committed (CI exports to public/data)
src/data/ipos.json
src/data/mutual-funds.json
src/data/fund-holdings.json
src/data/upcoming-ipos.json
src/data/ipo-performance.json
src/data/ipos_pretty.json
src/data/*.bak
*.bak

# Pipeline working dirs (AMFI Excel, temp parses — local only)
data/

# Deprecated fetch backups
scripts/ipos_*.json

# Local dev logs & script output (not needed for prod build)
build-log.txt
check-output.txt
scripts/output/

# Local debug / scrape dumps (Groww, HDFC, etc.) — never commit
_groww*.json
_groww_detail.json
tmp-*.json
**/tmp-*.json

# DB dumps / backups (migrations in db/migrations/ stay tracked)
*.dump
*.sql.gz
neon-backup*/

# Temporary holdings Excel used for local parser tests
scripts/_tmp*/
**/_tmp*/

# Local UI test screenshots
test-screenshots/

# Holdings source Excel (lives on disk at HOLDINGS_INPUT_DIR, not in git)
**/*.xlsx
**/*.xls
!data/amfi-excel/**

# Internal specs & SEO audit notes (not needed for prod build)
.kiro/
SEO_AUDIT_FINAL.md
SEO_STRATEGY.md

# Client JSON — regenerated on every `npm run build` / CI via export-client-data.mjs
public/data/**
!public/data/.gitkeep

# Sitemaps — regenerated during export / build (dist/ sitemaps covered by dist/)
public/sitemap*.xml
public/sitemap-overlap-staging-*.xml

# Test / coverage artifacts
coverage/
.nyc_output/
