{
  "name": "ipofins",
  "type": "module",
  "version": "1.0.0",
  "description": "IPOfin - Next-Gen IPO & Finance Intelligence Platform",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "fetch-data": "node scripts/fetch-all-data.mjs",
    "fetch-mf": "node scripts/fetch-all-data.mjs --mf-only",
    "fetch-gmp-sub": "node --use-system-ca scripts/fetch-subscription-gmp.mjs",
    "fetch-sub-only": "node --use-system-ca scripts/fetch-subscription-gmp.mjs --sub-only",
    "fetch-gmp-only": "node --use-system-ca scripts/fetch-subscription-gmp.mjs --gmp-only",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:seed": "node --use-system-ca db/seed/seed-from-json.mjs",
    "db:seed-holdings": "node --use-system-ca db/seed/seed-holdings-batch.mjs",
    "db:compute-signals": "node --use-system-ca db/compute/compute-signals.mjs",
    "db:compute-overlaps": "node --use-system-ca db/compute/compute-overlaps.mjs",
    "db:compute-all": "node --use-system-ca db/compute/compute-signals.mjs && node --use-system-ca db/compute/compute-overlaps.mjs",
    "db:refresh-holdings": "node scripts/parse-holdings.mjs && node --use-system-ca db/seed/seed-holdings-batch.mjs && node --use-system-ca db/compute/compute-signals.mjs && node --use-system-ca db/compute/compute-overlaps.mjs",
    "db:status": "node --use-system-ca db/check-full-counts.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "^6.4.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "puppeteer-core": "^25.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  }
}
