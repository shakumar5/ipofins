{
  "name": "ipofins",
  "type": "module",
  "version": "1.0.0",
  "description": "IPOfins - Financial intelligence platform for IPO analytics, mutual fund tracking, and investment tools",
  "scripts": {
    "dev": "node --use-system-ca ./node_modules/astro/bin/astro.mjs dev",
    "start": "node --use-system-ca ./node_modules/astro/bin/astro.mjs dev",
    "pipeline:ipo": "node --use-system-ca scripts/pipeline/00-ipo-broker-sync.mjs",
    "pipeline:daily": "node --use-system-ca scripts/pipeline/01-daily-nav-ipo.mjs",
    "pipeline:nav": "node --use-system-ca scripts/pipeline/sync-nav-only.mjs",
    "pipeline:subscription": "node --use-system-ca scripts/pipeline/02-ipo-subscription.mjs",
    "pipeline:monthly": "node --use-system-ca scripts/pipeline/03-monthly-mf-holdings.mjs",
    "fetch-data": "echo 'DEPRECATED: use npm run pipeline:daily' && exit 1",
    "fetch-mf": "echo 'DEPRECATED: use npm run pipeline:daily' && exit 1",
    "fetch-gmp-sub": "echo 'DEPRECATED: use npm run pipeline:subscription' && exit 1",
    "build": "node --use-system-ca ./node_modules/astro/bin/astro.mjs build",
    "check": "node --use-system-ca ./node_modules/astro/bin/astro.mjs check",
    "preview": "node --use-system-ca ./node_modules/astro/bin/astro.mjs preview",
    "astro": "node --use-system-ca ./node_modules/astro/bin/astro.mjs",
    "db:seed": "node --use-system-ca db/seed/seed-from-json.mjs",
    "db:seed-holdings": "node --use-system-ca db/seed/seed-holdings-batch.mjs",
    "db:seed-holdings:full": "node --use-system-ca db/seed/seed-holdings-batch.mjs --full",
    "db:fix-amcs": "node --use-system-ca db/seed/fix-amc-assignments.mjs",
    "db:compute-signals": "node --use-system-ca db/compute/compute-signals.mjs",
    "db:compute-overlaps": "node --use-system-ca db/compute/compute-overlaps.mjs",
    "db:compute-all": "node --use-system-ca db/compute/compute-signals.mjs && node --use-system-ca db/compute/compute-overlaps.mjs",
    "db:refresh-holdings": "node --use-system-ca scripts/pipeline/03-monthly-mf-holdings.mjs",
    "db:status": "node --use-system-ca db/check-full-counts.mjs",
    "audit:db": "node scripts/audit-db-health.mjs",
    "audit:nav-mapping": "node --use-system-ca scripts/audit-nav-mapping.mjs",
    "report:amcs": "node scripts/report-missing-amcs.mjs",
    "report:holdings": "node scripts/report-holdings-by-amc.mjs",
    "og:generate": "node scripts/generate-og-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "astro": "^6.4.4",
    "pg": "^8.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "puppeteer-core": "^25.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  }
}
