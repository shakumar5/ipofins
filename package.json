{
  "name": "ipofins",
  "type": "module",
  "version": "1.0.0",
  "description": "IPOFins - Financial intelligence platform for IPO analytics, mutual fund tracking, and investment tools",
  "scripts": {
    "dev": "astro dev",
    "dev:sync": "node scripts/node-with-ca.mjs scripts/export-client-data.mjs && astro dev",
    "start": "astro dev",
    "pipeline:ipo": "node scripts/node-with-ca.mjs scripts/pipeline/00-ipo-broker-sync.mjs",
    "pipeline:daily": "node scripts/node-with-ca.mjs scripts/pipeline/01-daily-nav-ipo.mjs",
    "pipeline:daily:full": "node scripts/node-with-ca.mjs scripts/pipeline/01-daily-nav-ipo.mjs -- --full-ipo",
    "pipeline:nav": "node scripts/node-with-ca.mjs scripts/pipeline/sync-nav-only.mjs",
    "pipeline:subscription": "node scripts/node-with-ca.mjs scripts/pipeline/02-ipo-subscription.mjs",
    "pipeline:monthly": "node scripts/node-with-ca.mjs scripts/pipeline/03-monthly-mf-holdings.mjs",
    "pipeline:ter": "node scripts/node-with-ca.mjs scripts/pipeline/sync-ter-only.mjs",
    "fetch-data": "echo 'DEPRECATED: use npm run pipeline:daily' && exit 1",
    "fetch-mf": "echo 'DEPRECATED: use npm run pipeline:daily' && exit 1",
    "fetch-gmp-sub": "echo 'DEPRECATED: use npm run pipeline:subscription' && exit 1",
    "build": "node db/verify-schema.mjs && node scripts/node-with-ca.mjs scripts/export-client-data.mjs && node scripts/generate-og-images.mjs && node scripts/regenerate-smart-money-sitemap.mjs && npx astro build && node scripts/generate-overlap-static-pages.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "astro": "astro",
    "predeploy": "node scripts/node-with-ca.mjs scripts/pipeline/sync-nav-only.mjs && node db/verify-schema.mjs",
    "db:rebuild-curated": "node scripts/node-with-ca.mjs db/rebuild-curated-mf.mjs",
    "db:purge-mf": "node scripts/node-with-ca.mjs db/purge-mf-data.mjs --confirm",
    "db:seed-curated": "node scripts/node-with-ca.mjs db/seed/seed-curated-mf.mjs",
    "db:verify": "node db/verify-schema.mjs",
    "db:seed": "node scripts/node-with-ca.mjs db/seed/seed-from-json.mjs",
    "db:seed-holdings": "node scripts/node-with-ca.mjs db/seed/seed-holdings-batch.mjs",
    "db:seed-holdings:full": "node scripts/node-with-ca.mjs db/seed/seed-holdings-batch.mjs --full",
    "db:fix-amcs": "node scripts/node-with-ca.mjs db/seed/fix-amc-assignments.mjs",
    "db:compute-signals": "node scripts/node-with-ca.mjs db/compute/compute-signals.mjs",
    "db:compute-overlaps": "node scripts/node-with-ca.mjs db/compute/compute-overlaps.mjs",
    "db:compute-all": "node scripts/node-with-ca.mjs db/compute/compute-signals.mjs && node scripts/node-with-ca.mjs db/compute/compute-overlaps.mjs",
    "db:refresh-holdings": "node scripts/node-with-ca.mjs scripts/pipeline/03-monthly-mf-holdings.mjs",
    "db:status": "node scripts/node-with-ca.mjs db/check-full-counts.mjs",
    "db:fix-holdings-canonical": "node scripts/node-with-ca.mjs db/seed/reassign-holdings-canonical.mjs",
    "db:dedupe-stocks": "node scripts/node-with-ca.mjs db/seed/dedupe-stocks-canonical.mjs",
    "audit:db": "node scripts/audit-db-health.mjs",
    "audit:nav-mapping": "node scripts/node-with-ca.mjs scripts/audit-nav-mapping.mjs",
    "report:amcs": "node scripts/report-missing-amcs.mjs",
    "report:holdings": "node scripts/report-holdings-by-amc.mjs",
    "export:client-data": "node scripts/node-with-ca.mjs scripts/export-client-data.mjs",
    "refresh:mutual-funds-json": "node scripts/node-with-ca.mjs scripts/refresh-mutual-funds-json.mjs",
    "og:generate": "node scripts/generate-og-images.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^1.4.1",
    "astro": "^6.4.4",
    "pg": "^8.21.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "puppeteer-core": "^25.1.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "xlsx": "^0.18.5"
  }
}
