# Neon PostgreSQL Connection (required for build + pipelines)
# Get this from: https://console.neon.tech → Your Project → Connection Details

DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Use ONE Neon database everywhere: local .env, GitHub Secrets, and (optionally) Vercel.
# Verify: npm run db:verify  →  "Schema OK — N IPOs"

# Windows only: npm scripts use scripts/node-with-ca.mjs (adds --use-system-ca automatically).
# If a raw `node db/...` call fails with SSL errors, use:
#   node scripts/node-with-ca.mjs <script>

# Build speed (local):
#   npm run export:client-data   # once (~3–6 min with DB)
#   npm run build                # skips export if data < 3h old
#   npm run build:fast           # never re-export — Astro compile only
#   FORCE_EXPORT=1 npm run build # always re-export
#   EXPORT_HOLDINGS=db npm run export:client-data  # force DB holdings (CI default when no JSON)
#   SI_BUILD_HOLDER_PAGES=1 npm run build  # opt-in: 1% Club /holder/* static pages (skipped in CI)

# Quarter-end bhavcopy (local, gitignored under data/) — drop files before db:compute-si:values
#   NSE → data/bhavcopy/nse/  (flat .csv OR zip-extract folder: nse/BhavCopy_...csv/BhavCopy_...csv)
#   BSE → data/bhavcopy/bse/  (flat BhavCopy_BSE_CM_...CSV only)
# Files within ±7 days of quarter-end anchor are accepted (BHAVCOPY_QUARTER_WINDOW_DAYS=7).
# Prefer the last trading day of the quarter (e.g. 20260330 for Mar 2026 if 31-Mar is a holiday).
# BSE alternates also work: BSE_EQ_BHAVCOPY_DDMMYYYY_T0.csv, EQ_ISINCODE_DDMMYY_T0.CSV
# Optional override: BHAVCOPY_DIR=/other/path

# Optional: Discord/Telegram webhook for pipeline alerts
# ALERT_WEBHOOK_URL=

# IPO email alerts (Resend) — required for /api/ipo-alert and cron sender
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=IPOFins Alerts <alerts@ipofins.com>
# CRON_SECRET=generate-a-long-random-string

# CRON_SECRET=generate-a-long-random-string

# Error monitoring (optional — enables @sentry/astro when SENTRY_DSN is set)
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=ipofins

# Google AdSense publisher client ID (optional — defaults to production ID)
# PUBLIC_ADSENSE_CLIENT_ID=ca-pub-9843041963430696
