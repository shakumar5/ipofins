{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": "node .cursor/hooks/validate-sql.mjs"
      },
      {
        "command": "node .cursor/hooks/validate-encoding.mjs"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/suggest-check.mjs"
      }
    ]
  }
}