---
import BaseLayout from './BaseLayout.astro';
import { OG_IPO_IMAGE } from '../lib/og-images';
import { getAllIPOs } from '../lib/data/ipos';
import { withCorrectStatuses } from '../utils/ipo-status';
import { ipoSectorSlug, ipoPerformanceYears } from '../lib/ipo-list-sections';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object | object[];
  activeTab: string;
}

const { title, description, ogImage = OG_IPO_IMAGE, canonicalUrl, jsonLd, activeTab } = Astro.props;

// Derive nav destinations from real data so tabs never point at a 404.
const iposForNav = withCorrectStatuses(await getAllIPOs());

const performanceYear = ipoPerformanceYears(iposForNav)[0] ?? String(new Date().getFullYear());

const sectorCounts = new Map<string, number>();
for (const ipo of iposForNav) {
  const slug = ipoSectorSlug(ipo.sector);
  if (slug) sectorCounts.set(slug, (sectorCounts.get(slug) ?? 0) + 1);
}
const topSectorSlug = [...sectorCounts.entries()].sort((a, b) => b[1] - a[1])[0]?.[0];

const tabs = [
  { key: 'all', label: 'All', href: '/ipo' },
  { key: 'mainboard', label: 'Mainboard', href: '/ipo/mainboard' },
  { key: 'sme', label: 'SME', href: '/ipo/sme' },
  { key: 'upcoming', label: 'Upcoming', href: '/ipo/upcoming' },
  { key: 'subscription', label: 'Subscription', href: '/ipo/subscription-status' },
  { key: 'gmp', label: 'GMP Today', href: '/ipo/gmp-today' },
  { key: 'allotment', label: 'Allotment', href: '/ipo/allotment-status' },
  { key: 'performance', label: 'Performance', href: `/ipo/performance/${performanceYear}` },
  ...(topSectorSlug ? [{ key: 'sector', label: 'Sector', href: `/ipo/sector/${topSectorSlug}` }] : []),
];
---

<BaseLayout title={title} description={description} ogImage={ogImage} canonicalUrl={canonicalUrl} jsonLd={jsonLd}>
  <!-- Breadcrumb -->
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">IPOs</li>
    </ol>
  </nav>

  <!-- Live IPO CTA (detail pages) + persistent tab navigation -->
  <div class="sticky top-[var(--site-header-h,4rem)] z-40">
    <slot name="cta" />
    <div class="container-wide pt-6 pb-2 bg-white/98 dark:bg-surface-900/98">
      <div class="overflow-x-auto -mx-4 px-4">
        <div class="flex gap-1 min-w-max border-b border-surface-200 dark:border-surface-700 pb-0">
          {tabs.map(tab => (
            <a
              href={tab.href}
              class={`px-4 py-2.5 text-sm font-medium whitespace-nowrap border-b-2 transition-colors ${
                activeTab === tab.key
                  ? 'border-primary-600 text-primary-600 dark:text-primary-400 dark:border-primary-400'
                  : 'border-transparent text-surface-500 hover:text-surface-700 dark:text-surface-400 dark:hover:text-surface-200 hover:border-surface-300'
              }`}
            >
              {tab.label}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Page Content -->
  <slot />
</BaseLayout>
