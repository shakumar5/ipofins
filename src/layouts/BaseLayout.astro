---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import DeferredAnalytics from '../components/DeferredAnalytics.astro';
import { BRAND_NAME, BRAND_URL, BRAND_TWITTER_HANDLE, BRAND_TWITTER_URL } from '../lib/brand';
import { OG_DEFAULT_IMAGE, resolveOgImageUrl } from '../lib/og-images';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object;
  robots?: string;
}

const {
  title,
  description = `${BRAND_NAME} - Free IPO tracker, mutual fund comparison, SIP & EMI calculators. Track live IPOs, subscription status for Indian investors.`,
  ogImage = OG_DEFAULT_IMAGE,
  canonicalUrl,
  jsonLd,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const siteUrl = BRAND_URL;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const socialImage = resolveOgImageUrl(ogImage);

// Site-wide Organization schema for brand authority
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": BRAND_NAME,
  "url": BRAND_URL,
  "logo": `${BRAND_URL}/favicon.svg`,
  "description": "Free, privacy-first financial tools and data for Indian investors. Track IPOs, compare mutual funds, and plan investments without login.",
  "sameAs": [
    BRAND_TWITTER_URL
  ]
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${socialImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BRAND_NAME} — IPO analytics and mutual fund intelligence for Indian investors`} />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${BRAND_TWITTER_HANDLE}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${socialImage}`} />

    <!-- Additional SEO -->
    <meta name="robots" content={robots} />
    <meta name="author" content={BRAND_NAME} />
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="India" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preconnect only to our own origin (fonts use system stack — no Google Fonts round-trip) -->

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme: prevent flash of wrong theme -->
    <script is:inline>
      (function(){
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google AdSense account (ads load only after cookie consent) -->
    <meta name="google-adsense-account" content="ca-pub-9843041963430696" />

    <!-- Third-party scripts load only after explicit cookie consent -->
    <script is:inline>
      (function(){
        var analyticsLoaded = false;
        window.__webVitalsPending = false;
        window.__analyticsReadyPending = false;
        window.__startWebVitals = function() {
          window.__webVitalsPending = true;
          if (window.__runWebVitals) window.__runWebVitals();
        };
        window.__markAnalyticsReady = function() {
          if (window.__flushAnalyticsReady) window.__flushAnalyticsReady();
          else window.__analyticsReadyPending = true;
        };
        window.loadThirdPartyScripts = function() {
          if (analyticsLoaded) return;
          analyticsLoaded = true;
          var p = document.createElement('script');
          p.async = true;
          p.src = 'https://plausible.io/js/pa-TzNuTbQbTb4FXM9xfpK3x.js';
          p.onload = function() {
            window.plausible = window.plausible || function(){(plausible.q=plausible.q||[]).push(arguments)};
            plausible.init = plausible.init || function(i){plausible.o=i||{}};
            plausible.init();
            if (window.__markAnalyticsReady) window.__markAnalyticsReady();
          };
          document.head.appendChild(p);
          var g = document.createElement('script');
          g.src = 'https://www.googletagmanager.com/gtag/js?id=G-VRXGEC8RTG';
          g.async = true;
          g.onload = function() {
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-VRXGEC8RTG');
            if (window.__markAnalyticsReady) window.__markAnalyticsReady();
          };
          document.head.appendChild(g);
          var a = document.createElement('script');
          a.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9843041963430696';
          a.crossOrigin = 'anonymous';
          a.async = true;
          a.onload = function() {
            window.__initAdsenseSlots && window.__initAdsenseSlots();
          };
          document.head.appendChild(a);
        };
        window.__initAdsenseSlots = function() {
          if (!window.adsbygoogle) return;
          document.querySelectorAll('ins.adsbygoogle[data-ad-pending="true"]').forEach(function(el) {
            el.removeAttribute('data-ad-pending');
            try { (adsbygoogle = window.adsbygoogle || []).push({}); } catch(e) {}
          });
        };
        window.scheduleThirdPartyAfterHydration = function() {
          if (window.__thirdPartyScheduled) return;
          window.__thirdPartyScheduled = true;
          var run = function() {
            if (window.__thirdPartyLoaded) return;
            window.__thirdPartyLoaded = true;
            if (window.__startWebVitals) window.__startWebVitals();
            if (window.loadThirdPartyScripts) window.loadThirdPartyScripts();
          };
          var afterHydration = function() {
            if ('requestIdleCallback' in window) {
              requestIdleCallback(function() { setTimeout(run, 1500); }, { timeout: 6000 });
            } else {
              setTimeout(run, 4000);
            }
          };
          var delay = function() { setTimeout(afterHydration, 2500); };
          if (document.readyState === 'complete') {
            delay();
          } else {
            window.addEventListener('load', delay, { once: true });
          }
        };
        if (localStorage.getItem('cookie-consent') === 'accepted') {
          window.scheduleThirdPartyAfterHydration();
        }
      })();
    </script>

    <!-- JSON-LD: Organization (site-wide) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- JSON-LD: Page-specific -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <slot name="head" />

  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary-600 focus:text-white focus:rounded-lg focus:shadow-lg">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Search Overlay -->
    <SearchOverlay />

    <!-- Cookie Consent (for AdSense compliance) -->
    <div id="cookie-consent" class="cookie-consent-banner fixed bottom-0 left-0 right-0 z-[90] p-4 bg-surface-900 text-white shadow-2xl cookie-consent-banner--hidden" aria-hidden="true">
      <div class="container-wide flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-surface-300">We use cookies for analytics and ads. By continuing, you agree to our <a href="/privacy" class="text-primary-300 underline hover:text-primary-200">Privacy Policy</a>.</p>
        <div class="flex gap-2">
          <button onclick="acceptCookies()" class="px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-lg hover:bg-primary-500 transition-colors">Accept</button>
          <button onclick="dismissCookies()" class="px-4 py-2 bg-surface-700 text-surface-300 text-sm font-medium rounded-lg hover:bg-surface-600 transition-colors">Dismiss</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (function() {
        if (!localStorage.getItem('cookie-consent')) {
          var el = document.getElementById('cookie-consent');
          if (el) {
            el.removeAttribute('aria-hidden');
            var showBanner = function() {
              requestAnimationFrame(function() {
                el.classList.remove('cookie-consent-banner--hidden');
              });
            };
            if (document.readyState === 'complete') {
              setTimeout(showBanner, 4000);
            } else {
              window.addEventListener('load', function() { setTimeout(showBanner, 4000); }, { once: true });
            }
          }
        }
      })();
      function acceptCookies() {
        try {
          localStorage.setItem('cookie-consent', 'accepted');
          var el = document.getElementById('cookie-consent');
          if (el) el.classList.add('cookie-consent-banner--hidden');
          if (window.scheduleThirdPartyAfterHydration) window.scheduleThirdPartyAfterHydration();
        } catch (e) {}
      }
      function dismissCookies() { localStorage.setItem('cookie-consent', 'dismissed'); var el = document.getElementById('cookie-consent'); el.classList.add('cookie-consent-banner--hidden'); }
    </script>
    <DeferredAnalytics />
  </body>
</html>
