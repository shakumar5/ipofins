---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';
import DeferredAnalytics from '../components/DeferredAnalytics.astro';
import { BRAND_NAME, BRAND_URL, BRAND_TWITTER_HANDLE, BRAND_TWITTER_URL } from '../lib/brand';
import { OG_DEFAULT_IMAGE, resolveOgImageUrl } from '../lib/og-images';
import { ADSENSE_CLIENT_ID, adsenseScriptUrl } from '../lib/adsense';

const adsenseScriptSrc = adsenseScriptUrl();

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object | object[];
  robots?: string;
}

const {
  title,
  description = `${BRAND_NAME} - Free IPO tracker, mutual fund comparison, SIP & EMI calculators. Track live IPOs, subscription status for Indian investors.`,
  ogImage = OG_DEFAULT_IMAGE,
  canonicalUrl,
  jsonLd,
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
} = Astro.props;

const siteUrl = BRAND_URL;
// Canonicalise to the non-trailing-slash form (except root) so the default
// canonical matches sitemap URLs and explicit canonicalFor() values, avoiding
// duplicate trailing-slash vs non-slash signals in Search Console.
const normalizedPathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = canonicalUrl || new URL(normalizedPathname, siteUrl).href;
const socialImage = resolveOgImageUrl(ogImage);

// Site-wide Organization schema for brand authority
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": BRAND_NAME,
  "url": BRAND_URL,
  "logo": `${BRAND_URL}/favicon.svg`,
  "description": "Free, privacy-first financial tools and data for Indian investors. Track IPOs, compare mutual funds, and plan investments without login.",
  "sameAs": [
    BRAND_TWITTER_URL
  ]
};
---

<!doctype html>
<html lang="en-IN">
  <head>
    <!--
      CONSENT MODE v2 — fires BEFORE any gtag() config call.
      Sets all storage to 'denied' by default. Updated to 'granted'
      only when user clicks Accept. Required by DPDP Act 2023 + Google policy.
    -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage':         'denied',
        'analytics_storage':  'denied',
        'ad_user_data':       'denied',
        'ad_personalization': 'denied',
        'wait_for_update':    500
      });
      if (typeof localStorage !== 'undefined') {
        try {
          var _c = localStorage.getItem('cookie-consent');
          var _accepted = _c === 'accepted' || (_c && _c.indexOf('"accepted"') !== -1);
          if (_accepted) {
            gtag('consent', 'update', {
              'ad_storage':         'granted',
              'analytics_storage':  'granted',
              'ad_user_data':       'granted',
              'ad_personalization': 'granted'
            });
          }
        } catch (e) {}
      }
    </script>

    <!-- Google tag (gtag.js) — loads AFTER consent defaults are set above -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-18230401074"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'AW-18230401074');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${socialImage}`} />
    <meta property="og:image:secure_url" content={`${siteUrl}${socialImage}`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${BRAND_NAME} — IPO analytics and mutual fund intelligence for Indian investors`} />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${BRAND_TWITTER_HANDLE}`} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${socialImage}`} />

    <!-- Additional SEO -->
    <meta name="robots" content={robots} />
    <meta name="author" content={BRAND_NAME} />
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="India" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Fonts: self-hosted via @fontsource-variable (imported in global.css, bundled by Vite) -->

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Theme: prevent flash of wrong theme -->
    <script is:inline>
      (function(){
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google AdSense account (ads load only after cookie consent) -->
    <meta name="google-adsense-account" content={ADSENSE_CLIENT_ID} />

    <!-- Third-party scripts load only after explicit cookie consent (staggered — never all at once) -->
    <script is:inline define:vars={{ adsenseScriptSrc }}>
      (function(){
        var analyticsStarted = false;
        var adsenseStarted = false;
        window.__webVitalsPending = false;
        window.__analyticsReadyPending = false;
        window.__startWebVitals = function() {
          window.__webVitalsPending = true;
          if (window.__runWebVitals) window.__runWebVitals();
        };
        window.__markAnalyticsReady = function() {
          if (window.__flushAnalyticsReady) window.__flushAnalyticsReady();
          else window.__analyticsReadyPending = true;
        };

        function delay(ms) {
          return new Promise(function(resolve) { setTimeout(resolve, ms); });
        }

        function loadScript(src, attrs) {
          return new Promise(function(resolve) {
            var s = document.createElement('script');
            s.async = true;
            s.src = src;
            if (attrs) {
              for (var k in attrs) {
                if (Object.prototype.hasOwnProperty.call(attrs, k)) s.setAttribute(k, attrs[k]);
              }
            }
            s.onload = resolve;
            s.onerror = resolve;
            document.head.appendChild(s);
          });
        }

        function runWhenIdle(fn, timeoutMs) {
          if ('requestIdleCallback' in window) {
            requestIdleCallback(function() { fn(); }, { timeout: timeoutMs || 12000 });
          } else {
            setTimeout(fn, 2000);
          }
        }

        /** Push one AdSense slot at a time so layout does not freeze. */
        window.__initAdsenseSlots = function() {
          if (!window.adsbygoogle) return;
          var slots = Array.prototype.slice.call(
            document.querySelectorAll('ins.adsbygoogle[data-ad-pending="true"]')
          );
          if (!slots.length) return;
          var i = 0;
          function pushNext() {
            if (i >= slots.length) return;
            var el = slots[i++];
            el.removeAttribute('data-ad-pending');
            try { (window.adsbygoogle = window.adsbygoogle || []).push({}); } catch (e) {}
            setTimeout(pushNext, 500);
          }
          runWhenIdle(pushNext, 8000);
        };

        function loadAdsenseWhenNeeded() {
          if (adsenseStarted) return;
          var containers = document.querySelectorAll('.ad-container');
          if (!containers.length) return;
          adsenseStarted = true;
          var loaded = false;
          function loadAds() {
            if (loaded) return;
            loaded = true;
            loadScript(
              adsenseScriptSrc,
              { crossOrigin: 'anonymous' }
            ).then(function() {
              return delay(1000);
            }).then(function() {
              if (window.__initAdsenseSlots) window.__initAdsenseSlots();
            });
          }
          if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function(entries) {
              for (var j = 0; j < entries.length; j++) {
                if (entries[j].isIntersecting) {
                  observer.disconnect();
                  runWhenIdle(loadAds, 10000);
                  return;
                }
              }
            }, { rootMargin: '300px', threshold: 0 });
            for (var c = 0; c < containers.length; c++) observer.observe(containers[c]);
            setTimeout(function() {
              observer.disconnect();
              runWhenIdle(loadAds, 12000);
            }, 45000);
          } else {
            setTimeout(function() { runWhenIdle(loadAds, 12000); }, 8000);
          }
        }

        /** GA4 analytics → pause → (optional) AdSense when visible → pause → Web Vitals */
        window.loadThirdPartyScripts = function() {
          if (analyticsStarted) return;
          analyticsStarted = true;
          if (typeof window.gtag === 'function') {
            window.gtag('config', 'G-VRXGEC8RTG');
          }
          document.addEventListener('click', function(e) {
            var el = e.target && e.target.closest ? e.target.closest('a[rel*="sponsored"]') : null;
            if (el && typeof window.gtag === 'function') {
              window.gtag('event', 'affiliate_click', {
                event_category: 'revenue',
                link_url: el.href || '',
                link_text: (el.textContent || '').trim().slice(0, 80),
              });
            }
          }, { capture: true });
          if (window.__markAnalyticsReady) window.__markAnalyticsReady();
          delay(1500)
            .then(function() {
              loadAdsenseWhenNeeded();
              return delay(6000);
            })
            .then(function() {
              if (window.__startWebVitals) window.__startWebVitals();
            });
        };

        window.scheduleThirdPartyAfterHydration = function() {
          if (window.__thirdPartyScheduled) return;
          window.__thirdPartyScheduled = true;
          var start = function() {
            runWhenIdle(function() {
              setTimeout(function() {
                if (window.loadThirdPartyScripts) window.loadThirdPartyScripts();
              }, 1500);
            }, 12000);
          };
          if (document.readyState === 'complete') {
            setTimeout(start, 2000);
          } else {
            window.addEventListener('load', function() { setTimeout(start, 2000); }, { once: true });
          }
        };

        function hasAcceptedConsent() {
          try {
            var raw = localStorage.getItem('cookie-consent');
            if (!raw) return false;
            if (raw === 'accepted') return true;
            var parsed = JSON.parse(raw);
            return parsed && parsed.status === 'accepted';
          } catch (e) {
            return false;
          }
        }

        if (hasAcceptedConsent()) {
          window.scheduleThirdPartyAfterHydration();
        }
      })();
    </script>

    <!-- JSON-LD: Organization (site-wide) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />

    <!-- JSON-LD: Page-specific -->
    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    )}

    <slot name="head" />

  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary-600 focus:text-white focus:rounded-lg focus:shadow-lg">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Search Overlay -->
    <SearchOverlay />

    <!-- Cookie Consent Banner
         - No global onclick handlers (uses addEventListener)
         - Escape key dismisses
         - Accept fires Consent Mode v2 'update' to grant all signals
         - Dismiss records decision without granting tracking
    -->
    <div
      id="cookie-consent"
      role="dialog"
      aria-modal="false"
      aria-label="Cookie consent"
      class="cookie-consent-banner fixed bottom-0 left-0 right-0 z-[90] p-4 bg-surface-900 text-white shadow-2xl cookie-consent-banner--hidden"
      aria-hidden="true"
    >
      <div class="container-wide flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-surface-300">
          We use cookies for anonymous analytics and optional ads.
          No personal data stored. <a href="/privacy" class="text-primary-300 underline hover:text-primary-200">Privacy Policy</a>.
        </p>
        <div class="flex gap-2 flex-shrink-0">
          <button id="cookie-accept-btn" type="button" class="px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-lg hover:bg-primary-500 transition-colors">Accept</button>
          <button id="cookie-dismiss-btn" type="button" class="px-4 py-2 bg-surface-700 text-surface-300 text-sm font-medium rounded-lg hover:bg-surface-600 transition-colors">Dismiss</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (function() {
        var CONSENT_KEY = 'cookie-consent';
        var CONSENT_VERSION = '1';
        var el = document.getElementById('cookie-consent');
        var acceptBtn = document.getElementById('cookie-accept-btn');
        var dismissBtn = document.getElementById('cookie-dismiss-btn');

        function readConsent() {
          try {
            var raw = localStorage.getItem(CONSENT_KEY);
            if (!raw) return null;
            if (raw === 'accepted' || raw === 'dismissed') {
              return { status: raw, ts: null, v: CONSENT_VERSION };
            }
            return JSON.parse(raw);
          } catch (e) {
            return null;
          }
        }

        function saveConsent(status) {
          localStorage.setItem(CONSENT_KEY, JSON.stringify({
            status: status,
            ts: new Date().toISOString(),
            v: CONSENT_VERSION
          }));
        }

        function hideBanner() {
          if (!el) return;
          el.classList.add('cookie-consent-banner--hidden');
          el.setAttribute('aria-hidden', 'true');
          setTimeout(function() { if (el && el.parentNode) el.parentNode.removeChild(el); }, 400);
        }

        function grantConsentSignals() {
          if (typeof window.gtag === 'function') {
            window.gtag('consent', 'update', {
              'ad_storage':         'granted',
              'analytics_storage':  'granted',
              'ad_user_data':       'granted',
              'ad_personalization': 'granted'
            });
          }
        }

        function acceptCookies() {
          try {
            saveConsent('accepted');
            grantConsentSignals();
            hideBanner();
            window.dispatchEvent(new CustomEvent('cookie-consent-accepted'));
            if (window.scheduleThirdPartyAfterHydration) window.scheduleThirdPartyAfterHydration();
          } catch (e) {}
        }

        function dismissCookies() {
          try {
            saveConsent('dismissed');
            hideBanner();
          } catch (e) {}
        }

        // Show banner on first visit
        if (!readConsent() && el) {
          el.removeAttribute('aria-hidden');
          var show = function() {
            requestAnimationFrame(function() { el.classList.remove('cookie-consent-banner--hidden'); });
          };
          if (document.readyState === 'complete') {
            setTimeout(show, 4000);
          } else {
            window.addEventListener('load', function() { setTimeout(show, 4000); }, { once: true });
          }
        }

        // Buttons wired with addEventListener — no global window namespace pollution
        if (acceptBtn) acceptBtn.addEventListener('click', acceptCookies);
        if (dismissBtn) dismissBtn.addEventListener('click', dismissCookies);

        // Escape key dismisses banner (accessibility)
        document.addEventListener('keydown', function onKey(e) {
          if (e.key === 'Escape' && el && !el.classList.contains('cookie-consent-banner--hidden')) {
            dismissCookies();
            document.removeEventListener('keydown', onKey);
          }
        });
      })();
    </script>
    <script is:inline>
      (function() {
        if (typeof localStorage === 'undefined') return;
        var path = location.pathname;
        if (!path || path === '/dashboard') return;
        var key = 'ipofins-recents';
        try {
          var recents = JSON.parse(localStorage.getItem(key) || '[]');
          var title = (document.title || '').split(' | ')[0];
          var current = { url: path, title: title, ts: Date.now() };
          recents = [current].concat(recents.filter(function(r) { return r.url !== path; })).slice(0, 10);
          localStorage.setItem(key, JSON.stringify(recents));
        } catch (e) {}
      })();
    </script>
    <DeferredAnalytics />

    <!-- FAQ mobile collapse: close all but first FAQ item on mobile screens.
         Uses [open] attribute removal — no layout shift, works without JS too
         (FAQ items stay open on SSR, collapse after hydration on small screens). -->
    <script is:inline>
      (function() {
        // FAQ: collapse extras on mobile
        if (window.innerWidth < 640) {
          var lists = document.querySelectorAll('.faq-list, [data-faq-list]');
          lists.forEach(function(list) {
            var items = list.querySelectorAll('details[open]');
            items.forEach(function(item, idx) {
              if (idx > 0) item.removeAttribute('open');
            });
          });
        }

        // FAQ: "Show all N" for long lists (data-faq-initial)
        document.querySelectorAll('[data-faq-list][data-faq-initial]').forEach(function(list) {
          var initial = parseInt(list.getAttribute('data-faq-initial') || '0', 10);
          if (!initial || initial < 1) return;
          var items = Array.prototype.slice.call(list.querySelectorAll('details.content-guide__faq-item, details'));
          if (items.length <= initial) return;
          items.forEach(function(item, idx) {
            if (idx >= initial) item.setAttribute('data-faq-hidden', '');
          });
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'faq-show-all-btn';
          btn.textContent = 'Show all ' + items.length + ' questions';
          btn.addEventListener('click', function() {
            list.setAttribute('data-faq-expanded', 'true');
            items.forEach(function(item) { item.removeAttribute('data-faq-hidden'); });
            btn.remove();
          });
          list.parentNode.insertBefore(btn, list.nextSibling);
        });
      })();
    </script>
  </body>
</html>
