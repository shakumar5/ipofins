---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object;
}

const {
  title,
  description = 'IPOfins - Free IPO tracker, mutual fund comparison, SIP & EMI calculators. Track live IPOs, GMP, subscription status for Indian investors.',
  ogImage = '/og-default.svg',
  canonicalUrl,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://ipofins.com';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content="ipofins" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="ipofins" />
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="India" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-9843041963430696" />
    <script is:inline>
      // Defer AdSense loading until after page is interactive
      window.addEventListener('load', function() {
        setTimeout(function() {
          var s = document.createElement('script');
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9843041963430696';
          s.crossOrigin = 'anonymous';
          s.async = true;
          document.head.appendChild(s);
        }, 3000);
      });
    </script>

    <!-- Google Analytics (deferred) -->
    <script is:inline>
      window.addEventListener('load', function() {
        setTimeout(function() {
          var s = document.createElement('script');
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-VRXGEC8RTG';
          s.async = true;
          s.onload = function() {
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-VRXGEC8RTG');
          };
          document.head.appendChild(s);
        }, 1500);
      });
    </script>

    <!-- Fonts (swap for better LCP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" /></noscript>

    <!-- JSON-LD -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Dark Mode Script (prevent flash) -->
    <script is:inline>
      const theme = localStorage.getItem('theme');
      if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary-600 focus:text-white focus:rounded-lg focus:shadow-lg">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Site-wide Bottom Navigation -->
    <div class="container-wide py-8 border-t border-surface-200 dark:border-surface-700">
      <p class="text-center text-xs text-surface-400 dark:text-surface-500 mb-4">Quick Navigation</p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="btn-secondary text-sm">🏠 Home</a>
        <a href="/ipo" class="btn-secondary text-sm">📊 IPOs</a>
        <a href="/mutual-funds" class="btn-secondary text-sm">💰 Mutual Funds</a>
        <a href="/broker" class="btn-secondary text-sm">🏦 Brokers</a>
        <a href="/tools" class="btn-secondary text-sm">🔧 Tools</a>
        <a href="/blogs" class="btn-secondary text-sm">📝 Blogs</a>
        <a href="/learn" class="btn-secondary text-sm">📚 Learn</a>
      </div>
    </div>

    <!-- Search Overlay -->
    <SearchOverlay />

    <!-- Cookie Consent (for AdSense compliance) -->
    <div id="cookie-consent" class="fixed bottom-0 left-0 right-0 z-[90] p-4 bg-surface-900 text-white shadow-2xl transition-transform duration-300 translate-y-full" aria-hidden="true">
      <div class="container-wide flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-surface-300">We use cookies for analytics and ads. By continuing, you agree to our <a href="/privacy" class="text-primary-400 hover:underline">Privacy Policy</a>.</p>
        <div class="flex gap-2">
          <button onclick="acceptCookies()" class="px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-lg hover:bg-primary-500 transition-colors">Accept</button>
          <button onclick="dismissCookies()" class="px-4 py-2 bg-surface-700 text-surface-300 text-sm font-medium rounded-lg hover:bg-surface-600 transition-colors">Dismiss</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (function() {
        if (!localStorage.getItem('cookie-consent')) {
          var el = document.getElementById('cookie-consent');
          if (el) { el.removeAttribute('aria-hidden'); setTimeout(function() { el.classList.remove('translate-y-full'); }, 1000); }
        }
      })();
      function acceptCookies() { localStorage.setItem('cookie-consent', 'accepted'); var el = document.getElementById('cookie-consent'); el.classList.add('translate-y-full'); }
      function dismissCookies() { localStorage.setItem('cookie-consent', 'dismissed'); var el = document.getElementById('cookie-consent'); el.classList.add('translate-y-full'); }
    </script>
  </body>
</html>
