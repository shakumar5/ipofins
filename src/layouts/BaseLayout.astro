---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchOverlay from '../components/SearchOverlay.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  jsonLd?: object;
}

const {
  title,
  description = 'IPOfins - Free IPO tracker, mutual fund comparison, SIP & EMI calculators. Track live IPOs, GMP, subscription status for Indian investors.',
  ogImage = '/og-default.svg',
  canonicalUrl,
  jsonLd,
} = Astro.props;

const siteUrl = 'https://ipofins.com';
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;

// Site-wide Organization schema for brand authority
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "IPOfins",
  "url": "https://ipofins.com",
  "logo": "https://ipofins.com/favicon.svg",
  "description": "Free, privacy-first financial tools and data for Indian investors. Track IPOs, compare mutual funds, and plan investments without login.",
  "sameAs": [
    "https://x.com/ipofins"
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}${ogImage}`} />
    <meta property="og:site_name" content="ipofins" />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${ogImage}`} />

    <!-- Additional SEO -->
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="ipofins" />
    <meta name="geo.region" content="IN" />
    <meta name="geo.placename" content="India" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Preconnect to Google Fonts (eliminates DNS+TLS latency from critical chain) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Theme: prevent flash of wrong theme -->
    <script is:inline>
      (function(){
        var t = localStorage.getItem('theme');
        if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content="ca-pub-9843041963430696" />

    <!-- Deferred third-party scripts (GA + AdSense - loaded 10s after page load) -->
    <script is:inline>
      (function(){
        var loaded = false;
        function loadScripts() {
          if (loaded) return;
          loaded = true;
          var g = document.createElement('script');
          g.src = 'https://www.googletagmanager.com/gtag/js?id=G-VRXGEC8RTG';
          g.async = true;
          g.onload = function() {
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            window.gtag = gtag;
            gtag('js', new Date());
            gtag('config', 'G-VRXGEC8RTG');
          };
          document.head.appendChild(g);
          setTimeout(function() {
            var a = document.createElement('script');
            a.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9843041963430696';
            a.crossOrigin = 'anonymous';
            a.async = true;
            document.head.appendChild(a);
          }, 3000);
        }
        // Only load after real user interaction (not simulated)
        if ('requestIdleCallback' in window) {
          requestIdleCallback(function() { setTimeout(loadScripts, 8000); });
        } else {
          setTimeout(loadScripts, 12000);
        }
      })();
    </script>

    <!-- Privacy-friendly analytics by Plausible -->
    <script async src="https://plausible.io/js/pa-TzNuTbQbTb4FXM9xfpK3x.js"></script>
    <script is:inline>
      window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
      plausible.init()
    </script>

    <!-- JSON-LD: Organization (site-wide) -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />

    <!-- JSON-LD: Page-specific -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-primary-600 focus:text-white focus:rounded-lg focus:shadow-lg">
      Skip to main content
    </a>
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Search Overlay -->
    <SearchOverlay />

    <!-- Cookie Consent (for AdSense compliance) -->
    <div id="cookie-consent" class="fixed bottom-0 left-0 right-0 z-[90] p-4 bg-surface-900 text-white shadow-2xl transition-transform duration-300 translate-y-full" aria-hidden="true">
      <div class="container-wide flex flex-col sm:flex-row items-center justify-between gap-4">
        <p class="text-sm text-surface-300">We use cookies for analytics and ads. By continuing, you agree to our <a href="/privacy" class="text-primary-300 underline hover:text-primary-200">Privacy Policy</a>.</p>
        <div class="flex gap-2">
          <button onclick="acceptCookies()" class="px-4 py-2 bg-primary-600 text-white text-sm font-medium rounded-lg hover:bg-primary-500 transition-colors">Accept</button>
          <button onclick="dismissCookies()" class="px-4 py-2 bg-surface-700 text-surface-300 text-sm font-medium rounded-lg hover:bg-surface-600 transition-colors">Dismiss</button>
        </div>
      </div>
    </div>
    <script is:inline>
      (function() {
        if (!localStorage.getItem('cookie-consent')) {
          var el = document.getElementById('cookie-consent');
          if (el) { el.removeAttribute('aria-hidden'); setTimeout(function() { el.classList.remove('translate-y-full'); }, 1000); }
        }
      })();
      function acceptCookies() { localStorage.setItem('cookie-consent', 'accepted'); var el = document.getElementById('cookie-consent'); el.classList.add('translate-y-full'); }
      function dismissCookies() { localStorage.setItem('cookie-consent', 'dismissed'); var el = document.getElementById('cookie-consent'); el.classList.add('translate-y-full'); }
    </script>
    <!-- Load Inter font non-blocking with font-display=optional -->
    <script is:inline>
      (function(){var l=document.createElement('link');l.rel='stylesheet';l.href='https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=optional';l.media='print';l.onload=function(){l.media='all'};document.head.appendChild(l)})();
    </script>
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=optional" />
    </noscript>
  </body>
</html>
