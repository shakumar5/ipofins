---
import IPOLayout from '../../layouts/IPOLayout.astro';
import upcomingData from '../../data/upcoming-ipos.json';

const drhpFiled = upcomingData.filter(ipo => ipo.status === 'drhp-filed');
const sebiApproved = upcomingData.filter(ipo => ipo.status === 'sebi-approved');

const today = new Date().toLocaleDateString('en-IN', { month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Upcoming IPO 2026 - New IPOs in India",
  "description": "Complete list of upcoming IPOs in India 2026. DRHP filed and SEBI approved IPOs with expected dates and issue sizes.",
  "url": "https://ipofins.com/ipo/upcoming",
  "dateModified": new Date().toISOString(),
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Which IPOs are upcoming in India 2026?", "acceptedAnswer": { "@type": "Answer", "text": "Major upcoming IPOs include Tata Capital (₹12,000 Cr), OYO (₹8,000 Cr), Ather Energy (₹4,500 Cr), InMobi (₹5,500 Cr), PhysicsWallah (₹2,800 Cr), and Boat (₹2,000 Cr)." } },
    { "@type": "Question", "name": "What is DRHP filed vs SEBI approved?", "acceptedAnswer": { "@type": "Answer", "text": "DRHP Filed = documents submitted to SEBI for review (30-75 days). SEBI Approved = company can launch IPO within 12 months." } },
    { "@type": "Question", "name": "How long after SEBI approval does IPO open?", "acceptedAnswer": { "@type": "Answer", "text": "Most companies launch within 2-6 months of SEBI approval. They have up to 12 months." } }
  ]
};
---

<IPOLayout
  activeTab="upcoming"
  title={`Upcoming IPO 2026 - New IPO List India (${today})`}
  description={`${upcomingData.length} upcoming IPOs in India 2026. DRHP filed & SEBI approved companies including Tata Capital, OYO, Ather Energy.`}
  jsonLd={jsonLd}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <!-- Header -->
  <section class="container-wide pt-6 pb-4">
    <h1 class="text-2xl font-bold text-surface-900 dark:text-white">Upcoming IPOs India 2026</h1>
    <p class="mt-1 text-sm text-surface-500">{upcomingData.length} companies have filed DRHP or received SEBI approval.</p>
  </section>

  <!-- SEBI Approved -->
  <section class="container-wide py-4">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-2 h-2 bg-success-500 rounded-full"></div>
      <h2 class="text-lg font-bold text-surface-900 dark:text-white">SEBI Approved — Expected Soon</h2>
      <span class="badge bg-success-50 text-success-600">{sebiApproved.length}</span>
    </div>
    <div class="space-y-2">
      {sebiApproved.map(ipo => (
        <a href={`/ipo/upcoming/${ipo.slug}`} class="card-compact group block hover:shadow-md transition-shadow">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors">{ipo.name}</h3>
                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-success-50 text-success-600">Approved</span>
              </div>
              <p class="text-xs text-surface-400 mt-0.5">{ipo.sector} • {ipo.type.toUpperCase()} • Registrar: {ipo.registrar}</p>
            </div>
            <div class="flex items-center gap-5 text-xs">
              <div><span class="text-surface-400">Size </span><span class="font-bold text-surface-800 dark:text-surface-200">{ipo.issueSize}</span></div>
              <div><span class="text-surface-400">Filed </span><span class="font-medium">{ipo.drhpDate}</span></div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- DRHP Filed -->
  <section class="container-wide py-4">
    <div class="flex items-center gap-3 mb-4">
      <div class="w-2 h-2 bg-warning-500 rounded-full"></div>
      <h2 class="text-lg font-bold text-surface-900 dark:text-white">DRHP Filed — Awaiting SEBI Approval</h2>
      <span class="badge bg-warning-50 text-warning-600">{drhpFiled.length}</span>
    </div>
    <div class="space-y-2">
      {drhpFiled.map(ipo => (
        <a href={`/ipo/upcoming/${ipo.slug}`} class="card-compact group block hover:shadow-md transition-shadow">
          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors">{ipo.name}</h3>
                <span class="px-2 py-0.5 text-xs font-medium rounded-full bg-warning-50 text-warning-600">DRHP Filed</span>
              </div>
              <p class="text-xs text-surface-400 mt-0.5">{ipo.sector} • {ipo.type.toUpperCase()} • Registrar: {ipo.registrar}</p>
            </div>
            <div class="flex items-center gap-5 text-xs">
              <div><span class="text-surface-400">Size </span><span class="font-bold text-surface-800 dark:text-surface-200">{ipo.issueSize}</span></div>
              <div><span class="text-surface-400">Filed </span><span class="font-medium">{ipo.drhpDate}</span></div>
              <div><span class="text-surface-400">Expected </span><span class="font-medium text-primary-600">2-4 months</span></div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- SEO Content -->
  <section class="container-wide py-8">
    <div class="max-w-3xl space-y-3 text-sm text-surface-600 dark:text-surface-300">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white">About Upcoming IPOs</h2>
      <p>Companies must file a DRHP with SEBI before going public. After SEBI gives its observation letter, the company has 12 months to launch. IPOfins tracks all filings automatically and updates this page every 12 hours.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-wide py-6">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">FAQ</h2>
    <div class="space-y-3 max-w-3xl">
      <details class="card-compact group" open>
        <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">Which IPOs are upcoming in 2026?</summary>
        <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">Tata Capital (₹12,000 Cr), OYO (₹8,000 Cr), Ather Energy (₹4,500 Cr), InMobi (₹5,500 Cr), PhysicsWallah (₹2,800 Cr), Boat (₹2,000 Cr).</p>
      </details>
      <details class="card-compact group">
        <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">DRHP Filed vs SEBI Approved?</summary>
        <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">DRHP Filed = under SEBI review. SEBI Approved = can launch within 12 months.</p>
      </details>
    </div>
  </section>
</IPOLayout>
