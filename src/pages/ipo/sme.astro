---
import IPOLayout from '../../layouts/IPOLayout.astro';
import iposRaw from '../../data/ipos.json';
import { withCorrectStatuses } from '../../utils/ipo-status';

const iposData = withCorrectStatuses(iposRaw);
const smeIPOs = iposData.filter(ipo => ipo.type === 'sme' && ipo.status === 'live');
---

<IPOLayout title="SME IPOs India 2026 - BSE SME & NSE Emerge | IPOfins" description="All SME IPOs in India 2026. Track small and medium enterprise IPOs on BSE SME and NSE Emerge platforms." activeTab="sme">
  <section class="container-wide py-6">
    <h1 class="text-2xl font-bold text-surface-900 dark:text-white mb-1">SME IPOs — Live</h1>
    <p class="text-sm text-surface-500 mb-6">{smeIPOs.length} SME IPOs currently open for subscription</p>

    {smeIPOs.length > 0 ? (
      <div class="space-y-2">
        {smeIPOs.map(ipo => (
          <a href={`/ipo/${ipo.slug}`} class="card-compact group block hover:shadow-md transition-shadow">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
              <div class="flex-1 min-w-0">
                <div class="flex items-center gap-2">
                  <h2 class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors truncate">{ipo.name}</h2>
                  <span class={`badge text-[10px] ${ipo.status === 'live' ? 'badge-live' : ipo.status === 'listed' ? 'badge-listed' : 'badge-closed'}`}>{ipo.status}</span>
                </div>
                <p class="text-xs text-surface-400 mt-0.5">{ipo.sector} • {ipo.issueSize} • {ipo.openDate} – {ipo.closeDate}</p>
              </div>
              <div class="flex items-center gap-5 text-xs">
                <div><span class="text-surface-400">Price </span><span class="font-semibold">₹{ipo.priceRange}</span></div>
                <div><span class="text-surface-400">Lot </span><span class="font-semibold">{ipo.lotSize}</span></div>
                {ipo.gmp !== undefined && ipo.gmp !== null && <div><span class="text-surface-400">GMP </span><span class={`font-bold ${ipo.gmp >= 0 ? 'text-success-500' : 'text-danger-500'}`}>{ipo.gmp >= 0 ? '+' : ''}₹{ipo.gmp}</span></div>}
                {ipo.aiScore && <div><span class="text-surface-400">AI </span><span class={`font-bold ${ipo.aiScore >= 7 ? 'text-success-500' : 'text-warning-500'}`}>{ipo.aiScore}/10</span></div>}
              </div>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <p class="text-surface-500 py-8 text-center">No SME IPOs available currently.</p>
    )}
  </section>

  <!-- FAQ Section -->
  <section class="container-wide py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">SME IPO FAQs</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is an SME IPO?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">SME (Small and Medium Enterprise) IPOs are listed on BSE SME or NSE Emerge platforms. These are smaller companies with issue sizes typically ₹5–50 Cr. They have relaxed listing requirements compared to mainboard. SME IPOs can give very high listing gains (50–100%+) but carry higher risk due to lower liquidity and limited company track record.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is the minimum investment for an SME IPO?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">SME IPOs have a minimum lot size of ₹1–2 lakh (higher than mainboard). For example, if lot size is 2000 shares at ₹60, minimum investment is ₹1,20,000. This higher minimum is set by SEBI to ensure only investors who can afford the risk participate in SME IPOs.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Are SME IPOs riskier than Mainboard IPOs?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Yes, generally. SME companies are smaller, have shorter operating history, lower liquidity after listing, and less analyst coverage. However, some SME IPOs deliver exceptional returns (100%+ listing gains). Do thorough research — check promoter background, financials, industry outlook, and subscription trends before applying.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How long does it take to sell SME IPO shares after listing?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">You can sell on listing day itself. However, SME stocks have lower liquidity — there might not be enough buyers at your desired price. Many SME stocks hit upper/lower circuits on listing day. It's recommended to place limit orders rather than market orders. Lock-in for anchor investors is 30/90 days.</p>
      </details>
    </div>
  </section>
</IPOLayout>
