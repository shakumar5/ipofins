---
import IPOLayout from '../../layouts/IPOLayout.astro';
import iposRaw from '../../data/ipos.json';
import { withCorrectStatuses } from '../../utils/ipo-status';

const iposData = withCorrectStatuses(iposRaw);
const iposWithGMP = iposData.filter(ipo => ipo.gmp !== undefined && (ipo.status === 'live' || ipo.status === 'upcoming'));
const listedWithGMP = iposData.filter(ipo => ipo.gmp !== undefined && ipo.status === 'listed');

const today = new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Asia/Kolkata' });

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `IPO GMP Today - ${today}`,
  "description": "Live Grey Market Premium (GMP) for all current and upcoming IPOs in India. Updated every 12 hours.",
  "url": "https://ipofins.com/ipo/gmp-today",
  "dateModified": new Date().toISOString(),
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "IPOs", "item": "https://ipofins.com/ipo" },
      { "@type": "ListItem", "position": 3, "name": "GMP Today", "item": "https://ipofins.com/ipo/gmp-today" }
    ]
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is IPO GMP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GMP (Grey Market Premium) is the unofficial premium at which IPO shares are traded in the grey market before they are officially listed on the stock exchange. A positive GMP indicates expected listing gains."
      }
    },
    {
      "@type": "Question",
      "name": "Is GMP a reliable indicator of listing price?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GMP gives a directional indication but is not always accurate. It can change rapidly based on market sentiment. Use GMP as one of many factors in your decision, not the sole indicator."
      }
    },
    {
      "@type": "Question",
      "name": "How often does GMP change?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "GMP can change multiple times a day based on demand and supply in the grey market. It typically stabilizes 1-2 days before listing. Our data refreshes every 12 hours."
      }
    },
    {
      "@type": "Question",
      "name": "Should I apply for an IPO with high GMP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "High GMP indicates market enthusiasm but doesn't guarantee listing gains. Consider fundamentals, company financials, sector outlook, and subscription data alongside GMP before applying."
      }
    }
  ]
};
---

<IPOLayout activeTab="gmp-today"
  title={`IPO GMP Today (${today}) - Live Grey Market Premium`}
  description={`Latest IPO GMP today ${today}. Check live Grey Market Premium for all upcoming and current IPOs. Mainboard & SME IPO GMP updated every 12 hours.`}
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />



  <!-- Header -->
  <section class="container-wide pt-8 pb-6">
    <div class="flex items-center gap-3 mb-2">
      <span class="w-2 h-2 bg-success-500 rounded-full animate-pulse"></span>
      <span class="text-xs font-medium text-success-600 dark:text-success-400">Updated every 12 hours</span>
    </div>
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      IPO GMP Today — {today}
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300 max-w-2xl">
      Live Grey Market Premium (GMP) for all current and upcoming IPOs in India. GMP indicates the unofficial premium at which shares trade before listing.
    </p>
  </section>

  <!-- Live/Upcoming IPO GMP -->
  <section class="container-wide py-6">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Current IPO GMP</h2>
    
    {iposWithGMP.length > 0 ? (
      <div class="space-y-3">
        {iposWithGMP.map(ipo => {
          const upperPrice = parseInt(ipo.priceRange.split('-').pop() || '0');
          const expectedListing = upperPrice + (ipo.gmp || 0);
          const expectedReturn = upperPrice > 0 ? ((ipo.gmp || 0) / upperPrice * 100).toFixed(1) : '0';
          
          return (
            <a href={`/ipo/${ipo.slug}`} class="card group block">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="text-base font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors">{ipo.name}</h3>
                    <span class={`badge ${ipo.status === 'live' ? 'badge-live' : 'badge-upcoming'}`}>{ipo.status === 'live' ? 'Live' : 'Upcoming'}</span>
                    <span class="text-xs text-surface-500 uppercase">{ipo.type}</span>
                  </div>
                  <p class="text-xs text-surface-500 dark:text-surface-400 mt-1">{ipo.sector} • ₹{ipo.priceRange} • {ipo.openDate} to {ipo.closeDate}</p>
                </div>
                <div class="grid grid-cols-3 gap-6 text-center">
                  <div>
                    <p class="text-xs text-surface-500 dark:text-surface-400">GMP</p>
                    <p class={`text-lg font-bold ${(ipo.gmp || 0) >= 0 ? 'text-success-500' : 'text-danger-500'}`}>
                      {(ipo.gmp || 0) >= 0 ? '+' : ''}₹{ipo.gmp}
                    </p>
                  </div>
                  <div>
                    <p class="text-xs text-surface-500 dark:text-surface-400">Expected Listing</p>
                    <p class="text-lg font-bold text-surface-900 dark:text-white">₹{expectedListing}</p>
                  </div>
                  <div>
                    <p class="text-xs text-surface-500 dark:text-surface-400">Expected Return</p>
                    <p class={`text-lg font-bold ${parseFloat(expectedReturn) >= 0 ? 'text-success-500' : 'text-danger-500'}`}>
                      {parseFloat(expectedReturn) >= 0 ? '+' : ''}{expectedReturn}%
                    </p>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="card text-center py-8">
        <p class="text-surface-500 dark:text-surface-400">No IPOs with GMP data currently. Check back when new IPOs open.</p>
      </div>
    )}
  </section>

  <!-- Recently Listed GMP (Performance) -->
  {listedWithGMP.length > 0 && (
    <section class="container-wide py-6">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Recently Listed — GMP vs Actual</h2>
      <div class="space-y-3">
        {listedWithGMP.map(ipo => {
          const upperPrice = parseInt(ipo.priceRange.split('-').pop() || '0');
          const expectedListing = upperPrice + (ipo.gmp || 0);
          const actualPrice = upperPrice; // Use issue price as baseline for listed
          return (
            <a href={`/ipo/${ipo.slug}`} class="card-compact group block">
              <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-2">
                <div>
                  <h3 class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors">{ipo.name}</h3>
                  <p class="text-xs text-surface-500 mt-0.5">{ipo.sector} • {ipo.type.toUpperCase()}</p>
                </div>
                <div class="flex items-center gap-6 text-xs">
                  <div class="text-center">
                    <p class="text-surface-400">Issue Price</p>
                    <p class="font-semibold text-surface-800 dark:text-surface-200">₹{upperPrice}</p>
                  </div>
                  <div class="text-center">
                    <p class="text-surface-400">GMP</p>
                    <p class={`font-bold ${(ipo.gmp || 0) >= 0 ? 'text-success-500' : 'text-danger-500'}`}>
                      {(ipo.gmp || 0) >= 0 ? '+' : ''}₹{ipo.gmp}
                    </p>
                  </div>
                  <div class="text-center">
                    <p class="text-surface-400">Expected</p>
                    <p class="font-semibold text-primary-600">₹{expectedListing}</p>
                  </div>
                  <div class="text-center">
                    <p class="text-surface-400">Actual Listing</p>
                    <p class="font-bold text-surface-900 dark:text-white">₹{upperPrice}</p>
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  )}

  <!-- SEO Content -->
  <section class="container-wide py-12">
    <div class="max-w-3xl">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">What is IPO GMP (Grey Market Premium)?</h2>
      <div class="space-y-4 text-sm text-surface-600 dark:text-surface-300 leading-relaxed">
        <p>
          IPO Grey Market Premium (GMP) is the unofficial premium at which IPO shares are traded in the grey market before they are officially listed on BSE or NSE. The grey market is an unofficial, over-the-counter market where IPO shares are bought and sold outside of the formal stock exchange system.
        </p>
        <p>
          For example, if an IPO has a price band of ₹100-105 and the current GMP is ₹50, it means shares are trading at approximately ₹155 in the grey market, indicating expected listing gains of about 47%.
        </p>
        
        <h3 class="text-base font-semibold text-surface-800 dark:text-surface-200 pt-2">How GMP is Determined</h3>
        <p>
          GMP is driven by supply and demand in the unofficial market. Factors affecting GMP include:
        </p>
        <ul class="list-disc list-inside space-y-1">
          <li>Company fundamentals and growth prospects</li>
          <li>Overall market sentiment (bull vs bear market)</li>
          <li>Subscription levels across categories (Retail, HNI, QIB)</li>
          <li>Sector momentum and peer valuations</li>
          <li>Lot size and total issue size</li>
        </ul>

        <h3 class="text-base font-semibold text-surface-800 dark:text-surface-200 pt-2">Should You Rely on GMP?</h3>
        <p>
          While GMP provides a useful directional indicator, it has limitations. GMP can be manipulated, changes rapidly, and doesn't account for post-listing volatility. We recommend using GMP as one of several factors in your analysis, alongside AI scores, fundamental analysis, and subscription data available on our platform.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-wide py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is IPO GMP?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">GMP (Grey Market Premium) is the unofficial premium at which IPO shares are traded before listing. A GMP of ₹50 on a ₹100 IPO means shares trade at ₹150 in the grey market.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Is GMP a reliable indicator?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">GMP gives directional indication but is not always accurate. It can change rapidly. Use it alongside fundamentals, subscription data, and AI analysis.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How often does GMP change?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">GMP can change multiple times daily. It typically stabilizes 1-2 days before listing. Our data refreshes every 12 hours.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Should I apply for an IPO with high GMP?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">High GMP indicates demand but doesn't guarantee listing gains. Consider company fundamentals, sector outlook, AI score, and subscription data before applying.</p>
      </details>
    </div>
  </section>

  <!-- Related Links -->
  <section class="container-wide py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related Pages</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/ipo" class="btn-secondary">All IPOs</a>
      <a href="/ipo/subscription-status" class="btn-secondary">Subscription Status</a>
      <a href="/ipo/allotment-status" class="btn-secondary">Allotment Status</a>
      <a href="/ipo/performance/2026" class="btn-secondary">IPO Performance 2026</a>
      <a href="/tools/ipo-profit-calculator" class="btn-secondary">IPO Profit Calculator</a>
    </div>
  </section>
</IPOLayout>
