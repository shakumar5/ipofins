---
import IPOLayout from '../../../layouts/IPOLayout.astro';
import PerformanceTable from '../../../components/performance/PerformanceTable.tsx';
import performanceAllData from '../../../data/ipo-performance.json';
import iposRaw from '../../../data/ipos.json';
import { withCorrectStatuses } from '../../../utils/ipo-status';

const iposData = withCorrectStatuses(iposRaw as any[]);

export function getStaticPaths() {
  return ['2024', '2025', '2026'].map(year => ({
    params: { year },
    props: { year },
  }));
}

const { year } = Astro.props;

const yearData = (performanceAllData as Record<string, any>)[year] || { mainboard: [], sme: [] };
const mainboardData = yearData.mainboard || [];
const smeData = yearData.sme || [];
const existingSlugs = iposData.map(ipo => ipo.slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": `IPO Performance ${year}`,
  "description": `IPO listing performance ${year}. Mainboard and SME IPO returns tracker.`,
  "url": `https://ipofins.com/ipo/performance/${year}`,
};
---

<IPOLayout
  activeTab="performance"
  title={`IPO Performance ${year} - Listing Returns (Mainboard & SME) | IPOfins`}
  description={`IPO performance ${year}: ${mainboardData.length} mainboard + ${smeData.length} SME IPOs. Track listing gains, sort by returns, view company details.`}
  jsonLd={jsonLd}
>
  <section class="container-wide pt-6 pb-4">
    <h1 class="text-2xl font-bold text-surface-900 dark:text-white">IPO Performance {year}</h1>
    <p class="mt-1 text-sm text-surface-500">Listing day returns for all IPOs in {year}. Click any company for details.</p>

    <!-- Year Selector -->
    <div class="mt-4 flex gap-2">
      {['2024', '2025', '2026'].map(y => (
        <a
          href={`/ipo/performance/${y}`}
          class={`px-4 py-2 text-sm font-medium rounded-lg transition-colors ${
            y === year ? 'bg-primary-600 text-white' : 'bg-surface-100 dark:bg-surface-800 text-surface-600 dark:text-surface-300 hover:bg-surface-200'
          }`}
        >
          {y}
        </a>
      ))}
    </div>
  </section>

  <!-- Interactive Table -->
  <section class="container-wide py-4">
    <PerformanceTable client:load mainboardData={mainboardData} smeData={smeData} existingSlugs={existingSlugs} />
  </section>
</IPOLayout>
