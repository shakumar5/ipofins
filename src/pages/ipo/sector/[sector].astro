---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import IPOCard from '../../../components/IPOCard.astro';
import iposRaw from '../../../data/ipos.json';
import { withCorrectStatuses } from '../../../utils/ipo-status';

const iposData = withCorrectStatuses(iposRaw as any[]);
const sectors = [...new Set(iposData.map(ipo => ipo.sector).filter(Boolean))];

export function getStaticPaths() {
  const allIPOs = withCorrectStatuses(iposRaw as any[]);
  const sectorSlugs = [...new Set(allIPOs.map(ipo => ipo.sector?.toLowerCase().replace(/\s+/g, '-')).filter(Boolean))];
  return sectorSlugs.map(sector => ({
    params: { sector },
    props: { sector },
  }));
}

const { sector } = Astro.props;
const sectorName = sector.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
const sectorIPOs = iposData.filter(ipo => ipo.sector?.toLowerCase().replace(/\s+/g, '-') === sector);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${sectorName} IPOs India`,
  "description": `All IPOs in the ${sectorName} sector. Track upcoming, live, and listed ${sectorName} IPOs with AI analysis.`,
  "url": `https://ipofins.com/ipo/sector/${sector}`,
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "IPOs", "item": "https://ipofins.com/ipo" },
      { "@type": "ListItem", "position": 3, "name": sectorName, "item": `https://ipofins.com/ipo/sector/${sector}` }
    ]
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `How to invest in ${sectorName} IPOs?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `To invest in ${sectorName} IPOs, you need a demat account with any SEBI-registered broker. When an IPO opens, apply through your broker's app or UPI-based ASBA process. Check the company's DRHP, financials, and sector outlook before investing.`
      }
    },
    {
      "@type": "Question",
      "name": `Are ${sectorName} IPOs risky?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Like all equity investments, ${sectorName} IPOs carry market risk. Sector-specific risks include regulatory changes, competition, and cyclical demand patterns. Evaluate each company's fundamentals individually rather than assuming all sector IPOs will perform similarly.`
      }
    },
    {
      "@type": "Question",
      "name": "What to check before investing in a sector-specific IPO?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Key checks include: company revenue growth and profitability, debt levels, promoter background, competitive positioning within the sector, IPO valuation vs listed peers, use of IPO proceeds, and overall sector growth outlook. Also review the GMP trend and subscription data."
      }
    },
    {
      "@type": "Question",
      "name": `How many IPOs have come from the ${sectorName} sector in 2026?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `This page lists all ${sectorName} sector IPOs tracked on IPOfins, including upcoming, live, and listed ones. The count updates automatically as new IPOs are announced. Check this page regularly for the latest sector-specific IPO activity.`
      }
    }
  ]
};
---

<BaseLayout title={`${sectorName} IPOs India - Sector Analysis | IPOfins`} description={`Complete list of ${sectorName} sector IPOs in India. AI-powered analysis, GMP tracking, and investment insights for ${sectorName} companies.`} jsonLd={jsonLd}>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/ipo" class="hover:text-primary-600 transition-colors">IPOs</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">{sectorName}</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      {sectorName} IPOs
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300 max-w-2xl">
      All IPOs from the {sectorName} sector with AI-powered investment insights and performance tracking.
    </p>
  </section>

  <section class="container-wide py-6">
    {sectorIPOs.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {sectorIPOs.map(ipo => <IPOCard {...ipo} />)}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-surface-500 dark:text-surface-400">No IPOs found in this sector currently. Check back soon!</p>
      </div>
    )}
  </section>

  <!-- Other Sectors -->
  <section class="container-wide py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Explore Other Sectors</h2>
    <div class="flex flex-wrap gap-2">
      {sectors.map(s => (
        <a
          href={`/ipo/sector/${s?.toLowerCase().replace(/\s+/g, '-')}`}
          class={`px-3 py-1.5 text-sm rounded-lg transition-colors ${
            s?.toLowerCase().replace(/\s+/g, '-') === sector
              ? 'bg-primary-600 text-white'
              : 'bg-surface-100 dark:bg-surface-800 text-surface-600 dark:text-surface-300 hover:bg-surface-200'
          }`}
        >
          {s}
        </a>
      ))}
    </div>
  </section>

  <!-- SEO Content Section -->
  <section class="container-narrow py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Investing in {sectorName} Sector IPOs</h2>
    <div class="prose prose-sm dark:prose-invert max-w-none text-surface-600 dark:text-surface-300">
      <p>Sector-focused IPO analysis helps investors understand industry-specific trends and identify opportunities within a particular segment of the Indian economy. The {sectorName} sector has seen growing interest from retail and institutional investors, driven by India's economic growth and increasing market participation.</p>
      <p>When evaluating IPOs from a specific sector, it's essential to understand the industry's growth drivers, regulatory environment, and competitive landscape. Compare the IPO company's financials with already-listed peers in the same sector — look at revenue growth rates, profit margins, return on equity (ROE), and debt-to-equity ratios. A company priced at a premium to listed peers needs strong justification through superior growth or market position.</p>
      <p>Sector concentration is a common risk in IPO investing. Avoid over-allocating to a single sector regardless of how promising it appears. SEBI regulations require companies to disclose sector-specific risks in the DRHP — review these carefully. Also consider the timing: sectors go through cycles, and IPOs tend to cluster during sector bull runs when valuations may be stretched. Use this page to track all {sectorName} IPOs, monitor their listing performance, and make informed decisions based on comprehensive data rather than market hype.</p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="container-wide py-12">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How to invest in {sectorName} IPOs?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">To invest in {sectorName} IPOs, you need a demat account with any SEBI-registered broker (Zerodha, Groww, Angel One, etc.). When an IPO opens, apply through your broker's app using the UPI-based ASBA process. Check the company's DRHP, financials, and sector outlook before investing. Allotment is lottery-based for retail investors.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Are {sectorName} IPOs risky?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Like all equity investments, {sectorName} IPOs carry market risk. Sector-specific risks include regulatory changes, competition intensity, technological disruption, and cyclical demand patterns. Evaluate each company individually — not all companies in a sector perform the same way. Diversification across sectors is recommended.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What to check before investing in a sector-specific IPO?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Key checks include: company revenue growth and profitability, debt levels, promoter background and track record, competitive positioning within the sector, IPO valuation vs listed peers (P/E, P/B ratios), use of IPO proceeds (growth vs debt repayment), and overall sector growth outlook. Also monitor the GMP trend and subscription data during the IPO period.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How many IPOs have come from the {sectorName} sector in 2026?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">This page lists all {sectorName} sector IPOs tracked on IPOfins, including upcoming, live, and already-listed ones. The count updates automatically as new IPOs are announced by SEBI. Check this page regularly for the latest sector-specific IPO activity and performance data.</p>
      </details>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
