---
import IPOLayout from '../../layouts/IPOLayout.astro';
import AdUnit from '../../components/AdUnit.astro';
import AIInsightBox from '../../components/AIInsightBox.astro';
import IpoRiskScore from '../../components/IpoRiskScore.astro';
import { getAllIPOs } from '../../lib/data/ipos';
import { ZERODHA_OPEN_ACCOUNT_URL } from '../../lib/affiliate-links';
import { withCorrectStatuses } from '../../utils/ipo-status';
import { buildShouldApplyFaqAnswer } from '../../lib/ipo-apply-faq';
import { defaultIpoListBack, IPO_LIST_BACK } from '../../lib/list-back-nav';
import ListBackLink from '../../components/ListBackLink.astro';
import type { IPORecord } from '../../types/ipo';

export async function getStaticPaths() {
  const allIPOs = withCorrectStatuses(await getAllIPOs());
  return allIPOs.map(ipo => ({
    params: { slug: ipo.slug },
    props: { ipo },
  }));
}

const { ipo: rawIpo } = Astro.props;
const ipo = rawIpo as unknown as IPORecord;

const statusConfig = {
  live: { label: 'Live', class: 'badge-live' },
  open: { label: 'Open', class: 'bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300' },
  upcoming: { label: 'Upcoming', class: 'badge-upcoming' },
  closed: { label: 'Closed', class: 'badge-closed' },
  allotment: { label: 'Allotment', class: 'bg-teal-50 text-teal-700 dark:bg-teal-900/30 dark:text-teal-300' },
  listed: { label: 'Listed', class: 'badge-listed' },
  'drhp-filed': { label: 'DRHP Filed', class: 'bg-surface-100 text-surface-600 dark:bg-surface-700 dark:text-surface-300' },
  failed: { label: 'Failed', class: 'bg-red-50 text-red-700 dark:bg-red-900/30 dark:text-red-300' },
  withdrawn: { label: 'Withdrawn', class: 'bg-surface-100 text-surface-500 dark:bg-surface-700 dark:text-surface-400' },
};
const statusInfo = statusConfig[ipo.status as keyof typeof statusConfig] || statusConfig['upcoming'];
const shouldApplyAnswer = buildShouldApplyFaqAnswer(ipo, ipo.gmp);
const defaultBack = defaultIpoListBack(ipo.type);
const ipoBackVariants = Object.fromEntries(
  Object.entries(IPO_LIST_BACK).filter(([key]) => key !== 'sector'),
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FinancialProduct",
  "name": `${ipo.name} IPO`,
  "description": ipo.description || ipo.aiSummary,
  "url": `https://ipofins.com/ipo/${ipo.slug}`,
};
---

<IPOLayout
  activeTab={ipo.type === 'mainboard' ? 'mainboard' : 'sme'}
  title={`${ipo.name} IPO - Price, Subscription & Review | IPOFins`}
  description={`${ipo.name} IPO: Price ₹${ipo.priceRange}, lot size ${ipo.lotSize}, issue size ${ipo.issueSize}. ${ipo.description?.slice(0, 100)}`}
  jsonLd={jsonLd}
>
  <!-- Header -->
  <section class="container-wide pt-6 pb-4">
    <ListBackLink
      id="ipo-list-back"
      defaultHref={defaultBack.href}
      defaultLabel={defaultBack.label}
      variants={ipoBackVariants}
      class="text-sm text-primary-600 hover:underline mb-3 inline-flex items-center gap-1"
    />

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4 mt-3">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class={`badge ${statusInfo.class}`}>{statusInfo.label}</span>
          <span class="text-xs text-surface-500 uppercase">{ipo.type}</span>
          <span class="text-xs text-surface-400">• {ipo.sector}</span>
        </div>
        <h1 class="text-2xl lg:text-3xl font-extrabold text-surface-900 dark:text-white">{ipo.name} IPO</h1>
        <p class="mt-1 text-sm text-surface-500">{ipo.sector} • {ipo.issueSize} • {ipo.headquarters || ''}</p>
      </div>
      <div class="flex items-center gap-4">
        {ipo.aiScore && (
          <div class="text-center">
            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-primary-500 to-primary-600 flex items-center justify-center">
              <span class="text-xl font-bold text-white">{ipo.aiScore}</span>
            </div>
            <p class="text-xs text-surface-500 mt-1" title="Quantitative score based on financials, valuation, and sector data">IPOFins Score</p>
          </div>
        )}
        <IpoRiskScore ipo={ipo} size="lg" />
      </div>
    </div>
  </section>

  <!-- Key Metrics -->
  <section class="container-wide py-4">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">Price Band</p>
        <p class="text-base font-bold text-surface-900 dark:text-white mt-1">₹{ipo.priceRange}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">Lot Size</p>
        <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.lotSize} shares</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">Issue Size</p>
        <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.issueSize}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">Open</p>
        <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.openDate}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">Close</p>
        <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.closeDate}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">Subscription</p>
        {ipo.subscription !== null && ipo.subscription !== undefined ? (
          <p class="text-base font-bold mt-1 text-primary-600">{ipo.subscription}x</p>
        ) : (
          <p class="text-base font-bold mt-1 text-surface-400">—</p>
        )}
      </div>
    </div>
  </section>

  <!-- IPO Schedule -->
  {(ipo.allotmentDate || ipo.listingDate || ipo.refundDate || ipo.creditDate) && (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">IPO Schedule</h2>
      <div class="card overflow-hidden">
        <table class="w-full text-sm">
          <tbody class="divide-y divide-surface-100 dark:divide-surface-700">
            <tr>
              <td class="py-2.5 px-3 text-surface-500 dark:text-surface-400">Issue Open Date</td>
              <td class="py-2.5 px-3 font-semibold text-surface-900 dark:text-white text-right">{ipo.openDate || '—'}</td>
            </tr>
            <tr>
              <td class="py-2.5 px-3 text-surface-500 dark:text-surface-400">Issue Close Date</td>
              <td class="py-2.5 px-3 font-semibold text-surface-900 dark:text-white text-right">{ipo.closeDate || '—'}</td>
            </tr>
            {ipo.allotmentDate && (
              <tr>
                <td class="py-2.5 px-3 text-surface-500 dark:text-surface-400">Allotment Date</td>
                <td class="py-2.5 px-3 font-semibold text-surface-900 dark:text-white text-right">{ipo.allotmentDate}</td>
              </tr>
            )}
            {ipo.refundDate && (
              <tr>
                <td class="py-2.5 px-3 text-surface-500 dark:text-surface-400">Refund Initiation</td>
                <td class="py-2.5 px-3 font-semibold text-surface-900 dark:text-white text-right">{ipo.refundDate}</td>
              </tr>
            )}
            {ipo.creditDate && (
              <tr>
                <td class="py-2.5 px-3 text-surface-500 dark:text-surface-400">Share Credit (Demat)</td>
                <td class="py-2.5 px-3 font-semibold text-surface-900 dark:text-white text-right">{ipo.creditDate}</td>
              </tr>
            )}
            {ipo.listingDate && (
              <tr>
                <td class="py-2.5 px-3 text-surface-500 dark:text-surface-400">Listing Date</td>
                <td class="py-2.5 px-3 font-semibold text-primary-600 dark:text-primary-400 text-right">{ipo.listingDate}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- About Company -->
  {ipo.description && (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">About {ipo.name}</h2>
      <div class="card">
        <p class="text-sm text-surface-600 dark:text-surface-300 leading-relaxed">{ipo.description}</p>
      </div>
    </section>
  )}

  <!-- Company Details Grid -->
  <section class="container-wide py-4">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">Company Details</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      {ipo.founders && (
        <div class="card-compact">
          <p class="text-xs text-surface-500">Founders / Promoters</p>
          <p class="text-sm font-semibold text-surface-900 dark:text-white mt-1">{ipo.founders}</p>
        </div>
      )}
      {ipo.headquarters && (
        <div class="card-compact">
          <p class="text-xs text-surface-500">Headquarters</p>
          <p class="text-sm font-semibold text-surface-900 dark:text-white mt-1">{ipo.headquarters}</p>
        </div>
      )}
      {ipo.founded && (
        <div class="card-compact">
          <p class="text-xs text-surface-500">Founded</p>
          <p class="text-sm font-semibold text-surface-900 dark:text-white mt-1">{ipo.founded}</p>
        </div>
      )}
      {ipo.registrar && (
        <div class="card-compact">
          <p class="text-xs text-surface-500">Registrar</p>
          <p class="text-sm font-semibold text-surface-900 dark:text-white mt-1">{ipo.registrar}</p>
        </div>
      )}
    </div>
  </section>

  <!-- Purpose of IPO -->
  {ipo.purpose && (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">Purpose of IPO (Objects of the Issue)</h2>
      <div class="card">
        <p class="text-sm text-surface-600 dark:text-surface-300 leading-relaxed">{ipo.purpose}</p>
      </div>
    </section>
  )}

  <!-- DRHP Document -->
  {ipo.drhpUrl && (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">Documents</h2>
      <a href={ipo.drhpUrl} target="_blank" rel="noopener noreferrer" class="card-compact group inline-flex items-center gap-3 hover:shadow-md transition-shadow">
        <div class="w-10 h-10 bg-danger-50 dark:bg-danger-500/10 rounded-lg flex items-center justify-center">
          <svg class="w-5 h-5 text-danger-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
        </div>
        <div>
          <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors">DRHP / RHP Document (PDF)</p>
          <p class="text-xs text-surface-500">View official prospectus →</p>
        </div>
      </a>
      <div class="mt-8">
        <AdUnit slot="4567890123" format="auto" />
      </div>
    </section>
  )}

  <!-- Subscription Status (for live/closed IPOs) -->
  {ipo.subscription && (ipo.status === 'live' || ipo.status === 'closed') ? (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">Subscription Status</h2>
      <div class="card">
        <div class="space-y-3">
          {ipo.subscriptionDetails ? (
            <>
              <div>
                <div class="flex justify-between mb-1"><span class="text-sm text-surface-600">Retail (RII)</span><span class="text-sm font-bold text-primary-600">{ipo.subscriptionDetails.retail?.toFixed(1) || '—'}x</span></div>
                <div class="w-full bg-surface-200 dark:bg-surface-700 rounded-full h-2.5"><div class="bg-primary-500 h-2.5 rounded-full" style={`width: ${Math.min((ipo.subscriptionDetails.retail || 0) * 10, 100)}%`}></div></div>
              </div>
              <div>
                <div class="flex justify-between mb-1"><span class="text-sm text-surface-600">NII (HNI)</span><span class="text-sm font-bold text-success-500">{ipo.subscriptionDetails.nii?.toFixed(1) || '—'}x</span></div>
                <div class="w-full bg-surface-200 dark:bg-surface-700 rounded-full h-2.5"><div class="bg-success-500 h-2.5 rounded-full" style={`width: ${Math.min((ipo.subscriptionDetails.nii || 0) * 10, 100)}%`}></div></div>
              </div>
              <div>
                <div class="flex justify-between mb-1"><span class="text-sm text-surface-600">QIB</span><span class="text-sm font-bold text-warning-500">{ipo.subscriptionDetails.qib?.toFixed(1) || '—'}x</span></div>
                <div class="w-full bg-surface-200 dark:bg-surface-700 rounded-full h-2.5"><div class="bg-warning-500 h-2.5 rounded-full" style={`width: ${Math.min((ipo.subscriptionDetails.qib || 0) * 5, 100)}%`}></div></div>
              </div>
            </>
          ) : null}
          <div class="pt-3 border-t border-surface-200 dark:border-surface-700 flex justify-between">
            <span class="font-semibold text-surface-900 dark:text-white">Total</span>
            <span class="text-lg font-bold text-primary-600">{ipo.subscription}x</span>
          </div>
        </div>
      </div>
    </section>
  ) : (ipo.status === 'live' || ipo.status === 'closed') ? (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">Subscription Status</h2>
      <div class="card">
        <p class="text-sm text-surface-500 text-center py-4">Subscription data not available</p>
      </div>
    </section>
  ) : null}

  <!-- AI Analysis -->
  {ipo.aiScore && (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">Investment Analysis</h2>
      <AIInsightBox
        title={`${ipo.name} — IPOFins Verdict`}
        summary={ipo.aiSummary || 'Analysis being generated.'}
        riskScore={ipo.riskScore}
        verdict={ipo.verdict as 'apply' | 'avoid' | 'neutral' | undefined}
        highlights={ipo.highlights || []}
      />
    </section>
  )}

  <!-- Listing Performance (for listed IPOs) -->
  {ipo.status === 'listed' && ipo.listingPrice && (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">Listing Performance</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        <div class="card-compact text-center">
          <p class="text-xs text-surface-500">Issue Price</p>
          <p class="text-base font-bold text-surface-900 dark:text-white mt-1">₹{ipo.priceMax || ipo.priceRange.split('-').pop()}</p>
        </div>
        <div class="card-compact text-center">
          <p class="text-xs text-surface-500">Listing Price</p>
          <p class={`text-base font-bold mt-1 ${ipo.listingPrice >= (ipo.priceMax || 0) ? 'text-success-500' : 'text-danger-500'}`}>
            ₹{ipo.listingPrice}
          </p>
        </div>
        <div class="card-compact text-center">
          <p class="text-xs text-surface-500">Listing Gain/Loss</p>
          {(() => {
            const issueP = ipo.priceMax || parseInt(ipo.priceRange.split('-').pop() || '0');
            const listP = ipo.listingPrice as number;
            const pct = issueP > 0 ? (((listP - issueP) / issueP) * 100).toFixed(2) : '0';
            return (
              <p class={`text-base font-bold mt-1 ${parseFloat(pct) >= 0 ? 'text-success-500' : 'text-danger-500'}`}>
                {parseFloat(pct) >= 0 ? '+' : ''}{pct}%
              </p>
            );
          })()}
        </div>
        <div class="card-compact text-center">
          <p class="text-xs text-surface-500">Listing Date</p>
          <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.listingDate || '—'}</p>
        </div>
      </div>
    </section>
  )}

  <!-- Financial Summary -->
  {ipo.financials && Object.keys(ipo.financials).length > 0 && (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">Financial Summary</h2>
      <div class="card overflow-x-auto">
        <table class="w-full text-sm min-w-[400px]">
          <thead>
            <tr class="border-b border-surface-200 dark:border-surface-700">
              <th class="py-2 px-3 text-left text-xs font-semibold text-surface-500 uppercase tracking-wider">Metric</th>
              {(() => {
                const firstKey = Object.keys(ipo.financials!)[0];
                const years: string[] = (ipo.financials![firstKey] || []).map((y) => y.year || y.label || '');
                return years.map((yr: string) => (
                  <th class="py-2 px-3 text-right text-xs font-semibold text-surface-500 uppercase tracking-wider">{yr}</th>
                ));
              })()}
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-100 dark:divide-surface-700">
            {Object.entries(ipo.financials).map(([metric, yearData]) => (
              <tr>
                <td class="py-2.5 px-3 text-surface-600 dark:text-surface-400 capitalize">{metric.replace(/_/g, ' ')}</td>
                {(yearData || []).map((y) => (
                  <td class="py-2.5 px-3 text-right font-semibold text-surface-900 dark:text-white">
                    {y.value !== null && y.value !== undefined ? `₹${Number(y.value).toLocaleString('en-IN')} Cr` : '—'}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  <!-- Key Performance Indicators -->
  {ipo.kpis && Object.keys(ipo.kpis).length > 0 && (
    <section class="container-wide py-4">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">Key Performance Indicators</h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
        {ipo.kpis.roe !== undefined && (
          <div class="card-compact text-center">
            <p class="text-xs text-surface-500">ROE</p>
            <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.kpis.roe}%</p>
          </div>
        )}
        {ipo.kpis.roce !== undefined && (
          <div class="card-compact text-center">
            <p class="text-xs text-surface-500">ROCE</p>
            <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.kpis.roce}%</p>
          </div>
        )}
        {ipo.kpis.ebitdaMargin !== undefined && (
          <div class="card-compact text-center">
            <p class="text-xs text-surface-500">EBITDA Margin</p>
            <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.kpis.ebitdaMargin}%</p>
          </div>
        )}
        {ipo.kpis.patMargin !== undefined && (
          <div class="card-compact text-center">
            <p class="text-xs text-surface-500">PAT Margin</p>
            <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.kpis.patMargin}%</p>
          </div>
        )}
        {ipo.kpis.eps !== undefined && (
          <div class="card-compact text-center">
            <p class="text-xs text-surface-500">EPS</p>
            <p class="text-base font-bold text-surface-900 dark:text-white mt-1">₹{ipo.kpis.eps}</p>
          </div>
        )}
        {ipo.kpis.nav !== undefined && (
          <div class="card-compact text-center">
            <p class="text-xs text-surface-500">NAV</p>
            <p class="text-base font-bold text-surface-900 dark:text-white mt-1">₹{ipo.kpis.nav}</p>
          </div>
        )}
        {ipo.kpis.debtEquity !== undefined && (
          <div class="card-compact text-center">
            <p class="text-xs text-surface-500">Debt/Equity</p>
            <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.kpis.debtEquity}x</p>
          </div>
        )}
        {ipo.kpis.ronw !== undefined && (
          <div class="card-compact text-center">
            <p class="text-xs text-surface-500">RONW</p>
            <p class="text-base font-bold text-surface-900 dark:text-white mt-1">{ipo.kpis.ronw}%</p>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Apply / Trade CTA -->  <section class="container-wide py-4">
    <div class="card bg-gradient-to-r from-primary-50 to-surface-50 dark:from-primary-950/20 dark:to-surface-800 border-primary-200 dark:border-primary-800">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        {ipo.status === 'listed' ? (
          <div>
            <h3 class="text-base font-bold text-surface-900 dark:text-white">Want to buy this stock?</h3>
            <p class="text-xs text-surface-500 mt-0.5">Trade {ipo.name} on the secondary market</p>
          </div>
        ) : (
          <div>
            <h3 class="text-base font-bold text-surface-900 dark:text-white">Want to apply for this IPO?</h3>
            <p class="text-xs text-surface-500 mt-0.5">Open a free Demat account and apply in minutes</p>
          </div>
        )}
        <div class="flex gap-3">
          {ipo.status === 'listed' ? (
            <>
              <a href={ZERODHA_OPEN_ACCOUNT_URL} target="_blank" rel="noopener noreferrer nofollow sponsored" class="btn-primary text-sm">Trade on Zerodha</a>
              <a href="https://groww.in" target="_blank" rel="noopener noreferrer" class="btn-secondary text-sm">Trade on Groww</a>
            </>
          ) : (
            <>
              <a href={ZERODHA_OPEN_ACCOUNT_URL} target="_blank" rel="noopener noreferrer nofollow sponsored" class="btn-primary text-sm">Apply via Zerodha</a>
              <a href="https://groww.in/ipo" target="_blank" rel="noopener noreferrer" class="btn-secondary text-sm">Apply via Groww</a>
            </>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-wide py-6">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">FAQ</h2>
    <div class="space-y-3 max-w-3xl">
      <details class="card-compact group" open>
        <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">What is the price band of {ipo.name} IPO?</summary>
        <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">The price band is ₹{ipo.priceRange} per share with a lot size of {ipo.lotSize} shares. Minimum investment: ₹{parseInt(ipo.priceRange.split('-').pop() || '0') * ipo.lotSize}.</p>
      </details>
      <details class="card-compact group">
        <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">What does {ipo.name} do?</summary>
        <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">{ipo.description || ipo.aiSummary}</p>
      </details>
      <details class="card-compact group">
        <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">Should I apply for {ipo.name} IPO?</summary>
        <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">{shouldApplyAnswer}</p>
      </details>
      {ipo.founders && (
        <details class="card-compact group">
          <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">Who founded {ipo.name}?</summary>
          <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">
            {ipo.name} was founded by {ipo.founders}{ipo.founded ? ` in ${ipo.founded}` : ''}{ipo.headquarters ? `. Headquartered in ${ipo.headquarters}` : ''}.
          </p>
        </details>
      )}
    </div>
  </section>
</IPOLayout>
