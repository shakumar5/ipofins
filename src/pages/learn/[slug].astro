---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import { BRAND_URL } from '../../lib/brand';
import { getLearnArticles } from '../../lib/learn-articles';

export function getStaticPaths() {
  return getLearnArticles().map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const isInsight = 'tier' in article && Boolean(article.tier);
const relatedArticles = getLearnArticles()
  .filter((a) => a.slug !== article.slug)
  .slice(0, 4);

const articleUrl = `${BRAND_URL}/learn/${article.slug}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.excerpt,
  "url": articleUrl,
  "mainEntityOfPage": articleUrl,
  "datePublished": article.date || "2026-01-01",
  "dateModified": article.date || "2026-06-01",
  "author": { "@type": "Organization", "name": "IPOFins" },
  "publisher": {
    "@type": "Organization",
    "name": "IPOFins",
    "logo": { "@type": "ImageObject", "url": `${BRAND_URL}/favicon.svg` },
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://ipofins.com/learn" },
      { "@type": "ListItem", "position": 3, "name": article.title, "item": `https://ipofins.com/learn/${article.slug}` }
    ]
  }
};
---

<BaseLayout title={`${article.title} - IPOFins`} description={article.excerpt} canonicalUrl={articleUrl} jsonLd={jsonLd}>
  <!-- Breadcrumb -->
  <nav class="container-narrow pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/learn" class="hover:text-primary-600 transition-colors">Learn</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium truncate max-w-[200px]">{article.title}</li>
    </ol>
  </nav>

  <article class="container-narrow pt-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <PageHeader
          eyebrow={isInsight ? 'Market Intelligence' : article.category}
          title={article.title}
          subtitle={article.excerpt}
          freshness={isInsight && article.month ? `Data: ${article.month}` : undefined}
          source={isInsight ? 'SEBI AMC disclosures' : undefined}
        >
          <div class="mt-3 flex flex-wrap items-center gap-2">
            <p class="text-xs text-surface-400 dark:text-surface-500">{article.readTime} read</p>
            {isInsight && article.tier && (
              <span class="insights-article-badge insights-article-badge--tier">Tier {article.tier}</span>
            )}
          </div>
          <AuthorByline date={'date' in article && article.date ? String(article.date) : 'June 2026'} />
        </PageHeader>
      </div>

      <!-- Content -->
      {isInsight ? (
        <div class="insights-article-shell">
          <div class="insights-article-panel">
            <div class="insights-article" set:html={article.content} />
          </div>
        </div>
      ) : (
        <div class="prose dark:prose-invert max-w-none text-surface-700 dark:text-surface-300 leading-relaxed space-y-4">
          <div set:html={article.content} />
        </div>
      )}

      <!-- Related Articles -->
      <div class="mt-12 pt-8 border-t border-surface-200 dark:border-surface-700">
        <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">More from Learn</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {relatedArticles.map(a => (
            <a href={`/learn/${a.slug}`} class="card-compact group block">
              <span class="text-xs text-primary-600 dark:text-primary-400">{a.category}</span>
              <h3 class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">{a.title}</h3>
            </a>
          ))}
        </div>
      </div>

      <!-- Bottom Navigation -->
      <div class="mt-8 pt-6 border-t border-surface-200 dark:border-surface-700">
        <div class="nav-btn-group">
          <a href="/learn" class="btn-secondary px-6 py-3">← Back to Learn</a>
          <a href="/tools" class="btn-secondary px-6 py-3">🔧 All Tools</a>
          <a href="/tools/sip-calculator" class="btn-secondary px-6 py-3">📈 SIP Calculator</a>
          <a href="/tools/cagr-calculator" class="btn-secondary px-6 py-3">📊 CAGR Calculator</a>
          <a href="/tools/emi-calculator" class="btn-secondary px-6 py-3">🏦 EMI Calculator</a>
          <a href="/blogs/ipo" class="btn-secondary px-6 py-3">📈 IPO FAQs</a>
          <a href="/blogs/mutual-funds" class="btn-secondary px-6 py-3">💰 MF FAQs</a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
