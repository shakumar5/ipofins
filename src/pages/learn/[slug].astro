---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorByline from '../../components/AuthorByline.astro';
import articlesData from '../../data/articles.json';

export function getStaticPaths() {
  return articlesData
    .filter(article => article.content && article.content.trim().length > 0)
    .map(article => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

const { article } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": article.title,
  "description": article.excerpt,
  "url": `https://ipofins.com/learn/${article.slug}`,
  "author": { "@type": "Organization", "name": "ipofins" },
  "publisher": { "@type": "Organization", "name": "ipofins" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://ipofins.com/learn" },
      { "@type": "ListItem", "position": 3, "name": article.title, "item": `https://ipofins.com/learn/${article.slug}` }
    ]
  }
};
---

<BaseLayout title={`${article.title} - ipofins`} description={article.excerpt} jsonLd={jsonLd}>
  <!-- Breadcrumb -->
  <nav class="container-narrow pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/learn" class="hover:text-primary-600 transition-colors">Learn</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium truncate max-w-[200px]">{article.title}</li>
    </ol>
  </nav>

  <article class="container-narrow pt-8 pb-16">
    <div class="max-w-3xl mx-auto">
      <!-- Header -->
      <div class="mb-8">
        <div class="flex items-center gap-3 mb-3">
          <span class="badge bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">{article.category}</span>
          <span class="text-xs text-surface-400 dark:text-surface-500">{article.readTime} read</span>
        </div>
        <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight leading-tight">
          {article.title}
        </h1>
        <p class="mt-3 text-lg text-surface-600 dark:text-surface-300">{article.excerpt}</p>
        <AuthorByline date={'date' in article && article.date ? String(article.date) : 'June 2026'} />
      </div>

      <!-- Content -->
      <div class="prose dark:prose-invert max-w-none text-surface-700 dark:text-surface-300 leading-relaxed space-y-4">
        <div set:html={article.content} />
      </div>

      <!-- Related Articles -->
      <div class="mt-12 pt-8 border-t border-surface-200 dark:border-surface-700">
        <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">More from Learn</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {articlesData.filter(a => a.slug !== article.slug && a.content && a.content.trim().length > 0).slice(0, 4).map(a => (
            <a href={`/learn/${a.slug}`} class="card-compact group block">
              <span class="text-xs text-primary-600 dark:text-primary-400">{a.category}</span>
              <h3 class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">{a.title}</h3>
            </a>
          ))}
        </div>
      </div>

      <!-- Bottom Navigation -->
      <div class="mt-8 pt-6 border-t border-surface-200 dark:border-surface-700">
        <div class="flex flex-wrap gap-3">
          <a href="/learn" class="btn-secondary">← Back to Learn</a>
          <a href="/tools" class="btn-secondary">🔧 All Tools</a>
          <a href="/tools/sip-calculator" class="btn-secondary">📈 SIP Calculator</a>
          <a href="/tools/cagr-calculator" class="btn-secondary">📊 CAGR Calculator</a>
          <a href="/tools/emi-calculator" class="btn-secondary">🏦 EMI Calculator</a>
          <a href="/blogs/ipo" class="btn-secondary">📈 IPO FAQs</a>
          <a href="/blogs/mutual-funds" class="btn-secondary">💰 MF FAQs</a>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
