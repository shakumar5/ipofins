---
import BaseLayout from '../../layouts/BaseLayout.astro';
import articlesData from '../../data/articles.json';

const articles = articlesData;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Learn Investing - Finance Education",
  "description": "Free guides and articles on IPO investing, mutual funds, trading, and personal finance in India.",
  "url": "https://ipofins.com/learn",
};
---

<BaseLayout
  title="Learn Investing - IPO, Mutual Funds & Trading Guides"
  description="Free educational guides on IPO investing, mutual funds, options trading, broker selection, and personal finance for Indian investors."
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Learn</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <section class="container-wide pt-8 pb-6">
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      Learn Investing
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300 max-w-2xl">
      Free guides and articles to help you understand IPOs, mutual funds, trading strategies, and personal finance.
    </p>
  </section>

  <!-- Articles Grid -->
  <section class="container-wide py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {articles.map(article => (
        <a href={`/learn/${article.slug}`} class="card group block">
          <div class="flex items-center gap-2 mb-3">
            <span class="badge bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
              {article.category}
            </span>
            <span class="text-xs text-surface-400 dark:text-surface-500">{article.readTime}</span>
          </div>
          <h3 class="text-base font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors mb-2">
            {article.title}
          </h3>
          <p class="text-sm text-surface-500 dark:text-surface-400 line-clamp-2">
            {article.excerpt}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Bottom Navigation -->
  <section class="container-wide py-8 border-t border-surface-200 dark:border-surface-700">
    <div class="flex flex-wrap gap-3">
      <a href="/" class="btn-secondary">🏠 Home</a>
      <a href="/tools" class="btn-secondary">🔧 All Tools</a>
      <a href="/tools/sip-calculator" class="btn-secondary">📈 SIP Calculator</a>
      <a href="/tools/cagr-calculator" class="btn-secondary">📊 CAGR Calculator</a>
      <a href="/tools/emi-calculator" class="btn-secondary">🏦 EMI Calculator</a>
      <a href="/blogs/ipo" class="btn-secondary">📈 IPO FAQs</a>
      <a href="/blogs/mutual-funds" class="btn-secondary">💰 MF FAQs</a>
    </div>
  </section>
</BaseLayout>
