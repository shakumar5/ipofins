---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BRAND_URL } from '../../lib/brand';
import articlesData from '../../data/articles.json';

const articles = articlesData.filter(article => article.content && article.content.trim().length > 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Learn Investing - Finance Education",
  "description": "Free guides and articles on IPO investing, mutual funds, trading, and personal finance in India.",
  "url": "https://ipofins.com/learn",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Learn", "item": "https://ipofins.com/learn" }
    ]
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How should a beginner start investing in India?", "acceptedAnswer": { "@type": "Answer", "text": "Start with these steps: (1) Open a demat + trading account with a broker like Zerodha or Groww. (2) Begin a SIP of ₹500–₹5,000 in a large-cap or flexi-cap mutual fund. (3) Learn the basics of equity, debt, and mutual funds. (4) Never invest money you might need in the next 2–3 years." } },
    { "@type": "Question", "name": "What is the difference between stocks and mutual funds?", "acceptedAnswer": { "@type": "Answer", "text": "Stocks are individual company shares — you pick one company and bear its full risk/reward. Mutual funds pool money from thousands of investors and invest in 30–100 stocks, managed by a professional. Mutual funds offer diversification and are better for beginners. Stocks offer higher potential returns but need research and monitoring." } },
    { "@type": "Question", "name": "How much money do I need to start investing?", "acceptedAnswer": { "@type": "Answer", "text": "You can start with as little as ₹100 for mutual fund SIP, ₹500 for most equity mutual funds, and any amount to buy stocks (even 1 share). There's no minimum barrier. The key is to start early and stay consistent — even ₹1,000/month for 20 years at 12% return grows to ₹10 lakh." } },
    { "@type": "Question", "name": "Are these guides suitable for complete beginners?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, all our learn articles are written for beginners with zero prior knowledge. We explain every concept from scratch with real Indian examples, practical tips, and step-by-step instructions. Each article also links to relevant calculators so you can practice with your own numbers." } }
  ]
};
---

<BaseLayout
  title="Learn Investing - IPO, Mutual Funds & Trading Guides | IPOFins"
  description="Free educational guides on IPO investing, mutual funds, options trading, broker selection, and personal finance for Indian investors."
  canonicalUrl={`${BRAND_URL}/learn`}
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <!-- Breadcrumb -->
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Learn</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <section class="container-wide pt-8 pb-6">
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      Learn Investing
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300 max-w-2xl">
      Free guides and articles to help you understand IPOs, mutual funds, trading strategies, and personal finance.
    </p>
  </section>

  <!-- Articles Grid -->
  <section class="container-wide py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {articles.map(article => (
        <a href={`/learn/${article.slug}`} class="card group block">
          <div class="flex items-center gap-2 mb-3">
            <span class="badge bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400">
              {article.category}
            </span>
            <span class="text-xs text-surface-400 dark:text-surface-500">{article.readTime}</span>
          </div>
          <h3 class="text-base font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors mb-2">
            {article.title}
          </h3>
          <p class="text-sm text-surface-500 dark:text-surface-400 line-clamp-2">
            {article.excerpt}
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="container-wide py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How should a beginner start investing in India?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Start with these steps: (1) Open a demat + trading account with a broker like Zerodha or Groww. (2) Begin a SIP of ₹500–₹5,000 in a large-cap or flexi-cap mutual fund. (3) Learn the basics of equity, debt, and mutual funds from our guides above. (4) Never invest money you might need in the next 2–3 years.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is the difference between stocks and mutual funds?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Stocks are individual company shares — you pick one company and bear its full risk/reward. Mutual funds pool money from thousands of investors and invest in 30–100 stocks, managed by a professional. Mutual funds offer diversification and are better for beginners. Stocks offer higher potential returns but need research and monitoring.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How much money do I need to start investing?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">You can start with as little as ₹100 for mutual fund SIP, ₹500 for most equity mutual funds, and any amount to buy stocks (even 1 share). There's no minimum barrier. The key is to start early and stay consistent — even ₹1,000/month for 20 years at 12% return grows to ₹10 lakh.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Are these guides suitable for complete beginners?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Yes, all our learn articles are written for beginners with zero prior knowledge. We explain every concept from scratch with real Indian examples, practical tips, and step-by-step instructions. Each article also links to relevant calculators so you can practice with your own numbers.</p>
      </details>
    </div>
  </section>

  <!-- Bottom Navigation -->
  <section class="container-wide py-8 border-t border-surface-200 dark:border-surface-700">
    <div class="nav-btn-group">
      <a href="/" class="btn-secondary px-6 py-3">🏠 Home</a>
      <a href="/tools" class="btn-secondary px-6 py-3">🔧 All Tools</a>
      <a href="/tools/sip-calculator" class="btn-secondary px-6 py-3">📈 SIP Calculator</a>
      <a href="/tools/cagr-calculator" class="btn-secondary px-6 py-3">📊 CAGR Calculator</a>
      <a href="/tools/emi-calculator" class="btn-secondary px-6 py-3">🏦 EMI Calculator</a>
      <a href="/blogs/ipo" class="btn-secondary px-6 py-3">📈 IPO FAQs</a>
      <a href="/blogs/mutual-funds" class="btn-secondary px-6 py-3">💰 MF FAQs</a>
    </div>
  </section>
</BaseLayout>
