---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About IPOFins',
  description:
    'IPOFins is a financial intelligence platform focused on IPO analytics, mutual fund portfolio tracking, investment tools, and market insights for Indian investors.',
  url: 'https://ipofins.com/about',
};
---

<BaseLayout
  title="About IPOFins — Financial Intelligence for Indian Investors"
  description="IPOFins is a financial intelligence platform for IPO analytics, mutual fund portfolio tracking, investment tools, and market insights. Learn about our mission and founder."
  jsonLd={jsonLd}
>
  <section class="container-narrow py-16">
    <div class="max-w-3xl mx-auto">
      <p class="text-sm font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">
        About IPOFins
      </p>
      <h1 class="mt-2 text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
        Helping Investors Make Smarter Decisions with Data
      </h1>

      <div class="mt-8 space-y-6 text-surface-600 dark:text-surface-300 leading-relaxed">
        <p class="text-lg text-surface-700 dark:text-surface-200">
          IPOFins is a financial intelligence platform focused on IPO analytics, mutual fund portfolio tracking, investment tools, and market insights. Founded by Shailesh Kumar, a technology leader with 16 years of experience across DP World, Myntra, Intuit, Paytm, and SAP Ariba, IPOFins aims to help investors make smarter decisions through data-driven research and transparent analytics.
        </p>
        <p>
          Whether you're tracking IPOs, analyzing mutual fund portfolio changes, comparing brokers, or using investment calculators, IPOFins provides reliable information in a simple and user-friendly format—grounded in publicly available market data and quantitative analysis.
        </p>

        <h2 class="text-xl font-bold text-surface-900 dark:text-white pt-4">Our Mission</h2>
        <p>
          To build a trusted financial intelligence platform that empowers retail investors with
          easy access to investment research, market analytics, and educational resources.
        </p>

        <h2 class="text-xl font-bold text-surface-900 dark:text-white pt-6">What We Offer</h2>

        <h3 class="text-lg font-semibold text-surface-900 dark:text-white pt-2">IPO Intelligence</h3>
        <ul class="list-disc list-inside space-y-1.5 ml-1">
          <li><a href="/ipo/upcoming" class="text-primary-600 dark:text-primary-400 hover:underline">Upcoming IPO Calendar</a></li>
          <li><a href="/ipo" class="text-primary-600 dark:text-primary-400 hover:underline">Live IPO Tracking</a></li>
          <li><a href="/ipo/subscription-status" class="text-primary-600 dark:text-primary-400 hover:underline">Subscription Data</a></li>
          <li><a href="/ipo/performance/2026" class="text-primary-600 dark:text-primary-400 hover:underline">IPO Listing Performance</a></li>
          <li><a href="/ipo/allotment-status" class="text-primary-600 dark:text-primary-400 hover:underline">Allotment Information</a></li>
          <li>IPO Analytics and Insights</li>
        </ul>

        <h3 class="text-lg font-semibold text-surface-900 dark:text-white pt-4">Mutual Fund Intelligence</h3>
        <ul class="list-disc list-inside space-y-1.5 ml-1">
          <li>Monthly Portfolio Changes</li>
          <li><a href="/mutual-funds/smart-money" class="text-primary-600 dark:text-primary-400 hover:underline">Smart Money Tracker</a></li>
          <li>Most Bought Stocks</li>
          <li>Most Sold Stocks</li>
          <li>Fresh Entries</li>
          <li>Complete Exits</li>
          <li>AMC-wise Portfolio Analysis</li>
        </ul>

        <h3 class="text-lg font-semibold text-surface-900 dark:text-white pt-4">Investment Tools</h3>
        <ul class="list-disc list-inside space-y-1.5 ml-1">
          <li><a href="/tools/sip-calculator" class="text-primary-600 dark:text-primary-400 hover:underline">SIP Calculator</a></li>
          <li><a href="/tools/lumpsum-calculator" class="text-primary-600 dark:text-primary-400 hover:underline">Lumpsum Calculator</a></li>
          <li><a href="/tools/swp-calculator" class="text-primary-600 dark:text-primary-400 hover:underline">SWP Calculator</a></li>
          <li><a href="/tools/step-up-sip-calculator" class="text-primary-600 dark:text-primary-400 hover:underline">Step-up SIP Calculator</a></li>
          <li><a href="/tools/goal-planner" class="text-primary-600 dark:text-primary-400 hover:underline">Goal Planning Tools</a></li>
        </ul>

        <h3 class="text-lg font-semibold text-surface-900 dark:text-white pt-4">Learning Resources</h3>
        <ul class="list-disc list-inside space-y-1.5 ml-1">
          <li><a href="/learn" class="text-primary-600 dark:text-primary-400 hover:underline">IPO Education</a></li>
          <li><a href="/blogs/mutual-funds" class="text-primary-600 dark:text-primary-400 hover:underline">Mutual Fund Guides</a></li>
          <li>Investment Concepts</li>
          <li><a href="/blogs" class="text-primary-600 dark:text-primary-400 hover:underline">Financial Planning Articles</a></li>
        </ul>

        <h2 class="text-xl font-bold text-surface-900 dark:text-white pt-6">About the Founder</h2>
        <p>
          <strong class="text-surface-900 dark:text-white">Shailesh Kumar</strong> is a technology
          leader with 16 years of experience in software quality engineering, automation, and
          large-scale technology platforms.{' '}
          <a
            href="https://www.linkedin.com/in/shailesh-kumar-222a1018/"
            target="_blank"
            rel="noopener noreferrer"
            class="text-primary-600 dark:text-primary-400 hover:underline"
          >
            LinkedIn
          </a>
        </p>
        <p>Throughout his career, he has worked with globally recognized organizations including:</p>
        <ul class="list-disc list-inside space-y-1 ml-1">
          <li>DP World</li>
          <li>Myntra</li>
          <li>Intuit</li>
          <li>Paytm</li>
          <li>SAP Ariba</li>
        </ul>
        <p>
          His experience spans technology leadership, data platforms, automation, analytics, and
          building scalable software systems. That background in large-scale data platforms is what
          powers IPOFins&apos; holdings pipeline and analytics.
        </p>
        <p>
          As an active market participant and long-term investor, Shailesh founded IPOFins to bridge
          the gap between complex financial data and practical investor insights.
        </p>
        <p>
          The vision behind IPOFins is to create a platform where investors can access high-quality
          financial information, powerful analytics, and clear, actionable market insights without
          unnecessary complexity.
        </p>

        <h2 class="text-xl font-bold text-surface-900 dark:text-white pt-6">Our Principles</h2>
        <div class="space-y-4">
          <div>
            <h3 class="font-semibold text-surface-900 dark:text-white">Transparency</h3>
            <p class="mt-1 text-sm">
              We clearly disclose our data sources, methodology, and monetization model.{' '}
              <a href="/methodology" class="text-primary-600 dark:text-primary-400 hover:underline">Read our data methodology →</a>
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 dark:text-white">Data-Driven Approach</h3>
            <p class="mt-1 text-sm">
              Our insights are based on publicly available market data and quantitative analysis.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 dark:text-white">Investor First</h3>
            <p class="mt-1 text-sm">
              Every feature is designed to help investors make informed decisions.
            </p>
          </div>
          <div>
            <h3 class="font-semibold text-surface-900 dark:text-white">Continuous Improvement</h3>
            <p class="mt-1 text-sm">
              We are constantly improving our platform, data coverage, and analytical capabilities.
            </p>
          </div>
        </div>

        <h2 class="text-xl font-bold text-surface-900 dark:text-white pt-6">Important Disclaimer</h2>
        <p class="text-sm text-surface-500 dark:text-surface-400">
          IPOFins is an educational and informational platform.
        </p>
        <p class="text-sm text-surface-500 dark:text-surface-400">
          We are not registered with SEBI as an Investment Advisor, Research Analyst, or Portfolio
          Manager. The information provided on this website should not be considered investment
          advice, stock recommendations, or financial planning advice.
        </p>
        <p class="text-sm text-surface-500 dark:text-surface-400">
          Investors should conduct their own research and consult qualified financial professionals
          before making investment decisions.
        </p>

        <h2 class="text-xl font-bold text-surface-900 dark:text-white pt-6">Connect With Us</h2>
        <p>
          We welcome feedback, suggestions, partnership opportunities, and data corrections.
        </p>
        <ul class="space-y-2 mt-3">
          <li>
            <span class="font-medium text-surface-900 dark:text-white">Email:</span>{' '}
            <a href="mailto:info@ipofins.com" class="text-primary-600 dark:text-primary-400 hover:underline">info@ipofins.com</a>
            {' '}&amp;{' '}
            <a href="mailto:kausshailesh@gmail.com" class="text-primary-600 dark:text-primary-400 hover:underline">kausshailesh@gmail.com</a>
          </li>
          <li>
            <span class="font-medium text-surface-900 dark:text-white">Website:</span>{' '}
            <a href="https://ipofins.com" class="text-primary-600 dark:text-primary-400 hover:underline">ipofins.com</a>
          </li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
