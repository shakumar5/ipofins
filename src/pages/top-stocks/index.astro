---
import {
  DEFAULT_TOP_STOCKS_FILTERS,
  parseTopStocksFiltersFromSearch,
  topStocksPath,
} from '../../lib/top-stocks-meta';

if (Astro.url.search) {
  const filters = parseTopStocksFiltersFromSearch(Astro.url.search);
  return Astro.redirect(topStocksPath(filters), 301);
}

return Astro.redirect(topStocksPath(DEFAULT_TOP_STOCKS_FILTERS), 301);
---
