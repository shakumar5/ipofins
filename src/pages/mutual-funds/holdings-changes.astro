---
import BaseLayout from '../../layouts/BaseLayout.astro';
import fundsData from '../../data/mutual-funds.json';

const fundNames = fundsData.map(f => ({ name: f.name, slug: f.slug }));
const months = ['Jun 2026', 'May 2026', 'Apr 2026', 'Mar 2026', 'Feb 2026', 'Jan 2026'];
---

<BaseLayout title="Mutual Fund Holdings Changes - Monthly Additions & Removals | IPOfins" description="Track what stocks mutual funds are buying and selling. Monthly holdings changes for all major funds.">
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Holdings Changes</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <h1 class="text-2xl font-bold text-surface-900 dark:text-white">Mutual Fund Holdings Changes</h1>
    <p class="mt-1 text-sm text-surface-500">Track monthly additions and removals in fund portfolios. See what stocks top funds are buying/selling.</p>

    <!-- Main Tabs -->
    <div class="mt-4 flex gap-2">
      <a href="/mutual-funds/best" class="px-4 py-2 text-sm font-medium text-surface-600 bg-surface-100 dark:bg-surface-800 rounded-lg hover:bg-surface-200 transition-colors">Best Funds</a>
      <a href="/mutual-funds/all" class="px-4 py-2 text-sm font-medium text-surface-600 bg-surface-100 dark:bg-surface-800 rounded-lg hover:bg-surface-200 transition-colors">All Funds</a>
      <span class="px-4 py-2 text-sm font-medium bg-primary-600 text-white rounded-lg">Holdings Changes</span>
    </div>
  </section>

  <!-- Fund & Month Selector -->
  <section class="container-wide py-4">
    <div class="card">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Select Fund & Month</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Fund Name -->
        <div>
          <label class="text-sm font-medium text-surface-700 dark:text-surface-300 block mb-2">Fund Name</label>
          <select class="w-full px-3 py-2.5 text-sm border border-surface-200 dark:border-surface-700 rounded-lg bg-white dark:bg-surface-800 text-surface-900 dark:text-white">
            <option value="">Select a fund...</option>
            {fundNames.map(f => (
              <option value={f.slug}>{f.name}</option>
            ))}
          </select>
        </div>
        <!-- Month -->
        <div>
          <label class="text-sm font-medium text-surface-700 dark:text-surface-300 block mb-2">Month</label>
          <select class="w-full px-3 py-2.5 text-sm border border-surface-200 dark:border-surface-700 rounded-lg bg-white dark:bg-surface-800 text-surface-900 dark:text-white">
            {months.map(m => (
              <option value={m}>{m}</option>
            ))}
          </select>
        </div>
      </div>
    </div>
  </section>

  <!-- Results Section (placeholder for deployment) -->
  <section class="container-wide py-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <!-- Additions -->
      <div class="card">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-3 h-3 bg-success-500 rounded-full"></div>
          <h3 class="text-base font-bold text-surface-900 dark:text-white">New Additions</h3>
        </div>
        <p class="text-xs text-surface-500 mb-3">Stocks newly added to the fund portfolio this month</p>

        <!-- Table header -->
        <div class="grid grid-cols-3 gap-2 px-2 py-1.5 text-xs font-medium text-surface-500 uppercase border-b border-surface-200 dark:border-surface-700 mb-2">
          <div>Stock</div>
          <div class="text-center">Sector</div>
          <div class="text-right">Weight (%)</div>
        </div>

        <!-- Placeholder -->
        <div class="text-center py-8">
          <div class="w-10 h-10 mx-auto bg-success-50 dark:bg-success-500/10 rounded-full flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-success-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/></svg>
          </div>
          <p class="text-sm text-surface-500">Holdings data available after deployment</p>
          <p class="text-xs text-surface-400 mt-1">Sourced from AMC monthly factsheets</p>
        </div>
      </div>

      <!-- Removals -->
      <div class="card">
        <div class="flex items-center gap-2 mb-4">
          <div class="w-3 h-3 bg-danger-500 rounded-full"></div>
          <h3 class="text-base font-bold text-surface-900 dark:text-white">Removed / Reduced</h3>
        </div>
        <p class="text-xs text-surface-500 mb-3">Stocks removed or weight reduced from the portfolio</p>

        <!-- Table header -->
        <div class="grid grid-cols-3 gap-2 px-2 py-1.5 text-xs font-medium text-surface-500 uppercase border-b border-surface-200 dark:border-surface-700 mb-2">
          <div>Stock</div>
          <div class="text-center">Sector</div>
          <div class="text-right">Change</div>
        </div>

        <!-- Placeholder -->
        <div class="text-center py-8">
          <div class="w-10 h-10 mx-auto bg-danger-50 dark:bg-danger-500/10 rounded-full flex items-center justify-center mb-3">
            <svg class="w-5 h-5 text-danger-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
          </div>
          <p class="text-sm text-surface-500">Holdings data available after deployment</p>
          <p class="text-xs text-surface-400 mt-1">Sourced from AMC monthly factsheets</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Info -->
  <section class="container-wide py-6">
    <div class="max-w-3xl text-sm text-surface-600 dark:text-surface-300 space-y-3">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white">About Holdings Changes</h2>
      <p>Mutual funds are required to disclose their complete portfolio holdings monthly. By comparing consecutive months, we identify which stocks were added, removed, or had their weight changed.</p>
      <p>This helps investors understand: What are the best fund managers buying? Which sectors are they bullish on? What stocks are they exiting?</p>
      <p class="text-xs text-surface-400">Data source: AMC monthly factsheet disclosures, typically published with a 15-day lag.</p>
    </div>
  </section>
</BaseLayout>
