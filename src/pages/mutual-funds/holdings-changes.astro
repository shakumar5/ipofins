---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HoldingsCompare from '../../components/funds/HoldingsCompare.tsx';
import holdingsData from '../../data/fund-holdings.json';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Mutual Fund Holdings Changes - Monthly Additions & Removals",
  "description": "Track what stocks mutual funds are buying and selling. Compare portfolio holdings between months to identify additions and removals.",
  "url": "https://ipofins.com/mutual-funds/holdings-changes"
};
---

<BaseLayout
  title="Mutual Fund Holdings Changes 2026 - Track Additions & Removals | IPOfins"
  description="Compare mutual fund portfolio holdings month-on-month. See which stocks top funds are buying and selling. Data from AMC monthly disclosures."
  jsonLd={jsonLd}
>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Holdings Changes</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <h1 class="text-2xl font-bold text-surface-900 dark:text-white">Mutual Fund Holdings Changes</h1>
    <p class="mt-1 text-sm text-surface-500">Compare portfolio holdings between months. See what stocks top fund managers are buying and selling.</p>

    <!-- Main Tabs -->
    <div class="mt-4 flex gap-2">
      <a href="/mutual-funds/best" class="px-4 py-2 text-sm font-medium text-surface-600 bg-surface-100 dark:bg-surface-800 rounded-lg hover:bg-surface-200 transition-colors">Best Funds</a>
      <a href="/mutual-funds/all" class="px-4 py-2 text-sm font-medium text-surface-600 bg-surface-100 dark:bg-surface-800 rounded-lg hover:bg-surface-200 transition-colors">All Funds</a>
      <span class="px-4 py-2 text-sm font-medium bg-primary-600 text-white rounded-lg">Holdings Changes</span>
    </div>
  </section>

  <section class="container-wide py-4">
    <HoldingsCompare client:load data={holdingsData} />
  </section>

  <!-- Info -->
  <section class="container-wide py-8">
    <div class="max-w-3xl text-sm text-surface-600 dark:text-surface-300 space-y-3">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white">About Holdings Changes</h2>
      <p>Mutual funds are required to disclose their complete portfolio holdings monthly. By comparing consecutive months, we identify which stocks were newly added, removed, or had their weight changed significantly.</p>
      <p>This helps investors understand: What are the best fund managers buying? Which sectors are they bullish on? What stocks are they exiting?</p>
      <p class="text-xs text-surface-400 mt-4">📋 Data source: AMC monthly portfolio disclosure filings. Updated every 15 days.<br/>📊 Available months: {holdingsData.months.join(', ')}<br/>🏦 AMCs covered: {Object.keys(holdingsData.amcs).length}<br/>📈 Funds tracked: {Object.keys(holdingsData.holdings).length}</p>
    </div>
  </section>
</BaseLayout>
