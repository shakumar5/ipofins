---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MfSectionTabs from '../../../components/funds/MfSectionTabs.astro';
import { getFundsWithHoldings, getRelatedFunds, getFundHoldingsLinkMeta, fundHoldingsHref, resolveFundDetailSlug } from '../../../lib/data/funds';
import { getFundHoldings, getFundOverlaps, getFundPortfolioStockCount } from '../../../lib/data/holdings';
import { ZERODHA_OPEN_ACCOUNT_URL } from '../../../lib/affiliate-links';

export async function getStaticPaths() {
  const fundsData = await getFundsWithHoldings();
  return fundsData.map(fund => ({
    params: { slug: `${fund.slug}-holdings` },
    props: { fund },
  }));
}

const { fund } = Astro.props;
const holdingsMeta = await getFundHoldingsLinkMeta();
const relatedFunds = await getRelatedFunds(fund.category, fund.slug, 5);
const relatedFundHref = (f: { slug: string; schemeCode: string }) =>
  fundHoldingsHref(resolveFundDetailSlug(f, holdingsMeta));

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FinancialProduct",
  "name": fund.name,
  "description": `${fund.name} - ${fund.category} mutual fund with ${fund.returns3y}% 3-year returns.`,
  "url": `https://ipofins.com/mutual-funds/fund/${fund.slug}-holdings`,
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Is ${fund.name} good for SIP?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${fund.name} is a ${fund.category} fund with ${fund.riskLevel} risk. For SIP investors, consistency of returns matters more than absolute returns. Check the fund's rolling returns and standard deviation before starting a SIP. ${fund.category} funds are generally suitable for SIP with a 5+ year horizon.`
      }
    },
    {
      "@type": "Question",
      "name": `What is the risk level of ${fund.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${fund.name} is categorized as ${fund.riskLevel} risk. This is determined by SEBI's riskometer methodology based on factors like market cap allocation, sector concentration, and portfolio volatility. ${fund.riskLevel === 'high' || fund.riskLevel === 'very-high' ? 'Higher risk funds may deliver better long-term returns but with more short-term volatility.' : 'Lower risk funds offer relatively stable returns with less portfolio fluctuation.'}`
      }
    },
    {
      "@type": "Question",
      "name": `How to invest in ${fund.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `You can invest in ${fund.name} (Direct-Growth plan) through platforms like Groww, Zerodha Coin, Kuvera, or directly from the AMC website. Minimum SIP starts at ₹500/month on most platforms. You'll need KYC completion (PAN + Aadhaar) to start investing.`
      }
    },
    {
      "@type": "Question",
      "name": "What are the tax implications of this mutual fund?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For equity mutual funds in India: Short-term capital gains (held < 1 year) are taxed at 20%. Long-term capital gains (held > 1 year) above ₹1.25 lakh are taxed at 12.5%. ELSS funds have a mandatory 3-year lock-in period. Dividend income is taxed at your income tax slab rate."
      }
    }
  ]
};

// Get holdings for this fund (latest month)
const fundHoldingsRows = (await getFundHoldings(fund.slug)) as Array<Record<string, unknown>>;
const portfolioStockCount = await getFundPortfolioStockCount(fund.slug);
const fundOverlaps = (await getFundOverlaps(fund.slug, 5)) as Array<Record<string, unknown>>;
const latestMonth = fundHoldingsRows[0]?.month
  ? new Date(String(fundHoldingsRows[0].month)).toLocaleDateString('en-IN', { month: 'long', year: 'numeric' })
  : '';

const holdings = fundHoldingsRows.filter((h: Record<string, unknown>) => {
  const name = String(h.name || '');
  const sector = String(h.sector || '');
  if (sector && /^(CRISIL|ICRA|FITCH|CARE|IND|BWR)\s/i.test(sector)) return false;
  if (/^\d+\.?\d*%\s/.test(name)) return false;
  return true;
});
---

<BaseLayout
  title={`${fund.name} - NAV, Returns & Holdings`}
  description={`${fund.name}: NAV ${fund.nav != null ? `₹${fund.nav}` : 'N/A'}, 1Y +${fund.returns1y ?? '—'}%, 3Y +${fund.returns3y ?? '—'}%, 5Y +${fund.returns5y ?? '—'}%. ${fund.category} fund, ${fund.riskLevel} risk.`}
  ogImage="/og-fund.png"
  jsonLd={jsonLd}
>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium truncate max-w-[200px]">{fund.name}</li>
    </ol>
  </nav>

  <!-- Header -->
  <section class="container-wide pt-6 pb-4">
    <MfSectionTabs active="all" />

    <div class="mt-3 flex flex-col md:flex-row md:items-start md:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-extrabold text-surface-900 dark:text-white">{fund.name}</h1>
        <div class="flex items-center gap-3 mt-2">
          <span class="badge bg-primary-50 text-primary-600">{fund.category}</span>
          <span class={`badge capitalize ${fund.riskLevel === 'low' ? 'bg-success-50 text-success-600' : fund.riskLevel === 'moderate' ? 'bg-warning-50 text-warning-600' : 'bg-danger-50 text-danger-600'}`}>{fund.riskLevel.replace('-', ' ')} Risk</span>
          <div class="flex">
            {Array.from({ length: fund.rating || 0 }).map(() => (
              <svg class="w-4 h-4 text-warning-500" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
            ))}
          </div>
        </div>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">Current NAV</p>
        <p class="text-2xl font-extrabold text-primary-600">{fund.nav != null ? `₹${fund.nav.toFixed(2)}` : '—'}</p>
      </div>
    </div>
  </section>

  <!-- Key Metrics -->
  <section class="container-wide py-4">
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">1Y Return</p>
        <p class={`text-lg font-bold mt-1 ${(fund.returns1y || 0) >= 0 ? 'text-success-500' : 'text-danger-500'}`}>{fund.returns1y !== null ? ((fund.returns1y >= 0 ? '+' : '') + fund.returns1y + '%') : '--'}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">3Y Return</p>
        <p class={`text-lg font-bold mt-1 ${(fund.returns3y || 0) >= 0 ? 'text-success-500' : 'text-danger-500'}`}>{fund.returns3y !== null ? ((fund.returns3y >= 0 ? '+' : '') + fund.returns3y + '%') : '--'}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">5Y Return</p>
        <p class={`text-lg font-bold mt-1 ${(fund.returns5y || 0) >= 0 ? 'text-success-500' : 'text-danger-500'}`}>{fund.returns5y !== null ? ((fund.returns5y >= 0 ? '+' : '') + fund.returns5y + '%') : '--'}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">AUM</p>
        <p class="text-lg font-bold text-surface-900 dark:text-white mt-1">{fund.aum || '--'}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">Expense Ratio (Direct)</p>
        <p class="text-lg font-bold text-surface-900 dark:text-white mt-1">{fund.expenseRatio != null ? `${fund.expenseRatio}%` : '--'}</p>
        {fund.expenseRatioRegular != null && (
          <p class="text-[10px] text-surface-400 mt-0.5">Regular: {fund.expenseRatioRegular}%</p>
        )}
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500">Category</p>
        <p class="text-lg font-bold text-surface-900 dark:text-white mt-1">{fund.category}</p>
      </div>
    </div>
    {fund.expenseRatio != null && (
      <p class="text-[10px] text-surface-400 mt-2 text-center">TER sourced from AMFI India (updated quarterly)</p>
    )}
  </section>

  <!-- Holdings Section -->
  <section class="container-wide py-4">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3 section-accent">Top Holdings</h2>
    {holdings.length > 0 ? (
      <div>
        <p class="text-xs text-surface-500 mb-4">
          Top {holdings.length}{portfolioStockCount && portfolioStockCount > holdings.length ? ` of ${portfolioStockCount}` : ''} stocks held by this fund as of {latestMonth} (Source: AMC monthly disclosure)
        </p>
        <div class="card overflow-hidden">
          <div class="hidden md:grid grid-cols-12 gap-4 px-4 py-2 text-xs font-medium text-surface-500 uppercase border-b border-surface-200 dark:border-surface-700">
            <div class="col-span-1">#</div>
            <div class="col-span-5">Stock</div>
            <div class="col-span-3">Sector</div>
            <div class="col-span-3 text-right">Weight (%)</div>
          </div>
          {holdings.map((h: any, i: number) => (
            <div class={`grid grid-cols-12 gap-4 px-4 py-2.5 text-sm items-center ${i % 2 === 0 ? '' : 'bg-surface-50 dark:bg-surface-800/50'}`}>
              <div class="col-span-1 text-xs text-surface-400">{i + 1}</div>
              <div class="col-span-5">
                <p class="font-medium text-surface-900 dark:text-white text-sm">{h.name}</p>
                <p class="text-[10px] text-surface-400 md:hidden">{h.sector}</p>
              </div>
              <div class="col-span-3 text-xs text-surface-500 hidden md:block">{h.sector}</div>
              <div class="col-span-3 text-right">
                <span class="text-sm font-semibold text-primary-600">{h.pct}%</span>
              </div>
            </div>
          ))}
        </div>
        <p class="text-xs text-surface-400 mt-3">📋 All returns shown are for Direct-Growth plan. Data from AMC monthly portfolio disclosure.</p>
      </div>
    ) : (
      <div class="card">
        <div class="text-center py-8">
          <div class="w-12 h-12 mx-auto bg-surface-100 dark:bg-surface-800 rounded-full flex items-center justify-center mb-3">
            <svg class="w-6 h-6 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          </div>
          <p class="text-sm text-surface-500">Holdings data will be added soon for this fund.</p>
          <p class="text-xs text-surface-400 mt-1">Updated monthly from AMC disclosures.</p>
        </div>
      </div>
    )}
  </section>

  <!-- SIP Calculation -->
  <section class="container-wide py-4">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3 section-accent">SIP in {fund.name}</h2>
    <div class="card">
      <p class="text-sm text-surface-600 dark:text-surface-300 mb-4">If you had invested ₹10,000/month via SIP:</p>
      <div class="grid grid-cols-3 gap-4 text-center">
        <div>
          <p class="text-xs text-surface-500">1 Year SIP</p>
          <p class="text-sm font-bold text-surface-900 dark:text-white">₹{(120000 * (1 + (fund.returns1y || 12) / 200)).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}</p>
          <p class="text-xs text-surface-400">Invested: ₹1,20,000</p>
        </div>
        <div>
          <p class="text-xs text-surface-500">3 Year SIP</p>
          <p class="text-sm font-bold text-surface-900 dark:text-white">₹{(360000 * (1 + (fund.returns3y || 12) / 100)).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}</p>
          <p class="text-xs text-surface-400">Invested: ₹3,60,000</p>
        </div>
        <div>
          <p class="text-xs text-surface-500">5 Year SIP</p>
          <p class="text-sm font-bold text-surface-900 dark:text-white">₹{(600000 * (1 + (fund.returns5y || 12) * 2 / 100)).toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ',')}</p>
          <p class="text-xs text-surface-400">Invested: ₹6,00,000</p>
        </div>
      </div>
      <a href="/tools/sip-calculator" class="mt-4 inline-flex text-sm text-primary-600 hover:underline">Calculate exact SIP returns →</a>
    </div>
  </section>

  <!-- Invest CTA -->
  <section class="container-wide py-4">
    <div class="card bg-gradient-to-r from-primary-50 to-surface-50 dark:from-primary-950/20 dark:to-surface-800 border-primary-200 dark:border-primary-800">
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <h3 class="text-base font-bold text-surface-900 dark:text-white">Invest in {fund.name}</h3>
          <p class="text-xs text-surface-500 mt-0.5">Start SIP from ₹500/month on these platforms</p>
        </div>
        <div class="flex gap-3">
          <a href="https://groww.in/mutual-funds" target="_blank" rel="noopener noreferrer" class="btn-primary text-sm">Invest via Groww</a>
          <a href={ZERODHA_OPEN_ACCOUNT_URL} target="_blank" rel="noopener noreferrer nofollow sponsored" class="btn-secondary text-sm">Invest via Zerodha</a>
        </div>
      </div>
    </div>
  </section>

  {fundOverlaps.length > 0 && (
    <section class="container-wide py-6">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4 section-accent">Portfolio Overlap</h2>
      <p class="text-sm text-surface-500 mb-4">Funds that share the most stock holdings with {fund.name}.</p>
      <div class="space-y-2">
        {fundOverlaps.map((row) => (
          <a href={`/mutual-funds/fund-overlap/${row.slug}`} class="card-compact flex items-center justify-between hover:shadow-md transition-shadow">
            <span class="text-sm font-medium text-surface-900 dark:text-white">{row.name}</span>
            <span class="text-sm font-bold text-primary-600">{row.overlap_pct != null ? `${Number(row.overlap_pct).toFixed(1)}% overlap` : '—'}</span>
          </a>
        ))}
      </div>
      <a href={`/mutual-funds/fund-overlap/${fund.slug}`} class="inline-block mt-3 text-sm text-primary-600 hover:underline">View full overlap analysis →</a>
    </section>
  )}

  <!-- More Funds from Same Category -->
  <section class="container-wide py-6">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4 section-accent">More {fund.category} Funds</h2>
    <div class="space-y-2">
      {relatedFunds.map(f => (
        <a href={relatedFundHref(f)} class="card-compact group block hover:shadow-md transition-shadow">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors">{f.name}</h3>
              <p class="text-xs text-surface-500">{f.aum}</p>
            </div>
            <div class="text-right">
              <p class={`text-sm font-bold ${(f.returns3y || 0) >= 0 ? 'text-success-500' : 'text-danger-500'}`}>{f.returns3y !== null ? ((f.returns3y >= 0 ? '+' : '') + f.returns3y + '%') : '--'}</p>
              <p class="text-[10px] text-surface-400">3Y</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- About Category Section -->
  <section class="container-narrow py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">About {fund.category} Funds</h2>
    <div class="prose prose-sm dark:prose-invert max-w-none text-surface-600 dark:text-surface-300">
      <p>{fund.category} mutual funds are a category defined by SEBI (Securities and Exchange Board of India) under their mutual fund categorization framework. These funds invest primarily in equities that match the {fund.category.toLowerCase()} profile, with specific allocation mandates that fund managers must follow. The category determines the fund's risk-return characteristics and its suitability for different investor profiles.</p>
      <p>When evaluating a {fund.category} fund like {fund.name}, key metrics to consider include: 3-year and 5-year CAGR (rolling returns are more reliable than point-to-point), expense ratio (Direct plans have lower costs), portfolio turnover, standard deviation (volatility measure), Sharpe ratio (risk-adjusted returns), and alpha generation over benchmark. A fund that consistently beats its benchmark index over multiple market cycles is a strong candidate.</p>
      <p>For long-term wealth creation, {fund.category} funds work best with a systematic investment plan (SIP) over 5+ years. SIP helps average out market volatility through rupee cost averaging. Lump sum investments are better timed during market corrections. Always ensure your mutual fund portfolio is diversified across 3-4 categories rather than concentrating in a single fund type. Consult a SEBI-registered investment advisor for personalized advice based on your financial goals and risk appetite.</p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="container-wide py-12">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Is {fund.name} good for SIP?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">{fund.name} is a {fund.category} fund with {fund.riskLevel} risk. For SIP investors, consistency of returns matters more than absolute returns. Check the fund's rolling returns and standard deviation before committing to a SIP. {fund.category} funds are generally suitable for SIP with a minimum 5-year investment horizon for optimal results.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is the risk level of this fund?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">{fund.name} is categorized as {fund.riskLevel} risk as per SEBI's riskometer methodology. This assessment considers market cap allocation, sector concentration, and historical portfolio volatility. {fund.riskLevel === 'high' || fund.riskLevel === 'very-high' ? 'Higher risk funds may deliver better long-term returns but expect 20-40% drawdowns during market corrections.' : 'This risk level indicates relatively stable returns with moderate portfolio fluctuation.'}</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How to invest in this fund?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">You can invest in {fund.name} (Direct-Growth plan) through platforms like Groww, Zerodha Coin, Kuvera, or directly from the AMC website. Minimum SIP amount starts at ₹500/month on most platforms. Complete KYC (PAN + Aadhaar verification) is mandatory before your first investment.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What are the tax implications?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">For equity mutual funds in India: Short-term capital gains (units held less than 1 year) are taxed at 20%. Long-term capital gains (held more than 1 year) above ₹1.25 lakh in a financial year are taxed at 12.5%. ELSS funds have a mandatory 3-year lock-in period. Dividend income from mutual funds is added to your income and taxed at your applicable slab rate.</p>
      </details>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- Bottom Navigation -->
  <section class="container-wide py-6 border-t border-surface-200 dark:border-surface-700">
    <div class="nav-btn-group">
      <a href="/mutual-funds/best" class="btn-secondary px-6 py-3">🏆 Best Mutual Funds</a>
      <a href="/mutual-funds/all" class="btn-secondary px-6 py-3">📊 All Mutual Funds</a>
      <a href="/mutual-funds/mutual-fund-holdings-changes" class="btn-secondary px-6 py-3">📋 Holdings Changes</a>
      <a href="/tools/sip-calculator" class="btn-secondary px-6 py-3">📈 SIP Calculator</a>
    </div>
  </section>
</BaseLayout>
