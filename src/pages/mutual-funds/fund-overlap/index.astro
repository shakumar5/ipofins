---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MfSectionHeader from '../../../components/funds/MfSectionHeader.astro';
import FundOverlapLoader from '../../../components/funds/FundOverlapLoader.tsx';
import { mfTabConfig } from '../../../lib/mf-section-config';

const cfg = mfTabConfig('fund-overlap');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Mutual Fund Portfolio Overlap",
  "description": "Compare portfolio overlap between mutual funds to avoid concentration risk.",
  "url": "https://ipofins.com/mutual-funds/fund-overlap",
};
---

<BaseLayout
  title={cfg.title}
  description={cfg.description}
  ogImage="/og-fund.png"
  jsonLd={jsonLd}
>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Fund Overlap</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <MfSectionHeader
      active="fund-overlap"
      heading={cfg.heading}
      subtitle={cfg.subtitle}
    />
  </section>

  <section class="container-wide pb-12">
    <FundOverlapLoader client:idle />
  </section>
</BaseLayout>
