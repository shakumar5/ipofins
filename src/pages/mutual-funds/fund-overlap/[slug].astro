---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/layout/PageHeader.astro';
import { getFundsWithOverlaps, getFundOverlaps } from '../../../lib/data/holdings';
import { fundHoldingsHref, getFundHoldingsLinkMeta } from '../../../lib/data/funds';
import { resolveDetailSlug } from '../../../lib/fund-detail-slug';
import { parsePgTextArray } from '../../../lib/holdings-utils';
import {
  defaultFundOverlapBack,
  fundOverlapDetailHref,
  MF_LIST_BACK,
} from '../../../lib/list-back-nav';
import { buildFundOverlapPageSlugResolver } from '../../../lib/fund-overlap-slug';
import ListBackLink from '../../../components/ListBackLink.astro';

const defaultBack = defaultFundOverlapBack();
const overlapBackVariants = Object.fromEntries(
  Object.entries(MF_LIST_BACK).filter(([key]) => key !== 'fund-overlap'),
);

export async function getStaticPaths() {
  const funds = await getFundsWithOverlaps();

  return funds.map((f) => ({
    params: { slug: f.slug },
    props: { fundName: f.name },
  }));
}

const { slug } = Astro.params;
const { fundName } = Astro.props;
const overlapIndex = await getFundsWithOverlaps();
const { resolve: resolveOverlapPageSlug } = buildFundOverlapPageSlugResolver(overlapIndex);
const overlaps = (await getFundOverlaps(slug!, 15)) as Array<Record<string, unknown>>;
const holdingsMeta = await getFundHoldingsLinkMeta();

const overlapRows = overlaps.map((row) => {
  const stockNames = parsePgTextArray(row.common_stock_names);
  const count = Number(row.common_stocks ?? stockNames.length);
  const rawSlug = String(row.slug);
  const pageSlug = resolveOverlapPageSlug(rawSlug, String(row.name));
  return {
    slug: pageSlug ?? rawSlug,
    name: String(row.name),
    overlapPct: row.overlap_pct != null ? Number(row.overlap_pct) : null,
    stockCount: count,
    stockNames: stockNames.length > 0 ? stockNames : [],
    hasOverlapPage: Boolean(pageSlug),
  };
});

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": `${fundName} - Portfolio Overlap`,
  "url": `https://ipofins.com/mutual-funds/fund-overlap/${slug}`,
};
---

<BaseLayout
  title={`${fundName} Overlap - Similar Mutual Funds | IPOFins`}
  description={`See which mutual funds overlap most with ${fundName}. Compare shared stock holdings and overlap percentage.`}
  ogImage="/og-fund.png"
  jsonLd={jsonLd}
>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds/fund-overlap" class="hover:text-primary-600 transition-colors">Fund Overlap</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium truncate max-w-[200px]">{fundName}</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <ListBackLink
      id="fund-overlap-detail-back"
      defaultHref={defaultBack.href}
      defaultLabel={defaultBack.label}
      variants={overlapBackVariants}
      class="text-sm text-primary-600 dark:text-primary-400 hover:underline mb-3 inline-flex items-center gap-1"
    />
    <PageHeader
      title={fundName}
      subtitle="Other funds with portfolio holdings that share the most stocks (by weight). Tap a common-stocks count to see the full list."
      freshness="Updated monthly"
      source="AMC portfolio disclosures"
    />
  </section>

  <section class="container-wide pb-12">
    {overlapRows.length > 0 ? (
      <div class="overflow-x-auto card p-0 data-table-premium">
        <table class="w-full text-sm">
          <thead class="bg-surface-50 dark:bg-surface-800/50 text-left text-xs text-surface-500 uppercase">
            <tr>
              <th class="px-4 py-3">Fund</th>
              <th class="px-4 py-3 text-right">Overlap %</th>
              <th class="px-4 py-3 text-right sm:min-w-[11rem]">Common Stocks</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-100 dark:divide-surface-700">
            {overlapRows.map((row) => {
              const detailSlug = resolveDetailSlug(
                row.slug,
                '',
                holdingsMeta.slugs,
                holdingsMeta.stockCounts,
              );
              const hasDetailPage = Boolean(detailSlug);
              const canExpand = row.stockNames.length > 0;
              return (
              <tr class="hover:bg-surface-50 dark:hover:bg-surface-800/30 align-top">
                <td class="px-4 py-3">
                  {row.hasOverlapPage ? (
                    <a href={fundOverlapDetailHref(row.slug, 'fund-overlap')} class="font-medium text-primary-600 hover:underline">{row.name}</a>
                  ) : (
                    <span class="font-medium text-surface-900 dark:text-white">{row.name}</span>
                  )}
                  {hasDetailPage && detailSlug && (
                    <span class="text-xs text-surface-400 block">
                      <a href={fundHoldingsHref(detailSlug)} class="hover:underline">View holdings →</a>
                    </span>
                  )}
                </td>
                <td class="px-4 py-3 text-right font-bold whitespace-nowrap">
                  {row.overlapPct != null ? `${row.overlapPct.toFixed(1)}%` : '—'}
                </td>
                <td class="px-4 py-3 text-right">
                  {canExpand ? (
                    <details class="fund-overlap-stocks group inline-block text-left w-full max-w-xs ml-auto">
                      <summary class="cursor-pointer list-none font-medium text-primary-600 dark:text-primary-400 hover:underline inline-flex items-center gap-1 justify-end w-full select-none">
                        <span>{row.stockCount} stock{row.stockCount === 1 ? '' : 's'}</span>
                        <svg class="w-3.5 h-3.5 shrink-0 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                      </summary>
                      <ul class="mt-2 max-h-52 overflow-y-auto rounded-lg border border-surface-200 dark:border-surface-600 bg-surface-50 dark:bg-surface-900/60 p-2 text-left text-xs text-surface-700 dark:text-surface-300 space-y-1">
                        {row.stockNames.map((stockName) => (
                          <li class="break-words leading-snug py-0.5 border-b border-surface-100 dark:border-surface-700 last:border-0">
                            {stockName}
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <span class="text-surface-600 dark:text-surface-300">
                      {row.stockCount > 0 ? row.stockCount : '—'}
                    </span>
                  )}
                </td>
              </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    ) : (
      <p class="text-surface-500 py-12 text-center">No overlap data for this fund.</p>
    )}
    <p class="mt-4">
      <a href={defaultBack.href} class="text-sm text-primary-600 hover:underline">← {defaultBack.label}</a>
    </p>
  </section>
</BaseLayout>

<style>
  .fund-overlap-stocks summary::-webkit-details-marker {
    display: none;
  }
</style>
