---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PageHeader from '../../../../components/layout/PageHeader.astro';
import HoldingsCompare from '../../../../components/funds/HoldingsCompare.tsx';
import { loadHoldingsPageBootstrap } from '../../../../lib/holdings-page-static';
import { monthSlug, monthDisplay } from '../../../../utils/month-slug';
import {
  defaultHoldingsChangesBack,
  holdingsChangesDetailHref,
  MF_LIST_BACK,
} from '../../../../lib/list-back-nav';
import ListBackLink from '../../../../components/ListBackLink.astro';
import InsightsArticleCallout from '../../../../components/insights/InsightsArticleCallout.astro';
import { getInsightCallout } from '../../../../lib/insights-callouts';

export async function getStaticPaths() {
  const bootstrap = loadHoldingsPageBootstrap();
  if (!bootstrap) return [];

  const amcs = bootstrap.index.amcs.map((a) => ({
    name: a.name,
    slug: a.slug,
    fundCount: a.fundCount,
  }));
  const months = [...bootstrap.index.months].reverse();
  const paths: { params: { amc: string; month: string }; props: Record<string, string> }[] = [];

  for (const amc of amcs) {
    for (let i = 0; i < months.length - 1; i++) {
      paths.push({
        params: { amc: amc.slug, month: monthSlug(months[i]) },
        props: {
          amcName: amc.name,
          currentMonth: months[i],
          previousMonth: months[i + 1],
        },
      });
    }
  }

  return paths;
}

const { amcName, currentMonth, previousMonth } = Astro.props;
const { amc: amcSlug, month: monthParam } = Astro.params;

const bootstrap = loadHoldingsPageBootstrap();
const amcList = bootstrap
  ? bootstrap.index.amcs.map((a) => ({ name: a.name, slug: a.slug, fundCount: a.fundCount }))
  : [];
const allMonths = bootstrap?.monthsNewestFirst ?? [];
const holdingsIndex = bootstrap?.index ?? null;

const displayMonth = monthDisplay(monthParam || '');

const pageTitle = `${amcName} Holdings Changes ${displayMonth} - Stocks Bought & Sold | IPOFins`;
const pageDesc = `See what stocks ${amcName} mutual funds bought and sold in ${displayMonth}. Compare portfolio holdings between ${previousMonth} and ${currentMonth} using official AMC disclosures.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${amcName} Mutual Fund Holdings Changes - ${displayMonth}`,
  description: pageDesc,
  url: `https://ipofins.com/mutual-funds/mutual-fund-holdings-changes/${amcSlug}/${monthParam}`,
};

const otherAmcs = amcList.filter((a) => a.name !== amcName).slice(0, 10);
const defaultBack = defaultHoldingsChangesBack();
const holdingsBackVariants = Object.fromEntries(
  Object.entries(MF_LIST_BACK).filter(([key]) => key !== 'holdings-changes'),
);
const amcInsight = getInsightCallout('holdings-amc', { amcSlug: amcSlug || '', monthSlug: monthParam || undefined });
---

<BaseLayout title={pageTitle} description={pageDesc} jsonLd={jsonLd}>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400 flex-wrap">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds/mutual-fund-holdings-changes" class="hover:text-primary-600 transition-colors">Holdings Changes</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium" data-breadcrumb-leaf>{amcName} - {displayMonth}</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <ListBackLink
      id="holdings-changes-detail-back"
      defaultHref={defaultBack.href}
      defaultLabel={defaultBack.label}
      variants={holdingsBackVariants}
      class="text-sm text-primary-600 dark:text-primary-400 hover:underline mb-3 inline-flex items-center gap-1"
    />
    <PageHeader
      title={`${amcName} Holdings Changes - ${displayMonth}`}
      subtitle={`Stocks bought and sold by ${amcName} funds between ${previousMonth} → ${currentMonth}`}
      freshness="Updated monthly"
      source="AMC portfolio disclosures"
    />

    <div class="mt-4 flex flex-wrap gap-2">
      <a href={defaultBack.href} class="px-4 py-2 text-sm font-medium text-surface-600 bg-surface-100 dark:bg-surface-800 rounded-lg hover:bg-surface-200 transition-colors">← {defaultBack.label}</a>
    </div>

    {amcInsight && (
      <div class="mt-4 max-w-2xl">
        <InsightsArticleCallout article={amcInsight} label="AMC holdings analysis" />
      </div>
    )}
  </section>

  <section class="container-wide py-4">
    {holdingsIndex && (
      <div
        id="holdings-compare-bootstrap"
        hidden
        data-json={JSON.stringify(holdingsIndex)}
      />
    )}
    <HoldingsCompare
      client:load
      initialAmc={amcName}
      initialMonth1={previousMonth}
      initialMonth2={currentMonth}
      monthQuickPick={allMonths.slice(1)}
      pageMode="amc"
      initialIndex={holdingsIndex}
    >
      <div slot="fallback" class="py-12 text-center text-sm text-surface-500 dark:text-surface-400">Loading holdings comparison…</div>
    </HoldingsCompare>
  </section>

  <section class="container-wide py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Other AMCs - {displayMonth}</h2>
    <div class="flex flex-wrap gap-2">
      {otherAmcs.map((other) => (
        <a
          href={holdingsChangesDetailHref(other.slug, monthParam || '')}
          class="px-3 py-2 text-sm font-medium text-surface-600 bg-surface-100 dark:bg-surface-800 rounded-lg hover:bg-surface-200 dark:hover:bg-surface-700 transition-colors border border-surface-200 dark:border-surface-700"
        >{other.name}</a>
      ))}
      <a
        href="/mutual-funds/mutual-fund-holdings-changes"
        class="px-3 py-2 text-sm font-medium text-primary-600 bg-primary-50 dark:bg-primary-900/20 rounded-lg hover:bg-primary-100 transition-colors border border-primary-200 dark:border-primary-800"
      >View All AMCs →</a>
    </div>
  </section>

  <section class="container-wide py-6">
    <div class="max-w-3xl text-sm text-surface-600 dark:text-surface-300 space-y-3">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white">About {amcName} Holdings Changes</h2>
      <p>This page shows the stocks that {amcName} mutual funds have bought (added) and sold (removed) in {displayMonth} compared to {previousMonth}. Data is sourced from official SEBI-mandated monthly portfolio disclosures published by {amcName}.</p>
      <p>Tracking what professional fund managers are buying helps identify stocks with institutional conviction. If multiple funds from {amcName} are adding the same stock, it signals strong conviction in that company's fundamentals.</p>
    </div>
  </section>
</BaseLayout>
