---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MfSectionHeader from '../../components/funds/MfSectionHeader.astro';
import HoldingsCompare from '../../components/funds/HoldingsCompare.tsx';
import SmartMoneyInternalLinks from '../../components/funds/SmartMoneyInternalLinks.astro';
import { loadHoldingsPageBootstrap } from '../../lib/holdings-page-static';
import { loadSmartMoneyTrackerLinks } from '../../lib/smart-money-tracker-links';
import { monthSlug } from '../../utils/month-slug';
import { mfTabConfig } from '../../lib/mf-section-config';
import { holdingsChangesDetailHref } from '../../lib/list-back-nav';
import ContentGuideSection from '../../components/content-guide/ContentGuideSection.astro';
import ContentGuidePanel from '../../components/content-guide/ContentGuidePanel.astro';
import ContentGuideFaqList from '../../components/content-guide/ContentGuideFaqList.astro';
import ContentGuideFaqItem from '../../components/content-guide/ContentGuideFaqItem.astro';
import ContentGuideExplore from '../../components/content-guide/ContentGuideExplore.astro';

const cfg = mfTabConfig('holdings-changes');
const sm = loadSmartMoneyTrackerLinks();
const bootstrap = loadHoldingsPageBootstrap();
const amcListData = bootstrap ? bootstrap.index.amcs.map((a) => ({
  name: a.name,
  slug: a.slug,
  fundCount: a.fundCount,
})) : [];
const amcCount = bootstrap?.stats.amcCount ?? 0;
const fundCount = bootstrap?.stats.fundsCovered ?? 0;
const latestMonthLabel = bootstrap?.stats.latestMonth ?? '';
const monthsList = bootstrap?.monthsNewestFirst ?? [];

function slugify(str: string): string {
  return str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}
const amcList = amcListData.map((a) => a.name).sort();
const latestMonthSlug = monthSlug(latestMonthLabel);
const amcSlugByName = Object.fromEntries(amcListData.map((a) => [a.name, a.slug]));
const holdingsIndex = bootstrap?.index ?? null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Mutual Fund Holdings Changes - Monthly Additions & Removals",
  "description": "Track what stocks mutual funds are buying and selling. Compare portfolio holdings between months to identify additions and removals.",
  "url": "https://ipofins.com/mutual-funds/mutual-fund-holdings-changes"
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What are mutual fund holdings changes?", "acceptedAnswer": { "@type": "Answer", "text": "Holdings changes show which stocks a mutual fund has newly bought (added) or sold (removed) between two consecutive months. SEBI mandates all mutual funds to publish their complete portfolio monthly. By comparing portfolios, we identify what fund managers are buying and selling." } },
    { "@type": "Question", "name": "How can I use this to make better investment decisions?", "acceptedAnswer": { "@type": "Answer", "text": "By tracking what professional fund managers are buying, you can identify stocks with institutional conviction. If multiple top funds add the same stock, it signals strong fundamentals. However, this should be one input in your research, not the sole decision factor." } },
    { "@type": "Question", "name": "Why does it show No portfolio changes detected?", "acceptedAnswer": { "@type": "Answer", "text": "This happens when: (1) The fund is an index fund that tracks a fixed benchmark and rarely changes holdings. (2) Data is available for only one month — two months are needed to compare. Try a different AMC or fund type. Active funds show more changes than index funds." } },
    { "@type": "Question", "name": "How often is the holdings data updated?", "acceptedAnswer": { "@type": "Answer", "text": "AMCs publish monthly portfolio disclosures by the 10th-15th of the following month. We update within 5 days of publication. New months appear automatically in the dropdown." } },
    { "@type": "Question", "name": "Where does the holdings data come from?", "acceptedAnswer": { "@type": "Answer", "text": "All data comes directly from official monthly portfolio disclosure filings published by each AMC as mandated by SEBI. We process original Excel files from fund house websites. No third-party or estimated data is used." } }
  ]
};
---

<BaseLayout
  title={cfg.title}
  description={cfg.description}
  jsonLd={jsonLd}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium" data-breadcrumb-leaf>Holdings Changes</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <MfSectionHeader
      active="holdings-changes"
      heading={cfg.heading}
      subtitle={cfg.subtitle}
      freshness={`🟢 Latest data: ${latestMonthLabel || '—'} • ${amcCount} AMCs • ${fundCount} equity funds with holdings`}
    />
  </section>

  <section class="container-wide py-4">
    {!bootstrap && (
      <div class="rounded-xl border border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-900/20 px-4 py-3 text-sm text-amber-800 dark:text-amber-200 mb-4">
        Holdings data is not loaded locally. Run <code class="text-xs bg-white/60 dark:bg-black/20 px-1 rounded">npm run dev:sync</code> or <code class="text-xs bg-white/60 dark:bg-black/20 px-1 rounded">npm run build</code> to export JSON from the database.
      </div>
    )}
    {holdingsIndex && (
      <div
        id="holdings-compare-bootstrap"
        hidden
        data-json={JSON.stringify(holdingsIndex)}
      />
    )}
    <HoldingsCompare client:load pageMode="hub" initialIndex={holdingsIndex}>
      <div slot="fallback" class="py-12 text-center text-sm text-surface-500 dark:text-surface-400">Loading holdings comparison…</div>
    </HoldingsCompare>
  </section>

  <!-- Browse by AMC - SEO internal links -->
  <section class="container-wide py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-2">Browse Holdings Changes by AMC</h2>
    <p class="text-sm text-surface-500 dark:text-surface-400 mb-4">View detailed holdings changes for each AMC — {latestMonthLabel}</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
      {amcList.map(amc => (
        <a
          href={holdingsChangesDetailHref(amcSlugByName[amc] || slugify(amc), latestMonthSlug)}
          class="px-3 py-2.5 text-sm font-medium text-surface-700 dark:text-surface-300 bg-white dark:bg-surface-800 rounded-lg hover:bg-primary-50 dark:hover:bg-primary-900/20 hover:text-primary-600 transition-colors border border-surface-200 dark:border-surface-700 text-center"
        >{amc}</a>
      ))}
    </div>
  </section>

  <ContentGuideSection
    eyebrow="Guide"
    title="About Holdings Changes"
    intro="Mutual funds disclose complete portfolio holdings every month. Comparing consecutive months shows which stocks were newly added, removed, or had weight changed significantly."
  >
    <ContentGuidePanel>
      <div class="content-guide__prose">
        <p>This helps investors understand: What are fund managers buying? Which sectors are they bullish on? What stocks are they exiting?</p>
        <p class="content-guide__meta">
          Data source: AMC monthly portfolio disclosure filings · Updated every 15 days ·
          Months: {monthsList.join(', ')} · AMCs: {amcCount} · Funds: {fundCount}
        </p>
      </div>

      <div class="content-guide__details" style="margin-top: 1rem;">
        <summary>How to use this tool</summary>
        <div class="content-guide__details-body">
          <div class="content-guide__steps">
            <div class="content-guide__step">
              <span class="content-guide__step-num">1</span>
              <p class="content-guide__step-body"><strong>Select an AMC</strong> — Choose the fund house you want to track (HDFC, ICICI, Axis, DSP, etc.)</p>
            </div>
            <div class="content-guide__step">
              <span class="content-guide__step-num">2</span>
              <p class="content-guide__step-body"><strong>Choose Fund Type</strong> — Filter by category: Large Cap, Mid Cap, Small Cap, Flexi Cap, or All</p>
            </div>
            <div class="content-guide__step">
              <span class="content-guide__step-num">3</span>
              <p class="content-guide__step-body"><strong>Select Two Months</strong> — Pick "From" (older) and "To" (newer) month to compare</p>
            </div>
            <div class="content-guide__step">
              <span class="content-guide__step-num">4</span>
              <p class="content-guide__step-body"><strong>View Changes</strong> — See new stocks added (green) and stocks removed (red) from the portfolio</p>
            </div>
          </div>
        </div>
      </div>
    </ContentGuidePanel>
  </ContentGuideSection>

  <ContentGuideExplore
    title="Related: Smart Money Tracker"
    subtitle={`AMC-level changes above; industry-wide stock rankings below (${sm.latestMonth}).`}
    bordered
  >
    <SmartMoneyInternalLinks variant="inline" showHub={false} showTabs />
  </ContentGuideExplore>

  <ContentGuideSection title="Frequently Asked Questions" variant="faq" bordered>
    <ContentGuideFaqList>
      <ContentGuideFaqItem open>
        <span slot="question">What are mutual fund holdings changes?</span>
        Holdings changes show which stocks a mutual fund has newly bought (added) or sold (removed) between two consecutive months. SEBI mandates all mutual funds to publish their complete portfolio monthly.
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">How can I use this to make better investment decisions?</span>
        By tracking what professional fund managers are buying, you can identify stocks with institutional conviction. See industry-wide views:
        <a href={sm.mostBought} class="content-guide__link">Most Bought Stocks</a>,
        <a href={sm.mostSold} class="content-guide__link">Most Sold</a>, and
        <a href={sm.sectorIntelligence} class="content-guide__link">Sector Intelligence</a>.
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Why does it show "No portfolio changes detected"?</span>
        This happens when the fund is an index fund (rarely changes holdings) or when only one month of data is available. Try a different AMC or fund type — active funds show more changes than passive/index funds.
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">How often is the holdings data updated?</span>
        AMCs publish monthly portfolio disclosures by the 10th–15th of the following month. We update within 5 days of publication. New months are added automatically.
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">What does the weight percentage (%) mean?</span>
        The percentage represents the proportion of the fund's total NAV invested in that stock. Top holdings typically range from 3% to 10% of NAV.
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Which AMCs and fund types are covered?</span>
        We track {amcCount} AMCs including HDFC, ICICI Prudential, Axis, DSP, Aditya Birla Sun Life, Motilal Oswal, Edelweiss, and more. Only equity-oriented funds are shown.
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Where does the holdings data come from?</span>
        All data comes from official monthly portfolio disclosure filings published by each AMC on their website, as mandated by SEBI.
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Can I see individual fund holdings without comparing?</span>
        Yes — go to any fund detail page via <a href="/mutual-funds/all" class="content-guide__link">All Funds</a> for the latest month's stocks with sector and weight.
      </ContentGuideFaqItem>
    </ContentGuideFaqList>
  </ContentGuideSection>
</BaseLayout>
