---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MfSectionHeader from '../../components/funds/MfSectionHeader.astro';
import HoldingsCompare from '../../components/funds/HoldingsCompare.tsx';
import SmartMoneyInternalLinks from '../../components/funds/SmartMoneyInternalLinks.astro';
import { loadHoldingsPageBootstrap } from '../../lib/holdings-page-static';
import { loadSmartMoneyTrackerLinks } from '../../lib/smart-money-tracker-links';
import { monthSlug } from '../../utils/month-slug';
import { mfTabConfig } from '../../lib/mf-section-config';

const cfg = mfTabConfig('holdings-changes');
const sm = loadSmartMoneyTrackerLinks();
const bootstrap = loadHoldingsPageBootstrap();
const amcListData = bootstrap ? bootstrap.index.amcs.map((a) => ({
  name: a.name,
  slug: a.slug,
  fundCount: a.fundCount,
})) : [];
const amcCount = bootstrap?.stats.amcCount ?? 0;
const fundCount = bootstrap?.stats.fundsCovered ?? 0;
const latestMonthLabel = bootstrap?.stats.latestMonth ?? '';
const monthsList = bootstrap?.monthsNewestFirst ?? [];

function slugify(str: string): string {
  return str.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}
const amcList = amcListData.map((a) => a.name).sort();
const latestMonthSlug = monthSlug(latestMonthLabel);
const amcSlugByName = Object.fromEntries(amcListData.map((a) => [a.name, a.slug]));
const holdingsIndex = bootstrap?.index ?? null;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Mutual Fund Holdings Changes - Monthly Additions & Removals",
  "description": "Track what stocks mutual funds are buying and selling. Compare portfolio holdings between months to identify additions and removals.",
  "url": "https://ipofins.com/mutual-funds/mutual-fund-holdings-changes"
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What are mutual fund holdings changes?", "acceptedAnswer": { "@type": "Answer", "text": "Holdings changes show which stocks a mutual fund has newly bought (added) or sold (removed) between two consecutive months. SEBI mandates all mutual funds to publish their complete portfolio monthly. By comparing portfolios, we identify what fund managers are buying and selling." } },
    { "@type": "Question", "name": "How can I use this to make better investment decisions?", "acceptedAnswer": { "@type": "Answer", "text": "By tracking what professional fund managers are buying, you can identify stocks with institutional conviction. If multiple top funds add the same stock, it signals strong fundamentals. However, this should be one input in your research, not the sole decision factor." } },
    { "@type": "Question", "name": "Why does it show No portfolio changes detected?", "acceptedAnswer": { "@type": "Answer", "text": "This happens when: (1) The fund is an index fund that tracks a fixed benchmark and rarely changes holdings. (2) Data is available for only one month — two months are needed to compare. Try a different AMC or fund type. Active funds show more changes than index funds." } },
    { "@type": "Question", "name": "How often is the holdings data updated?", "acceptedAnswer": { "@type": "Answer", "text": "AMCs publish monthly portfolio disclosures by the 10th-15th of the following month. We update within 5 days of publication. New months appear automatically in the dropdown." } },
    { "@type": "Question", "name": "Where does the holdings data come from?", "acceptedAnswer": { "@type": "Answer", "text": "All data comes directly from official monthly portfolio disclosure filings published by each AMC as mandated by SEBI. We process original Excel files from fund house websites. No third-party or estimated data is used." } }
  ]
};
---

<BaseLayout
  title={cfg.title}
  description={cfg.description}
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Holdings Changes</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <MfSectionHeader
      active="holdings-changes"
      heading={cfg.heading}
      subtitle={cfg.subtitle}
      freshness={`🟢 Latest data: ${latestMonthLabel || '—'} • ${amcCount} AMCs • ${fundCount} equity funds with holdings`}
    />
  </section>

  <section class="container-wide py-4">
    {!bootstrap && (
      <div class="rounded-xl border border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-900/20 px-4 py-3 text-sm text-amber-800 dark:text-amber-200 mb-4">
        Holdings data is not loaded locally. Run <code class="text-xs bg-white/60 dark:bg-black/20 px-1 rounded">npm run dev:sync</code> or <code class="text-xs bg-white/60 dark:bg-black/20 px-1 rounded">npm run build</code> to export JSON from the database.
      </div>
    )}
    <HoldingsCompare client:load pageMode="hub" initialIndex={holdingsIndex}>
      <div slot="fallback" class="py-12 text-center text-sm text-surface-500 dark:text-surface-400">Loading holdings comparison…</div>
    </HoldingsCompare>
  </section>

  <!-- Browse by AMC - SEO internal links -->
  <section class="container-wide py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-2">Browse Holdings Changes by AMC</h2>
    <p class="text-sm text-surface-500 dark:text-surface-400 mb-4">View detailed holdings changes for each AMC — {latestMonthLabel}</p>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-2">
      {amcList.map(amc => (
        <a
          href={`/mutual-funds/mutual-fund-holdings-changes/${amcSlugByName[amc] || slugify(amc)}/${latestMonthSlug}`}
          class="px-3 py-2.5 text-sm font-medium text-surface-700 dark:text-surface-300 bg-white dark:bg-surface-800 rounded-lg hover:bg-primary-50 dark:hover:bg-primary-900/20 hover:text-primary-600 transition-colors border border-surface-200 dark:border-surface-700 text-center"
        >{amc}</a>
      ))}
    </div>
  </section>

  <!-- Info -->
  <section class="container-wide py-8">
    <div class="max-w-3xl text-sm text-surface-600 dark:text-surface-300 space-y-3">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white">About Holdings Changes</h2>
      <p>Mutual funds are required by SEBI to disclose their complete portfolio holdings every month. By comparing consecutive months, we identify which stocks were newly added, removed, or had their weight changed significantly.</p>
      <p>This helps investors understand: What are the best fund managers buying? Which sectors are they bullish on? What stocks are they exiting?</p>
      <p class="text-xs text-surface-400 mt-4">📋 Data source: AMC monthly portfolio disclosure filings. Updated every 15 days.<br/>📊 Available months: {monthsList.join(', ')}<br/>🏦 AMCs covered: {amcCount}<br/>📈 Funds tracked: {fundCount}</p>
    </div>
  </section>

  <!-- How to Use -->
  <section class="container-wide py-6">
    <div class="max-w-3xl">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">How to Use This Tool</h2>
      <div class="space-y-3 text-sm text-surface-600 dark:text-surface-300">
        <div class="flex gap-3 items-start">
          <span class="w-6 h-6 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold flex-shrink-0">1</span>
          <p><strong>Select an AMC</strong> — Choose the fund house you want to track (HDFC, ICICI, Axis, DSP, etc.)</p>
        </div>
        <div class="flex gap-3 items-start">
          <span class="w-6 h-6 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold flex-shrink-0">2</span>
          <p><strong>Choose Fund Type</strong> — Filter by category: Large Cap, Mid Cap, Small Cap, Flexi Cap, or All</p>
        </div>
        <div class="flex gap-3 items-start">
          <span class="w-6 h-6 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold flex-shrink-0">3</span>
          <p><strong>Select Two Months</strong> — Pick "From" (older) and "To" (newer) month to compare</p>
        </div>
        <div class="flex gap-3 items-start">
          <span class="w-6 h-6 rounded-full bg-primary-100 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 flex items-center justify-center text-xs font-bold flex-shrink-0">4</span>
          <p><strong>View Changes</strong> — See new stocks added (green) and stocks removed (red) from the portfolio</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-wide py-6 border-t border-surface-200 dark:border-surface-700">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-2">Related: Smart Money Tracker</h2>
    <p class="text-sm text-surface-500 dark:text-surface-400 mb-4">AMC-level changes above; industry-wide stock rankings below ({sm.latestMonth}).</p>
    <SmartMoneyInternalLinks showTabs />
  </section>

  <!-- FAQ Section -->
  <section class="container-wide py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What are mutual fund holdings changes?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Holdings changes show which stocks a mutual fund has newly bought (added) or sold (removed) between two consecutive months. SEBI mandates all mutual funds to publish their complete portfolio on a monthly basis. By comparing the portfolio of Month A with Month B, we can identify what the fund manager is buying and selling.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How can I use this to make better investment decisions?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">By tracking what professional fund managers are buying, you can identify stocks that have institutional conviction. If multiple top-performing funds are adding the same stock, it signals strong fundamentals. See industry-wide views: <a href={sm.mostBought} class="text-primary-600 hover:underline">Most Bought Stocks</a>, <a href={sm.mostSold} class="text-primary-600 hover:underline">Most Sold</a>, and <a href={sm.sectorIntelligence} class="text-primary-600 hover:underline">Sector Intelligence</a>.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Why does it show "No portfolio changes detected"?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">This happens in two cases: (1) The fund is an index fund — these track a fixed benchmark like Nifty 50 and rarely change their holdings. (2) Data is available for only one month — we need two months to compare. Try selecting a different AMC or fund type. Active funds (Flexi Cap, Mid Cap, Small Cap) tend to show more changes than passive/index funds.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How often is the holdings data updated?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">AMCs typically publish monthly portfolio disclosures by the 10th–15th of the following month (e.g., April data is available by mid-May). We update our data within 5 days of publication. Currently available months are shown in the dropdown. New months are added automatically when we process the latest AMC disclosures.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What does the weight percentage (%) mean?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">The percentage shown (e.g., 4.37%) represents the proportion of the fund's total Net Asset Value (NAV) invested in that particular stock. A higher percentage means the fund has more conviction in that stock. Top holdings typically range from 3% to 10% of NAV. We show the top 20 holdings for each fund.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Which AMCs and fund types are covered?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">We currently track {amcCount} AMCs including HDFC, ICICI Prudential, Axis, DSP, Aditya Birla Sun Life, Motilal Oswal, Edelweiss, and more. Only equity-oriented funds are shown (we exclude debt, liquid, gold, and silver funds). You can filter by fund type: Large Cap, Mid Cap, Small Cap, Flexi Cap, Multi Cap, and Others.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Where does the holdings data come from?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">All data comes directly from the official monthly portfolio disclosure filings published by each AMC on their website, as mandated by SEBI. We process the original Excel files published by fund houses. No third-party or estimated data is used — this is the same data available on each AMC's statutory disclosures page.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Can I see individual fund holdings without comparing?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Yes! Go to any mutual fund's detail page (via <a href="/mutual-funds/all" class="text-primary-600 hover:underline">All Funds</a>) — if holdings data is available, it shows the latest month's top 20 stocks with their sector and weight. Funds with available holdings show a green "Y" badge in the Holdings column on the fund listing page.</p>
      </details>
    </div>
  </section>
</BaseLayout>
