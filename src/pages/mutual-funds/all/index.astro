---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MfSectionHeader from '../../../components/funds/MfSectionHeader.astro';
import FundTableLoader from '../../../components/funds/FundTableLoader.tsx';
import { getMfHubBuildData } from '../../../lib/mf-hub-build';
import { mfTabConfig } from '../../../lib/mf-section-config';
import { BRAND_URL } from '../../../lib/brand';

const hub = await getMfHubBuildData();
const cfg = mfTabConfig('all');

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "List of All Mutual Funds India 2026",
  "description": "Complete list of all mutual funds in India with returns comparison, NAV, and ratings.",
  "url": "https://ipofins.com/mutual-funds/all"
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How do I compare mutual funds by returns?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Use the table above to sort funds by 1-year, 3-year, or 5-year returns. Click on any column header to sort. You can also filter by category (Large Cap, Mid Cap, Small Cap, etc.) using the category tabs. Always compare funds within the same category for a fair comparison."
      }
    },
    {
      "@type": "Question",
      "name": "What do 1Y, 3Y, and 5Y returns mean?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "1Y is the absolute return over the past 1 year. 3Y and 5Y are CAGR (Compound Annual Growth Rate) over 3 and 5 years respectively. CAGR gives a smoothed annual return that accounts for compounding, making it a better measure for comparing long-term performance."
      }
    },
    {
      "@type": "Question",
      "name": "What categories of mutual funds are available?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We track: Large Cap (stable, lower risk), Mid Cap (growth potential, moderate risk), Small Cap (high growth, high risk), Flexi Cap (flexible allocation), ELSS (tax-saving with 3-year lock-in), and Hybrid (mix of equity and debt for balanced returns)."
      }
    },
    {
      "@type": "Question",
      "name": "Where does the mutual fund data come from?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "All NAV and return data is sourced from AMFI (Association of Mutual Funds in India), the official industry body. Returns are calculated from historical NAV data. We show only Direct-Growth plans to help investors get the best possible returns."
      }
    }
  ]
};
---

<BaseLayout title={cfg.title} description={cfg.description} canonicalUrl={`${BRAND_URL}/mutual-funds/all`} jsonLd={jsonLd}>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium" data-breadcrumb-leaf>All Mutual Funds</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <MfSectionHeader
      active="all"
      heading={cfg.heading}
      subtitle={`${hub.totalFunds} equity Direct-Growth funds · Portfolio data for ${hub.holdingsCount} funds · Sort by returns`}
      freshness={`🟢 Data as of ${hub.dataDate} • Source: AMFI India`}
    />
  </section>

  <section class="container-wide py-4">
    <FundTableLoader client:load table="all" basePath="/mutual-funds/all" />
  </section>

  <!-- How to Use Section -->
  <section class="container-narrow py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">How to Use This Page</h2>
    <div class="prose prose-sm dark:prose-invert max-w-none text-surface-600 dark:text-surface-300">
      <p>This page lists all mutual funds tracked on IPOFins with their latest NAV data sourced directly from AMFI India. You can use the interactive table above to filter funds by category, sort by different return periods, and search for specific fund names. This makes it easy to compare performance across funds within the same category.</p>
      <p>Start by selecting a category tab (Large Cap, Mid Cap, Small Cap, etc.) to narrow down funds relevant to your investment goal. Then sort by 3-year or 5-year CAGR to identify consistent performers. Click on any fund name to view detailed information including top holdings, SIP projections, and risk metrics. Funds with holdings data available are marked — this lets you see exactly what stocks the fund owns.</p>
      <p>For new investors, we recommend comparing at least 3-5 funds within your chosen category before making a decision. Look beyond just returns — consider AUM (larger AUMs indicate investor confidence), expense ratio, and fund manager tenure. A fund with slightly lower returns but consistent performance across market cycles is often a better choice than one with spectacular recent returns driven by a single sector bet. All data shown is for Direct-Growth plans which offer the lowest expense ratio.</p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="container-wide py-12">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How do I compare mutual funds by returns?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Use the table above to sort funds by 1-year, 3-year, or 5-year returns. Click on any column header to sort. You can also filter by category (Large Cap, Mid Cap, Small Cap, etc.) using the category tabs. Always compare funds within the same category for a fair comparison.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What do 1Y, 3Y, and 5Y returns mean?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">1Y is the absolute return over the past 1 year. 3Y and 5Y are CAGR (Compound Annual Growth Rate) over 3 and 5 years respectively. CAGR gives a smoothed annual return that accounts for compounding, making it a better measure for comparing long-term performance.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What categories of mutual funds are available?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">We track: Large Cap (stable, lower risk), Mid Cap (growth potential, moderate risk), Small Cap (high growth, high risk), Flexi Cap (flexible allocation), ELSS (tax-saving with 3-year lock-in), and Hybrid (mix of equity and debt for balanced returns).</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Where does the mutual fund data come from?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">All NAV and return data is sourced from AMFI (Association of Mutual Funds in India), the official industry body. Returns are calculated from historical NAV data. We show only Direct-Growth plans to help investors get the best possible returns.</p>
      </details>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
