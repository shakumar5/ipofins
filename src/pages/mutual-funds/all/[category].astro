---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FundTableLoader from '../../../components/funds/FundTableLoader.tsx';
import MfSectionTabs from '../../../components/funds/MfSectionTabs.astro';
import { getAllFunds } from '../../../lib/data/funds';
import { catToSlug } from '../../../lib/fund-category-slug';
import { getFundTablePageMeta } from '../../../lib/fund-table-meta';
import { BRAND_URL } from '../../../lib/brand';

export async function getStaticPaths() {
  const fundsData = await getAllFunds();
  const available = [...new Set(fundsData.map((f) => f.category))];
  return available.map((cat) => ({
    params: { category: catToSlug(cat) },
    props: { categoryName: cat },
  }));
}

const { categoryName } = Astro.props;
const fundsData = await getAllFunds();
const categoryCount = fundsData.filter((f) => f.category === categoryName).length;
const pageMeta = getFundTablePageMeta('all', categoryName, categoryCount);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": pageMeta.heading,
  "description": pageMeta.description,
  "url": `https://ipofins.com${pageMeta.path}`
};
---

<BaseLayout
  title={pageMeta.title}
  description={pageMeta.description}
  canonicalUrl={`${BRAND_URL}${pageMeta.path}`}
  jsonLd={jsonLd}
>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds/all" class="hover:text-primary-600 transition-colors">All Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium" data-breadcrumb-leaf>{pageMeta.breadcrumbLabel}</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <h1 class="text-2xl font-bold text-surface-900 dark:text-white" data-page-heading>{pageMeta.heading}</h1>
    <p class="mt-1 text-sm text-surface-500" data-page-subtitle>{pageMeta.subtitle}</p>

    <MfSectionTabs active="all" />
  </section>

  <section class="container-wide py-4">
    <FundTableLoader
      client:load
      table="all"
      basePath="/mutual-funds/all"
      defaultCategory={categoryName}
    />
  </section>
</BaseLayout>
