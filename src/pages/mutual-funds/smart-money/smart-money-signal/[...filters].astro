---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SmartMoneyHubView from '../../../../components/funds/SmartMoneyHubView.astro';
import { BRAND_URL } from '../../../../lib/brand';
import { resolveSmartMoneyPage } from '../../../../lib/smart-money-page-context';
import { loadSmartMoneyTrackerLinks } from '../../../../lib/smart-money-tracker-links';
import {
  getSmartMoneySignalsListPageMeta,
  parseSmartMoneySignalsListFiltersFromPathname,
  parseSmartMoneySignalsListFiltersFromSearch,
  smartMoneySignalsListPath,
  SMART_MONEY_SIGNALS_LIST_BASE,
} from '../../../../lib/smart-money-signals-list-meta';
import { loadSmartMoneySignalFilterPathParams, loadSignalIndexCategories } from '../../../../lib/smart-money-signals-list-server';

export function getStaticPaths() {
  const filterPaths = loadSmartMoneySignalFilterPathParams();
  if (!filterPaths.length) {
    return [{ params: { filters: '_placeholder' }, props: { filtersPath: '_placeholder' } }];
  }
  return filterPaths.map((filtersPath) => ({
    params: { filters: filtersPath },
    props: { filtersPath },
  }));
}

const { filtersPath } = Astro.props;
const isPlaceholder = filtersPath === '_placeholder';

if (!isPlaceholder && Astro.url.search) {
  const legacy = parseSmartMoneySignalsListFiltersFromSearch(Astro.url.search);
  return Astro.redirect(smartMoneySignalsListPath(legacy), 301);
}

const pathname = isPlaceholder
  ? SMART_MONEY_SIGNALS_LIST_BASE
  : `${SMART_MONEY_SIGNALS_LIST_BASE}/${filtersPath}`;

let initialSignalsFilters;
if (!isPlaceholder) {
  const categories = loadSignalIndexCategories();
  initialSignalsFilters =
    parseSmartMoneySignalsListFiltersFromPathname(pathname, categories) ?? undefined;
}

const { parsed, parsedTab, pageMeta, trackerBootstrap } = resolveSmartMoneyPage(SMART_MONEY_SIGNALS_LIST_BASE);
const pageMetaFiltered =
  initialSignalsFilters && !isPlaceholder
    ? getSmartMoneySignalsListPageMeta(initialSignalsFilters)
    : pageMeta;
const sm = loadSmartMoneyTrackerLinks();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageMetaFiltered.heading || 'Smart Money Signal',
  description: pageMetaFiltered.description,
  url: `${BRAND_URL}${pageMetaFiltered.path}`,
};
---

<BaseLayout
  title={pageMetaFiltered.title}
  description={pageMetaFiltered.description}
  canonicalUrl={`${BRAND_URL}${pageMetaFiltered.path}`}
  ogImage="/og-fund.png"
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" href="/data/smart-money-signals-index.json" as="fetch" crossorigin />
  {isPlaceholder ? (
    <div class="container-wide py-12 text-center text-sm text-surface-500">
      <p>Run <code>npm run export:client-data</code> to generate signal filter pages.</p>
      <a href={SMART_MONEY_SIGNALS_LIST_BASE} class="text-primary-600 mt-2 inline-block">← Smart Money Signal</a>
    </div>
  ) : (
    <SmartMoneyHubView
      pageMeta={pageMetaFiltered}
      parsed={parsed}
      parsedTab="signals"
      sm={sm}
      trackerBootstrap={trackerBootstrap}
      initialSignalsFilters={initialSignalsFilters}
    />
  )}
</BaseLayout>
