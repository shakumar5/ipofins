---
import { stockSignalPath } from '../../../../lib/stock-signal-meta';
import { loadSmartMoneyStockSlugs } from '../../../../lib/smart-money-stock-slugs';

export function getStaticPaths() {
  const stocks = loadSmartMoneyStockSlugs();
  if (!stocks.length) {
    return [{ params: { slug: '_placeholder' } }];
  }
  return stocks.map(({ slug }) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
if (slug && slug !== '_placeholder') {
  const qs = Astro.url.search;
  return Astro.redirect(`${stockSignalPath(slug)}${qs}`, 301);
}

return Astro.redirect(stockSignalPath(), 302);
---
