---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import StockSignalPage from '../../../../components/funds/StockSignalPage.tsx';
import SmartMoneySubNav from '../../../../components/funds/SmartMoneySubNav.astro';
import PageHeader from '../../../../components/layout/PageHeader.astro';
import { getStockSignalPageMeta } from '../../../../lib/stock-signal-meta';
import { loadSmartMoneyTrackerLinks } from '../../../../lib/smart-money-tracker-links';
import {
  readSignalsIndexFromDisk,
  SIGNALS_INDEX_PUBLIC_PATH,
  signalSearchPublicUrl,
} from '../../../../lib/smart-money-signals-server';
import { BRAND_URL } from '../../../../lib/brand';

const pageMeta = getStockSignalPageMeta();
const sm = loadSmartMoneyTrackerLinks();
const signalsIndex = readSignalsIndexFromDisk();
const latestMonth = signalsIndex?.months[0];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageMeta.heading || 'Stock Signal',
  description: pageMeta.description,
  url: `${BRAND_URL}${pageMeta.path}`,
};
---

<BaseLayout
  title={pageMeta.title}
  description={pageMeta.description}
  canonicalUrl={`${BRAND_URL}${pageMeta.path}`}
  ogImage="/og-fund.png"
  jsonLd={jsonLd}
>
  <link slot="head" rel="preload" href={SIGNALS_INDEX_PUBLIC_PATH} as="fetch" crossorigin />
  {latestMonth && (
    <link slot="head" rel="preload" href={signalSearchPublicUrl(latestMonth)} as="fetch" crossorigin />
  )}

  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href={sm.hub} class="hover:text-primary-600 transition-colors">Smart Money</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">{pageMeta.breadcrumbLabel}</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    <PageHeader title={pageMeta.heading || 'Stock Signal'} subtitle={pageMeta.subtitle} freshness="Updated monthly" source="AMC monthly portfolio disclosures">
      <div class="mt-4"><SmartMoneySubNav active="stock-signal-hub" /></div>
    </PageHeader>
  </section>

  <section class="container-wide pb-12">
    <StockSignalPage client:load>
      <div slot="fallback" class="py-12 text-center text-sm text-surface-500 dark:text-surface-400">Loading Stock Signal…</div>
    </StockSignalPage>
  </section>

</BaseLayout>
