---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import StockSignalPage from '../../../../components/funds/StockSignalPage.tsx';
import SmartMoneySubNav from '../../../../components/funds/SmartMoneySubNav.astro';
import PageHeader from '../../../../components/layout/PageHeader.astro';
import SmartMoneyInternalLinks from '../../../../components/funds/SmartMoneyInternalLinks.astro';
import { getStockSignalPageMeta, stockSignalPath } from '../../../../lib/stock-signal-meta';
import {
  SMART_MONEY_LIST_BACK,
  stockSignalDetailBackNav,
} from '../../../../lib/list-back-nav';
import ListBackLink from '../../../../components/ListBackLink.astro';
import { BRAND_URL } from '../../../../lib/brand';
import { loadSmartMoneyStockSlugs } from '../../../../lib/smart-money-stock-slugs';
import { loadSmartMoneyTrackerLinks } from '../../../../lib/smart-money-tracker-links';
import {
  readSignalsIndexFromDisk,
  SIGNALS_INDEX_PUBLIC_PATH,
  signalSearchPublicUrl,
} from '../../../../lib/smart-money-signals-server';
import { getCuratedInvestorsForStock, getOnePercentHoldersForStock } from '../../../../lib/tracked-entities';
import StockCrossLinks from '../../../../components/tracked/StockCrossLinks.astro';

export function getStaticPaths() {
  const stocks = loadSmartMoneyStockSlugs();
  if (!stocks.length) {
    return [{ params: { slug: '_placeholder' }, props: { stockSlug: '_placeholder', stockName: 'Stock' } }];
  }
  return stocks.map(({ slug, stockName }) => ({
    params: { slug },
    props: { stockSlug: slug, stockName },
  }));
}

const { stockSlug, stockName } = Astro.props;
const isPlaceholder = stockSlug === '_placeholder';
const pageMeta = isPlaceholder
  ? getStockSignalPageMeta()
  : getStockSignalPageMeta(stockName, stockSlug);
const sm = loadSmartMoneyTrackerLinks();
const defaultBack = stockSignalDetailBackNav(isPlaceholder ? undefined : stockName, isPlaceholder ? undefined : stockSlug);
const smBackVariants = Object.fromEntries(
  Object.entries(SMART_MONEY_LIST_BACK).filter(([key]) => key !== 'stock-signal'),
);
const signalsIndex = readSignalsIndexFromDisk();
const latestMonth = signalsIndex?.months[0];

const onePercentHolders = isPlaceholder ? [] : await getOnePercentHoldersForStock(stockSlug);
const curatedInvestors = onePercentHolders
  .filter((h) => h.entitySlug)
  .map((h) => ({ slug: h.entitySlug!, name: h.holderName, pct: h.pctOfCompany }));
const latestQuarter = onePercentHolders[0]?.quarter ?? null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageMeta.heading || stockName,
  description: pageMeta.description,
  url: `${BRAND_URL}${pageMeta.path}`,
};
---

<BaseLayout
  title={pageMeta.title}
  description={pageMeta.description}
  canonicalUrl={`${BRAND_URL}${pageMeta.path}`}
  ogImage="/og-fund.png"
  jsonLd={jsonLd}
>
  {!isPlaceholder && (
    <>
      <link slot="head" rel="preload" href={SIGNALS_INDEX_PUBLIC_PATH} as="fetch" crossorigin />
      {latestMonth && (
        <link slot="head" rel="preload" href={signalSearchPublicUrl(latestMonth)} as="fetch" crossorigin />
      )}
    </>
  )}

  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href={sm.hub} class="hover:text-primary-600 transition-colors">Smart Money</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href={stockSignalPath()} class="hover:text-primary-600 transition-colors">Stock Signal</a></li>
      {!isPlaceholder && (
        <>
          <li><span class="mx-1">/</span></li>
          <li class="text-surface-900 dark:text-white font-medium">{stockName}</li>
        </>
      )}
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-4">
    {!isPlaceholder && (
      <ListBackLink
        id="stock-signal-detail-back"
        defaultHref={defaultBack.href}
        defaultLabel={defaultBack.label}
        variants={smBackVariants}
        class="text-sm text-primary-600 dark:text-primary-400 hover:underline mb-3 inline-flex items-center gap-1"
      />
    )}
    <PageHeader title={pageMeta.heading || stockName} subtitle={pageMeta.subtitle} freshness="Updated monthly" source="AMC monthly portfolio disclosures">
      {!isPlaceholder && <div class="mt-4"><SmartMoneySubNav active="stock-signal-hub" /></div>}
    </PageHeader>
  </section>

  {!isPlaceholder && (
    <StockCrossLinks
      stockName={stockName}
      stockSlug={stockSlug}
      curatedInvestors={curatedInvestors}
      showMfStockSignal={false}
      showOnePercentClub={onePercentHolders.length > 0}
      latestQuarter={latestQuarter}
    />
  )}

  <section class="container-wide pb-12">
    {isPlaceholder ? (
      <div class="text-center py-12 text-surface-500 text-sm">
        <p>Run <code class="text-xs bg-surface-100 dark:bg-surface-800 px-1 rounded">npm run export:client-data</code> to generate stock signal pages.</p>
        <ListBackLink
          id="stock-signal-detail-back-placeholder"
          defaultHref={stockSignalPath()}
          defaultLabel="Back to Stock Signal"
          variants={smBackVariants}
          class="text-primary-600 mt-2 inline-flex"
        />
      </div>
    ) : (
      <StockSignalPage client:load initialStockSlug={stockSlug}>
        <div slot="fallback" class="py-12 text-center text-sm text-surface-500 dark:text-surface-400">Loading Stock Signal…</div>
      </StockSignalPage>
    )}
  </section>

  {!isPlaceholder && (
    <section class="container-wide pb-12">
      <h2 class="text-sm font-bold text-surface-900 dark:text-white mb-2">More Smart Money</h2>
      <SmartMoneyInternalLinks variant="inline" showHub={false} showTabs={false} monthNote={false} />
    </section>
  )}
</BaseLayout>
