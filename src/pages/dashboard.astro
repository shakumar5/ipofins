---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioTracker from '../components/dashboard/PortfolioTracker.tsx';
import Watchlist from '../components/dashboard/Watchlist.tsx';
---

<BaseLayout title="Investment Dashboard - Portfolio & Watchlist | IPOfins" description="Your personalized investment dashboard. Track portfolio, manage watchlist, and get AI-powered insights.">
  <section class="container-wide py-8">
    <!-- Welcome Header -->
    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl lg:text-3xl font-extrabold text-surface-900 dark:text-white">Dashboard</h1>
        <p class="text-surface-500 dark:text-surface-400 mt-1">Welcome back! Here's your investment overview.</p>
      </div>
      <div class="flex items-center gap-3">
        <span class="badge bg-primary-50 dark:bg-primary-900/30 text-primary-600 dark:text-primary-400 px-3 py-1">Pro Plan</span>
      </div>
    </div>

    <!-- AI Daily Brief -->
    <div class="card border-primary-100 dark:border-primary-900/50 bg-gradient-to-br from-primary-50/50 to-white dark:from-primary-950/20 dark:to-surface-800 mb-8">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white mb-1">AI Daily Brief — June 5, 2026</h3>
          <p class="text-sm text-surface-600 dark:text-surface-300">
            Good morning! Your portfolio is up 2.3% this week. CMR Green Technologies IPO closes today with 8.5x subscription — strong institutional interest suggests good listing. 
            Hexagon Nutrition is tracking well at 3.2x. Consider the healthcare sector tailwinds.
          </p>
          <div class="flex items-center gap-4 mt-3">
            <span class="text-xs text-success-500 font-medium">↑ Portfolio +₹7,240 today</span>
            <span class="text-xs text-primary-500 font-medium">2 IPOs closing this week</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Portfolio (2/3 width) -->
      <div class="lg:col-span-2">
        <h2 class="section-title mb-4">Portfolio Tracker</h2>
        <PortfolioTracker client:load />
      </div>

      <!-- Sidebar (1/3 width) -->
      <div>
        <h2 class="section-title mb-4">Watchlist & Alerts</h2>
        <Watchlist client:load />
      </div>
    </div>
  </section>
</BaseLayout>
