---
import BaseLayout from '../layouts/BaseLayout.astro';
import PortfolioTracker from '../components/dashboard/PortfolioTracker.tsx';
import Watchlist from '../components/dashboard/Watchlist.tsx';

const today = new Date().toLocaleDateString('en-IN', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Kolkata',
});
---

<BaseLayout title="Investment Dashboard - Portfolio & Watchlist | IPOFins" description="Preview dashboard with sample portfolio and watchlist data stored locally in your browser. Not connected to live brokerage accounts." robots="noindex, nofollow">
  <section class="container-wide py-8">
    <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/30 px-4 py-3 text-sm text-amber-900 dark:text-amber-200">
      <strong>Preview only.</strong> This dashboard uses sample data and browser localStorage. It is not linked to your demat or mutual fund accounts. No login or paid plan is required.
    </div>

    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-2xl lg:text-3xl font-extrabold text-surface-900 dark:text-white">Dashboard</h1>
        <p class="text-surface-500 dark:text-surface-400 mt-1">Sample portfolio overview — {today}</p>
      </div>
      <span class="badge bg-surface-100 dark:bg-surface-700 text-surface-600 dark:text-surface-300 px-3 py-1">Demo</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2">
        <h2 class="section-title mb-4">Portfolio Tracker</h2>
        <PortfolioTracker client:idle />
      </div>
      <div>
        <h2 class="section-title mb-4">Watchlist & Alerts</h2>
        <Watchlist client:idle />
      </div>
    </div>
  </section>
</BaseLayout>
