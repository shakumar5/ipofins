---
import BaseLayout from '../layouts/BaseLayout.astro';
import AdUnit from '../components/AdUnit.astro';
import ToolCard from '../components/ToolCard.astro';
import PlatformFeatureCard from '../components/home/PlatformFeatureCard.astro';
import toolsData from '../data/tools.json';
import { getAllIPOs } from '../lib/data/ipos';
import { getHoldingsStats } from '../lib/data/funds';
import { withCorrectStatuses } from '../utils/ipo-status';
import { BRAND_NAME } from '../lib/brand';
import { loadSmartMoneyTrackerLinks } from '../lib/smart-money-tracker-links';

const sm = loadSmartMoneyTrackerLinks();
const iposData = withCorrectStatuses(await getAllIPOs());
const liveIPOs = iposData.filter(ipo => ipo.status === 'live');
const featuredLiveIPOs = [...liveIPOs]
  .sort((a, b) => (a.type === 'mainboard' ? -1 : 1) - (b.type === 'mainboard' ? -1 : 1))
  .slice(0, 3);

const { amcCount, fundsCovered } = await getHoldingsStats();

const featuredToolSlugs = [
  'sip-calculator',
  'ipo-profit-calculator',
  'lumpsum-calculator',
  'fd-calculator',
  'tax-calculator',
  'retirement-calculator',
];
const featuredTools = featuredToolSlugs
  .map(slug => toolsData.find(tool => tool.slug === slug))
  .filter(Boolean);

const ipoQuickLinks = [
  { label: 'Mainboard IPOs', href: '/ipo/mainboard' },
  { label: 'SME IPOs', href: '/ipo/sme' },
  { label: 'Upcoming IPOs', href: '/ipo/upcoming' },
  { label: 'IPO Subscription', href: '/ipo/subscription-status' },
  { label: 'IPO Allotment', href: '/ipo/allotment-status' },
  { label: 'IPO Performance', href: '/ipo/performance/2026' },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": BRAND_NAME,
      "url": "https://ipofins.com",
      "description": "Financial intelligence platform for IPO analytics, mutual fund smart money tracking, portfolio overlap, and free investment tools for Indian investors.",
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://ipofins.com/search?q={search_term_string}"
        },
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "Organization",
      "name": BRAND_NAME,
      "url": "https://ipofins.com",
      "logo": "https://ipofins.com/favicon.svg",
      "description": "IPO analytics, mutual fund holdings tracking, smart money signals, and investment planning tools for Indian investors.",
      "sameAs": ["https://x.com/ipofins", "https://youtube.com/@ipofins"]
    },
    {
      "@type": "ItemList",
      "name": "IPOFins Platform Features",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Smart Money Tracker", "url": "https://ipofins.com/mutual-funds/smart-money" },
        { "@type": "ListItem", "position": 2, "name": "Mutual Fund Holdings Changes", "url": "https://ipofins.com/mutual-funds/mutual-fund-holdings-changes" },
        { "@type": "ListItem", "position": 3, "name": "Stock Signal", "url": "https://ipofins.com/mutual-funds/smart-money/stock-signal" },
        { "@type": "ListItem", "position": 4, "name": "Sector Intelligence", "url": "https://ipofins.com/mutual-funds/smart-money/sector-intelligence" },
        { "@type": "ListItem", "position": 5, "name": "Portfolio Overlap Checker", "url": "https://ipofins.com/mutual-funds/portfolio-overlap-checker" },
        { "@type": "ListItem", "position": 6, "name": "IPO Performance", "url": "https://ipofins.com/ipo/performance/2026" }
      ]
    }
  ]
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is IPOFins?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "IPOFins is a free financial intelligence platform for Indian investors. It tracks IPOs, mutual fund portfolio changes from official AMC disclosures, smart money signals, sector rotation, and offers free investment planning tools — no login required."
      }
    },
    {
      "@type": "Question",
      "name": "What is Smart Money Tracker on IPOFins?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Smart Money Tracker aggregates month-on-month mutual fund holdings changes across AMCs to show which stocks are most bought, most sold, freshly entered, or completely exited — giving you a view of what fund managers are doing industry-wide."
      }
    },
    {
      "@type": "Question",
      "name": "Is IPOFins free to use?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. IPOFins is completely free with no login, no premium plans, and no paywalls. All tools run in your browser and we do not store personal data."
      }
    },
    {
      "@type": "Question",
      "name": "Where does IPOFins get its data?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Data is sourced from official public disclosures — AMFI for mutual fund NAVs and portfolios, SEBI/NSE/BSE for IPO information, and AMC monthly portfolio statements for holdings changes."
      }
    }
  ]
};
---

<BaseLayout
  title="IPOFins - IPO Analytics, Smart Money Tracker & Mutual Fund Tools India"
  description="Track what mutual funds are buying, analyze IPOs, check portfolio overlap, and plan investments with free SIP and tax tools. Data-driven research for Indian investors — no login required."
  jsonLd={jsonLd}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-surface-200/80 dark:border-surface-800">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-50/80 via-white to-surface-50 dark:from-surface-950 dark:via-surface-900 dark:to-primary-950/20"></div>
    <div class="absolute top-0 right-0 w-[480px] h-[480px] bg-primary-200/20 dark:bg-primary-500/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>

    <div class="relative container-wide py-14 lg:py-20">
      <div class="home-hero-grid">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-white/80 dark:bg-surface-800/80 backdrop-blur border border-surface-200 dark:border-surface-700 rounded-full mb-6">
            <span class="w-2 h-2 bg-success-500 rounded-full animate-pulse-subtle"></span>
            <span class="text-xs font-semibold text-surface-600 dark:text-surface-300">Free · No login · Official data</span>
          </div>

          <h1 class="text-4xl lg:text-[2.75rem] font-extrabold text-surface-900 dark:text-white tracking-tighter leading-[1.1]">
            IPO &amp; Mutual Fund Intelligence<br />
            <span class="text-gradient">for Indian Investors</span>
          </h1>
          <p class="mt-5 text-lg text-surface-600 dark:text-surface-300 max-w-xl leading-relaxed">
            See what funds are buying and track every IPO. IPOFins turns SEBI &amp; AMFI disclosures into actionable intelligence — smart money signals, holdings changes, sector rotation, and IPO analytics.
          </p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a href={sm.hub} class="btn-primary px-6 py-3 text-base">
              Smart Money Tracker
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
            <a href="/ipo" class="btn-secondary px-6 py-3 text-base">
              {liveIPOs.length > 0 ? `${liveIPOs.length} Live IPOs` : 'Browse IPOs'}
            </a>
          </div>

          <div class="mt-6 nav-btn-group">
            <a href={sm.mostBought} class="btn-secondary px-6 py-3">Most Bought Stocks</a>
            <a href={sm.stockSignal} class="btn-secondary px-6 py-3">Stock Signal</a>
            <a href="/mutual-funds/portfolio-overlap-checker" class="btn-secondary px-6 py-3">Portfolio Overlap</a>
            <a href="/mutual-funds/best" class="btn-secondary px-6 py-3">Best Funds</a>
            <a href="/broker/compare" class="btn-secondary px-6 py-3">Compare Brokers</a>
            <a href="/learn" class="btn-secondary px-6 py-3">Learn</a>
            <a href="/blogs" class="btn-secondary px-6 py-3">Guides & FAQs</a>
          </div>

          <p class="mt-5 text-xs text-surface-500 dark:text-surface-400">
            Not investment advice. Data from AMFI, SEBI, NSE &amp; BSE.{' '}
            <a href="/methodology" class="text-primary-600 dark:text-primary-400 hover:underline font-medium">Methodology →</a>
          </p>
        </div>

        <!-- Stats bento -->
        <div class="home-stat-bento">
          <a href="/ipo" class="card-compact lg:col-span-1 hover:shadow-md transition-shadow">
            <p class="text-3xl font-extrabold text-surface-900 dark:text-white tabular-nums">{iposData.length}</p>
            <p class="text-xs font-medium text-surface-500 dark:text-surface-400 mt-1">IPOs Tracked</p>
          </a>
          <a href="/ipo" class="card-compact border-success-500/30 bg-success-50/50 dark:bg-success-500/5 hover:shadow-md transition-shadow">
            <p class="text-3xl font-extrabold text-success-600 tabular-nums">{liveIPOs.length}</p>
            <p class="text-xs font-medium text-surface-500 dark:text-surface-400 mt-1">Live Now</p>
          </a>
          <a href="/mutual-funds/all" class="card-compact hover:shadow-md transition-shadow">
            <p class="text-3xl font-extrabold text-primary-600 dark:text-primary-400 tabular-nums">{fundsCovered}+</p>
            <p class="text-xs font-medium text-surface-500 dark:text-surface-400 mt-1">Funds with Holdings</p>
          </a>
          <a href="/tools" class="card-compact hover:shadow-md transition-shadow">
            <p class="text-3xl font-extrabold text-surface-900 dark:text-white tabular-nums">{toolsData.length}</p>
            <p class="text-xs font-medium text-surface-500 dark:text-surface-400 mt-1">Finance Tools</p>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform features — unique to IPOFins -->
  <section class="container-wide py-12 lg:py-16">
    <div class="max-w-2xl mb-8">
      <h2 class="section-title">Built for Indian Investors</h2>
      <p class="section-subtitle">Tools you won't find on generic finance sites — powered by official AMC &amp; exchange disclosures.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <PlatformFeatureCard
        title="Smart Money Tracker"
        description={`Industry-wide stock activity from ${amcCount} AMCs — most bought, sold, fresh entries & complete exits each month.`}
        href={sm.hub}
        badge="Core"
        icon="💡"
        accent="success"
      />
      <PlatformFeatureCard
        title="Holdings Changes"
        description="Month-on-month portfolio diffs per AMC — see additions, removals, and weight shifts fund by fund."
        href={sm.holdingsChanges}
        badge="Deep dive"
        icon="📋"
        accent="primary"
      />
      <PlatformFeatureCard
        title="Stock Signal"
        description="Per-stock conviction scores from aggregated fund manager activity — searchable across 900+ stocks."
        href={sm.stockSignal}
        badge="900+ stocks"
        icon="📡"
        accent="primary"
      />
      <PlatformFeatureCard
        title="Sector Intelligence"
        description="Where smart money is rotating — Banking, IT, Healthcare, Capital Markets and more, updated monthly."
        href={sm.sectorIntelligence}
        badge="Monthly"
        icon="🌐"
        accent="success"
      />
      <PlatformFeatureCard
        title="Portfolio Overlap"
        description="Check how much your mutual funds overlap before you unknowingly double up on the same holdings."
        href="/mutual-funds/portfolio-overlap-checker"
        badge="Free tool"
        icon="🔗"
        accent="warning"
      />
      <PlatformFeatureCard
        title="IPO Performance"
        description="Listing gains, subscription trends, and year-wise IPO returns for mainboard and SME issues."
        href="/ipo/performance/2026"
        badge="Analytics"
        icon="📈"
        accent="primary"
      />
    </div>
  </section>

  <!-- Live IPOs — compact -->
  {featuredLiveIPOs.length > 0 && (
    <section class="container-wide py-6 lg:py-8">
      <div class="flex items-end justify-between mb-5">
        <div>
          <h2 class="section-title flex items-center gap-2">
            <span class="w-2.5 h-2.5 bg-success-500 rounded-full animate-pulse-subtle"></span>
            Live IPOs — Apply Now
          </h2>
          <p class="section-subtitle">Currently open for subscription</p>
        </div>
        <a href="/ipo" class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 transition-colors hidden sm:inline-flex items-center gap-1">
          All IPOs
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>

      <div class="home-ipo-strip">
        {featuredLiveIPOs.map(ipo => (
          <a href={`/ipo/${ipo.slug}`} class="home-ipo-pill group">
            <div class="min-w-0">
              <p class="text-sm font-semibold text-surface-900 dark:text-white truncate group-hover:text-primary-600 transition-colors">{ipo.name}</p>
              <p class="text-xs text-surface-500 mt-0.5">{ipo.type} · {ipo.openDate} – {ipo.closeDate}</p>
            </div>
            <div class="text-right flex-shrink-0">
              <p class="text-sm font-bold text-surface-900 dark:text-white">₹{ipo.priceRange}</p>
              {ipo.subscription && <p class="text-xs text-primary-600 font-semibold">{ipo.subscription}x subscribed</p>}
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- IPO quick links — SEO internal linking -->
  <section class="container-wide py-6">
    <h2 class="text-sm font-semibold text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-4">IPO Hub</h2>
    <div class="nav-btn-group">
      {ipoQuickLinks.map(link => (
        <a href={link.href} class="btn-secondary px-6 py-3">{link.label}</a>
      ))}
      <a href="/ipo" class="btn-primary px-6 py-3">All IPOs →</a>
    </div>
  </section>

  <!-- Featured tools — not the full list -->
  <section class="container-wide py-10 lg:py-12">
    <div class="flex items-end justify-between mb-8">
      <div>
        <h2 class="section-title">Popular Tools</h2>
        <p class="section-subtitle">Free tools that run in your browser — no data stored</p>
      </div>
      <a href="/tools" class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:text-primary-700 transition-colors hidden sm:inline-flex items-center gap-1">
        All {toolsData.length} tools
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {featuredTools.map(tool => (
        <ToolCard
          title={tool!.title}
          description={tool!.description}
          href={`/tools/${tool!.slug}`}
          icon={tool!.icon}
          color={tool!.color}
        />
      ))}
    </div>
  </section>

  <section class="container-wide py-8 lg:py-10" aria-label="Sponsored">
    <p class="text-sm text-surface-600 dark:text-surface-300 max-w-2xl mb-6 leading-relaxed">
      IPOFins is built for long-term Indian investors — from tracking AMC portfolio changes to planning SIPs and comparing brokers. Explore the guides below or browse our full tool library.
    </p>
    <AdUnit slot="3456789012" format="auto" />
  </section>

  <!-- FAQ — SEO -->
  <section class="container-wide py-10 lg:py-12">
    <h2 class="section-title mb-6">Frequently Asked Questions</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-5xl">
      <div class="card-compact">
        <h3 class="font-semibold text-surface-900 dark:text-white text-sm">What is IPOFins?</h3>
        <p class="mt-2 text-sm text-surface-500 dark:text-surface-400 leading-relaxed">A free platform for Indian investors covering IPO analytics, mutual fund smart money tracking, portfolio overlap, and investment planning — built on official AMFI &amp; SEBI disclosures.</p>
      </div>
      <div class="card-compact">
        <h3 class="font-semibold text-surface-900 dark:text-white text-sm">What is Smart Money Tracker?</h3>
        <p class="mt-2 text-sm text-surface-500 dark:text-surface-400 leading-relaxed">It aggregates holdings changes across AMCs to reveal which stocks funds are buying, selling, entering, or exiting — giving you a fund-manager-level view of the market. <a href={sm.hub} class="font-medium text-primary-700 dark:text-primary-300 underline underline-offset-2">Explore →</a></p>
      </div>
      <div class="card-compact">
        <h3 class="font-semibold text-surface-900 dark:text-white text-sm">Is IPOFins free?</h3>
        <p class="mt-2 text-sm text-surface-500 dark:text-surface-400 leading-relaxed">Yes — no login, no premium plans, no paywalls. Tools run entirely in your browser and we don't store personal data.</p>
      </div>
      <div class="card-compact">
        <h3 class="font-semibold text-surface-900 dark:text-white text-sm">Where does the data come from?</h3>
        <p class="mt-2 text-sm text-surface-500 dark:text-surface-400 leading-relaxed">AMFI for NAVs &amp; portfolios, SEBI/NSE/BSE for IPOs, and AMC monthly portfolio statements for holdings changes. <a href="/methodology" class="font-medium text-primary-700 dark:text-primary-300 underline underline-offset-2">Read methodology →</a></p>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="container-wide pb-14">
    <div class="rounded-2xl border border-surface-200 dark:border-surface-700 bg-surface-50 dark:bg-surface-800/50 px-6 py-5">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-xs text-surface-600 dark:text-surface-300">
          <span class="flex items-center gap-1.5"><span class="text-success-600 dark:text-success-500" aria-hidden="true">✓</span> No login required</span>
          <span class="flex items-center gap-1.5"><span class="text-success-600 dark:text-success-500" aria-hidden="true">✓</span> Zero data storage</span>
          <span class="flex items-center gap-1.5"><span class="text-success-600 dark:text-success-500" aria-hidden="true">✓</span> Official sources only</span>
        </div>
        <a href="/about" class="text-xs font-medium text-primary-700 dark:text-primary-300 hover:text-primary-800 dark:hover:text-primary-200 hover:underline flex-shrink-0">About IPOFins →</a>
      </div>
      <p class="mt-4 text-xs text-surface-600 dark:text-surface-400 leading-relaxed max-w-4xl">
        <strong>Disclaimer:</strong> IPOFins is for informational purposes only. We are not SEBI-registered advisors. Mutual fund investments are subject to market risks. Past performance does not guarantee future returns.
      </p>
    </div>
  </section>
</BaseLayout>
