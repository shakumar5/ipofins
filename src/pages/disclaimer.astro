---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Disclaimer - IPOFins",
  "url": "https://ipofins.com/disclaimer",
};
---

<BaseLayout title="Disclaimer - IPOFins" description="Important disclaimer about IPOFins financial tools and content. Not SEBI registered investment advice." jsonLd={jsonLd}>
  <section class="container-narrow py-16">
    <PageHeader title="Disclaimer" subtitle="Investment in securities market is subject to market risks." />
    <div class="mt-8 space-y-6 text-sm text-surface-600 dark:text-surface-300 leading-relaxed prose prose-surface dark:prose-invert max-w-none">
      <p class="text-base font-medium text-surface-800 dark:text-surface-200">Investment in securities market is subject to market risks. Read all the related documents carefully before investing.</p>
      <h2 class="text-lg font-bold text-surface-900 dark:text-white pt-4">Not Investment Advice</h2>
      <p>IPOFins is not a SEBI-registered Research Analyst or Investment Advisor. The information, tools, and analysis on this website are for educational and informational purposes only. They do not constitute investment advice, recommendations, or solicitation to buy or sell securities.</p>
      <h2 class="text-lg font-bold text-surface-900 dark:text-white pt-4">IPOFins Score Disclaimer</h2>
      <p>IPOFins Scores, risk ratings, and verdicts are quantitative research aids based on available financial and market data. They are not guaranteed to be accurate and should not be the sole basis for investment decisions. Past performance does not guarantee future results.</p>
      <h2 class="text-lg font-bold text-surface-900 dark:text-white pt-4">Data Accuracy</h2>
      <p>While we source data from official channels (AMFI, BSE, NSE), information may be delayed up to 12 hours, incomplete, or contain errors. Always verify with official sources before investing.</p>
      <h2 class="text-lg font-bold text-surface-900 dark:text-white pt-4">IPO Data Sources</h2>
      <p>IPOFins publishes IPO subscription and listing data from authorized exchange and regulatory sources (NSE, BSE, SEBI, AMFI). We do not publish grey market premium (GMP) or other unofficial market indicators.</p>
    </div>
  </section>
</BaseLayout>
