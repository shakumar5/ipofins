---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact Us - ipofins" description="Get in touch with the ipofins team for questions, feedback, or partnership inquiries.">
  <section class="container-narrow py-16">
    <div class="max-w-xl mx-auto text-center">
      <h1 class="text-3xl font-extrabold text-surface-900 dark:text-white">Contact Us</h1>
      <p class="mt-4 text-surface-600 dark:text-surface-300">Have questions, feedback, or partnership inquiries? We'd love to hear from you.</p>
      
      <div class="mt-10 space-y-6 text-left">
        <div class="card">
          <h2 class="font-semibold text-surface-900 dark:text-white mb-2">General Inquiries</h2>
          <p class="text-sm text-surface-600 dark:text-surface-300"><a href="mailto:info@ipofins.com" class="hover:text-primary-600 transition-colors">info@ipofins.com</a></p>
        </div>
        <div class="card">
          <h2 class="font-semibold text-surface-900 dark:text-white mb-2">Advertising & Partnerships</h2>
          <p class="text-sm text-surface-600 dark:text-surface-300"><a href="mailto:info@ipofins.com" class="hover:text-primary-600 transition-colors">info@ipofins.com</a></p>
        </div>
        <div class="card">
          <h2 class="font-semibold text-surface-900 dark:text-white mb-2">Report Data Issues</h2>
          <p class="text-sm text-surface-600 dark:text-surface-300"><a href="mailto:info@ipofins.com" class="hover:text-primary-600 transition-colors">info@ipofins.com</a></p>
        </div>
      </div>

      <p class="mt-8 text-xs text-surface-400 dark:text-surface-500">We typically respond within 24-48 hours on business days.</p>
    </div>
  </section>
</BaseLayout>
