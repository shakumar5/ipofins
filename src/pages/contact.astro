---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import { BRAND_NAME, BRAND_EMAIL } from '../lib/brand';
---

<BaseLayout title={`Contact Us - ${BRAND_NAME}`} description={`Get in touch with the ${BRAND_NAME} team for questions, feedback, or partnership inquiries.`}>
  <section class="container-narrow py-16">
    <div class="max-w-xl mx-auto text-center">
      <PageHeader
        title="Contact Us"
        subtitle="Have questions, feedback, or partnership inquiries? We'd love to hear from you."
      />
      
      <div class="mt-10 space-y-6 text-left">
        <div class="card">
          <h2 class="font-semibold text-surface-900 dark:text-white mb-2">General Inquiries</h2>
          <p class="text-sm text-surface-600 dark:text-surface-300"><a href={`mailto:${BRAND_EMAIL}`} class="hover:text-primary-600 transition-colors">{BRAND_EMAIL}</a></p>
        </div>
        <div class="card">
          <h2 class="font-semibold text-surface-900 dark:text-white mb-2">Advertising & Partnerships</h2>
          <p class="text-sm text-surface-600 dark:text-surface-300"><a href={`mailto:${BRAND_EMAIL}`} class="hover:text-primary-600 transition-colors">{BRAND_EMAIL}</a></p>
        </div>
        <div class="card">
          <h2 class="font-semibold text-surface-900 dark:text-white mb-2">Report Data Issues</h2>
          <p class="text-sm text-surface-600 dark:text-surface-300"><a href={`mailto:${BRAND_EMAIL}`} class="hover:text-primary-600 transition-colors">{BRAND_EMAIL}</a></p>
        </div>
      </div>

      <p class="mt-8 text-xs text-surface-400 dark:text-surface-500">We typically respond within 24-48 hours on business days.</p>
    </div>
  </section>
</BaseLayout>
