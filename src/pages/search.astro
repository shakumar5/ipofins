---
import BaseLayout from '../layouts/BaseLayout.astro';

const query = (Astro.url.searchParams.get('q') || '').trim();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: query ? `Search: ${query}` : 'Search IPOfins',
  url: query
    ? `https://ipofins.com/search?q=${encodeURIComponent(query)}`
    : 'https://ipofins.com/search',
  isPartOf: {
    '@type': 'WebSite',
    name: 'IPOfins',
    url: 'https://ipofins.com',
  },
};
---

<BaseLayout
  title={query ? `Search: ${query} | IPOfins` : 'Search IPOfins'}
  description="Search IPOs, mutual funds, brokers, tools, and guides on IPOfins."
  robots="noindex, follow"
  jsonLd={jsonLd}
>
  <section class="container-narrow py-12">
    <h1 class="text-2xl font-extrabold text-surface-900 dark:text-white">Search IPOfins</h1>
    <p class="mt-2 text-sm text-surface-500 dark:text-surface-400">
      Find IPOs, mutual funds, brokers, calculators, and guides.
    </p>

    <form class="mt-6" role="search" action="/search" method="get">
      <label for="site-search" class="sr-only">Search query</label>
      <div class="flex gap-2">
        <input
          id="site-search"
          name="q"
          type="search"
          value={query}
          placeholder="Search IPOs, mutual funds, brokers, tools..."
          class="flex-1 px-4 py-3 rounded-lg border border-surface-200 dark:border-surface-700 bg-white dark:bg-surface-800 text-surface-900 dark:text-white text-sm outline-none focus:ring-2 focus:ring-primary-500"
          autocomplete="off"
          autofocus
        />
        <button type="submit" class="btn-primary px-5 py-3 text-sm">Search</button>
      </div>
    </form>

    <div id="search-page-results" class="mt-6 space-y-2" aria-live="polite">
      {query ? (
        <p class="text-sm text-surface-500 dark:text-surface-400">Loading results for “{query}”…</p>
      ) : (
        <p class="text-sm text-surface-500 dark:text-surface-400">
          Enter a search term above, or press <kbd class="px-1.5 py-0.5 rounded bg-surface-100 dark:bg-surface-800 text-xs">Ctrl+K</kbd> anywhere on the site.
        </p>
      )}
    </div>
  </section>

  <script is:inline define:vars={{ initialQuery: query }}>
    (function () {
      var container = document.getElementById('search-page-results');
      var input = document.getElementById('site-search');
      if (!container) return;

      var catColors = {
        IPO: 'bg-green-50 text-green-700 dark:bg-green-900/30 dark:text-green-400',
        Fund: 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
        Broker: 'bg-purple-50 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400',
        Tool: 'bg-orange-50 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400',
        Learn: 'bg-yellow-50 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400',
        Page: 'bg-surface-100 text-surface-700 dark:bg-surface-800 dark:text-surface-300',
      };

      function isSafePath(path) {
        return typeof path === 'string' && path.charAt(0) === '/' && path.indexOf('://') === -1;
      }

      function score(item, q) {
        var text = (item.t + ' ' + (item.k || '') + ' ' + (item.m || '')).toLowerCase();
        var lower = q.toLowerCase();
        if (item.t.toLowerCase() === lower) return 100;
        if (item.t.toLowerCase().indexOf(lower) === 0) return 80;
        if (text.indexOf(lower) !== -1) return 50;
        var words = lower.split(/\s+/);
        var hits = 0;
        for (var i = 0; i < words.length; i++) {
          if (words[i].length > 1 && text.indexOf(words[i]) !== -1) hits++;
        }
        return hits > 0 ? 20 + hits * 5 : 0;
      }

      function render(items, q) {
        container.textContent = '';
        if (!q) return;
        if (!items.length) {
          var empty = document.createElement('p');
          empty.className = 'text-sm text-surface-500 dark:text-surface-400 py-4';
          empty.textContent = 'No results for “' + q + '”. Try IPO names, fund categories, or tool names.';
          container.appendChild(empty);
          return;
        }
        items.slice(0, 30).forEach(function (item) {
          if (!isSafePath(item.u)) return;
          var a = document.createElement('a');
          a.href = item.u;
          a.className =
            'block card-compact hover:border-primary-300 dark:hover:border-primary-700 transition-colors';
          var row = document.createElement('div');
          row.className = 'flex items-start justify-between gap-3';
          var left = document.createElement('div');
          var title = document.createElement('p');
          title.className = 'text-sm font-semibold text-surface-900 dark:text-white';
          title.textContent = item.t;
          left.appendChild(title);
          if (item.m) {
            var meta = document.createElement('p');
            meta.className = 'text-xs text-surface-500 dark:text-surface-400 mt-0.5';
            meta.textContent = item.m;
            left.appendChild(meta);
          }
          row.appendChild(left);
          var badge = document.createElement('span');
          badge.className =
            'badge text-[10px] flex-shrink-0 ' + (catColors[item.y] || catColors.Page);
          badge.textContent = item.y || 'Page';
          row.appendChild(badge);
          a.appendChild(row);
          container.appendChild(a);
        });
      }

      function runSearch(q) {
        if (!q) return;
        fetch('/data/search-index.json')
          .then(function (r) {
            if (!r.ok) throw new Error('fetch failed');
            return r.json();
          })
          .then(function (data) {
            var results = data
              .map(function (item) {
                return { item: item, s: score(item, q) };
              })
              .filter(function (x) {
                return x.s > 0;
              })
              .sort(function (a, b) {
                return b.s - a.s;
              })
              .map(function (x) {
                return x.item;
              });
            render(results, q);
          })
          .catch(function () {
            container.textContent = '';
            var err = document.createElement('p');
            err.className = 'text-sm text-danger-600 dark:text-danger-400';
            err.textContent = 'Search is temporarily unavailable. Please try again.';
            container.appendChild(err);
          });
      }

      if (initialQuery) runSearch(initialQuery);
      if (input) {
        input.addEventListener('input', function () {
          var q = input.value.trim();
          if (q.length >= 2) runSearch(q);
        });
      }
    })();
  </script>
</BaseLayout>
