---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import { BRAND_NAME } from '../../lib/brand';
import brokersData from '../../data/brokers.json';

export function getStaticPaths() {
  return brokersData.map(broker => ({
    params: { slug: broker.slug },
    props: { broker },
  }));
}

const { broker } = Astro.props;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Review",
  "name": `${broker.name} Review 2026`,
  "description": `Detailed review of ${broker.name} - trading fees, platforms, features, pros and cons.`,
  "url": `https://ipofins.com/broker/${broker.slug}`,
  "author": {
    "@type": "Organization",
    "name": BRAND_NAME,
  },
  "itemReviewed": {
    "@type": "Organization",
    "name": broker.name,
  },
  "reviewRating": {
    "@type": "Rating",
    "ratingValue": broker.rating,
    "bestRating": 5
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Brokers", "item": "https://ipofins.com/broker" },
      { "@type": "ListItem", "position": 3, "name": broker.name, "item": `https://ipofins.com/broker/${broker.slug}` }
    ]
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": `Is ${broker.name} safe to use?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${broker.name} is registered with SEBI (Securities and Exchange Board of India) and is a member of BSE and NSE. Client funds are kept in segregated accounts. However, like all brokers, it is subject to market and operational risks. Always verify SEBI registration before opening an account.`
      }
    },
    {
      "@type": "Question",
      "name": `What are ${broker.name}'s charges for delivery and intraday?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${broker.name} charges ${broker.tradingFee} per trade. Account opening fee is ${broker.accountOpening} and annual maintenance charge (AMC) is ${broker.amc}. Additional statutory charges like STT, GST, stamp duty, and exchange transaction charges apply as per government regulations.`
      }
    },
    {
      "@type": "Question",
      "name": `How to open account with ${broker.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `You can open a ${broker.name} account online in 10-15 minutes. You'll need: PAN card, Aadhaar card (linked to mobile), bank account details, and a selfie/signature. The process is paperless with e-KYC verification through Aadhaar OTP or DigiLocker.`
      }
    },
    {
      "@type": "Question",
      "name": `Can I trade IPOs on ${broker.name}?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `Yes, you can apply for IPOs through ${broker.name} using the UPI-based ASBA (Application Supported by Blocked Amount) process. Your funds remain in your bank account until allotment. ${broker.name} provides IPO application facility through their trading app.`
      }
    },
    {
      "@type": "Question",
      "name": `What is ${broker.name}'s customer support like?`,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": `${broker.name} offers customer support through multiple channels including email, phone, and in-app chat. Response times vary based on query complexity. For urgent trading issues, phone support is recommended. Check their website for current support hours and contact details.`
      }
    }
  ]
};
---

<BaseLayout
  title={`${broker.name} Review 2026 - Fees, Features & Verdict`}
  description={`${broker.name} review: ${broker.tradingFee} brokerage, ${broker.accountOpening} account opening, rated ${broker.rating}/5. Complete analysis of features, pros, cons and platforms.`}
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/broker" class="hover:text-primary-600 transition-colors">Brokers</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">{broker.name}</li>
    </ol>
  </nav>

  <!-- Header -->
  <section class="container-wide pt-8 pb-6">
    <PageHeader title={broker.name} subtitle={`${broker.rating}/5 rating · ${broker.type} broker`}>
    <div class="flex items-center gap-4 mt-4">
      <div class="w-16 h-16 bg-gradient-to-br from-primary-500 to-primary-700 rounded-2xl flex items-center justify-center">
        <span class="text-white font-bold text-2xl">{broker.logo}</span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-warning-500 text-lg">★</span>
          <span class="font-semibold text-surface-700 dark:text-surface-300">{broker.rating}/5</span>
          <span class="badge bg-surface-100 dark:bg-surface-700 text-surface-600 dark:text-surface-300 capitalize">{broker.type}</span>
        </div>
      </div>
    </div>
    </PageHeader>
  </section>

  <!-- Key Metrics -->
  <section class="container-wide py-6">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500 dark:text-surface-400">Trading Fee</p>
        <p class="text-lg font-bold text-surface-900 dark:text-white mt-1">{broker.tradingFee}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500 dark:text-surface-400">Account Opening</p>
        <p class="text-lg font-bold text-surface-900 dark:text-white mt-1">{broker.accountOpening}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500 dark:text-surface-400">AMC</p>
        <p class="text-lg font-bold text-surface-900 dark:text-white mt-1">{broker.amc}</p>
      </div>
      <div class="card-compact text-center">
        <p class="text-xs text-surface-500 dark:text-surface-400">Rating</p>
        <p class="text-lg font-bold text-warning-500 mt-1">★ {broker.rating}</p>
      </div>
    </div>
  </section>

  <!-- Platforms -->
  <section class="container-wide py-6">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Trading Platforms</h2>
    <div class="flex flex-wrap gap-3">
      {broker.platforms.map(platform => (
        <div class="card-compact flex items-center gap-2">
          <svg class="w-4 h-4 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span class="text-sm font-medium text-surface-700 dark:text-surface-300">{platform}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Pros & Cons -->
  <section class="container-wide py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card">
        <h3 class="text-lg font-bold text-success-500 mb-4">✓ Pros</h3>
        <ul class="space-y-3">
          {broker.pros.map(pro => (
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-success-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-sm text-surface-700 dark:text-surface-300">{pro}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="card">
        <h3 class="text-lg font-bold text-danger-500 mb-4">✕ Cons</h3>
        <ul class="space-y-3">
          {broker.cons.map(con => (
            <li class="flex items-start gap-2">
              <svg class="w-5 h-5 text-danger-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              <span class="text-sm text-surface-700 dark:text-surface-300">{con}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Open Account CTA -->
  <section class="container-wide py-8">
    <div class="card bg-gradient-to-r from-primary-50 to-surface-50 dark:from-primary-950/20 dark:to-surface-800 border-primary-200 dark:border-primary-800 text-center">
      <h3 class="text-xl font-bold text-surface-900 dark:text-white mb-2">Open a {broker.name} Account</h3>
      <p class="text-sm text-surface-600 dark:text-surface-300 mb-4">
        {broker.accountOpening} account opening • {broker.tradingFee} per trade
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3">
        <a href={broker.affiliateUrl} class="btn-primary px-8 py-3" rel="nofollow sponsored">
          Open Account →
        </a>
        <a href={`/broker/compare?broker=${broker.slug}`} class="btn-secondary px-8 py-3">
          Compare Broker
        </a>
      </div>
      <p class="text-xs text-surface-400 dark:text-surface-500 mt-3">
        Affiliate link. We may earn a commission at no extra cost to you.
      </p>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="container-wide py-12">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Is {broker.name} safe to use?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">{broker.name} is registered with SEBI (Securities and Exchange Board of India) and is a member of BSE and NSE. Client funds are kept in segregated accounts as per regulatory requirements. However, like all brokers, it is subject to market and operational risks. Always verify the SEBI registration number before opening an account.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What are {broker.name}'s charges for delivery and intraday?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">{broker.name} charges {broker.tradingFee} per trade. Account opening fee is {broker.accountOpening} and annual maintenance charge (AMC) is {broker.amc}. Additional statutory charges like STT, GST, stamp duty, SEBI turnover fee, and exchange transaction charges apply as per government regulations.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How to open account with {broker.name}?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">You can open a {broker.name} account online in 10-15 minutes. Requirements: PAN card, Aadhaar card (linked to mobile number), bank account details, and a selfie/signature. The process is fully paperless with e-KYC verification through Aadhaar OTP or DigiLocker integration.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Can I trade IPOs on {broker.name}?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Yes, you can apply for IPOs through {broker.name} using the UPI-based ASBA (Application Supported by Blocked Amount) process. Your funds remain in your bank account until allotment is confirmed. {broker.name} provides IPO application facility through their trading app with real-time subscription status updates. See <a href="/ipo" class="text-primary-600 hover:underline">live IPOs</a> and <a href="/ipo/subscription-status" class="text-primary-600 hover:underline">subscription status</a>.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is {broker.name}'s customer support like?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">{broker.name} offers customer support through multiple channels including email, phone, and in-app chat. Response times vary based on query complexity. For urgent trading issues, phone support during market hours is recommended. Check their official website for current support hours and contact details.</p>
      </details>
    </div>
  </section>

  <!-- Related Links -->
  <section class="container-wide py-6 border-t border-surface-200 dark:border-surface-700">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related Pages</h2>
    <div class="nav-btn-group">
      <a href="/broker" class="btn-secondary px-6 py-3">📊 All Brokers</a>
      <a href="/broker/compare" class="btn-secondary px-6 py-3">⚖️ Compare Brokers</a>
      <a href="/ipo" class="btn-secondary px-6 py-3">🚀 Upcoming IPOs</a>
      <a href="/tools/ipo-profit-calculator" class="btn-secondary px-6 py-3">💰 IPO Profit Calculator</a>
      <a href="/mutual-funds/best" class="btn-secondary px-6 py-3">🏆 Best Mutual Funds</a>
      <a href="/learn/best-stock-broker-2026" class="btn-secondary px-6 py-3">📖 Broker Selection Guide</a>
    </div>
  </section>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
</BaseLayout>
