---
import BaseLayout from '../../layouts/BaseLayout.astro';
import brokersData from '../../data/brokers.json';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Best Stock Brokers in India 2026",
  "description": "Compare the best stock brokers in India. Detailed reviews, pricing, features, and side-by-side comparison of discount and full-service brokers.",
  "url": "https://ipofins.com/broker",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Brokers", "item": "https://ipofins.com/broker" }
    ]
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is the difference between a discount broker and a full-service broker?", "acceptedAnswer": { "@type": "Answer", "text": "Discount brokers like Zerodha and Groww charge flat ₹20 per trade regardless of trade size, and offer self-service platforms. Full-service brokers like ICICI Direct provide research reports, dedicated relationship managers, and advisory services but charge higher brokerage (often a percentage of trade value)." } },
    { "@type": "Question", "name": "Which broker is best for beginners in India?", "acceptedAnswer": { "@type": "Answer", "text": "Groww and Zerodha are popular choices for beginners. Groww offers the simplest interface with zero account opening and AMC charges. Zerodha provides comprehensive educational resources through Varsity and a well-designed platform suitable for learning." } },
    { "@type": "Question", "name": "Is my money safe with a discount broker?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. All SEBI-registered brokers (discount or full-service) must follow the same regulations. Your shares are held in your demat account with CDSL/NSDL depositories, not with the broker. Even if a broker shuts down, your holdings remain safe in your demat account." } },
    { "@type": "Question", "name": "Can I apply for IPOs through these brokers?", "acceptedAnswer": { "@type": "Answer", "text": "Yes, all major brokers listed here support IPO applications through UPI-based ASBA. You can apply directly from their apps. Zerodha, Groww, Upstox, and Angel One all have seamless one-click IPO application flows integrated into their platforms." } }
  ]
};

const discountBrokers = brokersData.filter(b => b.type === 'discount');
const fullServiceBrokers = brokersData.filter(b => b.type === 'full-service');
---

<BaseLayout
  title="Best Stock Brokers in India 2026 - Compare & Review | IPOFins"
  description="Compare India's best stock brokers side-by-side. Reviews of Zerodha, Groww, Upstox, Angel One, ICICI Direct with pricing, features, pros & cons."
  jsonLd={jsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- Breadcrumb -->
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Brokers</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <section class="container-wide pt-8 pb-6">
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      Best Stock Brokers in India 2026
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300 max-w-2xl">
      Comprehensive reviews and side-by-side comparison of India's top discount and full-service brokers.
    </p>
  </section>

  <!-- Discount Brokers -->
  <section class="container-wide py-6">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Discount Brokers</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {discountBrokers.map(broker => (
        <a href={`/broker/${broker.slug}`} class="card group block">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-primary-500 to-primary-700 rounded-xl flex items-center justify-center">
              <span class="text-white font-bold text-lg">{broker.logo}</span>
            </div>
            <div>
              <h3 class="font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors">{broker.name}</h3>
              <div class="flex items-center gap-1">
                <span class="text-warning-500">★</span>
                <span class="text-sm text-surface-600 dark:text-surface-300">{broker.rating}</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-3 mb-4">
            <div>
              <p class="text-xs text-surface-500 dark:text-surface-400">Trading Fee</p>
              <p class="text-sm font-semibold text-surface-800 dark:text-surface-200">{broker.tradingFee}</p>
            </div>
            <div>
              <p class="text-xs text-surface-500 dark:text-surface-400">Account</p>
              <p class="text-sm font-semibold text-surface-800 dark:text-surface-200">{broker.accountOpening}</p>
            </div>
            <div>
              <p class="text-xs text-surface-500 dark:text-surface-400">AMC</p>
              <p class="text-sm font-semibold text-surface-800 dark:text-surface-200">{broker.amc}</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {broker.platforms.map(platform => (
              <span class="px-2 py-0.5 text-xs bg-surface-100 dark:bg-surface-700 text-surface-600 dark:text-surface-300 rounded">
                {platform}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Full Service Brokers -->
  <section class="container-wide py-6">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Full-Service Brokers</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {fullServiceBrokers.map(broker => (
        <a href={`/broker/${broker.slug}`} class="card group block">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-surface-600 to-surface-800 rounded-xl flex items-center justify-center">
              <span class="text-white font-bold text-lg">{broker.logo}</span>
            </div>
            <div>
              <h3 class="font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors">{broker.name}</h3>
              <div class="flex items-center gap-1">
                <span class="text-warning-500">★</span>
                <span class="text-sm text-surface-600 dark:text-surface-300">{broker.rating}</span>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-3 mb-4">
            <div>
              <p class="text-xs text-surface-500 dark:text-surface-400">Trading Fee</p>
              <p class="text-sm font-semibold text-surface-800 dark:text-surface-200">{broker.tradingFee}</p>
            </div>
            <div>
              <p class="text-xs text-surface-500 dark:text-surface-400">Account</p>
              <p class="text-sm font-semibold text-surface-800 dark:text-surface-200">{broker.accountOpening}</p>
            </div>
            <div>
              <p class="text-xs text-surface-500 dark:text-surface-400">AMC</p>
              <p class="text-sm font-semibold text-surface-800 dark:text-surface-200">{broker.amc}</p>
            </div>
          </div>

          <div class="flex flex-wrap gap-1.5">
            {broker.platforms.map(platform => (
              <span class="px-2 py-0.5 text-xs bg-surface-100 dark:bg-surface-700 text-surface-600 dark:text-surface-300 rounded">
                {platform}
              </span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Comparison CTA -->
  <section class="container-wide py-8">
    <div class="card bg-gradient-to-r from-surface-50 to-primary-50 dark:from-surface-800 dark:to-primary-950/20 text-center">
      <h3 class="text-lg font-bold text-surface-900 dark:text-white mb-2">Can't decide?</h3>
      <p class="text-sm text-surface-600 dark:text-surface-300 mb-4">Use our comparison tool to see brokers side-by-side</p>
      <a href="/broker/compare" class="btn-primary">Compare Brokers</a>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="container-wide py-12">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is the difference between a discount broker and a full-service broker?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Discount brokers like Zerodha and Groww charge flat ₹20 per trade regardless of trade size, and offer self-service platforms. Full-service brokers like ICICI Direct provide research reports, dedicated relationship managers, and advisory services but charge higher brokerage (often a percentage of trade value).</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Which broker is best for beginners in India?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Groww and Zerodha are popular choices for beginners. Groww offers the simplest interface with zero account opening and AMC charges. Zerodha provides comprehensive educational resources through Varsity and a well-designed platform suitable for learning.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Is my money safe with a discount broker?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Yes. All SEBI-registered brokers (discount or full-service) must follow the same regulations. Your shares are held in your demat account with CDSL/NSDL depositories, not with the broker. Even if a broker shuts down, your holdings remain safe in your demat account.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Can I apply for IPOs through these brokers?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Yes, all major brokers listed here support <a href="/ipo" class="text-primary-600 hover:underline">IPO applications</a> through UPI-based ASBA. You can apply directly from their apps. Zerodha, Groww, Upstox, and Angel One all have seamless one-click IPO application flows integrated into their platforms.</p>
      </details>
    </div>
  </section>

  <!-- Cross-section Links -->
  <section class="container-wide py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related on IPOFins</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/broker/compare" class="btn-secondary">Compare Brokers</a>
      <a href="/ipo" class="btn-secondary">Live IPOs</a>
      <a href="/ipo/subscription-status" class="btn-secondary">IPO Subscription</a>
      <a href="/mutual-funds" class="btn-secondary">Mutual Funds</a>
      <a href="/tools/sip-calculator" class="btn-secondary">SIP Calculator</a>
      <a href="/tools/ipo-profit-calculator" class="btn-secondary">IPO Profit Calculator</a>
    </div>
  </section>
</BaseLayout>
