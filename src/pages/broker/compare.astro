---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import BrokerCompare from '../../components/BrokerCompare.tsx';
import brokersData from '../../data/brokers.json';

const focusBroker = Astro.url.searchParams.get('broker') || Astro.url.searchParams.get('b') || '';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Compare Stock Brokers India 2026",
  "description": "Side-by-side comparison of India's top stock brokers. Compare fees, platforms, features, pros and cons.",
  "url": "https://ipofins.com/broker/compare",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Brokers", "item": "https://ipofins.com/broker" },
      { "@type": "ListItem", "position": 3, "name": "Compare", "item": "https://ipofins.com/broker/compare" }
    ]
  }
};
import ContentGuideSection from '../../components/content-guide/ContentGuideSection.astro';
import ContentGuideFaqList from '../../components/content-guide/ContentGuideFaqList.astro';
import ContentGuideFaqItem from '../../components/content-guide/ContentGuideFaqItem.astro';
---

<BaseLayout
  title="Compare Stock Brokers India 2026 - Side by Side | IPOFins"
  description="Compare India's top stock brokers side-by-side. Select 2-4 brokers and compare fees, platforms, features, pros and cons of Zerodha, Groww, Upstox, Angel One, and more."
  jsonLd={jsonLd}
>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/broker" class="hover:text-primary-600 transition-colors">Brokers</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Compare</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <PageHeader
      title="Compare Stock Brokers - Side by Side"
      subtitle="Select 2 to 4 brokers from the dropdowns below and compare them on fees, platforms, strengths, and weaknesses."
    >
      <p class="mt-3 text-sm text-surface-600 dark:text-surface-300 max-w-2xl">
        Read individual <a href="/broker" class="text-primary-600 hover:underline">broker reviews</a> or use our
        <a href="/learn/best-stock-broker-2026" class="text-primary-600 hover:underline">broker selection guide</a>.
      </p>
    </PageHeader>
  </section>

  <!-- Interactive Comparison Tool -->
  <section class="container-wide py-6">
    <BrokerCompare client:load brokers={brokersData} focusBroker={focusBroker} />
  </section>

  <!-- AI Recommendation -->
  <section class="container-wide py-8">
    <div class="card border-primary-100 dark:border-primary-900/50 bg-gradient-to-br from-primary-50/50 to-white dark:from-primary-950/20 dark:to-surface-800">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white mb-1">Quick Recommendation</h3>
          <p class="text-sm text-surface-600 dark:text-surface-300">
            <strong>Most retail investors:</strong>
            <a href="/broker/zerodha" class="text-primary-600 hover:underline">Zerodha</a> — best platform quality + reliability.
            <strong>Beginners:</strong>
            <a href="/broker/groww" class="text-primary-600 hover:underline">Groww</a> — simplest UI + zero AMC.
            <strong>Active traders:</strong>
            <a href="/broker/dhan" class="text-primary-600 hover:underline">Dhan</a> — fastest execution + options tools.
            <strong>Zero brokerage:</strong>
            <a href="/broker/mstock" class="text-primary-600 hover:underline">m.Stock</a> — one-time ₹999 fee, then free forever.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How to Choose Section -->
  <section class="container-wide py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">How to Choose the Right Broker</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
        <div class="card-compact">
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white mb-2">🏃 Active Traders</h3>
          <p class="text-xs text-surface-600 dark:text-surface-300">Need: fast execution, advanced charting, low per-trade fees. Look at: <a href="/broker/zerodha" class="text-primary-600 hover:underline">Zerodha</a>, <a href="/broker/dhan" class="text-primary-600 hover:underline">Dhan</a>, <a href="/broker/fyers" class="text-primary-600 hover:underline">Fyers</a>.</p>
        </div>
        <div class="card-compact">
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white mb-2">📈 Long-term Investors</h3>
          <p class="text-xs text-surface-600 dark:text-surface-300">Need: research reports, mutual fund access, low AMC. Look at: <a href="/broker/groww" class="text-primary-600 hover:underline">Groww</a>, <a href="/broker/mstock" class="text-primary-600 hover:underline">m.Stock</a>, <a href="/broker/icici-direct" class="text-primary-600 hover:underline">ICICI Direct</a>.</p>
        </div>
        <div class="card-compact">
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white mb-2">🤖 Algo/API Traders</h3>
          <p class="text-xs text-surface-600 dark:text-surface-300">Need: free API, good documentation, reliable uptime. Look at: <a href="/broker/fyers" class="text-primary-600 hover:underline">Fyers</a>, <a href="/broker/angel-one" class="text-primary-600 hover:underline">Angel One</a> (SmartAPI), <a href="/broker/zerodha" class="text-primary-600 hover:underline">Zerodha</a> (Kite Connect).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <ContentGuideSection title="Frequently Asked Questions" variant="faq" bordered container="wide">
    <ContentGuideFaqList>
      <ContentGuideFaqItem open>
        <span slot="question">How do I choose the best broker for my needs?</span>
        <p>Consider your trading frequency, investment style, and the features you need. If you trade frequently, low brokerage (₹20 flat) matters most. If you're a long-term investor, platform quality and mutual fund options are more important. Beginners should prioritize ease of use and educational resources.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">What charges should I compare between brokers?</span>
        <p>Compare: brokerage per trade, account opening fee, annual maintenance charge (AMC), demat charges, DP charges per sell transaction (₹13-18), margin interest rates, and call & trade charges. Many brokers offer zero account opening as promotional offers.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Can I have accounts with multiple brokers?</span>
        <p>Yes, you can hold demat and trading accounts with multiple brokers simultaneously. Many investors use one broker for long-term investments (for research tools) and another for active trading (for low brokerage). Your shares are linked to your PAN, so holdings are visible across all accounts.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Discount broker vs full-service broker — which is better?</span>
        <p>Discount brokers (<a href="/broker/zerodha" class="text-primary-600 hover:underline">Zerodha</a>, <a href="/broker/groww" class="text-primary-600 hover:underline">Groww</a>, <a href="/broker/upstox" class="text-primary-600 hover:underline">Upstox</a>) charge flat ₹20/trade and are best for self-directed investors. Full-service brokers (<a href="/broker/icici-direct" class="text-primary-600 hover:underline">ICICI Direct</a>, <a href="/broker/hdfc-securities" class="text-primary-600 hover:underline">HDFC Securities</a>) charge percentage-based fees but offer research, advisory, and 3-in-1 accounts. Most modern investors prefer discount brokers for the cost savings.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">How long does it take to open a trading account?</span>
        <p>Most discount brokers offer instant account opening through e-KYC with Aadhaar. The process takes 10-15 minutes, and you can start trading within 24-48 hours after verification. You'll need PAN card, Aadhaar, bank details, and a selfie for video KYC.</p>
      </ContentGuideFaqItem>
    </ContentGuideFaqList>
  </ContentGuideSection>

  <!-- Broker Review Links -->
  <section class="container-wide py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Individual Broker Reviews</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3">
      {brokersData.map((broker) => (
        <a
          href={`/broker/${broker.slug}`}
          class="card-compact text-center group hover:shadow-md transition-shadow"
        >
          <div class="w-9 h-9 mx-auto bg-gradient-to-br from-primary-500 to-primary-700 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-sm">{broker.logo}</span>
          </div>
          <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-2">{broker.name}</p>
          <p class="text-xs text-surface-500 mt-0.5">★ {broker.rating}</p>
        </a>
      ))}
    </div>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-4">
      <a href="/broker" class="text-primary-600 hover:underline">View all broker reviews →</a>
    </p>
  </section>

  <!-- Cross-section Links -->
  <section class="container-wide py-8 border-t border-surface-200 dark:border-surface-700">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related on IPOFins</h2>
    <div class="nav-btn-group">
      <a href="/broker" class="btn-secondary px-6 py-3">All Broker Reviews</a>
      <a href="/learn/best-stock-broker-2026" class="btn-secondary px-6 py-3">How to Choose a Broker</a>
      <a href="/learn/how-to-open-demat-account" class="btn-secondary px-6 py-3">Open Demat Account</a>
      <a href="/ipo" class="btn-secondary px-6 py-3">Live IPOs</a>
      <a href="/ipo/subscription-status" class="btn-secondary px-6 py-3">IPO Subscription</a>
      <a href="/mutual-funds" class="btn-secondary px-6 py-3">Mutual Funds</a>
      <a href="/tools/sip-calculator" class="btn-secondary px-6 py-3">SIP Calculator</a>
      <a href="/tools/ipo-profit-calculator" class="btn-secondary px-6 py-3">IPO Profit Calculator</a>
    </div>
  </section>
</BaseLayout>
