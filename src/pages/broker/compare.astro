---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrokerCompare from '../../components/BrokerCompare.tsx';
import brokersData from '../../data/brokers.json';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Compare Stock Brokers India 2026",
  "description": "Side-by-side comparison of India's top stock brokers. Compare fees, platforms, features, pros and cons.",
  "url": "https://ipofins.com/broker/compare",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Brokers", "item": "https://ipofins.com/broker" },
      { "@type": "ListItem", "position": 3, "name": "Compare", "item": "https://ipofins.com/broker/compare" }
    ]
  }
};
---

<BaseLayout
  title="Compare Stock Brokers India 2026 - Side by Side | IPOfins"
  description="Compare India's top stock brokers side-by-side. Select 2-4 brokers and compare fees, platforms, features, pros and cons of Zerodha, Groww, Upstox, Angel One, and more."
  jsonLd={jsonLd}
>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/broker" class="hover:text-primary-600 transition-colors">Brokers</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Compare</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      Compare Stock Brokers - Side by Side
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300 max-w-2xl">
      Select 2 to 4 brokers from the dropdowns below and compare them on fees, platforms, strengths, and weaknesses. Find the perfect broker for your trading style.
    </p>
  </section>

  <!-- Interactive Comparison Tool -->
  <section class="container-wide py-6">
    <BrokerCompare client:load brokers={brokersData} />
  </section>

  <!-- AI Recommendation -->
  <section class="container-wide py-8">
    <div class="card border-primary-100 dark:border-primary-900/50 bg-gradient-to-br from-primary-50/50 to-white dark:from-primary-950/20 dark:to-surface-800">
      <div class="flex items-start gap-3">
        <div class="w-8 h-8 rounded-lg bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white mb-1">Quick Recommendation</h3>
          <p class="text-sm text-surface-600 dark:text-surface-300">
            <strong>Most retail investors:</strong> Zerodha — best platform quality + reliability.
            <strong>Beginners:</strong> Groww — simplest UI + zero AMC.
            <strong>Active traders:</strong> Dhan — fastest execution + options tools.
            <strong>Zero brokerage:</strong> m.Stock — one-time ₹999 fee, then free forever.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- How to Choose Section -->
  <section class="container-wide py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">How to Choose the Right Broker</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-4">
        <div class="card-compact">
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white mb-2">🏃 Active Traders</h3>
          <p class="text-xs text-surface-600 dark:text-surface-300">Need: fast execution, advanced charting, low per-trade fees. Look at: Zerodha, Dhan, Fyers.</p>
        </div>
        <div class="card-compact">
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white mb-2">📈 Long-term Investors</h3>
          <p class="text-xs text-surface-600 dark:text-surface-300">Need: research reports, mutual fund access, low AMC. Look at: Groww, m.Stock, ICICI Direct.</p>
        </div>
        <div class="card-compact">
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white mb-2">🤖 Algo/API Traders</h3>
          <p class="text-xs text-surface-600 dark:text-surface-300">Need: free API, good documentation, reliable uptime. Look at: Fyers, Angel One (SmartAPI), Zerodha (Kite Connect).</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="container-wide py-12">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4 max-w-3xl">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How do I choose the best broker for my needs?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Consider your trading frequency, investment style, and the features you need. If you trade frequently, low brokerage (₹20 flat) matters most. If you're a long-term investor, platform quality and mutual fund options are more important. Beginners should prioritize ease of use and educational resources.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What charges should I compare between brokers?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Compare: brokerage per trade, account opening fee, annual maintenance charge (AMC), demat charges, DP charges per sell transaction (₹13-18), margin interest rates, and call & trade charges. Many brokers offer zero account opening as promotional offers.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Can I have accounts with multiple brokers?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Yes, you can hold demat and trading accounts with multiple brokers simultaneously. Many investors use one broker for long-term investments (for research tools) and another for active trading (for low brokerage). Your shares are linked to your PAN, so holdings are visible across all accounts.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Discount broker vs full-service broker — which is better?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Discount brokers (Zerodha, Groww, Upstox) charge flat ₹20/trade and are best for self-directed investors. Full-service brokers (ICICI Direct, HDFC Securities) charge percentage-based fees but offer research, advisory, and 3-in-1 accounts. Most modern investors prefer discount brokers for the cost savings.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How long does it take to open a trading account?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Most discount brokers offer instant account opening through e-KYC with Aadhaar. The process takes 10-15 minutes, and you can start trading within 24-48 hours after verification. You'll need PAN card, Aadhaar, bank details, and a selfie for video KYC.</p>
      </details>
    </div>
  </section>
</BaseLayout>
