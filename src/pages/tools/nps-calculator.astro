---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NPSCalculator from '../../components/calculators/NPSCalculator.tsx';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "NPS Calculator",
  "description": "Calculate your National Pension System corpus at retirement. Estimate monthly pension based on your contributions.",
  "url": "https://ipofins.com/tools/nps-calculator",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://ipofins.com/tools" },
      { "@type": "ListItem", "position": 3, "name": "NPS Calculator", "item": "https://ipofins.com/tools/nps-calculator" }
    ]
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is NPS and how does it work?",
      "acceptedAnswer": { "@type": "Answer", "text": "NPS (National Pension System) is a government-sponsored pension scheme. You contribute monthly/yearly during your working life, and at retirement (age 60), you must use at least 40% of the corpus to buy an annuity (monthly pension). The remaining 60% can be withdrawn tax-free." }
    },
    {
      "@type": "Question",
      "name": "What is the tax benefit of NPS?",
      "acceptedAnswer": { "@type": "Answer", "text": "NPS offers additional tax benefit of ₹50,000 under Section 80CCD(1B) over and above the ₹1.5 lakh limit of Section 80C. Employer contributions up to 10% of basic salary are also deductible under 80CCD(2) with no upper limit." }
    },
    {
      "@type": "Question",
      "name": "What returns can I expect from NPS?",
      "acceptedAnswer": { "@type": "Answer", "text": "NPS returns depend on your asset allocation. Historically, NPS equity (Tier I - Scheme E) has delivered 12-14% CAGR, corporate bonds 8-10%, and government securities 7-9%. A balanced allocation typically yields 9-11% over the long term." }
    },
    {
      "@type": "Question",
      "name": "Can I withdraw from NPS before retirement?",
      "acceptedAnswer": { "@type": "Answer", "text": "Partial withdrawal is allowed after 3 years for specific purposes (education, marriage, house purchase, medical treatment). Up to 25% of own contributions can be withdrawn, maximum 3 times during the entire tenure. Premature exit before 60 requires 80% annuity purchase." }
    }
  ]
};
---

<BaseLayout
  title="NPS Calculator 2026 - Pension Returns Calculator | IPOFins"
  description="Free NPS calculator to estimate retirement corpus and monthly pension. Plan your NPS contributions with expected returns. Additional ₹50,000 tax benefit."
  jsonLd={jsonLd}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">NPS Calculator</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      NPS Calculator
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300 max-w-2xl">
      Estimate your National Pension System corpus at retirement. Enter your age, monthly contribution, and expected return to plan your pension.
    </p>
  </section>

  <section class="container-narrow py-6">
    <div class="card max-w-2xl mx-auto">
      <NPSCalculator client:idle />
    </div>
  </section>

  <section class="container-narrow py-12">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is NPS and how does it work?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">NPS (National Pension System) is a government-sponsored pension scheme. You contribute monthly or yearly during your working life, and at retirement (age 60), you must use at least 40% of the corpus to buy an annuity (monthly pension). The remaining 60% can be withdrawn tax-free.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is the tax benefit of NPS?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">NPS offers an additional tax benefit of ₹50,000 under Section 80CCD(1B) over and above the ₹1.5 lakh limit of Section 80C. Employer contributions up to 10% of basic salary are also deductible under 80CCD(2) with no upper limit.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What returns can I expect from NPS?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">NPS returns depend on your asset allocation. Historically, NPS equity (Scheme E) has delivered 12-14% CAGR, corporate bonds 8-10%, and government securities 7-9%. A balanced allocation typically yields 9-11% over the long term.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Can I withdraw from NPS before retirement?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Partial withdrawal is allowed after 3 years for specific purposes (education, marriage, house purchase, medical treatment). Up to 25% of own contributions can be withdrawn, maximum 3 times during the entire tenure.</p>
      </details>
    </div>
  </section>

  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">How to Use This NPS Calculator</h2>
      <p class="text-surface-600 dark:text-surface-300">Enter your current age, planned retirement age, monthly contribution amount, and expected annual return. The calculator estimates your total corpus at retirement, helping you plan adequate contributions for your desired pension.</p>
      <h3 class="text-base font-semibold text-surface-800 dark:text-surface-200 mt-4 mb-2">Benefits of NPS</h3>
      <ul class="list-disc list-inside text-surface-600 dark:text-surface-300 space-y-1">
        <li>Extra ₹50,000 tax deduction under Section 80CCD(1B)</li>
        <li>Low fund management charges (0.01% - lowest among pension funds)</li>
        <li>Flexible asset allocation across equity, bonds, and government securities</li>
        <li>Portability across employers and locations</li>
      </ul>
      <p class="text-surface-600 dark:text-surface-300 mt-3">
        Complement NPS with a <a href="/tools/sip-calculator" class="text-primary-600 hover:underline">mutual fund SIP</a> for additional wealth building outside the pension system. Use our <a href="/tools/ppf-calculator" class="text-primary-600 hover:underline">PPF Calculator</a> to plan your Section 80C allocation.
      </p>
    </div>
  </section>

  <section class="container-narrow py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related Calculators</h2>
    <div class="nav-btn-group">
      <a href="/tools/sip-calculator" class="btn-secondary px-6 py-3">SIP Calculator</a>
      <a href="/tools/ppf-calculator" class="btn-secondary px-6 py-3">PPF Calculator</a>
      <a href="/tools/fd-calculator" class="btn-secondary px-6 py-3">FD Calculator</a>
      <a href="/tools/lumpsum-calculator" class="btn-secondary px-6 py-3">Lumpsum Calculator</a>
      <a href="/tools/emi-calculator" class="btn-secondary px-6 py-3">EMI Calculator</a>
    </div>
  </section>
</BaseLayout>
