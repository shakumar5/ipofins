---
import { toolPageJsonLd } from '../../lib/tool-schemas';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import PPFCalculator from '../../components/calculators/PPFCalculator.tsx';

const jsonLd = toolPageJsonLd({
  name: "PPF Calculator",
  slug: "ppf-calculator",
  description: "Calculate Public Provident Fund maturity value with current interest rate. Plan your 15-year PPF investment.",
});

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the current PPF interest rate in 2026?",
      "acceptedAnswer": { "@type": "Answer", "text": "The PPF interest rate is reviewed quarterly by the government. As of 2026, the rate is around 7.1% per annum, compounded annually. Check the latest RBI notification for the current quarter's rate." }
    },
    {
      "@type": "Question",
      "name": "What is the maximum PPF investment limit per year?",
      "acceptedAnswer": { "@type": "Answer", "text": "The maximum annual deposit in PPF is ₹1,50,000. The minimum required deposit is ₹500 per year to keep the account active. You can deposit in a lump sum or in up to 12 installments per year." }
    },
    {
      "@type": "Question",
      "name": "Can PPF be extended beyond 15 years?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, PPF can be extended in blocks of 5 years after the initial 15-year maturity. You can extend with or without contributions. The interest continues at the prevailing rate." }
    },
    {
      "@type": "Question",
      "name": "Is PPF interest tax-free?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, PPF falls under the EEE (Exempt-Exempt-Exempt) tax category. The investment qualifies for Section 80C deduction, the interest earned is tax-free, and the maturity amount is also tax-free." }
    }
  ]
};
import ContentGuideSection from '../../components/content-guide/ContentGuideSection.astro';
import ContentGuideFaqList from '../../components/content-guide/ContentGuideFaqList.astro';
import ContentGuideFaqItem from '../../components/content-guide/ContentGuideFaqItem.astro';
---

<BaseLayout
  title="PPF Calculator 2026 - PPF Maturity Calculator | IPOFins"
  description="Free PPF calculator to estimate maturity value and interest earned on Public Provident Fund. Plan your 15-year tax-free investment with current rates."
  jsonLd={jsonLd}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">PPF Calculator</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <PageHeader
      title="PPF Calculator"
      subtitle="Calculate how your Public Provident Fund investment grows over time. PPF offers guaranteed, tax-free returns with government backing."
      freshness="Runs in browser"
      source="No data stored"
    />
  </section>

  <section class="container-narrow py-6">
    <div class="card max-w-2xl mx-auto">
      <PPFCalculator client:idle />
    </div>
  </section>

  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">How to Use the PPF Calculator</h2>
      <p class="text-surface-600 dark:text-surface-300">
        Enter your annual deposit (₹500–₹1,50,000), the current PPF interest rate, and tenure in years. The calculator projects maturity value and total interest — all computed locally in your browser.
      </p>
      <ol class="list-decimal list-inside text-surface-600 dark:text-surface-300 space-y-2 mt-3">
        <li><strong>Annual deposit</strong> — total you contribute each financial year (lump sum or installments)</li>
        <li><strong>Interest rate</strong> — government-set rate, reviewed quarterly (~7.1% in 2026)</li>
        <li><strong>Tenure</strong> — minimum 15 years; extend in 5-year blocks after maturity</li>
      </ol>
    </div>
  </section>

  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">PPF Maturity Formula</h2>
      <div class="bg-surface-100 dark:bg-surface-800 rounded-lg p-4 font-mono text-xs space-y-2">
        <p><strong>Each year:</strong> Balance = (Previous balance + Deposit) × (1 + r)</p>
        <p class="text-surface-500 font-sans text-xs mt-2">r = annual rate (decimal). Interest is compounded annually on the lowest balance between the 5th and last day of each month.</p>
      </div>
      <p class="text-surface-600 dark:text-surface-300 mt-4">
        Example: ₹1,50,000/year at 7.1% for 15 years → maturity ≈ ₹40.7 lakh (interest ≈ ₹18.2 lakh, all tax-free under EEE).
      </p>
    </div>
  </section>

  <section class="container-narrow py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">PPF Maturity Examples (7.1% p.a.)</h2>
    <div class="overflow-x-auto data-table-premium">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-surface-200 dark:border-surface-700">
            <th class="text-left py-3 px-4 font-semibold">Annual deposit</th>
            <th class="text-right py-3 px-4 font-semibold">15 years</th>
            <th class="text-right py-3 px-4 font-semibold">20 years</th>
            <th class="text-right py-3 px-4 font-semibold">25 years</th>
          </tr>
        </thead>
        <tbody class="text-surface-600 dark:text-surface-300">
          <tr class="border-b border-surface-100 dark:border-surface-800">
            <td class="py-3 px-4 font-medium">₹50,000/yr</td>
            <td class="py-3 px-4 text-right">₹13.6 L</td>
            <td class="py-3 px-4 text-right">₹22.1 L</td>
            <td class="py-3 px-4 text-right">₹34.2 L</td>
          </tr>
          <tr class="border-b border-surface-100 dark:border-surface-800">
            <td class="py-3 px-4 font-medium">₹1,00,000/yr</td>
            <td class="py-3 px-4 text-right">₹27.1 L</td>
            <td class="py-3 px-4 text-right">₹44.2 L</td>
            <td class="py-3 px-4 text-right">₹68.4 L</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-medium">₹1,50,000/yr (max)</td>
            <td class="py-3 px-4 text-right">₹40.7 L</td>
            <td class="py-3 px-4 text-right">₹66.3 L</td>
            <td class="py-3 px-4 text-right">₹1.03 Cr</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-surface-500 mt-3">Illustrative. Assumes full deposit at start of each year.</p>
  </section>

  <ContentGuideSection title="Frequently Asked Questions" variant="faq" bordered container="narrow">
    <ContentGuideFaqList>
      <ContentGuideFaqItem open>
        <span slot="question">What is the current PPF interest rate in 2026?</span>
        <p>The PPF interest rate is reviewed quarterly by the government. As of 2026, the rate is around 7.1% per annum, compounded annually. Check the latest RBI notification for the current quarter's rate.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">What is the maximum PPF investment limit per year?</span>
        <p>The maximum annual deposit in PPF is ₹1,50,000. The minimum required deposit is ₹500 per year to keep the account active. You can deposit in a lump sum or in up to 12 installments per year.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Can PPF be extended beyond 15 years?</span>
        <p>Yes, PPF can be extended in blocks of 5 years after the initial 15-year maturity. You can extend with or without contributions. The interest continues at the prevailing rate.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Is PPF interest tax-free?</span>
        <p>Yes, PPF falls under the EEE (Exempt-Exempt-Exempt) tax category. The investment qualifies for Section 80C deduction, the interest earned is tax-free, and the maturity amount is also tax-free.</p>
      </ContentGuideFaqItem>
    </ContentGuideFaqList>
  </ContentGuideSection>

  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">How to Use This PPF Calculator</h2>
      <p class="text-surface-600 dark:text-surface-300">Enter your monthly investment amount, the current PPF interest rate, and the number of years you plan to invest. The calculator shows your total corpus at maturity including the accumulated interest.</p>
      <h3 class="text-base font-semibold text-surface-800 dark:text-surface-200 mt-4 mb-2">Benefits of PPF</h3>
      <ul class="list-disc list-inside text-surface-600 dark:text-surface-300 space-y-1">
        <li>Government-backed, zero-risk investment</li>
        <li>Triple tax benefit (EEE) under Section 80C</li>
        <li>Loan facility available after 3rd year</li>
        <li>Partial withdrawal allowed after 7th year</li>
      </ul>
      <p class="text-surface-600 dark:text-surface-300 mt-3">
        For higher growth potential alongside PPF, consider starting a <a href="/tools/sip-calculator" class="text-primary-600 hover:underline">SIP in equity mutual funds</a>. A balanced approach: PPF for safety + SIP for growth. Compare <a href="/mutual-funds/best" class="text-primary-600 hover:underline">best mutual funds</a> on IPOFins.
      </p>
    </div>
  </section>

  <section class="container-narrow py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related Calculators</h2>
    <div class="nav-btn-group">
      <a href="/tools/sip-calculator" class="btn-secondary px-6 py-3">SIP Calculator</a>
      <a href="/tools/fd-calculator" class="btn-secondary px-6 py-3">FD Calculator</a>
      <a href="/tools/nps-calculator" class="btn-secondary px-6 py-3">NPS Calculator</a>
      <a href="/tools/lumpsum-calculator" class="btn-secondary px-6 py-3">Lumpsum Calculator</a>
      <a href="/tools/emi-calculator" class="btn-secondary px-6 py-3">EMI Calculator</a>
    </div>
  </section>
</BaseLayout>
