---
import { toolPageJsonLd } from '../../lib/tool-schemas';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import TaxCalculator from '../../components/calculators/TaxCalculator.tsx';

const jsonLd = toolPageJsonLd({
  name: "Investment Tax Calculator - LTCG & STCG Tax on Stocks, Mutual Funds, Gold",
  slug: "tax-calculator",
  description: "Free capital gains tax calculator for Indian investors. Calculate STCG and LTCG tax on equity, debt mutual funds, stocks, and gold with 2024 tax rules.",
});

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is LTCG tax?", "acceptedAnswer": { "@type": "Answer", "text": "Long-Term Capital Gains (LTCG) tax applies when investments are held beyond the specified holding period. For equity/equity MFs, LTCG is taxed at 12.5% on gains exceeding ₹1.25 lakh per year (holding period: 12 months)." } },
    { "@type": "Question", "name": "What is STCG tax?", "acceptedAnswer": { "@type": "Answer", "text": "Short-Term Capital Gains (STCG) tax applies when equity investments are sold before completing 12 months. STCG on equity is taxed at a flat rate of 20% as per the 2024 Budget changes." } },
    { "@type": "Question", "name": "Are tax rules different for stocks and mutual funds?", "acceptedAnswer": { "@type": "Answer", "text": "Equity stocks and equity MFs have the same tax rules (12 months for LTCG). Debt MFs are taxed at your income tax slab rate regardless of holding period. Gold has a 24-month holding period for LTCG at 12.5%." } },
    { "@type": "Question", "name": "How is tax calculated on mutual funds?", "acceptedAnswer": { "@type": "Answer", "text": "Tax depends on fund type and holding period. Equity funds: STCG 20% (<12 months), LTCG 12.5% (>12 months, gains above ₹1.25L exempt). Debt funds: taxed at slab rate regardless of holding period (post-2023 rules)." } },
    { "@type": "Question", "name": "Does this calculator include the latest tax rules?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. This calculator reflects the Union Budget 2024 changes: equity STCG at 20%, equity LTCG at 12.5% with ₹1.25 lakh exemption, debt MF at slab rate, and gold LTCG at 12.5% after 24 months." } },
    { "@type": "Question", "name": "Can I calculate tax before selling investments?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Enter your purchase amount, expected sale amount, and holding period to estimate tax liability before making the sell decision. This helps in tax planning and deciding optimal sell timing." } }
  ]
};
import ContentGuideSection from '../../components/content-guide/ContentGuideSection.astro';
import ContentGuideFaqList from '../../components/content-guide/ContentGuideFaqList.astro';
import ContentGuideFaqItem from '../../components/content-guide/ContentGuideFaqItem.astro';
import CalculatorSeoGuide from '../../components/tools/CalculatorSeoGuide.astro';
---

<BaseLayout
  title="Investment Tax Calculator 2026 - LTCG & STCG Tax on Stocks, MFs, Gold | IPOFins"
  description="Free capital gains tax calculator for India. Calculate STCG/LTCG tax on equity mutual funds, stocks, debt funds, and gold with updated 2024 Budget rules. Plan before you sell!"
  jsonLd={jsonLd}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Tax Calculator</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <PageHeader
      title="Investment Tax Calculator - LTCG &amp; STCG Tax on Stocks, MFs, Gold"
      subtitle="Calculate your exact capital gains tax liability before selling. Covers equity mutual funds, stocks, debt MFs, and gold with the latest 2024 Union Budget tax rules."
      freshness="Runs in browser"
      source="No data stored"
    />
  </section>

  <section class="container-narrow py-6">
    <div class="card max-w-2xl mx-auto">
      <TaxCalculator client:idle />
    </div>
  </section>

  <!-- How it Works -->
  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">How Capital Gains Tax Works in India (2024 Rules)</h2>
      <p class="text-surface-600 dark:text-surface-300">Tax rules differ based on asset type and holding period:</p>
    </div>
    <div class="overflow-x-auto mt-4 data-table-premium">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-surface-200 dark:border-surface-700">
            <th class="text-left py-3 px-4 font-semibold text-surface-900 dark:text-white">Asset</th>
            <th class="text-center py-3 px-4 font-semibold text-surface-900 dark:text-white">STCG Period</th>
            <th class="text-center py-3 px-4 font-semibold text-surface-900 dark:text-white">STCG Rate</th>
            <th class="text-center py-3 px-4 font-semibold text-surface-900 dark:text-white">LTCG Rate</th>
            <th class="text-center py-3 px-4 font-semibold text-surface-900 dark:text-white">Exemption</th>
          </tr>
        </thead>
        <tbody class="text-surface-600 dark:text-surface-300">
          <tr class="border-b border-surface-100 dark:border-surface-800">
            <td class="py-3 px-4">Equity MF / Stocks</td>
            <td class="py-3 px-4 text-center">&lt;12 months</td>
            <td class="py-3 px-4 text-center">20%</td>
            <td class="py-3 px-4 text-center">12.5%</td>
            <td class="py-3 px-4 text-center">₹1.25L/year</td>
          </tr>
          <tr class="border-b border-surface-100 dark:border-surface-800">
            <td class="py-3 px-4">Debt Mutual Funds</td>
            <td class="py-3 px-4 text-center">Any period</td>
            <td class="py-3 px-4 text-center" colspan="2">Slab Rate (no LTCG benefit)</td>
            <td class="py-3 px-4 text-center">None</td>
          </tr>
          <tr>
            <td class="py-3 px-4">Gold / Gold ETF</td>
            <td class="py-3 px-4 text-center">&lt;24 months</td>
            <td class="py-3 px-4 text-center">Slab Rate</td>
            <td class="py-3 px-4 text-center">12.5%</td>
            <td class="py-3 px-4 text-center">₹1.25L/year</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- Formula -->
  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Tax Calculation Formula</h2>
      <div class="bg-surface-100 dark:bg-surface-800 rounded-lg p-4 font-mono text-xs space-y-2">
        <p><strong>Capital Gain</strong> = Sale Amount - Purchase Amount</p>
        <p><strong>Taxable Gain (LTCG)</strong> = Capital Gain - ₹1,25,000 (exemption)</p>
        <p><strong>Tax Amount</strong> = Taxable Gain × Tax Rate</p>
        <p><strong>Net Profit</strong> = Capital Gain - Tax Amount</p>
        <p><strong>Effective Tax Rate</strong> = Tax Amount / Capital Gain × 100</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <ContentGuideSection title="Frequently Asked Questions - Investment Tax" variant="faq" bordered container="narrow">
    <ContentGuideFaqList>
      <ContentGuideFaqItem open>
        <span slot="question">What is LTCG tax on equity mutual funds?</span>
        <p>Long-Term Capital Gains on equity mutual funds (held over 12 months) are taxed at 12.5% on gains exceeding ₹1.25 lakh per financial year. For example, if you sell equity MF with ₹2L profit after 14 months, taxable gain = ₹2L - ₹1.25L = ₹75,000. Tax = ₹75,000 × 12.5% = ₹9,375.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">What is STCG tax rate?</span>
        <p>STCG on equity (stocks/equity MFs sold within 12 months) is taxed at a flat 20% on the entire gain amount. There is no exemption for STCG. This was increased from 15% in the Union Budget 2024.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">How are debt mutual funds taxed?</span>
        <p>Since April 2023, debt mutual fund gains are always taxed at your income tax slab rate regardless of holding period. There is no LTCG benefit for debt funds anymore. If you're in the 30% bracket, you pay 30% tax on any gains from debt MFs.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Does this calculator use the latest 2024 tax rules?</span>
        <p>Yes. This calculator reflects all changes from the Union Budget 2024: equity STCG at 20% (up from 15%), equity LTCG at 12.5% (up from 10%), LTCG exemption increased to ₹1.25 lakh (from ₹1 lakh), and debt funds at slab rate.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Can I calculate tax before selling?</span>
        <p>Yes, that's the primary purpose of this tool. Enter your expected sale amount and holding period to estimate tax liability. This helps decide whether to wait for LTCG treatment (lower rate + exemption) or sell now.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">How can I reduce capital gains tax legally?</span>
        <p>Strategies: (1) Hold equity for 12+ months for LTCG treatment, (2) Harvest ₹1.25L LTCG exemption annually by selling and rebuying, (3) Set off losses against gains, (4) Time your sales across financial years to use exemption limit each year.</p>
      </ContentGuideFaqItem>
    </ContentGuideFaqList>
  </ContentGuideSection>

  <CalculatorSeoGuide slug="tax-calculator" />

  <!-- Related Calculators -->
  <section class="container-narrow py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related Calculators</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <a href="/tools/tax-saving-planner" class="card-compact text-center group hover:shadow-md transition-shadow">
        <span class="text-2xl">🧾</span>
        <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">Tax Saving Planner</p>
        <p class="text-xs text-surface-500 mt-0.5">80C, 80D, HRA</p>
      </a>
      <a href="/tools/sip-calculator" class="card-compact text-center group hover:shadow-md transition-shadow">
        <span class="text-2xl">📈</span>
        <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">SIP Calculator</p>
        <p class="text-xs text-surface-500 mt-0.5">Plan MF investments</p>
      </a>
      <a href="/tools/cagr-calculator" class="card-compact text-center group hover:shadow-md transition-shadow">
        <span class="text-2xl">📊</span>
        <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">CAGR Calculator</p>
        <p class="text-xs text-surface-500 mt-0.5">Measure returns</p>
      </a>
      <a href="/tools/lumpsum-calculator" class="card-compact text-center group hover:shadow-md transition-shadow">
        <span class="text-2xl">💵</span>
        <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">Lumpsum Calculator</p>
        <p class="text-xs text-surface-500 mt-0.5">One-time investment</p>
      </a>
    </div>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-4">
      <a href="/tools" class="text-primary-600 hover:underline">View all finance tools →</a>
    </p>
  </section>
</BaseLayout>
