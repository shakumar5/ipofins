---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import RetirementCalculator from '../../components/calculators/RetirementCalculator.tsx';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Retirement Corpus Calculator - How Much Do You Need to Retire?",
  "description": "Free retirement planning calculator for India. Find out how much corpus you need and monthly SIP required to retire comfortably with inflation-adjusted expenses.",
  "url": "https://ipofins.com/tools/retirement-calculator",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web Browser",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "INR" },
  "creator": { "@type": "Organization", "name": "IPOFins", "url": "https://ipofins.com" },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://ipofins.com/tools" },
      { "@type": "ListItem", "position": 3, "name": "Retirement Calculator", "item": "https://ipofins.com/tools/retirement-calculator" }
    ]
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is a retirement corpus?", "acceptedAnswer": { "@type": "Answer", "text": "A retirement corpus is the total amount of money required to maintain your desired lifestyle after retirement, accounting for inflation, life expectancy, and post-retirement investment returns." } },
    { "@type": "Question", "name": "How much retirement corpus do I need?", "acceptedAnswer": { "@type": "Answer", "text": "The required corpus depends on current monthly expenses, retirement age, life expectancy, inflation rate, and expected post-retirement returns. For example, if you spend ₹50,000/month today and retire in 30 years at 6% inflation, you will need approximately ₹2.87 lakh/month at retirement." } },
    { "@type": "Question", "name": "Why should inflation be considered in retirement planning?", "acceptedAnswer": { "@type": "Answer", "text": "Inflation reduces purchasing power. At 6% inflation, ₹1 lakh today will have the purchasing power of only ₹17,400 in 30 years. Your retirement corpus must generate enough to cover inflated expenses." } },
    { "@type": "Question", "name": "At what age should I start retirement planning?", "acceptedAnswer": { "@type": "Answer", "text": "The earlier the better. Starting at 25 vs 35 can reduce your required monthly investment by 50-60% due to compounding. Even small amounts invested early grow significantly over 30+ years." } },
    { "@type": "Question", "name": "How much should I save for retirement every month?", "acceptedAnswer": { "@type": "Answer", "text": "This depends on your retirement goal, expected returns, and years remaining. A general rule: save 20-30% of your income for retirement. Use this calculator to find your exact requirement." } },
    { "@type": "Question", "name": "Can SIPs help build a retirement corpus?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. SIPs in equity mutual funds are one of the most effective ways to build a retirement corpus. Historical equity returns of 12-15% CAGR over 15+ years significantly outpace inflation." } }
  ]
};
---

<BaseLayout
  title="Retirement Corpus Calculator 2026 - How Much Do You Need to Retire? | IPOFins"
  description="Free retirement planning calculator for India. Enter your age, expenses, and inflation — get the exact corpus needed and monthly SIP required to retire comfortably."
  jsonLd={jsonLd}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Retirement Calculator</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <PageHeader
      title="Retirement Corpus Calculator - How Much Do You Need to Retire?"
      subtitle="The most important personal finance question answered with precision. Enter your age, monthly expenses, and inflation rate to find the exact retirement corpus and monthly SIP needed."
      freshness="Runs in browser"
      source="No data stored"
    />
  </section>

  <section class="container-narrow py-6">
    <div class="card max-w-2xl mx-auto">
      <RetirementCalculator client:idle />
    </div>
  </section>

  <!-- How it Works -->
  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">How the Retirement Calculator Works</h2>
      <p class="text-surface-600 dark:text-surface-300">This calculator works backward from your desired retirement lifestyle:</p>
      <ol class="list-decimal list-inside text-surface-600 dark:text-surface-300 space-y-2 mt-3">
        <li><strong>Inflates your current expenses</strong> to find what they will cost at retirement age</li>
        <li><strong>Calculates total corpus needed</strong> to sustain those expenses for your entire retirement (adjusting for post-retirement returns and ongoing inflation)</li>
        <li><strong>Computes the monthly SIP</strong> required to build that corpus before retirement at your expected pre-retirement return rate</li>
      </ol>
    </div>
  </section>

  <!-- Formula -->
  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Retirement Corpus Formula</h2>
      <div class="bg-surface-100 dark:bg-surface-800 rounded-lg p-4 font-mono text-xs space-y-2">
        <p><strong>Step 1:</strong> Monthly expense at retirement = Current expense × (1 + inflation)^years_to_retire</p>
        <p><strong>Step 2:</strong> Real return rate = ((1 + post_return) / (1 + inflation)) - 1</p>
        <p><strong>Step 3:</strong> Corpus needed = Annual expense × (1 - (1 + real_rate)^(-years_in_retirement)) / real_rate</p>
        <p><strong>Step 4:</strong> Monthly SIP = Corpus / [((1+r)^n - 1) / r × (1+r)]</p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-narrow py-12">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions - Retirement Planning</h2>
    <div class="space-y-4">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is a retirement corpus?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">A retirement corpus is the total amount of money required to maintain your desired lifestyle after retirement. It must account for inflation, medical expenses, and your life expectancy. The corpus should generate enough returns to cover monthly expenses without depleting the principal too quickly.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How much retirement corpus do I need?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">A common rule of thumb is 25-30x your annual expenses at retirement. If you need ₹2L/month at 60, your corpus should be ₹6-7.2 Cr. Use this calculator for a precise number based on your specific situation including inflation and post-retirement returns.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Why is inflation so important in retirement planning?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">At 6% inflation, ₹50,000/month today becomes ₹2.87L/month in 30 years. Most people underestimate this. Without accounting for inflation, you'll run out of money 10-15 years into retirement. This is the #1 retirement planning mistake.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">At what age should I start planning for retirement?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Immediately. Starting at 25 vs 35 can reduce your required monthly SIP by 50-60%. For example, to build ₹5 Cr by 60 at 12% returns: starting at 25 needs ~₹7,500/month, starting at 35 needs ~₹20,000/month. Compounding rewards early starters disproportionately.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Can SIPs build a retirement corpus?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">Yes, SIPs in equity mutual funds are the most accessible way to build a large retirement corpus. Historical NIFTY 50 returns have been 12-13% CAGR over 20+ years. Combine equity SIPs with NPS (additional tax benefits) and PPF (risk-free component) for a balanced retirement portfolio.</p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How much should I save monthly for retirement?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">A general guideline: save 20-30% of your monthly income for retirement. But the exact amount depends on your goals. Use this calculator to find your specific number. Consider using a <a href="/tools/step-up-sip-calculator" class="text-primary-600 hover:underline">Step-Up SIP</a> to increase contributions as your salary grows.</p>
      </details>
    </div>
  </section>

  <!-- Related Calculators -->
  <section class="container-narrow py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related Calculators</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
      <a href="/tools/step-up-sip-calculator" class="card-compact text-center group hover:shadow-md transition-shadow">
        <span class="text-2xl">📈</span>
        <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">Step-Up SIP</p>
        <p class="text-xs text-surface-500 mt-0.5">Growing investments</p>
      </a>
      <a href="/tools/nps-calculator" class="card-compact text-center group hover:shadow-md transition-shadow">
        <span class="text-2xl">👴</span>
        <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">NPS Calculator</p>
        <p class="text-xs text-surface-500 mt-0.5">Pension planning</p>
      </a>
      <a href="/tools/goal-planner" class="card-compact text-center group hover:shadow-md transition-shadow">
        <span class="text-2xl">🎯</span>
        <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">Goal Planner</p>
        <p class="text-xs text-surface-500 mt-0.5">Any financial goal</p>
      </a>
      <a href="/tools/sip-calculator" class="card-compact text-center group hover:shadow-md transition-shadow">
        <span class="text-2xl">💰</span>
        <p class="text-sm font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 transition-colors mt-1">SIP Calculator</p>
        <p class="text-xs text-surface-500 mt-0.5">Monthly investing</p>
      </a>
    </div>
    <p class="text-sm text-surface-500 dark:text-surface-400 mt-4">
      <a href="/tools" class="text-primary-600 hover:underline">View all finance tools →</a>
    </p>
  </section>
</BaseLayout>
