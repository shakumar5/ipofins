---
import { toolPageJsonLd } from '../../lib/tool-schemas';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import FDCalculator from '../../components/calculators/FDCalculator.tsx';

const jsonLd = toolPageJsonLd({
  name: "FD Calculator",
  slug: "fd-calculator",
  description: "Calculate Fixed Deposit maturity amount and interest earned with quarterly or annual compounding.",
});

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How is FD interest calculated?",
      "acceptedAnswer": { "@type": "Answer", "text": "FD interest is calculated using compound interest formula: A = P(1 + r/n)^(nt), where P is principal, r is annual rate, n is compounding frequency (quarterly=4, annually=1), and t is time in years." }
    },
    {
      "@type": "Question",
      "name": "What is the best compounding frequency for FD?",
      "acceptedAnswer": { "@type": "Answer", "text": "Quarterly compounding gives higher returns than annual compounding for the same interest rate. Most banks in India offer quarterly compounding on fixed deposits by default." }
    },
    {
      "@type": "Question",
      "name": "Is FD interest taxable in India?",
      "acceptedAnswer": { "@type": "Answer", "text": "Yes, FD interest is fully taxable as per your income tax slab. Banks deduct TDS at 10% if annual interest exceeds ₹40,000 (₹50,000 for senior citizens). You can claim refund while filing ITR if your total income is below taxable limit." }
    },
    {
      "@type": "Question",
      "name": "What is the current FD interest rate in India 2026?",
      "acceptedAnswer": { "@type": "Answer", "text": "As of 2026, major banks offer FD rates between 6.5% to 8% for general citizens and 7% to 8.5% for senior citizens. Small finance banks and NBFCs may offer slightly higher rates." }
    }
  ]
};
import ContentGuideSection from '../../components/content-guide/ContentGuideSection.astro';
import ContentGuideFaqList from '../../components/content-guide/ContentGuideFaqList.astro';
import ContentGuideFaqItem from '../../components/content-guide/ContentGuideFaqItem.astro';
import CalculatorSeoGuide from '../../components/tools/CalculatorSeoGuide.astro';
---

<BaseLayout
  title="FD Calculator 2026 - Fixed Deposit Maturity Calculator | IPOFins"
  description="Free FD calculator to estimate fixed deposit maturity amount and interest earned. Compare quarterly vs annual compounding. Updated for 2026 rates."
  jsonLd={jsonLd}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">FD Calculator</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <PageHeader
      title="FD Calculator"
      subtitle="Calculate your Fixed Deposit maturity amount and interest earned. Adjust principal, rate, tenure, and compounding frequency."
      freshness="Runs in browser"
      source="No data stored"
    />
  </section>

  <section class="container-narrow py-6">
    <div class="card max-w-2xl mx-auto">
      <FDCalculator client:idle />
    </div>
  </section>

  <!-- How to Use (before FAQs) -->
  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">How to Use the FD Calculator</h2>
      <p class="text-surface-600 dark:text-surface-300">
        Enter your deposit amount, the annual interest rate offered by your bank or NBFC, tenure in years, and compounding frequency. The calculator instantly shows maturity value and total interest earned — all in your browser, with no data stored.
      </p>
      <ol class="list-decimal list-inside text-surface-600 dark:text-surface-300 space-y-2 mt-3">
        <li><strong>Principal amount</strong> — lump sum you deposit (₹1,000 to ₹1 crore)</li>
        <li><strong>Annual interest rate</strong> — FD rate from your bank (typically 6.5%–8.5% in 2026)</li>
        <li><strong>Tenure</strong> — lock-in period in years (7 days to 10 years for regular FDs)</li>
        <li><strong>Compounding</strong> — quarterly compounding usually beats annual for the same rate</li>
      </ol>
    </div>
  </section>

  <!-- Formula -->
  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">FD Interest Formula Explained</h2>
      <div class="bg-surface-100 dark:bg-surface-800 rounded-lg p-4 font-mono text-xs space-y-2">
        <p><strong>Maturity Amount (A)</strong> = P × (1 + r/n)<sup>nt</sup></p>
        <p><strong>Interest Earned</strong> = A − P</p>
        <p class="text-surface-500 font-sans text-xs mt-2">P = principal, r = annual rate (decimal), n = compounding per year, t = years</p>
      </div>
      <p class="text-surface-600 dark:text-surface-300 mt-4">
        Example: ₹5,00,000 at 7.5% for 3 years with quarterly compounding → maturity ≈ ₹6,24,000 (interest ≈ ₹1,24,000).
      </p>
    </div>
  </section>

  <!-- Worked Examples -->
  <section class="container-narrow py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">FD Maturity Examples (7.5% p.a., Quarterly Compounding)</h2>
    <div class="overflow-x-auto data-table-premium">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-surface-200 dark:border-surface-700">
            <th class="text-left py-3 px-4 font-semibold">Deposit</th>
            <th class="text-right py-3 px-4 font-semibold">1 Year</th>
            <th class="text-right py-3 px-4 font-semibold">3 Years</th>
            <th class="text-right py-3 px-4 font-semibold">5 Years</th>
          </tr>
        </thead>
        <tbody class="text-surface-600 dark:text-surface-300">
          <tr class="border-b border-surface-100 dark:border-surface-800">
            <td class="py-3 px-4 font-medium">₹1,00,000</td>
            <td class="py-3 px-4 text-right">₹1.08 L</td>
            <td class="py-3 px-4 text-right">₹1.25 L</td>
            <td class="py-3 px-4 text-right">₹1.45 L</td>
          </tr>
          <tr class="border-b border-surface-100 dark:border-surface-800">
            <td class="py-3 px-4 font-medium">₹5,00,000</td>
            <td class="py-3 px-4 text-right">₹5.39 L</td>
            <td class="py-3 px-4 text-right">₹6.24 L</td>
            <td class="py-3 px-4 text-right">₹7.23 L</td>
          </tr>
          <tr>
            <td class="py-3 px-4 font-medium">₹10,00,000</td>
            <td class="py-3 px-4 text-right">₹10.77 L</td>
            <td class="py-3 px-4 text-right">₹12.48 L</td>
            <td class="py-3 px-4 text-right">₹14.46 L</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-surface-500 mt-3">Illustrative only. Actual bank rates and TDS may differ.</p>
  </section>

  <!-- Tips -->
  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">FD Tips for Indian Investors</h2>
      <ul class="list-disc list-inside text-surface-600 dark:text-surface-300 space-y-2">
        <li>Compare rates across SBI, HDFC, ICICI, and small finance banks — spreads can be 0.5–1% for the same tenure.</li>
        <li>Senior citizens typically earn 0.25–0.50% extra; always declare age for the correct rate.</li>
        <li>Tax-saving FD (5-year lock-in) qualifies under Section 80C but interest is still taxable.</li>
        <li>Ladder FDs across maturities (1yr, 2yr, 3yr) to balance liquidity and rate lock-in.</li>
        <li>For inflation-beating returns over 7+ years, consider <a href="/tools/sip-calculator" class="text-primary-600 hover:underline">SIP in equity mutual funds</a> alongside FDs for stability.</li>
      </ul>
    </div>
  </section>

  <ContentGuideSection title="Frequently Asked Questions" variant="faq" bordered container="narrow">
    <ContentGuideFaqList>
      <ContentGuideFaqItem open>
        <span slot="question">How is FD interest calculated?</span>
        <p>FD interest is calculated using the compound interest formula: A = P(1 + r/n)^(nt), where P is your principal amount, r is the annual interest rate, n is the compounding frequency (quarterly = 4, annually = 1), and t is the tenure in years.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">What is the best compounding frequency for FD?</span>
        <p>Quarterly compounding gives higher returns than annual compounding for the same interest rate. Most banks in India offer quarterly compounding on fixed deposits by default.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Is FD interest taxable in India?</span>
        <p>Yes, FD interest is fully taxable as per your income tax slab. Banks deduct TDS at 10% if annual interest exceeds ₹40,000 (₹50,000 for senior citizens). You can claim a refund while filing your ITR if your total income is below the taxable limit.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">What is the current FD interest rate in India 2026?</span>
        <p>As of 2026, major banks offer FD rates between 6.5% to 8% for general citizens and 7% to 8.5% for senior citizens. Small finance banks and NBFCs may offer slightly higher rates.</p>
      </ContentGuideFaqItem>
    </ContentGuideFaqList>
  </ContentGuideSection>

  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">How to Use This FD Calculator</h2>
      <p class="text-surface-600 dark:text-surface-300">Enter your principal amount, the annual interest rate offered by your bank, the tenure in years, and select the compounding frequency. The calculator will show you the total maturity amount and interest earned.</p>
      <h3 class="text-base font-semibold text-surface-800 dark:text-surface-200 mt-4 mb-2">Benefits of Fixed Deposits</h3>
      <ul class="list-disc list-inside text-surface-600 dark:text-surface-300 space-y-1">
        <li>Guaranteed returns with zero market risk</li>
        <li>Flexible tenure from 7 days to 10 years</li>
        <li>Senior citizens get 0.25% to 0.50% extra interest</li>
        <li>Tax-saving FD under Section 80C (5-year lock-in)</li>
      </ul>
      <p class="text-surface-600 dark:text-surface-300 mt-3">
        Want higher returns with some risk? Consider <a href="/tools/sip-calculator" class="text-primary-600 hover:underline">SIP investing in mutual funds</a> which historically deliver 12-15% over 10+ years vs 6-8% for FDs. Browse <a href="/mutual-funds" class="text-primary-600 hover:underline">top mutual funds</a> on IPOFins.
      </p>
    </div>
  </section>

  <section class="container-narrow py-8">
  <CalculatorSeoGuide slug="fd-calculator" />

    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related Calculators</h2>
    <div class="nav-btn-group">
      <a href="/tools/sip-calculator" class="btn-secondary px-6 py-3">SIP Calculator</a>
      <a href="/tools/ppf-calculator" class="btn-secondary px-6 py-3">PPF Calculator</a>
      <a href="/tools/lumpsum-calculator" class="btn-secondary px-6 py-3">Lumpsum Calculator</a>
      <a href="/tools/nps-calculator" class="btn-secondary px-6 py-3">NPS Calculator</a>
      <a href="/tools/emi-calculator" class="btn-secondary px-6 py-3">EMI Calculator</a>
    </div>
  </section>
</BaseLayout>
