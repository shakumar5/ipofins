---
import { toolPageJsonLd } from '../../lib/tool-schemas';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import EMICalculator from '../../components/calculators/EMICalculator.tsx';

const jsonLd = toolPageJsonLd({
  name: "EMI Calculator",
  slug: "emi-calculator",
  description: "Calculate monthly EMI for home loan, car loan, or personal loan. Free online EMI calculator with amortization breakdown.",
});

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How is EMI calculated?", "acceptedAnswer": { "@type": "Answer", "text": "EMI is calculated using the formula: EMI = [P × R × (1+R)^N] / [(1+R)^N - 1], where P = Principal loan amount, R = Monthly interest rate (annual rate/12/100), N = Total number of monthly installments (years × 12)." } },
    { "@type": "Question", "name": "What is the EMI for a 50 lakh home loan?", "acceptedAnswer": { "@type": "Answer", "text": "For a ₹50 lakh home loan at 8.5% interest for 20 years, the monthly EMI is approximately ₹43,391. Total interest paid would be around ₹54.1 lakhs over the loan tenure." } },
    { "@type": "Question", "name": "Does prepayment reduce EMI or tenure?", "acceptedAnswer": { "@type": "Answer", "text": "Prepayment can either reduce your EMI amount (keeping tenure same) or reduce your tenure (keeping EMI same). Reducing tenure saves more interest overall. Most banks allow you to choose." } },
    { "@type": "Question", "name": "What are current home loan interest rates in India 2026?", "acceptedAnswer": { "@type": "Answer", "text": "Home loan rates in India (2026) range from 8.25% to 9.5% depending on the lender and borrower's credit score. SBI, HDFC, and ICICI offer competitive rates for salaried individuals with CIBIL score above 750." } },
    { "@type": "Question", "name": "Should I choose a longer or shorter loan tenure?", "acceptedAnswer": { "@type": "Answer", "text": "Shorter tenure means higher EMI but significantly less total interest. A ₹50L loan at 8.5% costs ₹19.3L interest over 15 years vs ₹38L over 30 years. Choose tenure where EMI is 30-40% of your monthly income." } }
  ]
};
import ContentGuideSection from '../../components/content-guide/ContentGuideSection.astro';
import ContentGuideFaqList from '../../components/content-guide/ContentGuideFaqList.astro';
import ContentGuideFaqItem from '../../components/content-guide/ContentGuideFaqItem.astro';
import CalculatorSeoGuide from '../../components/tools/CalculatorSeoGuide.astro';
---

<BaseLayout title="EMI Calculator 2026 - Home, Car & Personal Loan EMI | IPOFins" description="Free EMI calculator for home loans, car loans, and personal loans. Calculate monthly EMI, total interest payable, and principal vs interest breakdown instantly." jsonLd={jsonLd}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">EMI Calculator</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <PageHeader
      title="EMI Calculator"
      subtitle="Calculate your monthly EMI for home loans, car loans, or personal loans. See the complete interest breakdown and total repayment amount."
      freshness="Runs in browser"
      source="No data stored"
    />
  </section>

  <section class="container-narrow py-6">
    <div class="card max-w-2xl mx-auto">
      <EMICalculator client:idle />
    </div>
  </section>

  <ContentGuideSection title="Frequently Asked Questions" variant="faq" bordered container="narrow">
    <ContentGuideFaqList>
      <ContentGuideFaqItem open>
        <span slot="question">How is EMI calculated?</span>
        <p>EMI = [P × R × (1+R)^N] / [(1+R)^N - 1], where P = Principal loan amount, R = Monthly interest rate (annual rate ÷ 12 ÷ 100), N = Total number of monthly installments (years × 12).</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">What is the EMI for a ₹50 lakh home loan?</span>
        <p>For ₹50 lakh at 8.5% for 20 years, monthly EMI is approximately ₹43,391. Total interest paid: ~₹54.1 lakhs over the full tenure.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Does prepayment reduce EMI or tenure?</span>
        <p>You can choose either. Reducing tenure saves more interest overall. Most banks allow prepayment without penalty on floating-rate home loans (per RBI guidelines).</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">What are current home loan rates in India?</span>
        <p>Home loan rates in 2026 range from 8.25% to 9.5%. SBI, HDFC, and ICICI offer competitive rates for borrowers with CIBIL scores above 750.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Longer or shorter loan tenure — which is better?</span>
        <p>Shorter tenure = higher EMI but much less total interest. A ₹50L loan costs ₹19.3L interest over 15 years vs ₹38L over 30 years. Ideal EMI should be 30-40% of monthly income.</p>
      </ContentGuideFaqItem>
    </ContentGuideFaqList>
  </ContentGuideSection>

  <CalculatorSeoGuide slug="emi-calculator" />

  <section class="container-narrow py-8">
    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related Calculators</h2>
    <div class="nav-btn-group">
      <a href="/tools/sip-calculator" class="btn-secondary px-6 py-3">SIP Calculator</a>
      <a href="/tools/cagr-calculator" class="btn-secondary px-6 py-3">CAGR Calculator</a>
      <a href="/tools/return-simulator" class="btn-secondary px-6 py-3">Return Simulator</a>
      <a href="/tools/ipo-profit-calculator" class="btn-secondary px-6 py-3">IPO Profit Calculator</a>
    </div>
  </section>
</BaseLayout>
