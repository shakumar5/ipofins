---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import toolsData from '../../data/tools.json';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Finance Tools - SIP, EMI, FD, PPF | IPOFins",
  "description": "Free online finance calculators: SIP, CAGR, EMI, IPO profit, return simulator, and risk analyzer.",
  "url": "https://ipofins.com/tools",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://ipofins.com/tools" }
    ]
  }
};
import ContentGuideSection from '../../components/content-guide/ContentGuideSection.astro';
import ContentGuideFaqList from '../../components/content-guide/ContentGuideFaqList.astro';
import ContentGuideFaqItem from '../../components/content-guide/ContentGuideFaqItem.astro';
---

<BaseLayout
  title="Finance Tools"
  description="Free online finance tools — SIP, CAGR, EMI, IPO profit, return simulator, and risk analyzer. Make smarter investment decisions."
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Tools</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <section class="container-wide pt-8 pb-6">
    <PageHeader
      title="Finance Tools"
      subtitle="Free, fast, and accurate calculators to help you plan investments, estimate returns, and analyze risk."
      freshness="Runs in browser"
      source="No data stored"
    />
  </section>

  <!-- Tools Grid — grouped by category -->
  <section class="container-wide py-6">
    <!-- Investment Calculators -->
    <div class="mb-8">
      <h2 class="text-base font-semibold text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-4">Investment Calculators</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {['sip-calculator','lumpsum-calculator','swp-calculator','cagr-calculator','return-simulator','step-up-sip-calculator'].map(slug => {
          const tool = toolsData.find(t => t.slug === slug);
          if (!tool) return null;
          return (
            <ToolCard title={tool.title} description={tool.description} href={`/tools/${tool.slug}`} icon={tool.icon} color={tool.color} />
          );
        }).filter(Boolean)}
      </div>
    </div>

    <!-- Loans & Savings -->
    <div class="mb-8">
      <h2 class="text-base font-semibold text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-4">Loans & Savings</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {['emi-calculator','fd-calculator','ppf-calculator','nps-calculator'].map(slug => {
          const tool = toolsData.find(t => t.slug === slug);
          if (!tool) return null;
          return (
            <ToolCard title={tool.title} description={tool.description} href={`/tools/${tool.slug}`} icon={tool.icon} color={tool.color} />
          );
        }).filter(Boolean)}
      </div>
    </div>

    <!-- Tax & Goal Planning -->
    <div class="mb-8">
      <h2 class="text-base font-semibold text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-4">Tax & Goal Planning</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {['tax-calculator','tax-saving-planner','goal-planner','retirement-calculator','rent-vs-buy-calculator'].map(slug => {
          const tool = toolsData.find(t => t.slug === slug);
          if (!tool) return null;
          return (
            <ToolCard title={tool.title} description={tool.description} href={`/tools/${tool.slug}`} icon={tool.icon} color={tool.color} />
          );
        }).filter(Boolean)}
      </div>
    </div>

    <!-- IPO Tools -->
    <div class="mb-4">
      <h2 class="text-base font-semibold text-surface-500 dark:text-surface-400 uppercase tracking-wider mb-4">IPO Tools</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {['ipo-profit-calculator'].map(slug => {
          const tool = toolsData.find(t => t.slug === slug);
          if (!tool) return null;
          return (
            <ToolCard title={tool.title} description={tool.description} href={`/tools/${tool.slug}`} icon={tool.icon} color={tool.color} />
          );
        }).filter(Boolean)}
        {/* Fallback: any tool not in the above groups */}
        {toolsData.filter(t =>
          !['sip-calculator','lumpsum-calculator','swp-calculator','cagr-calculator','return-simulator','step-up-sip-calculator',
            'emi-calculator','fd-calculator','ppf-calculator','nps-calculator',
            'tax-calculator','tax-saving-planner','goal-planner','retirement-calculator','rent-vs-buy-calculator',
            'ipo-profit-calculator'].includes(t.slug)
        ).map(tool => (
          <ToolCard title={tool.title} description={tool.description} href={`/tools/${tool.slug}`} icon={tool.icon} color={tool.color} />
        ))}
      </div>
    </div>
  </section>

  <!-- SEO Content -->
  <section class="container-wide py-12">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">About Our Finance Tools</h2>
      <p class="text-surface-600 dark:text-surface-300">
        IPOFins provides free financial tools to help Indian investors make informed decisions.
        Our tools cover everything from SIP planning and CAGR computation to EMI estimation and IPO profit analysis.
        Each calculator is designed for speed, accuracy, and ease of use on any device.
      </p>
    </div>
    <a href="/blogs/tools" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary-600 hover:underline">
      Tools FAQ — 40+ questions answered →
    </a>
  </section>

  <!-- FAQ -->
  <ContentGuideSection title="Frequently Asked Questions" variant="faq" bordered container="wide">
    <ContentGuideFaqList>
      <ContentGuideFaqItem open>
        <span slot="question">Are these calculators free?</span>
        <p>Yes, 100% free. No signup, no login, no hidden charges. All calculations run in your browser. No data stored.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">How accurate are the results?</span>
        <p>Our calculators use standard financial formulas and give mathematically accurate results. However, actual investment returns vary due to market conditions. Use as planning tools, not guarantees.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Can I use these on mobile?</span>
        <p>Yes. All tools are fully responsive — sliders and inputs work on touch devices. No app needed.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Which calculator should I start with?</span>
        <p>For beginners: SIP Calculator (plan monthly investments). For loans: EMI Calculator. For comparing investments: CAGR Calculator. For IPO investing: IPO Profit Calculator.</p>
      </ContentGuideFaqItem>
    </ContentGuideFaqList>
    <a href="/blogs/tools" class="mt-4 inline-flex text-sm text-primary-600 hover:underline">More tool FAQs →</a>
  </ContentGuideSection>
</BaseLayout>
