---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from '../../components/ToolCard.astro';
import toolsData from '../../data/tools.json';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Finance Tools & Calculators - SIP, EMI, FD, PPF | IPOFins",
  "description": "Free online finance calculators: SIP, CAGR, EMI, IPO profit, return simulator, and risk analyzer.",
  "url": "https://ipofins.com/tools",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://ipofins.com/tools" }
    ]
  }
};
---

<BaseLayout
  title="Finance Tools & Calculators"
  description="Free online finance calculators — SIP, CAGR, EMI, IPO Profit, Return Simulator, and Risk Analyzer. Make smarter investment decisions."
  jsonLd={jsonLd}
>
  <!-- Breadcrumb -->
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Tools</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <section class="container-wide pt-8 pb-6">
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      Finance Tools & Calculators
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300 max-w-2xl">
      Free, fast, and accurate calculators to help you plan investments, estimate returns, and analyze risk.
    </p>
  </section>

  <!-- Tools Grid -->
  <section class="container-wide py-6">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {toolsData.map(tool => (
        <ToolCard
          title={tool.title}
          description={tool.description}
          href={`/tools/${tool.slug}`}
          icon={tool.icon}
          color={tool.color}
        />
      ))}
    </div>
  </section>

  <!-- SEO Content -->
  <section class="container-wide py-12">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">About Our Finance Calculators</h2>
      <p class="text-surface-600 dark:text-surface-300">
        IPOFins provides free financial calculators to help Indian investors make informed decisions.
        Our tools cover everything from SIP planning and CAGR computation to EMI estimation and IPO profit analysis.
        Each calculator is designed for speed, accuracy, and ease of use on any device.
      </p>
    </div>
    <a href="/blogs/tools" class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary-600 hover:underline">
      Tools FAQ — 40+ questions answered →
    </a>
  </section>

  <!-- FAQ -->
  <section class="container-wide py-8">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-4">Frequently Asked Questions</h2>
    <div class="space-y-3 max-w-3xl">
      <details class="card-compact group" open>
        <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">Are these calculators free?</summary>
        <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">Yes, 100% free. No signup, no login, no hidden charges. All calculations run in your browser. No data stored.</p>
      </details>
      <details class="card-compact group">
        <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">How accurate are the results?</summary>
        <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">Our calculators use standard financial formulas and give mathematically accurate results. However, actual investment returns vary due to market conditions. Use as planning tools, not guarantees.</p>
      </details>
      <details class="card-compact group">
        <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">Can I use these on mobile?</summary>
        <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">Yes. All tools are fully responsive — sliders and inputs work on touch devices. No app needed.</p>
      </details>
      <details class="card-compact group">
        <summary class="cursor-pointer font-medium text-sm text-surface-900 dark:text-white">Which calculator should I start with?</summary>
        <p class="mt-2 text-xs text-surface-600 dark:text-surface-300">For beginners: SIP Calculator (plan monthly investments). For loans: EMI Calculator. For comparing investments: CAGR Calculator. For IPO investing: IPO Profit Calculator.</p>
      </details>
    </div>
    <a href="/blogs/tools" class="mt-4 inline-flex text-sm text-primary-600 hover:underline">More tool FAQs →</a>
  </section>
</BaseLayout>
