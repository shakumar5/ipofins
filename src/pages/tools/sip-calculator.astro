---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SIPCalculator from '../../components/calculators/SIPCalculator.tsx';

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "SIP Calculator",
  "description": "Calculate your SIP returns with this free online calculator. See how monthly investments grow over time with compound interest.",
  "url": "https://ipofins.com/tools/sip-calculator",
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "Web",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  },
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ipofins.com" },
      { "@type": "ListItem", "position": 2, "name": "Tools", "item": "https://ipofins.com/tools" },
      { "@type": "ListItem", "position": 3, "name": "SIP Calculator", "item": "https://ipofins.com/tools/sip-calculator" }
    ]
  }
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is a SIP?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SIP (Systematic Investment Plan) is a method of investing a fixed amount regularly in mutual funds. It helps in rupee cost averaging and building wealth over time through the power of compounding."
      }
    },
    {
      "@type": "Question",
      "name": "How is SIP return calculated?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "SIP returns are calculated using the compound interest formula: FV = P × ((1 + r)^n - 1) / r × (1 + r), where P is the monthly investment, r is the monthly rate of return, and n is the total number of months."
      }
    },
    {
      "@type": "Question",
      "name": "What is a good SIP amount to start with?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "You can start a SIP with as little as ₹500 per month. However, ₹5,000-₹10,000 per month is recommended for meaningful wealth creation over 10+ years."
      }
    }
  ]
};
---

<BaseLayout
  title="SIP Calculator 2026 - Free Online SIP Calculator | IPOfins"
  description="Free SIP calculator to estimate mutual fund returns. See how ₹5,000/month grows to ₹1 Cr with compound interest. Includes visual charts and step-up SIP planning."
  jsonLd={jsonLd}
>
  <!-- FAQ JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- Breadcrumb -->
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">SIP Calculator</li>
    </ol>
  </nav>

  <!-- Page Header -->
  <section class="container-wide pt-8 pb-6">
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      SIP Calculator
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300 max-w-2xl">
      Calculate how your systematic monthly investments will grow over time. Adjust the parameters to see the power of compounding.
    </p>
  </section>

  <!-- Calculator -->
  <section class="container-narrow py-6">
    <div class="card max-w-2xl mx-auto">
      <SIPCalculator client:load />
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="container-narrow py-12">
    <h2 class="text-xl font-bold text-surface-900 dark:text-white mb-6">Frequently Asked Questions</h2>
    <div class="space-y-4">
      <details class="card group" open>
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is a SIP?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">
          SIP (Systematic Investment Plan) is a method of investing a fixed amount regularly in mutual funds.
          It helps in rupee cost averaging and building wealth over time through the power of compounding.
        </p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">How is SIP return calculated?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">
          SIP returns are calculated using the compound interest formula: FV = P × ((1 + r)^n - 1) / r × (1 + r),
          where P is the monthly investment, r is the monthly rate of return, and n is the total number of months.
        </p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">What is a good SIP amount to start with?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">
          You can start a SIP with as little as ₹500 per month. However, ₹5,000-₹10,000 per month is recommended
          for meaningful wealth creation over 10+ years.
        </p>
      </details>
      <details class="card group">
        <summary class="cursor-pointer font-medium text-surface-900 dark:text-white">Is SIP safe?</summary>
        <p class="mt-3 text-sm text-surface-600 dark:text-surface-300">
          SIP in mutual funds is subject to market risk. However, investing via SIP reduces timing risk through rupee cost averaging.
          Equity mutual fund SIPs have historically delivered 12-15% returns over 10+ year periods in India.
        </p>
      </details>
    </div>
  </section>

  <!-- SEO Content -->
  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">How to Use This SIP Calculator</h2>
      <p class="text-surface-600 dark:text-surface-300">
        This SIP calculator helps you estimate the future value of your monthly mutual fund investments.
        Simply adjust the monthly investment amount, expected annual return rate, and investment duration to see
        how your money grows. The calculator uses the compound interest formula to give you an accurate projection.
      </p>
      <h3 class="text-base font-semibold text-surface-800 dark:text-surface-200 mt-4 mb-2">Benefits of SIP Investing</h3>
      <ul class="list-disc list-inside text-surface-600 dark:text-surface-300 space-y-1">
        <li>Rupee cost averaging reduces market timing risk</li>
        <li>Power of compounding grows your wealth exponentially</li>
        <li>Disciplined investing habit with small amounts</li>
        <li>Flexibility to increase, decrease, or pause anytime</li>
      </ul>
    </div>
  </section>
</BaseLayout>
