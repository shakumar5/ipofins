---
import { toolPageJsonLd } from '../../lib/tool-schemas';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
import ReturnSimulator from '../../components/calculators/ReturnSimulator.tsx';

const jsonLd = toolPageJsonLd({
  name: "Investment Return Simulator",
  slug: "return-simulator",
  description: "Simulate and compare investment returns across conservative, moderate, and aggressive scenarios over different time horizons.",
});

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "What is a lumpsum investment?", "acceptedAnswer": { "@type": "Answer", "text": "A lumpsum investment is when you invest a large amount at once, as opposed to SIP (monthly installments). Lumpsum works best when markets are low or when you receive a windfall (bonus, inheritance, etc.)." } },
    { "@type": "Question", "name": "What returns can I expect from mutual funds?", "acceptedAnswer": { "@type": "Answer", "text": "Historical returns in India: Large-cap funds deliver 12-14% CAGR, mid-cap 15-18%, small-cap 18-22%, and debt funds 7-9% over 10+ year periods. Past performance doesn't guarantee future results." } },
    { "@type": "Question", "name": "Is lumpsum better than SIP?", "acceptedAnswer": { "@type": "Answer", "text": "Lumpsum gives better returns in rising markets, while SIP wins in volatile/falling markets due to rupee cost averaging. For most investors, SIP is safer. Use lumpsum only when markets are clearly undervalued or you have a long horizon (10+ years)." } },
    { "@type": "Question", "name": "How does compounding work in investments?", "acceptedAnswer": { "@type": "Answer", "text": "Compounding means your returns generate further returns. ₹1 lakh at 12% becomes ₹1.76L in 5 years, ₹3.1L in 10 years, and ₹9.6L in 20 years. The longer you stay invested, the more powerful compounding becomes." } }
  ]
};
import ContentGuideSection from '../../components/content-guide/ContentGuideSection.astro';
import ContentGuideFaqList from '../../components/content-guide/ContentGuideFaqList.astro';
import ContentGuideFaqItem from '../../components/content-guide/ContentGuideFaqItem.astro';
import CalculatorSeoGuide from '../../components/tools/CalculatorSeoGuide.astro';
---

<BaseLayout title="Return Simulator 2026 - Investment Scenarios | IPOFins" description="Free investment return simulator. Compare how your lumpsum grows across conservative (8%), moderate (12%), and aggressive (18%) scenarios over 1-30 years." jsonLd={jsonLd}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />

  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium">Return Simulator</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <PageHeader
      title="Investment Return Simulator"
      subtitle="Compare how your lump-sum investment grows across different risk scenarios. Model conservative, moderate, and aggressive outcomes side by side."
      freshness="Runs in browser"
      source="No data stored"
    />
  </section>

  <section class="container-narrow py-6">
    <div class="card max-w-2xl mx-auto">
      <ReturnSimulator client:idle />
    </div>
  </section>

  <ContentGuideSection title="Frequently Asked Questions" variant="faq" bordered container="narrow">
    <ContentGuideFaqList>
      <ContentGuideFaqItem open>
        <span slot="question">What is a lumpsum investment?</span>
        <p>A lumpsum investment means investing a large amount at once (as opposed to SIP). It works best in rising markets or when you have a long horizon (10+ years) to ride out volatility.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">What returns can I expect from mutual funds?</span>
        <p>Historical Indian market returns: Large-cap 12-14%, Mid-cap 15-18%, Small-cap 18-22%, Debt funds 7-9% CAGR over 10+ years. Past performance doesn't guarantee future results.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">Is lumpsum better than SIP?</span>
        <p>Lumpsum outperforms in rising markets; SIP wins in volatile/falling markets via rupee cost averaging. For most people, SIP is safer. Use lumpsum when markets are undervalued or you have 10+ year horizon.</p>
      </ContentGuideFaqItem>
      <ContentGuideFaqItem>
        <span slot="question">How does compounding work?</span>
        <p>Compounding = returns on returns. ₹1L at 12% becomes ₹1.76L (5yr), ₹3.1L (10yr), ₹9.6L (20yr). The longer you stay invested, the more powerful compounding gets. Time in market > timing the market.</p>
      </ContentGuideFaqItem>
    </ContentGuideFaqList>
  </ContentGuideSection>

  <!-- SEO Content -->
  <section class="container-narrow py-8">
    <div class="prose dark:prose-invert max-w-none text-sm">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-3">How to Use This Return Simulator</h2>
      <p class="text-surface-600 dark:text-surface-300">Enter your lump-sum investment amount and time horizon. The simulator automatically shows three scenarios — conservative (8%), moderate (12%), and aggressive (18%) — so you can visualize the range of possible outcomes for your investment.</p>
      <h3 class="text-base font-semibold text-surface-800 dark:text-surface-200 mt-4 mb-2">Common Use Cases</h3>
      <ul class="list-disc list-inside text-surface-600 dark:text-surface-300 space-y-1">
        <li>Visualizing long-term wealth creation across risk levels</li>
        <li>Deciding how much to invest based on target corpus at retirement</li>
        <li>Understanding the impact of time horizon on compounding returns</li>
        <li>Comparing equity vs debt vs hybrid portfolio outcomes</li>
      </ul>
      <h3 class="text-base font-semibold text-surface-800 dark:text-surface-200 mt-4 mb-2">Choosing the Right Scenario</h3>
      <p class="text-surface-600 dark:text-surface-300">Conservative (8%) suits debt funds, FDs, and PPF. Moderate (12%) represents large-cap equity or balanced funds over 10+ years. Aggressive (18%) reflects mid/small-cap equity performance over long periods. Your actual returns will vary year to year, but these scenarios help set realistic expectations. For goals under 5 years, use the conservative estimate; for 10+ year goals, moderate is a reasonable baseline.</p>
    </div>
  </section>

  <section class="container-narrow py-8">
  <CalculatorSeoGuide slug="return-simulator" />

    <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-4">Related Calculators</h2>
    <div class="nav-btn-group">
      <a href="/tools/sip-calculator" class="btn-secondary px-6 py-3">SIP Calculator</a>
      <a href="/tools/cagr-calculator" class="btn-secondary px-6 py-3">CAGR Calculator</a>
      <a href="/tools/emi-calculator" class="btn-secondary px-6 py-3">EMI Calculator</a>
      <a href="/mutual-funds" class="btn-secondary px-6 py-3">Best Mutual Funds</a>
    </div>
  </section>
</BaseLayout>
