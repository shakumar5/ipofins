---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SuperInvestorsSubNav from '../../../components/tracked/SuperInvestorsSubNav.astro';
import {
  getDistinctHolderSlugs,
  getHoldingsByHolderSlug,
  hasSuperInvestorProfile,
  onePercentStockUrl,
  formatPct,
  formatCr,
  canonicalFor,
  isHolderPageIndexable,
  HOLDER_PAGE_MIN_INDEXABLE_STOCKS,
  superInvestorUrl,
  ONE_PERCENT_CLUB_HUB,
  SUPER_INVESTORS_HUB,
} from '../../../lib/tracked-entities';

export async function getStaticPaths() {
  const holders = await getDistinctHolderSlugs();
  const seen = new Set<string>();
  const paths: {
    params: { holderSlug: string };
    props: { holderName: string; entitySlug: string | null };
  }[] = [];
  for (const h of holders) {
    if (!h.holderSlug || seen.has(h.holderSlug)) continue;
    seen.add(h.holderSlug);
    paths.push({
      params: { holderSlug: h.holderSlug },
      props: { holderName: h.holderName, entitySlug: h.entitySlug },
    });
  }
  return paths;
}

const { holderSlug } = Astro.params;
const { holderName, entitySlug } = Astro.props;
if (!holderSlug) {
  return Astro.redirect('/404');
}
const data = await getHoldingsByHolderSlug(holderSlug, { holderName, entitySlug });

if (!data.rows.length) {
  return Astro.redirect('/404');
}

const indexable = isHolderPageIndexable(data.rows.length);
const robots = indexable
  ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
  : 'noindex, follow';

const path = `${ONE_PERCENT_CLUB_HUB}/holder/${holderSlug}`;
const canonical = canonicalFor(path);
const title = `${data.holderName} — Stocks with ≥1% Shareholding | IPOFins`;
const description = `Stocks where ${data.holderName} holds 1% or more per latest NSE/BSE shareholding pattern disclosure. ${data.rows.length} positions.`;
---

<BaseLayout title={title} description={description} canonicalUrl={canonical} robots={robots}>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
    <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400 flex-wrap">
      <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
      <li><span class="mx-1">/</span></li>
      <li><a href={ONE_PERCENT_CLUB_HUB} class="hover:text-primary-600 transition-colors">1% Club</a></li>
      <li><span class="mx-1">/</span></li>
      <li class="text-surface-900 dark:text-white font-medium truncate max-w-[200px]">{data.holderName}</li>
    </ol>
  </nav>

  <section class="container-wide pt-8 pb-6">
    <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
      {data.holderName}
    </h1>
    <p class="mt-2 text-surface-600 dark:text-surface-300">
      {data.rows.length} stock{data.rows.length === 1 ? '' : 's'} with ≥1% disclosed stake (latest quarter).
    </p>
  {data.entitySlug && hasSuperInvestorProfile(data.entitySlug) && (
    <p class="mt-2 text-sm">
      <a href={superInvestorUrl(data.entitySlug)} class="text-primary-600 dark:text-primary-400 hover:underline font-medium">
        View Super Investor profile →
      </a>
    </p>
  )}
  {!indexable && (
    <p class="mt-3 text-xs text-surface-500 dark:text-surface-400 max-w-2xl">
      This is a single-position holder view from 1% Club search. For full institutional context, see the stock’s{' '}
      <a href={onePercentStockUrl(data.rows[0]!.stockSlug)} class="text-primary-600 dark:text-primary-400 hover:underline">
        ≥1% shareholders page
      </a>
      . Pages with fewer than {HOLDER_PAGE_MIN_INDEXABLE_STOCKS} disclosed positions are not indexed.
    </p>
  )}
    <SuperInvestorsSubNav active="club" />
  </section>

  <section class="container-wide pb-10">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wide text-surface-500 dark:text-surface-400 border-b border-surface-200 dark:border-surface-700">
            <th class="py-2 pr-4 font-medium">Stock</th>
            <th class="py-2 px-4 font-medium">Type</th>
            <th class="py-2 px-4 font-medium text-right">% of company</th>
            <th class="py-2 px-4 font-medium text-right">Shares</th>
            <th class="py-2 pl-4 font-medium text-right">Value (₹ Cr)</th>
          </tr>
        </thead>
        <tbody>
          {data.rows.map((row) => (
            <tr class="border-b border-surface-100 dark:border-surface-800">
              <td class="py-3 pr-4">
                <a href={onePercentStockUrl(row.stockSlug)} class="font-medium text-primary-600 hover:underline">
                  {row.stockName}
                </a>
              </td>
              <td class="py-3 px-4 capitalize text-surface-600 dark:text-surface-300">{row.holderType.replace('_', ' ')}</td>
              <td class="py-3 px-4 text-right font-semibold">{formatPct(row.pctOfCompany)}</td>
              <td class="py-3 px-4 text-right text-surface-600 dark:text-surface-300">
                {row.shares != null ? Number(row.shares).toLocaleString('en-IN') : '—'}
              </td>
              <td class="py-3 pl-4 text-right font-medium tabular-nums">{formatCr(row.marketValueCr)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="container-wide pb-10 max-w-3xl">
    <div class="card bg-warning-50/60 dark:bg-warning-950/20 border border-warning-200 dark:border-warning-900/40">
      <p class="text-xs text-surface-700 dark:text-surface-300">
        Data from quarterly shareholding pattern filings. Only stakes ≥1% are disclosed. Not investment advice.{' '}
        <a href="/methodology" class="text-primary-600 dark:text-primary-400 hover:underline">Methodology →</a>
      </p>
    </div>
  </section>

  <section class="container-wide py-6">
    <div class="nav-btn-group">
      <a href={ONE_PERCENT_CLUB_HUB} class="btn-secondary px-6 py-3">1% Club</a>
      <a href={SUPER_INVESTORS_HUB} class="btn-secondary px-6 py-3">Super Investors</a>
    </div>
  </section>
</BaseLayout>
