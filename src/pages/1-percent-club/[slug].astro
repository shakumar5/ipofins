---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SuperInvestorsSubNav from '../../components/tracked/SuperInvestorsSubNav.astro';
import {
  getOnePercentStockSlugs,
  getOnePercentHoldersForStock,
  curatedEntityUrl,
  formatPct,
  formatCr,
  formatQuarter,
  buildOnePercentStockSeo,
  canonicalFor,
  ONE_PERCENT_CLUB_HUB,
  SUPER_INVESTORS_HUB,
} from '../../lib/tracked-entities';
import StockCrossLinks from '../../components/tracked/StockCrossLinks.astro';
import { loadSmartMoneyStockSlugs } from '../../lib/smart-money-stock-slugs';

export async function getStaticPaths() {
  const stocks = await getOnePercentStockSlugs();
  return stocks.map(({ slug, stockName }) => ({ params: { slug }, props: { slug, stockName } }));
}

const { slug, stockName } = Astro.props;

const holders = await getOnePercentHoldersForStock(slug);
const hasData = holders.length > 0;

if (!hasData) {
  return Astro.redirect('/404');
}

const path = `${ONE_PERCENT_CLUB_HUB}/${slug}`;
const canonical = canonicalFor(path);

const curatedCount = holders.filter((h) => h.entitySlug).length;
const mysteryCount = holders.length - curatedCount;

const seo = buildOnePercentStockSeo(stockName, holders, curatedCount, mysteryCount);
const title = seo.title;
const description = seo.description;

const mfSlugs = new Set(loadSmartMoneyStockSlugs().map((s) => s.slug));
const curatedInvestors = holders
  .filter((h) => h.entitySlug)
  .map((h) => ({ slug: h.entitySlug!, name: h.holderName, pct: h.pctOfCompany }));

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://ipofins.com' },
    { '@type': 'ListItem', position: 2, name: '1% Club', item: canonicalFor(ONE_PERCENT_CLUB_HUB) },
    { '@type': 'ListItem', position: 3, name: stockName, item: canonical },
  ],
};

const latestQuarter = holders[0]?.quarter ?? null;
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonical}
  ogImage="/og-fund.png"
  jsonLd={breadcrumbJsonLd}
>
  <nav class="container-wide pt-6" aria-label="Breadcrumb">
        <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400 flex-wrap">
          <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
          <li><span class="mx-1">/</span></li>
          <li><a href={ONE_PERCENT_CLUB_HUB} class="hover:text-primary-600 transition-colors">1% Club</a></li>
          <li><span class="mx-1">/</span></li>
          <li class="text-surface-900 dark:text-white font-medium">{stockName}</li>
        </ol>
      </nav>

      <section class="container-wide pt-8 pb-6">
        <h1 class="text-3xl lg:text-4xl font-extrabold text-surface-900 dark:text-white tracking-tight">
          {stockName} — ≥1% Shareholders
        </h1>
        <p class="mt-3 text-surface-600 dark:text-surface-300 max-w-3xl">
          Every non-promoter shareholder owning 1% or more of {stockName}, parsed from the latest quarterly
          Shareholding Pattern filing. Curated holders link to a tracked profile; mystery holders are flagged.
        </p>
        {hasData && (
          <div class="flex flex-wrap gap-3 mt-4 text-sm">
            <span class="px-3 py-1 bg-success-100 text-success-700 dark:bg-success-900/40 dark:text-success-300 rounded-full">
              {curatedCount} curated
            </span>
            <span class="px-3 py-1 bg-warning-100 text-warning-700 dark:bg-warning-900/40 dark:text-warning-300 rounded-full">
              {mysteryCount} mystery
            </span>
            {latestQuarter && (
              <span class="px-3 py-1 bg-surface-100 text-surface-600 dark:bg-surface-700 dark:text-surface-300 rounded-full">
                Quarter: {formatQuarter(latestQuarter)}
              </span>
            )}
          </div>
        )}
        <SuperInvestorsSubNav active="club" />
      </section>

      <StockCrossLinks
        stockName={stockName}
        stockSlug={slug}
        curatedInvestors={curatedInvestors}
        showMfStockSignal={mfSlugs.has(slug)}
        showOnePercentClub={false}
        latestQuarter={latestQuarter}
      />

      {hasData ? (
        <section class="container-wide py-4">
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-xs uppercase tracking-wide text-surface-500 dark:text-surface-400 border-b border-surface-200 dark:border-surface-700">
                  <th class="py-2 pr-4 font-medium">Holder</th>
                  <th class="py-2 px-4 font-medium">Type</th>
                  <th class="py-2 px-4 font-medium text-right">% of company</th>
                  <th class="py-2 px-4 font-medium text-right">Shares</th>
                  <th class="py-2 pl-4 font-medium text-right">Value (₹ Cr)</th>
                </tr>
              </thead>
              <tbody>
                {holders.map((h) => {
                  const isCurated = !!h.entitySlug;
                  return (
                    <tr class="border-b border-surface-100 dark:border-surface-800">
                      <td class="py-3 pr-4 font-medium text-surface-900 dark:text-white">
                        {isCurated ? (
                          <a
                            href={curatedEntityUrl(h.entitySlug)!}
                            class="hover:text-primary-600 dark:hover:text-primary-400 hover:underline"
                            title={h.filingNames?.join('\n')}
                          >
                            {h.holderName}
                            {h.filingCount && h.filingCount > 1 && (
                              <span class="block text-[11px] font-normal text-surface-500 dark:text-surface-400 mt-0.5">
                                {h.filingCount} related filings combined
                              </span>
                            )}
                          </a>
                        ) : (
                          h.holderName
                        )}
                      </td>
                      <td class="py-3 px-4 text-surface-600 dark:text-surface-300 capitalize">{h.holderType.replace('_', ' ')}</td>
                      <td class="py-3 px-4 text-right font-semibold text-surface-800 dark:text-surface-100">{formatPct(h.pctOfCompany)}</td>
                      <td class="py-3 px-4 text-right text-surface-600 dark:text-surface-300">
                        {h.shares != null ? Number(h.shares).toLocaleString('en-IN') : '—'}
                      </td>
                      <td class="py-3 pl-4 text-right font-medium tabular-nums">{formatCr(h.marketValueCr)}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>
      ) : (
        <section class="container-wide py-10">
          <div class="card text-center max-w-xl mx-auto">
            <p class="text-sm text-surface-600 dark:text-surface-300">
              No ≥1% non-promoter holders disclosed for {stockName} in the latest quarter. This can happen when
              the only ≥1% holders are promoters (excluded by design).
            </p>
          </div>
        </section>
      )}

      <!-- Disclaimer -->
      <section class="container-wide py-8 max-w-3xl">
        <div class="card bg-warning-50/60 dark:bg-warning-950/20 border border-warning-200 dark:border-warning-900/40">
          <p class="text-xs text-surface-700 dark:text-surface-300">
            Shareholding data sourced from NSE/BSE regulatory filings. Not investment advice. See our
            <a href="/disclaimer" class="text-primary-600 hover:underline">disclaimer</a> and
            <a href="/methodology" class="text-primary-600 hover:underline">methodology</a>.
          </p>
        </div>
      </section>

      <section class="container-wide py-4">
        <div class="nav-btn-group">
          <a href={ONE_PERCENT_CLUB_HUB} class="btn-secondary px-6 py-3">All 1% Club stocks</a>
          <a href="/super-investors" class="btn-secondary px-6 py-3">Super Investors</a>
        </div>
      </section>
</BaseLayout>
