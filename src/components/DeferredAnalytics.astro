---
/** Loads Vercel Analytics + web-vitals hook registration after idle — not on the LCP critical path. */
---

<script>
  function bootDeferredAnalytics() {
    void import('@vercel/analytics').then(({ inject }) => inject());
    void import('../lib/web-vitals-report');
  }

  if (typeof requestIdleCallback === 'function') {
    requestIdleCallback(bootDeferredAnalytics, { timeout: 4000 });
  } else {
    setTimeout(bootDeferredAnalytics, 2000);
  }
</script>
