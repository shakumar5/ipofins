---
interface Props {
  name: string;
  slug: string;
  detailSlug?: string;
  category: string;
  returns1y?: number;
  returns3y?: number;
  returns5y?: number;
  nav?: number | null;
  rating?: number;
  aum?: string;
  riskLevel: 'low' | 'moderate' | 'high' | 'very-high';
}

const {
  name,
  slug,
  detailSlug,
  category,
  returns1y,
  returns3y,
  returns5y,
  nav,
  rating,
  aum,
  riskLevel,
} = Astro.props;

const riskConfig = {
  low: { label: 'Low', class: 'text-success-500 bg-success-50 dark:bg-success-500/10' },
  moderate: { label: 'Moderate', class: 'text-warning-500 bg-warning-50 dark:bg-warning-500/10' },
  high: { label: 'High', class: 'text-danger-500 bg-danger-50 dark:bg-danger-500/10' },
  'very-high': { label: 'Very High', class: 'text-danger-600 bg-danger-50 dark:bg-danger-500/10' },
};

const risk = riskConfig[riskLevel];
---

<a href={`/mutual-funds/fund/${detailSlug || slug}-holdings`} class="card group block">
  <!-- Header -->
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1 min-w-0">
      <h3 class="text-base font-semibold text-surface-900 dark:text-white truncate group-hover:text-primary-600 transition-colors">
        {name}
      </h3>
      <p class="text-xs text-surface-500 dark:text-surface-400 mt-1">{category}</p>
    </div>
    {rating && (
      <div class="flex items-center gap-0.5">
        {Array.from({ length: rating }).map(() => (
          <svg class="w-3.5 h-3.5 text-warning-500" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        ))}
      </div>
    )}
  </div>

  <!-- Returns -->
  <div class="grid grid-cols-3 gap-3 mb-4">
    <div class="text-center p-2 bg-surface-50 dark:bg-surface-700/50 rounded-lg">
      <p class="text-xs text-surface-500 dark:text-surface-400">1Y</p>
      <p class={`text-sm font-bold font-mono ${returns1y && returns1y >= 0 ? 'text-success-500' : 'text-danger-500'}`}>
        {returns1y !== undefined ? `${returns1y > 0 ? '+' : '−'}${Math.abs(returns1y)}%` : '—'}
      </p>
    </div>
    <div class="text-center p-2 bg-surface-50 dark:bg-surface-700/50 rounded-lg">
      <p class="text-xs text-surface-500 dark:text-surface-400">3Y</p>
      <p class={`text-sm font-bold font-mono ${returns3y && returns3y >= 0 ? 'text-success-500' : 'text-danger-500'}`}>
        {returns3y !== undefined ? `${returns3y > 0 ? '+' : '−'}${Math.abs(returns3y)}%` : '—'}
      </p>
    </div>
    <div class="text-center p-2 bg-surface-50 dark:bg-surface-700/50 rounded-lg">
      <p class="text-xs text-surface-500 dark:text-surface-400">5Y</p>
      <p class={`text-sm font-bold font-mono ${returns5y && returns5y >= 0 ? 'text-success-500' : 'text-danger-500'}`}>
        {returns5y !== undefined ? `${returns5y > 0 ? '+' : '−'}${Math.abs(returns5y)}%` : '—'}
      </p>
    </div>
  </div>

  <!-- Bottom -->
  <div class="flex items-center justify-between pt-3 border-t border-surface-100 dark:border-surface-700">
    <div>
      <p class="text-xs text-surface-500 dark:text-surface-400">NAV</p>
      <p class="text-sm font-semibold font-mono text-surface-800 dark:text-surface-200">{nav != null ? `₹${nav.toFixed(2)}` : '—'}</p>
    </div>
    {aum && (
      <div class="text-right">
        <p class="text-xs text-surface-500 dark:text-surface-400">AUM</p>
        <p class="text-sm font-medium text-surface-700 dark:text-surface-300">{aum}</p>
      </div>
    )}
    <span class={`badge ${risk.class}`}>{risk.label}</span>
  </div>
</a>
