---
/**
 * AdUnit Component — Google AdSense Ad Placement
 * Ads initialize only after cookie consent via window.__initAdsenseSlots()
 */

interface Props {
  slot: string;
  format?: 'auto' | 'horizontal' | 'rectangle' | 'vertical';
  responsive?: boolean;
  className?: string;
}

const {
  slot,
  format = 'auto',
  responsive = true,
  className = '',
} = Astro.props;

const CLIENT_ID = 'ca-pub-9843041963430696';

const heightMap: Record<string, string> = {
  auto: '100px',
  horizontal: '90px',
  rectangle: '280px',
  vertical: '600px',
};
const minHeight = heightMap[format] || heightMap.auto;
---

<div class={`ad-container ${className}`} style={`min-height: ${minHeight};`} aria-label="Advertisement">
  <ins class="adsbygoogle"
    style={format === 'rectangle' ? 'display:inline-block; width:336px; height:280px' : 'display:block'}
    data-ad-client={CLIENT_ID}
    data-ad-slot={slot}
    data-ad-format={format === 'auto' ? 'auto' : undefined}
    data-full-width-responsive={responsive ? 'true' : undefined}
    data-ad-pending="true"
  ></ins>
</div>

<style>
  .ad-container {
    min-height: 0;
    text-align: center;
    overflow: hidden;
    margin: 2rem 0;
    padding: 1rem 0;
  }
  /* Avoid :has() — it forces full-document style recalc when ads fill during scroll. */
  .ad-container ins:not([data-ad-status="filled"]) {
    display: none !important;
  }
  .ad-container ins[data-ad-status="filled"] {
    display: block;
    margin-top: 0.75rem;
    margin-bottom: 0.75rem;
  }
</style>
