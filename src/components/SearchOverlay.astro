<!-- Search Overlay -->
<div id="search-overlay" class="hidden fixed inset-0 z-[100] bg-black/50 backdrop-blur-sm">
  <div class="max-w-xl mx-auto mt-20 px-4">
    <div class="bg-white dark:bg-surface-800 rounded-xl shadow-2xl border border-surface-200 dark:border-surface-700 overflow-hidden">
      <!-- Input -->
      <div class="flex items-center gap-3 px-4 py-3 border-b border-surface-200 dark:border-surface-700">
        <svg class="w-5 h-5 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          id="search-input"
          type="text"
          placeholder="Search IPOs, funds, tools, articles..."
          class="flex-1 bg-transparent text-surface-900 dark:text-white text-sm outline-none placeholder:text-surface-400"
          autocomplete="off"
        />
        <button id="search-close" class="text-xs text-surface-400 border border-surface-300 dark:border-surface-600 px-2 py-0.5 rounded">ESC</button>
      </div>
      <!-- Results -->
      <div id="search-results" class="max-h-80 overflow-y-auto p-2">
        <p class="text-xs text-surface-400 text-center py-6">Start typing to search...</p>
      </div>
    </div>
  </div>
</div>

<!-- Search Logic (loads data on-demand) -->
<script is:inline>
(function() {
  var _items = null;
  var _loading = false;
  var _so, _sin, _sr;

  function init() {
    _so = document.getElementById('search-overlay');
    _sin = document.getElementById('search-input');
    _sr = document.getElementById('search-results');
    var _sc = document.getElementById('search-close');
    var _sb = document.getElementById('search-trigger');
    if (_sb) _sb.addEventListener('click', openSearch);
    if (_sc) _sc.addEventListener('click', closeSearch);
    if (_so) _so.addEventListener('click', function(e) { if (e.target === _so) closeSearch(); });
    if (_sin) _sin.addEventListener('input', function(e) { doSearch(e.target.value); });
  }

  function loadData() {
    if (_items || _loading) return;
    _loading = true;
    fetch('/data/search-index.json')
      .then(function(r) { return r.json(); })
      .then(function(data) { _items = data; _loading = false; })
      .catch(function() { _loading = false; });
  }

  function openSearch() {
    _so.classList.remove('hidden');
    _sin.value = '';
    _sin.focus();
    _sr.innerHTML = '<p class="text-xs text-surface-400 text-center py-6">Start typing to search...</p>';
    loadData();
  }

  function closeSearch() {
    _so.classList.add('hidden');
  }

  function doSearch(query) {
    if (!_items) {
      _sr.innerHTML = '<p class="text-xs text-surface-400 text-center py-6">Loading search data...</p>';
      loadData();
      return;
    }
    if (!query || query.length < 2) {
      _sr.innerHTML = '<p class="text-xs text-surface-400 text-center py-6">Start typing to search...</p>';
      return;
    }
    var q = query.toLowerCase();
    var matches = _items.filter(function(item) {
      return item.t.toLowerCase().indexOf(q) !== -1 || item.m.toLowerCase().indexOf(q) !== -1 || item.y.toLowerCase().indexOf(q) !== -1;
    }).slice(0, 8);

    if (matches.length === 0) {
      _sr.innerHTML = '<p class="text-xs text-surface-500 text-center py-6">No results found</p>';
      return;
    }

    _sr.innerHTML = matches.map(function(item) {
      return '<a href="' + item.u + '" class="flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-surface-100 dark:hover:bg-surface-700 transition-colors">' +
        '<span class="px-1.5 py-0.5 text-xs font-medium rounded bg-surface-100 dark:bg-surface-700 text-surface-500">' + item.y + '</span>' +
        '<div class="flex-1 min-w-0"><p class="text-sm font-medium text-surface-900 dark:text-white truncate">' + item.t + '</p>' +
        '<p class="text-xs text-surface-400 truncate">' + item.m + '</p></div>' +
        '<svg class="w-4 h-4 text-surface-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>';
    }).join('');
  }

  document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
    if (e.key === 'Escape') closeSearch();
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>
