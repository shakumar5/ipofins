<!-- Search Overlay -->
<div
  id="search-overlay"
  class="hidden fixed inset-0 z-[100] bg-black/60"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-dialog-title"
  aria-hidden="true"
>
  <div class="max-w-xl mx-auto mt-20 px-4">
    <div class="bg-white dark:bg-surface-800 rounded-xl shadow-2xl border border-surface-200 dark:border-surface-700 overflow-hidden">
      <div class="flex items-center gap-3 px-4 py-3 border-b border-surface-200 dark:border-surface-700">
        <svg class="w-5 h-5 text-surface-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <label id="search-dialog-title" class="sr-only" for="search-input">Search site</label>
        <input
          id="search-input"
          type="search"
          placeholder="Search IPOs, super investors, stocks, tools..."
          class="flex-1 bg-transparent text-surface-900 dark:text-white text-sm outline-none placeholder:text-surface-400"
          autocomplete="off"
        />
        <button id="search-close" type="button" class="text-xs text-surface-400 border border-surface-300 dark:border-surface-600 px-2 py-0.5 rounded">ESC</button>
      </div>
      <div id="search-results" class="max-h-80 overflow-y-auto p-2 overscroll-contain" role="listbox" aria-live="polite">
        <p class="text-xs text-surface-400 text-center py-6">Start typing to search IPOs, super investors, 1% Club stocks, tools…</p>
      </div>
      <div class="px-4 py-2 border-t border-surface-100 dark:border-surface-700 flex items-center justify-between">
        <span class="text-[10px] text-surface-400">Type 2+ characters • Matches name &amp; keywords</span>
        <span class="text-[10px] text-surface-400">⌘K / Ctrl+K to open</span>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function() {
  var BATCH_SIZE = 100;
  var DEBOUNCE_MS = 150;
  var MIN_QUERY_LEN = 2;
  var MAX_RESULTS = 10;

  var _rows = null;
  var _loading = false;
  var _loadError = false;
  var _so, _sin, _sr, _lastFocus;
  var _debounce = null;
  var _trapHandler = null;
  var _searchGen = 0;

  var catColors = {
    IPO: 'bg-green-50 text-green-700 dark:bg-green-900/30 dark:text-green-400',
    Fund: 'bg-blue-50 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
    Broker: 'bg-purple-50 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400',
    Tool: 'bg-orange-50 text-orange-700 dark:bg-orange-900/30 dark:text-orange-400',
    Learn: 'bg-yellow-50 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400',
    Investor: 'bg-teal-50 text-teal-700 dark:bg-teal-900/30 dark:text-teal-400',
    Stock: 'bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-400',
    Page: 'bg-surface-100 text-surface-700 dark:bg-surface-800 dark:text-surface-300'
  };

  function init() {
    _so = document.getElementById('search-overlay');
    _sin = document.getElementById('search-input');
    _sr = document.getElementById('search-results');
    var _sc = document.getElementById('search-close');
    var _sb = document.getElementById('search-trigger');
    var _msb = document.getElementById('mobile-search-trigger');
    if (_sb) _sb.addEventListener('click', openSearch);
    if (_msb) _msb.addEventListener('click', function() {
      var mobileMenu = document.getElementById('mobile-menu');
      var mobileMenuBtn = document.getElementById('mobile-menu-btn');
      if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
        mobileMenu.classList.add('hidden');
        if (mobileMenuBtn) mobileMenuBtn.setAttribute('aria-expanded', 'false');
      }
      openSearch();
    });
    if (_sc) _sc.addEventListener('click', closeSearch);
    if (_so) _so.addEventListener('click', function(e) { if (e.target === _so) closeSearch(); });
    if (_sin) _sin.addEventListener('input', function(e) {
      clearTimeout(_debounce);
      _debounce = setTimeout(function() { doSearch(e.target.value); }, DEBOUNCE_MS);
    });
  }

  function isSafePath(path) {
    return typeof path === 'string' && path.charAt(0) === '/' && path.indexOf('://') === -1 && path.indexOf('javascript:') === -1;
  }

  function setMessage(text) {
    _sr.textContent = '';
    var p = document.createElement('p');
    p.className = 'text-xs text-surface-400 text-center py-6';
    p.textContent = text;
    _sr.appendChild(p);
  }

  function indexRows(items) {
    _rows = new Array(items.length);
    for (var i = 0; i < items.length; i++) {
      var item = items[i];
      _rows[i] = {
        item: item,
        text: ((item.k || '') + ' ' + item.t + ' ' + item.m + ' ' + item.y).toLowerCase()
      };
    }
  }

  function parseIndexAsync(text, cb) {
    var run = function() {
      try {
        indexRows(JSON.parse(text));
        cb(null);
      } catch (err) {
        cb(err);
      }
    };
    if (typeof requestIdleCallback === 'function') {
      requestIdleCallback(run, { timeout: 500 });
    } else {
      setTimeout(run, 0);
    }
  }

  function loadData(cb) {
    if (_rows) { if (cb) cb(); return; }
    if (_loading) return;
    _loading = true;
    _loadError = false;
    fetch('/data/search-index.json')
      .then(function(r) { if (!r.ok) throw new Error('fetch failed'); return r.text(); })
      .then(function(text) {
        parseIndexAsync(text, function(err) {
          _loading = false;
          if (err) {
            _loadError = true;
            setMessage('Search unavailable. Please try again.');
            return;
          }
          if (cb) cb();
        });
      })
      .catch(function() {
        _loading = false;
        _loadError = true;
        setMessage('Search unavailable. Please try again.');
      });
  }

  function trapFocus() {
    if (!_so) return;
    if (_trapHandler) _so.removeEventListener('keydown', _trapHandler);
    var focusables = _so.querySelectorAll('button, input, a[href]');
    if (!focusables.length) return;
    var first = focusables[0];
    var last = focusables[focusables.length - 1];
    _trapHandler = function(e) {
      if (e.key !== 'Tab') return;
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    };
    _so.addEventListener('keydown', _trapHandler);
  }

  function openSearch() {
    _searchGen++;
    _lastFocus = document.activeElement;
    _so.classList.remove('hidden');
    _so.setAttribute('aria-hidden', 'false');
    _sin.value = '';
    setMessage('Start typing to search across IPOs, mutual funds, brokers, tools...');
    requestAnimationFrame(function() {
      _sin.focus();
      trapFocus();
    });
    loadData();
  }

  function closeSearch() {
    _searchGen++;
    _so.classList.add('hidden');
    _so.setAttribute('aria-hidden', 'true');
    if (_lastFocus && _lastFocus.focus) _lastFocus.focus();
  }

  /** Fast substring / word-prefix scoring only — avoids O(n×m) subsequence fuzzy. */
  function quickScore(q, t) {
    if (t.indexOf(q) !== -1) return 100 + (q.length / t.length) * 50;
    var words = t.split(/[\s\-_]+/);
    for (var w = 0; w < words.length; w++) {
      if (words[w].indexOf(q) === 0) return 80;
    }
    return 0;
  }

  function renderResults(matches) {
    _sr.textContent = '';
    var frag = document.createDocumentFragment();
    for (var m = 0; m < matches.length; m++) {
      var item = matches[m].item;
      if (!isSafePath(item.u)) continue;
      var a = document.createElement('a');
      a.href = item.u;
      a.className = 'flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-surface-100 dark:hover:bg-surface-700 transition-colors';
      a.setAttribute('role', 'option');

      var badge = document.createElement('span');
      badge.className = 'px-1.5 py-0.5 text-[10px] font-bold rounded whitespace-nowrap ' + (catColors[item.y] || 'bg-surface-100 text-surface-500');
      badge.textContent = item.y || '';

      var body = document.createElement('div');
      body.className = 'flex-1 min-w-0';
      var title = document.createElement('p');
      title.className = 'text-sm font-medium text-surface-900 dark:text-white truncate';
      title.textContent = item.t || '';
      var meta = document.createElement('p');
      meta.className = 'text-xs text-surface-400 dark:text-surface-500 truncate';
      meta.textContent = item.m || '';

      body.appendChild(title);
      body.appendChild(meta);
      a.appendChild(badge);
      a.appendChild(body);
      frag.appendChild(a);
    }
    _sr.appendChild(frag);
  }

  function doSearch(query) {
    if (_loadError) return;
    if (!_rows) {
      setMessage('Loading...');
      loadData(function() { doSearch(query); });
      return;
    }
    if (!query || query.length < MIN_QUERY_LEN) {
      setMessage('Type at least ' + MIN_QUERY_LEN + ' characters to search…');
      return;
    }

    var q = query.trim().toLowerCase();
    var gen = ++_searchGen;
    var scored = [];
    var i = 0;

    function processBatch() {
      if (gen !== _searchGen) return;
      var end = Math.min(i + BATCH_SIZE, _rows.length);
      for (; i < end; i++) {
        var row = _rows[i];
        var s = quickScore(q, row.text);
        if (s > 0) scored.push({ item: row.item, score: s });
      }
      if (i < _rows.length) {
        requestAnimationFrame(processBatch);
        return;
      }

      scored.sort(function(a, b) { return b.score - a.score; });
      var top = scored.slice(0, MAX_RESULTS);
      if (top.length === 0) {
        setMessage('No results for "' + query.trim() + '"');
        return;
      }
      renderResults(top);
    }

    setMessage('Searching…');
    requestAnimationFrame(processBatch);
  }

  document.addEventListener('keydown', function(e) {
    if ((e.ctrlKey || e.metaKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
    if (e.key === 'Escape' && _so && !_so.classList.contains('hidden')) closeSearch();
  });

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
  else init();
})();
</script>
