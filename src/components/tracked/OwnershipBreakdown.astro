---
import type { StockShareholdingDetail } from '../../lib/tracked-entities';
import { formatPct, formatQuarter } from '../../lib/tracked-entities';
import { getOwnershipBreakdown } from '../../lib/ownership-breakdown';

interface Props {
  detail: StockShareholdingDetail;
}

const { detail } = Astro.props;
const breakdown = getOwnershipBreakdown(detail);
const { segments, mode, chartTotal, superInvestorTotalPct, onePercentClubTotalPct } = breakdown;
const quarterLabel = detail.summary.quarter ? formatQuarter(detail.summary.quarter) : null;
---

{segments.length > 0 ? (
  <section class="container-wide pb-6">
    <div class="card">
      <h2 class="text-lg font-bold text-surface-900 dark:text-white mb-1">Ownership breakdown</h2>
      {mode === 'verified' ? (
        <p class="text-xs text-surface-500 dark:text-surface-400 mb-4">
          Category totals from the official quarterly Shareholding Pattern filing
          {quarterLabel ? ` (${quarterLabel})` : ''}. Sums to {formatPct(chartTotal)}.
        </p>
      ) : (
        <p class="text-xs text-surface-500 dark:text-surface-400 mb-4">
          Estimated from named holders at or above 1% in the latest filing
          {quarterLabel ? ` (${quarterLabel})` : ''}. Official category totals not yet parsed. Sums to {formatPct(chartTotal)}.
        </p>
      )}

      <div
        class="flex h-8 w-full rounded-lg overflow-hidden ring-1 ring-surface-200 dark:ring-surface-700"
        role="img"
        aria-label="Ownership breakdown chart"
      >
        {segments.map((seg) => (
          <div
            class={`${seg.colorClass} min-w-[2px]`}
            style={`width: ${seg.pct}%`}
            title={`${seg.label}: ${formatPct(seg.pct)}`}
          />
        ))}
      </div>

      <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-surface-600 dark:text-surface-300">
        {segments.map((seg) => (
          <li class="flex items-center gap-1.5">
            <span class={`inline-block w-2.5 h-2.5 rounded-sm ${seg.colorClass}`} />
            {seg.label} {formatPct(seg.pct)}
          </li>
        ))}
        {superInvestorTotalPct > 0.01 && (
          <li class="flex items-center gap-1.5">
            <span class="inline-block w-2.5 h-2.5 rounded-sm bg-emerald-500" />
            Super Investors {formatPct(superInvestorTotalPct)} <span class="text-surface-400">(subset)</span>
          </li>
        )}
        {onePercentClubTotalPct > 0.01 && (
          <li class="flex items-center gap-1.5">
            <span class="inline-block w-2.5 h-2.5 rounded-sm bg-orange-500" />
            1% Club {formatPct(onePercentClubTotalPct)} <span class="text-surface-400">(subset)</span>
          </li>
        )}
      </ul>

      <p class="mt-3 text-[11px] text-surface-500 dark:text-surface-400">
        Super Investors and 1% Club names below are disclosed holders at or above 1%. They are subsets of the categories above, not additive.
        {detail.summary.sourceUrl && (
          <>
            {' '}
            <a
              href={detail.summary.sourceUrl}
              rel="nofollow noopener noreferrer"
              target="_blank"
              class="text-primary-600 dark:text-primary-400 hover:underline"
            >
              View filing
            </a>
          </>
        )}
      </p>
    </div>
  </section>
) : (
  <section class="container-wide pb-6">
    <div class="card bg-warning-50/50 dark:bg-warning-950/20">
      <p class="text-sm text-surface-600 dark:text-surface-300">
        Category totals not yet parsed for this stock. Showing named holders only. Re-run pipeline:superinvestor after migration 010.
      </p>
    </div>
  </section>
)}