---
interface Props {
  score: number;
  size?: 'sm' | 'md' | 'lg';
  showLabel?: boolean;
}

const { score, size = 'md', showLabel = true } = Astro.props;

const getColor = (s: number) => {
  if (s <= 3) return { text: 'text-success-500', bg: 'bg-success-50 dark:bg-success-500/10', ring: 'ring-success-500/20' };
  if (s <= 6) return { text: 'text-warning-500', bg: 'bg-warning-50 dark:bg-warning-500/10', ring: 'ring-warning-500/20' };
  return { text: 'text-danger-500', bg: 'bg-danger-50 dark:bg-danger-500/10', ring: 'ring-danger-500/20' };
};

const getLabel = (s: number) => {
  if (s <= 3) return 'Low Risk';
  if (s <= 6) return 'Medium Risk';
  return 'High Risk';
};

const color = getColor(score);
const label = getLabel(score);

const sizeClasses = {
  sm: 'w-8 h-8 text-xs',
  md: 'w-10 h-10 text-sm',
  lg: 'w-12 h-12 text-base',
};
---

<div class="flex items-center gap-2">
  <div class={`${sizeClasses[size]} ${color.bg} ${color.text} ring-1 ${color.ring} rounded-full flex items-center justify-center font-bold`}>
    {score}
  </div>
  {showLabel && (
    <span class={`text-xs font-medium ${color.text}`}>{label}</span>
  )}
</div>
