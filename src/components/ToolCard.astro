---
interface Props {
  title: string;
  description: string;
  href: string;
  icon: string;
  color?: string;
}

const { title, description, href, icon } = Astro.props;
---

<a href={href} class="card group block">
  <div class="flex items-start gap-4">
    <div class="tool-card-icon" aria-hidden="true">
      <span>{icon}</span>
    </div>
    <div class="flex-1 min-w-0">
      <h3 class="text-base font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
        {title}
      </h3>
      <p class="text-sm text-surface-500 dark:text-surface-400 mt-1 line-clamp-2">
        {description}
      </p>
    </div>
    <svg class="w-5 h-5 text-surface-400 group-hover:text-primary-500 transition-colors flex-shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </div>
</a>
