---
import { BRAND_NAME } from '../lib/brand';
import BrandLogo from './BrandLogo.astro';
import { loadSmartMoneyTrackerLinks } from '../lib/smart-money-tracker-links';

const sm = loadSmartMoneyTrackerLinks();

const footerSections = [
  {
    title: 'IPOs',
    links: [
      { label: 'Mainboard IPOs', href: '/ipo/mainboard' },
      { label: 'SME IPOs', href: '/ipo/sme' },
      { label: 'Upcoming IPOs', href: '/ipo/upcoming' },
      { label: 'IPO Performance', href: '/ipo/performance/2026' },
      { label: 'IPO Subscription', href: '/ipo/subscription-status' },
    ],
  },
  {
    title: 'Mutual Funds',
    links: [
      { label: 'All Mutual Funds', href: '/mutual-funds/all' },
      { label: 'Best Funds', href: '/mutual-funds/best' },
      { label: 'Holdings Changes', href: '/mutual-funds/mutual-fund-holdings-changes' },
      { label: 'Portfolio Overlap', href: '/mutual-funds/portfolio-overlap-checker' },
      { label: 'Fund Overlap', href: '/mutual-funds/fund-overlap' },
    ],
  },
  {
    title: 'Smart Money',
    links: [
      { label: 'Smart Money Tracker', href: sm.hub },
      { label: 'Smart Money Signal', href: sm.signals },
      { label: 'Stock Signal', href: sm.stockSignal },
      { label: 'Sector Intelligence', href: sm.sectorIntelligence },
      { label: 'Most Bought Stocks', href: sm.mostBought },
      { label: 'Most Sold Stocks', href: sm.mostSold },
      { label: 'Fresh Entries', href: sm.freshEntries },
      { label: 'Complete Exits', href: sm.completeExits },
    ],
  },
  {
    title: 'Super Investors',
    links: [
      { label: 'Super Investors', href: '/super-investors' },
      { label: '1% Club', href: '/1-percent-club' },
      { label: 'PMS Providers', href: '/pms' },
      { label: 'AIF & SIF', href: '/alternative-funds' },
    ],
  },
  {
    title: 'Learn',
    links: [
      { label: 'Learn Hub', href: '/learn' },
      { label: 'IPO Guides', href: '/blogs/ipo' },
      { label: 'Mutual Fund Guides', href: '/blogs/mutual-funds' },
      { label: 'Calculator FAQs', href: '/blogs/tools' },
      { label: 'All Articles', href: '/learn' },
    ],
  },
  {
    title: 'Tools',
    links: [
      { label: 'SIP Calculator', href: '/tools/sip-calculator' },
      { label: 'Lumpsum Calculator', href: '/tools/lumpsum-calculator' },
      { label: 'SWP Calculator', href: '/tools/swp-calculator' },
      { label: 'FD Calculator', href: '/tools/fd-calculator' },
      { label: 'EMI Calculator', href: '/tools/emi-calculator' },
      { label: 'NPS Calculator', href: '/tools/nps-calculator' },
    ],
  },
  {
    title: 'Brokers',
    links: [
      { label: 'Compare Brokers', href: '/broker/compare' },
      { label: 'Zerodha Review', href: '/broker/zerodha' },
      { label: 'Groww Review', href: '/broker/groww' },
      { label: 'Upstox Review', href: '/broker/upstox' },
      { label: 'Angel One Review', href: '/broker/angel-one' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About', href: '/about' },
      { label: 'Data Methodology', href: '/methodology' },
      { label: 'Contact', href: '/contact' },
      { label: 'Privacy Policy', href: '/privacy' },
      { label: 'Terms of Use', href: '/terms' },
      { label: 'Disclaimer', href: '/disclaimer' },
    ],
  },
];
---

<footer class="bg-surface-50 dark:bg-surface-900 border-t border-surface-200 dark:border-surface-700 mt-20">
  <div class="container-wide py-12 lg:py-16">
    <!-- Top section -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 gap-8 lg:gap-10">
      {footerSections.map((section) => (
        <div>
          <h3 class="text-sm font-semibold text-surface-900 dark:text-white uppercase tracking-wider mb-4">
            {section.title}
          </h3>
          <ul class="space-y-2.5">
            {section.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-surface-500 dark:text-surface-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom section -->
    <div class="mt-12 pt-8 border-t border-surface-200 dark:border-surface-700">
      <!-- Privacy Trust Badge -->
      <div class="flex items-center justify-center gap-2 mb-6 px-4 py-3 bg-surface-100 dark:bg-surface-800 rounded-lg">
        <svg class="w-4 h-4 text-success-500 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
        <p class="text-xs text-surface-600 dark:text-surface-300 font-medium">Calculators run in your browser. Analytics and ads load only if you accept cookies. No login required.</p>
      </div>

      <div class="flex flex-col md:flex-row items-center justify-between gap-4">
        <div class="flex items-center gap-2">
          <BrandLogo compact />
          <span class="text-sm text-surface-500 dark:text-surface-400">
            © 2026 {BRAND_NAME}. All rights reserved.
          </span>
        </div>
        <div class="flex items-center gap-4">
          <a href="https://x.com/ipofins" target="_blank" rel="noopener noreferrer" class="text-surface-500 hover:text-surface-700 dark:text-surface-400 dark:hover:text-surface-200 transition-colors" aria-label="Twitter/X">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>
      <p class="text-xs text-surface-500 dark:text-surface-400 text-center mt-4 max-w-lg mx-auto">
        Investment in securities market are subject to market risks. Read all the related documents carefully before investing. SEBI Registration not applicable.
      </p>
    </div>
  </div>
</footer>
