---
import FeatureIcon from '../icons/FeatureIcon.astro';
interface Props {
  title: string; description: string; href: string; badge: string;
  iconName: 'smart-money' | 'holdings' | 'signal' | 'investors' | 'one-percent' | 'sector' | 'overlap' | 'ipo' | 'chart';
}
const { title, description, href, badge, iconName } = Astro.props;
---
<a href={href} class="home-feature-card group block">
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class="home-feature-card__icon group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors"><FeatureIcon name={iconName} /></div>
    <span class="home-feature-card__badge">{badge}</span>
  </div>
  <h3 class="text-base font-semibold text-surface-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">{title}</h3>
  <p class="mt-1.5 text-sm text-surface-500 dark:text-surface-400 leading-relaxed line-clamp-2">{description}</p>
  <span class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-surface-500 group-hover:text-primary-600 dark:group-hover:text-primary-400 group-hover:gap-2 transition-all">Explore<svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></span>
</a>