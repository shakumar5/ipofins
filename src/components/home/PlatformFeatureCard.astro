---
interface Props {
  title: string;
  description: string;
  href: string;
  badge: string;
  icon: string;
  accent?: 'primary' | 'success' | 'warning';
}

const { title, description, href, badge, icon, accent = 'primary' } = Astro.props;

const accentMap = {
  primary: {
    border: 'border-primary-200 dark:border-primary-800 hover:border-primary-400 dark:hover:border-primary-600',
    bg: 'from-primary-50/80 to-white dark:from-primary-950/30 dark:to-surface-800',
    icon: 'bg-primary-100 dark:bg-primary-900/40 text-primary-600 dark:text-primary-400',
    badge: 'bg-primary-100 text-primary-700 dark:bg-primary-900/50 dark:text-primary-300',
  },
  success: {
    border: 'border-success-500/20 hover:border-success-500/40',
    bg: 'from-success-50/60 to-white dark:from-success-500/5 dark:to-surface-800',
    icon: 'bg-success-50 dark:bg-success-500/10 text-success-600',
    badge: 'bg-success-50 text-success-600 dark:bg-success-500/10 dark:text-success-500',
  },
  warning: {
    border: 'border-warning-500/20 hover:border-warning-500/40',
    bg: 'from-warning-50/60 to-white dark:from-warning-500/5 dark:to-surface-800',
    icon: 'bg-warning-50 dark:bg-warning-500/10 text-warning-600',
    badge: 'bg-warning-50 text-warning-600 dark:bg-warning-500/10 dark:text-warning-500',
  },
};

const a = accentMap[accent];
---

<a
  href={href}
  class={`home-feature-card group block rounded-2xl border bg-gradient-to-br p-5 transition-all duration-300 hover:-translate-y-0.5 hover:shadow-lg ${a.border} ${a.bg}`}
>
  <div class="flex items-start justify-between gap-3 mb-3">
    <div class={`w-11 h-11 rounded-xl flex items-center justify-center text-xl flex-shrink-0 ${a.icon}`}>
      {icon}
    </div>
    <span class={`px-2 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wide ${a.badge}`}>
      {badge}
    </span>
  </div>
  <h3 class="text-base font-bold text-surface-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
    {title}
  </h3>
  <p class="mt-1.5 text-sm text-surface-500 dark:text-surface-400 leading-relaxed line-clamp-2">
    {description}
  </p>
  <span class="mt-4 inline-flex items-center gap-1 text-xs font-semibold text-primary-600 dark:text-primary-400 group-hover:gap-2 transition-all">
    Explore
    <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
