---
interface Props {
  active: 'hub' | 'best' | 'all' | 'holdings-changes' | 'overlap-checker' | 'fund-overlap' | 'smart-money';
}

const { active } = Astro.props;

const tabs = [
  { id: 'best', label: 'Best Mutual Funds', href: '/mutual-funds/best' },
  { id: 'all', label: 'All Mutual Funds', href: '/mutual-funds/all' },
  { id: 'holdings-changes', label: 'Holdings Changes', href: '/mutual-funds/mutual-fund-holdings-changes' },
  { id: 'overlap-checker', label: 'Portfolio Overlap', href: '/mutual-funds/portfolio-overlap-checker' },
  { id: 'fund-overlap', label: 'Fund Overlap', href: '/mutual-funds/fund-overlap' },
  { id: 'smart-money', label: 'Smart Money Tracker', href: '/mutual-funds/smart-money' },
] as const;
---

<nav class="nav-btn-group mt-6" aria-label="Mutual funds sections">
  {tabs.map((tab) => {
    if (active === 'hub') {
      const cls = tab.id === 'best' ? 'btn-primary px-6 py-3' : 'btn-secondary px-6 py-3';
      return <a href={tab.href} class={cls}>{tab.label}</a>;
    }
    if (tab.id === active) {
      return (
        <span class="btn-primary px-6 py-3 cursor-default" aria-current="page">
          {tab.label}
        </span>
      );
    }
    return <a href={tab.href} class="btn-secondary px-6 py-3">{tab.label}</a>;
  })}
</nav>
