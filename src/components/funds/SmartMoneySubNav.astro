---
import { smartMoneyTabPath } from '../../lib/smart-money-meta';
import { STOCK_SIGNAL_BASE } from '../../lib/stock-signal-meta';

type ActiveTab = 'tracker' | 'signals' | 'stock-signal-hub' | 'sectors';

interface Props {
  active: ActiveTab;
}

const { active } = Astro.props;

const tabs: { id: ActiveTab; label: string; href: string }[] = [
  { id: 'tracker', label: 'Smart Money Tracker', href: smartMoneyTabPath('tracker') },
  { id: 'signals', label: 'Smart Money Signal', href: smartMoneyTabPath('signals') },
  { id: 'stock-signal-hub', label: 'Stock Signal', href: STOCK_SIGNAL_BASE },
  { id: 'sectors', label: 'Sector Intelligence', href: smartMoneyTabPath('sectors') },
];
---

<nav class="nav-btn-group mt-6" aria-label="Smart Money sections">
  {tabs.map((tab) => (
    active === tab.id ? (
      <span class="btn-primary px-6 py-3 cursor-default" aria-current="page">{tab.label}</span>
    ) : (
      <a href={tab.href} class="btn-secondary px-6 py-3">{tab.label}</a>
    )
  ))}
</nav>
