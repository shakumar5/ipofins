---
import { fundStockSignalHref } from '../../lib/list-back-nav';

export interface FundHoldingRow {
  name: string;
  sector: string;
  pct: number;
  stockSlug?: string;
  isin?: string;
  nseSymbol?: string;
  bseCode?: string;
}

interface Props {
  fundSlug: string;
  fundName: string;
  holdings: FundHoldingRow[];
  latestMonth?: string;
}

const { fundSlug, fundName, holdings, latestMonth } = Astro.props;
/** Default: largest weight first (Top Holdings). User can toggle sort in the table. */
const sortedHoldings = [...holdings].sort((a, b) => {
  const pctDiff = (b.pct ?? 0) - (a.pct ?? 0);
  if (pctDiff !== 0) return pctDiff;
  return String(a.name).localeCompare(String(b.name));
});
const totalCount = sortedHoldings.length;
const tableId = `fund-holdings-${fundSlug.replace(/[^a-z0-9-]/gi, '-')}`;
const holdingsDataId = `${tableId}-data`;
const ROWS_PAGE = 20;
const initialVisible = Math.min(ROWS_PAGE, sortedHoldings.length);
const showMoreInitially = totalCount > initialVisible;
const holdingsDataJson = JSON.stringify(
  sortedHoldings.map((h) => ({
    name: h.name,
    sector: h.sector,
    pct: h.pct,
    stockSlug: h.stockSlug || '',
    isin: h.isin || '',
    nseSymbol: h.nseSymbol || '',
    bseCode: h.bseCode || '',
  })),
);
---

<div
  class="fund-holdings-static"
  data-fund-holdings-root
  data-fund-slug={fundSlug}
  data-fund-name={fundName}
  data-total={totalCount}
  data-rows-page={ROWS_PAGE}
>
  <p class="text-xs text-surface-500 mb-4" data-fund-holdings-summary>
    Showing <span data-fund-holdings-shown>{Math.min(initialVisible, totalCount)}</span> of <span data-fund-holdings-total>{totalCount}</span> stocks in portfolio
    {latestMonth ? ` as of ${latestMonth}` : ''} (Source: AMC monthly disclosure).
    {showMoreInitially ? ' Use Show more below for the full list.' : ''}
  </p>
  <div class="card overflow-hidden">
    <div class="hidden md:grid grid-cols-12 gap-4 px-4 py-2 text-xs font-medium text-surface-500 uppercase border-b border-surface-200 dark:border-surface-700">
      <div class="col-span-1">#</div>
      <div class="col-span-5">Stock</div>
      <div class="col-span-3">Sector</div>
      <div class="col-span-3 text-right">
        <button
          type="button"
          data-fund-holdings-sort-weight
          class="inline-flex items-center gap-1 ml-auto hover:text-primary-600 dark:hover:text-primary-400 cursor-pointer uppercase"
          aria-sort="descending"
        >
          Weight (%)
          <span data-fund-holdings-sort-icon aria-hidden="true">↓</span>
        </button>
      </div>
    </div>
    <div class="md:hidden flex justify-end px-4 py-2 text-xs font-medium text-surface-500 uppercase border-b border-surface-200 dark:border-surface-700">
      <button
        type="button"
        data-fund-holdings-sort-weight
        class="inline-flex items-center gap-1 hover:text-primary-600 dark:hover:text-primary-400 cursor-pointer"
        aria-sort="descending"
      >
        Weight (%)
        <span data-fund-holdings-sort-icon aria-hidden="true">↓</span>
      </button>
    </div>
    <div id={tableId}>
      {sortedHoldings.slice(0, initialVisible).map((h, i) => (
        <div
          class={`grid grid-cols-12 gap-4 px-4 py-2.5 text-sm items-center ${i % 2 === 0 ? '' : 'bg-surface-50 dark:bg-surface-800/50'}`}
          data-holding-row
        >
          <div class="col-span-1 text-xs text-surface-400">{i + 1}</div>
          <div class="col-span-5">
            {h.stockSlug ? (
              <a
                href={fundStockSignalHref(h.stockSlug, fundSlug, fundName)}
                class="font-medium text-sm text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 hover:underline"
              >
                {h.name}
              </a>
            ) : (
              <span class="font-medium text-sm text-surface-900 dark:text-white">{h.name}</span>
            )}
            <p class="text-[10px] text-surface-400 md:hidden">{h.sector}</p>
          </div>
          <div class="col-span-3 text-xs text-surface-500 hidden md:block">{h.sector}</div>
          <div class="col-span-3 text-right">
            <span class="text-sm font-semibold text-primary-600">{h.pct}%</span>
          </div>
        </div>
      ))}
    </div>
  </div>
  <div class="text-center mt-4" data-fund-holdings-more-wrap hidden={!showMoreInitially}>
    <button
      type="button"
      data-fund-holdings-more
      class="px-4 py-2 text-sm font-medium text-primary-600 bg-primary-50 dark:bg-primary-900/20 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-900/30 transition-colors"
    >
      Show more ({Math.max(totalCount - initialVisible, 0)} remaining)
    </button>
  </div>
  <p class="text-xs text-surface-400 mt-3">
    All returns shown are for Direct-Growth plan. Data from AMC monthly portfolio disclosure.
  </p>
  <script id={holdingsDataId} type="application/json" set:html={holdingsDataJson}></script>
</div>

<script>
  import { initFundHoldingsStaticTable } from '../../scripts/fund-holdings-static';

  function boot() {
    document.querySelectorAll<HTMLElement>('[data-fund-holdings-root]').forEach((root) => {
      const fundSlug = root.getAttribute('data-fund-slug') || '';
      const fundName = root.getAttribute('data-fund-name') || '';
      const rowsPage = Number(root.getAttribute('data-rows-page') || '20');
      const tableId = `fund-holdings-${fundSlug.replace(/[^a-z0-9-]/gi, '-')}`;
      const holdingsDataId = `${tableId}-data`;
      initFundHoldingsStaticTable({
        root,
        tableId,
        holdingsDataId,
        fundSlug,
        fundName,
        rowsPage,
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
