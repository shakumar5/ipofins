---
import { stockSignalPath } from '../../lib/stock-signal-meta';

export interface FundHoldingRow {
  name: string;
  sector: string;
  pct: number;
  stockSlug?: string;
}

interface Props {
  fundSlug: string;
  holdings: FundHoldingRow[];
  latestMonth?: string;
  portfolioStockCount?: number | null;
}

const { fundSlug, holdings, latestMonth, portfolioStockCount } = Astro.props;
const totalCount = portfolioStockCount ?? holdings.length;
const initialVisible = Math.min(40, holdings.length);
const visibleHoldings = holdings.slice(0, initialVisible);
const remaining = Math.max(0, totalCount - initialVisible);
const showMoreButton = remaining > 0 || holdings.length < totalCount;
const tableId = `fund-holdings-${fundSlug.replace(/[^a-z0-9-]/gi, '-')}`;
---

<div class="fund-holdings-static" data-fund-holdings-root data-fund-slug={fundSlug} data-total={totalCount}>
  <p class="text-xs text-surface-500 mb-4" data-fund-holdings-summary>
    Showing <span data-fund-holdings-shown>{Math.min(initialVisible, holdings.length)}</span> of <span data-fund-holdings-total>{totalCount}</span> stocks
    {latestMonth ? ` held by this fund as of ${latestMonth}` : ''} (Source: AMC monthly disclosure)
  </p>
  <div class="card overflow-hidden">
    <div class="hidden md:grid grid-cols-12 gap-4 px-4 py-2 text-xs font-medium text-surface-500 uppercase border-b border-surface-200 dark:border-surface-700">
      <div class="col-span-1">#</div>
      <div class="col-span-5">Stock</div>
      <div class="col-span-3">Sector</div>
      <div class="col-span-3 text-right">Weight (%)</div>
    </div>
    <div id={tableId} data-visible-limit={initialVisible}>
      {visibleHoldings.map((h, i) => (
        <div
          class={`grid grid-cols-12 gap-4 px-4 py-2.5 text-sm items-center ${i % 2 === 0 ? '' : 'bg-surface-50 dark:bg-surface-800/50'}`}
          data-holding-row
        >
          <div class="col-span-1 text-xs text-surface-400">{i + 1}</div>
          <div class="col-span-5">
            {h.stockSlug ? (
              <a
                href={stockSignalPath(h.stockSlug)}
                class="font-medium text-sm text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 hover:underline"
              >
                {h.name}
              </a>
            ) : (
              <span class="font-medium text-sm text-surface-900 dark:text-white">{h.name}</span>
            )}
            <p class="text-[10px] text-surface-400 md:hidden">{h.sector}</p>
          </div>
          <div class="col-span-3 text-xs text-surface-500 hidden md:block">{h.sector}</div>
          <div class="col-span-3 text-right">
            <span class="text-sm font-semibold text-primary-600">{h.pct}%</span>
          </div>
        </div>
      ))}
    </div>
  </div>
  {showMoreButton && (
    <div class="text-center mt-4">
      <button
        type="button"
        class="fund-holdings-show-more px-4 py-2 text-sm font-medium text-primary-600 bg-primary-50 dark:bg-primary-900/20 rounded-lg hover:bg-primary-100 dark:hover:bg-primary-900/30 transition-colors disabled:opacity-60"
        data-remaining={remaining}
      >
        Show more ({remaining} remaining)
      </button>
    </div>
  )}
  <p class="text-xs text-surface-400 mt-3">
    All returns shown are for Direct-Growth plan. Data from AMC monthly portfolio disclosure.
  </p>
</div>

<script is:inline define:vars={{ tableId, fundSlug, initialHoldings: holdings, totalCount }}>
  (function () {
    const root = document.querySelector('[data-fund-holdings-root][data-fund-slug="' + fundSlug + '"]');
    const tbody = document.getElementById(tableId);
    const btn = root && root.querySelector('.fund-holdings-show-more');
    if (!root || !tbody || !btn) return;

    let allRows = initialHoldings.slice();
    let visibleLimit = Number(tbody.getAttribute('data-visible-limit') || 40);
    let fetchExhausted = allRows.length >= totalCount;
    const pageSize = 40;

    function rowHtml(h, index) {
      const stripe = index % 2 === 0 ? '' : ' bg-surface-50 dark:bg-surface-800/50';
      const slug = h.stockSlug ? String(h.stockSlug).trim() : '';
      const nameCell = slug
        ? '<a href="/mutual-funds/smart-money/stock-signal/' + encodeURIComponent(slug) + '" class="font-medium text-sm text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 hover:underline">' + h.name + '</a>'
        : '<span class="font-medium text-sm text-surface-900 dark:text-white">' + h.name + '</span>';
      return (
        '<div class="grid grid-cols-12 gap-4 px-4 py-2.5 text-sm items-center' + stripe + '" data-holding-row>' +
        '<div class="col-span-1 text-xs text-surface-400">' + (index + 1) + '</div>' +
        '<div class="col-span-5">' + nameCell +
        '<p class="text-[10px] text-surface-400 md:hidden">' + (h.sector || '') + '</p></div>' +
        '<div class="col-span-3 text-xs text-surface-500 hidden md:block">' + (h.sector || '') + '</div>' +
        '<div class="col-span-3 text-right"><span class="text-sm font-semibold text-primary-600">' + h.pct + '%</span></div>' +
        '</div>'
      );
    }

    function render() {
      const slice = allRows.slice(0, visibleLimit);
      tbody.innerHTML = slice.map(function (h, i) { return rowHtml(h, i); }).join('');
      const shownEl = root.querySelector('[data-fund-holdings-shown]');
      if (shownEl) shownEl.textContent = String(Math.min(visibleLimit, allRows.length));
      const left = fetchExhausted
        ? Math.max(0, allRows.length - visibleLimit)
        : Math.max(0, totalCount - visibleLimit);
      if (left <= 0) {
        btn.remove();
        return;
      }
      btn.textContent = 'Show more (' + left + ' remaining)';
      btn.disabled = false;
    }

    btn.addEventListener('click', function () {
      if (visibleLimit < allRows.length) {
        visibleLimit = Math.min(visibleLimit + pageSize, allRows.length);
        render();
        return;
      }
      if (fetchExhausted) return;
      btn.disabled = true;
      btn.textContent = 'Loading…';
      fetch('/data/fund-holdings-by-slug/' + encodeURIComponent(fundSlug) + '.json')
        .then(function (res) { return res.ok ? res.json() : null; })
        .then(function (data) {
          const stocks = (data && data.stocks) || [];
          if (stocks.length > allRows.length) {
            allRows = stocks.map(function (h) {
              return {
                name: String(h.name || ''),
                sector: String(h.sector || ''),
                pct: h.pct != null ? Number(h.pct) : 0,
                stockSlug: h.stockSlug ? String(h.stockSlug) : undefined,
              };
            });
          }
          fetchExhausted = !totalCount || allRows.length >= totalCount;
          visibleLimit = Math.min(visibleLimit + pageSize, allRows.length);
          render();
        })
        .catch(function () {
          btn.disabled = false;
          btn.textContent = 'Show more (' + Math.max(0, totalCount - visibleLimit) + ' remaining)';
        });
    });
  })();
</script>
