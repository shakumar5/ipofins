---
import type { SmartMoneyTab } from '../../lib/smart-money-meta';
import type { PageMeta } from '../../lib/page-meta';
import type { SmartMoneyTrackerLinks } from '../../lib/smart-money-tracker-links';
import SmartMoneyPage from './SmartMoneyPage.tsx';
import SmartMoneySubNav from './SmartMoneySubNav.astro';
import PageHeader from '../layout/PageHeader.astro';
import type { TrackerViewType } from '../../lib/smart-money-tracker-meta';
import type { SmartMoneyTrackerBootstrap } from '../../lib/smart-money-tracker-server';
import type { SmartMoneySignalsListFilters } from '../../lib/smart-money-signals-list-meta';
import type { TrackerListFilters } from '../../lib/smart-money-tracker-filters-meta';
import { SMART_MONEY_TRACKER_DATA_BOOTSTRAP_ID, SMART_MONEY_TRACKER_INDEX_BOOTSTRAP_ID } from '../../lib/smart-money-tracker-bootstrap';
import InsightsArticleCallout from '../insights/InsightsArticleCallout.astro';
import SmartMoneyGuide from './SmartMoneyGuide.astro';
import { getSmartMoneyInsightCallout } from '../../lib/insights-callouts';

interface TrackerInit {
  view: TrackerViewType;
  monthLabel: string;
}

interface Props {
  pageMeta: PageMeta;
  parsed: TrackerInit | null;
  parsedTab: SmartMoneyTab | null;
  sm: SmartMoneyTrackerLinks;
  trackerBootstrap?: SmartMoneyTrackerBootstrap | null;
  initialSignalsFilters?: Partial<SmartMoneySignalsListFilters>;
  initialTrackerFilters?: TrackerListFilters;
}

const { pageMeta, parsed, parsedTab, sm, trackerBootstrap = null, initialSignalsFilters, initialTrackerFilters } = Astro.props;

const smNavActive =
  parsedTab === 'signals' ? 'signals'
  : parsedTab === 'sectors' ? 'sectors'
  : 'tracker';

const trackerIndexJson = trackerBootstrap
  ? JSON.stringify(trackerBootstrap.index).replace(/</g, '\\u003c')
  : null;

const trackerDataJson = trackerBootstrap?.data
  ? JSON.stringify(trackerBootstrap.data).replace(/</g, '\\u003c')
  : null;

const skeletonRows = Array.from({ length: 12 });
const islandDirective = 'load';

const insightArticle = getSmartMoneyInsightCallout({
  parsedTab,
  trackerView: parsed?.view ?? null,
});
---

<nav class="container-wide pt-6" aria-label="Breadcrumb">
  <ol class="flex items-center gap-2 text-sm text-surface-500 dark:text-surface-400">
    <li><a href="/" class="hover:text-primary-600 transition-colors">Home</a></li>
    <li><span class="mx-1">/</span></li>
    <li><a href="/mutual-funds" class="hover:text-primary-600 transition-colors">Mutual Funds</a></li>
    <li><span class="mx-1">/</span></li>
    <li class="text-surface-900 dark:text-white font-medium" data-breadcrumb-leaf>{pageMeta.breadcrumbLabel || 'Smart Money'}</li>
  </ol>
</nav>

<section class="container-wide pt-8 pb-4">
  <PageHeader
    title={pageMeta.heading || 'Smart Money Tracker'}
    subtitle={pageMeta.subtitle || 'Track institutional conviction — what fund managers are buying, selling, and rotating at the stock and sector level.'}
    freshness="Updated monthly"
    source="AMC monthly portfolio disclosures"
  >
    <div class="mt-4"><SmartMoneySubNav active={smNavActive} /></div>
  </PageHeader>
</section>

<section class="container-wide pb-4">
  <div class="max-w-2xl">
    <InsightsArticleCallout article={insightArticle} />
  </div>
</section>

<section class="container-wide pb-12 smart-money-tracker-section">
  {trackerIndexJson && (
    <div
      id={SMART_MONEY_TRACKER_INDEX_BOOTSTRAP_ID}
      data-json={trackerIndexJson}
      hidden
      aria-hidden="true"
    />
  )}
  {trackerDataJson && (
    <div
      id={SMART_MONEY_TRACKER_DATA_BOOTSTRAP_ID}
      data-json={trackerDataJson}
      hidden
      aria-hidden="true"
    />
  )}
  <div class="smart-money-app-shell">
    {islandDirective === 'load' ? (
    <SmartMoneyPage
      client:load
      initialTracker={parsed ? { view: parsed.view, monthLabel: parsed.monthLabel } : null}
      initialTab={parsedTab}
      initialTrackerIndex={trackerBootstrap?.index ?? null}
      initialTrackerMonth={trackerBootstrap?.initialMonth ?? null}
      initialTrackerData={trackerBootstrap?.data ?? null}
      initialSignalsFilters={initialSignalsFilters}
      initialTrackerFilters={initialTrackerFilters}
    >
      <div slot="fallback" class="animate-pulse" aria-busy="true" aria-label="Loading Smart Money">
      <div class="p-5 bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-600 rounded-xl mb-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="smart-money-skeleton-bar h-16"></div>
          <div class="smart-money-skeleton-bar h-16"></div>
          <div class="smart-money-skeleton-bar h-16"></div>
          <div class="smart-money-skeleton-bar h-16"></div>
        </div>
        <div class="smart-money-skeleton-bar h-3 w-full max-w-2xl mt-3" aria-hidden="true"></div>
      </div>
      <div class="md:hidden flex flex-wrap gap-2 mb-3" aria-hidden="true">
        <div class="smart-money-skeleton-bar h-7 w-10"></div>
        <div class="smart-money-skeleton-bar h-7 w-14"></div>
        <div class="smart-money-skeleton-bar h-7 w-14"></div>
        <div class="smart-money-skeleton-bar h-7 w-12"></div>
      </div>
      <div class="md:hidden space-y-2" aria-hidden="true">
        {skeletonRows.map(() => (
          <div class="smart-money-skeleton-card space-y-2">
            <div class="smart-money-skeleton-bar h-3 w-8"></div>
            <div class="smart-money-skeleton-bar h-4 w-3/4"></div>
            <div class="smart-money-skeleton-bar h-3 w-1/2"></div>
            <div class="grid grid-cols-2 gap-2 pt-1">
              <div class="smart-money-skeleton-bar h-8"></div>
              <div class="smart-money-skeleton-bar h-8"></div>
            </div>
          </div>
        ))}
      </div>
      <div class="md:hidden mt-3 flex justify-center" aria-hidden="true">
        <div class="smart-money-skeleton-bar h-10 w-44"></div>
      </div>
      <div class="hidden md:block space-y-2" aria-hidden="true">
        <div class="smart-money-skeleton-bar h-10"></div>
        {skeletonRows.map(() => (
          <div class="smart-money-skeleton-bar h-10"></div>
        ))}
      </div>
      <div class="hidden md:flex md:mt-3 md:justify-center" aria-hidden="true">
        <div class="smart-money-skeleton-bar h-10 w-44"></div>
      </div>
      <div class="smart-money-skeleton-bar h-8 w-full max-w-3xl mt-4" aria-hidden="true"></div>
      <p class="sr-only">Loading Smart Money…</p>
    </div>
  </SmartMoneyPage>
    ) : (
    <SmartMoneyPage
      client:load
      initialTracker={parsed ? { view: parsed.view, monthLabel: parsed.monthLabel } : null}
      initialTab={parsedTab}
      initialTrackerIndex={trackerBootstrap?.index ?? null}
      initialTrackerMonth={trackerBootstrap?.initialMonth ?? null}
      initialTrackerData={trackerBootstrap?.data ?? null}
      initialSignalsFilters={initialSignalsFilters}
      initialTrackerFilters={initialTrackerFilters}
    >
      <div slot="fallback" class="animate-pulse" aria-busy="true" aria-label="Loading Smart Money">
      <div class="p-5 bg-white dark:bg-surface-800 border border-surface-200 dark:border-surface-600 rounded-xl mb-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          <div class="smart-money-skeleton-bar h-16"></div>
          <div class="smart-money-skeleton-bar h-16"></div>
          <div class="smart-money-skeleton-bar h-16"></div>
          <div class="smart-money-skeleton-bar h-16"></div>
        </div>
        <div class="smart-money-skeleton-bar h-3 w-full max-w-2xl mt-3" aria-hidden="true"></div>
      </div>
      <div class="md:hidden flex flex-wrap gap-2 mb-3" aria-hidden="true">
        <div class="smart-money-skeleton-bar h-7 w-10"></div>
        <div class="smart-money-skeleton-bar h-7 w-14"></div>
        <div class="smart-money-skeleton-bar h-7 w-14"></div>
        <div class="smart-money-skeleton-bar h-7 w-12"></div>
      </div>
      <div class="md:hidden space-y-2" aria-hidden="true">
        {skeletonRows.map(() => (
          <div class="smart-money-skeleton-card space-y-2">
            <div class="smart-money-skeleton-bar h-3 w-8"></div>
            <div class="smart-money-skeleton-bar h-4 w-3/4"></div>
            <div class="smart-money-skeleton-bar h-3 w-1/2"></div>
            <div class="grid grid-cols-2 gap-2 pt-1">
              <div class="smart-money-skeleton-bar h-8"></div>
              <div class="smart-money-skeleton-bar h-8"></div>
            </div>
          </div>
        ))}
      </div>
      <div class="md:hidden mt-3 flex justify-center" aria-hidden="true">
        <div class="smart-money-skeleton-bar h-10 w-44"></div>
      </div>
      <div class="hidden md:block space-y-2" aria-hidden="true">
        <div class="smart-money-skeleton-bar h-10"></div>
        {skeletonRows.map(() => (
          <div class="smart-money-skeleton-bar h-10"></div>
        ))}
      </div>
      <div class="hidden md:flex md:mt-3 md:justify-center" aria-hidden="true">
        <div class="smart-money-skeleton-bar h-10 w-44"></div>
      </div>
      <div class="smart-money-skeleton-bar h-8 w-full max-w-3xl mt-4" aria-hidden="true"></div>
      <p class="sr-only">Loading Smart Money…</p>
    </div>
  </SmartMoneyPage>
    )}
  </div>
</section>

<SmartMoneyGuide sm={sm} />
