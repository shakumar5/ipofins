---
interface Props {
  name: string;
  slug: string;
  priceRange: string;
  lotSize: number;
  openDate?: string;
  closeDate?: string;
  listingDate?: string;
  status: 'live' | 'open' | 'upcoming' | 'closed' | 'allotment' | 'listed' | 'drhp-filed' | 'sebi-approved' | 'failed' | 'withdrawn';
  type: 'mainboard' | 'sme';
  subscription?: number | null;
  aiScore?: number | null;
  sector?: string;
}

const {
  name,
  slug,
  priceRange,
  lotSize,
  openDate = '—',
  closeDate = '—',
  listingDate,
  status,
  type,
  subscription,
  aiScore,
  sector,
} = Astro.props;

const statusConfig = {
  live: { label: 'Live', class: 'badge-live' },
  open: { label: 'Open', class: 'bg-amber-50 text-amber-700 dark:bg-amber-900/30 dark:text-amber-300' },
  upcoming: { label: 'Upcoming', class: 'badge-upcoming' },
  closed: { label: 'Closed', class: 'badge-closed' },
  allotment: { label: 'Allotment', class: 'bg-teal-50 text-teal-700 dark:bg-teal-900/30 dark:text-teal-300' },
  listed: { label: 'Listed', class: 'badge-listed' },
  'drhp-filed': { label: 'DRHP Filed', class: 'bg-surface-100 text-surface-600 dark:bg-surface-700 dark:text-surface-300' },
  'sebi-approved': { label: 'SEBI Approved', class: 'bg-indigo-50 text-indigo-700 dark:bg-indigo-900/30 dark:text-indigo-300' },
  failed: { label: 'Failed', class: 'bg-red-50 text-red-700 dark:bg-red-900/30 dark:text-red-300' },
  withdrawn: { label: 'Withdrawn', class: 'bg-surface-200 text-surface-700 dark:bg-surface-700 dark:text-surface-300' },
};

const statusInfo = statusConfig[status as keyof typeof statusConfig] || statusConfig['upcoming'];
---

<a href={`/ipo/${slug}`} class="card group block">
  <!-- Header -->
  <div class="flex items-start justify-between mb-4">
    <div class="flex-1 min-w-0">
      <h3 class="text-base font-semibold text-surface-900 dark:text-white truncate group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
        {name}
      </h3>
      <div class="flex items-center gap-2 mt-1">
        <span class="text-xs text-surface-600 dark:text-surface-400 uppercase font-medium">
          {type}
        </span>
        {sector && (
          <span class="text-xs text-surface-600 dark:text-surface-400">• {sector}</span>
        )}
      </div>
    </div>
    <span class={`badge ${statusInfo.class}`}>{statusInfo.label}</span>
  </div>

  <!-- Metrics Grid -->
  <div class="grid grid-cols-2 gap-3 mb-4">
    <div>
      <p class="text-xs text-surface-600 dark:text-surface-400">Price Band</p>
      <p class="text-sm font-semibold text-surface-800 dark:text-surface-200">₹{priceRange}</p>
    </div>
    <div>
      <p class="text-xs text-surface-600 dark:text-surface-400">Lot Size</p>
      <p class="text-sm font-semibold text-surface-800 dark:text-surface-200">{lotSize} shares</p>
    </div>
    <div>
      <p class="text-xs text-surface-600 dark:text-surface-400">Open</p>
      <p class="text-sm font-medium text-surface-700 dark:text-surface-300">{openDate}</p>
    </div>
    <div>
      <p class="text-xs text-surface-600 dark:text-surface-400">Close</p>
      <p class="text-sm font-medium text-surface-700 dark:text-surface-300">{closeDate}</p>
    </div>
  </div>

  <!-- Subscription Bar (for live IPOs) -->
  {subscription !== undefined && subscription !== null && (status === 'live' || status === 'closed') && (
    <div class="mb-4">
      <div class="flex items-center justify-between mb-1">
        <span class="text-xs text-surface-500 dark:text-surface-400">Subscription</span>
        <span class="text-xs font-semibold text-primary-700 dark:text-primary-400">{subscription}x</span>
      </div>
      <div class="w-full bg-surface-200 dark:bg-surface-700 rounded-full h-2">
        <div
          class="bg-gradient-to-r from-primary-500 to-primary-600 h-2 rounded-full transition-all duration-500"
          style={`width: ${Math.min(subscription * 10, 100)}%`}
        />
      </div>
    </div>
  )}

  <!-- Bottom Row -->
  <div class="flex items-center justify-between pt-3 border-t border-surface-100 dark:border-surface-700">
    {aiScore !== undefined && aiScore !== null && (
      <div class="flex items-center gap-1">
        <span class="text-xs text-surface-600 dark:text-surface-400" title="Quantitative score based on financials, valuation, and sector data">IPOFins Score:</span>
        <span class={`text-xs font-bold ${aiScore >= 7 ? 'text-success-500' : aiScore >= 4 ? 'text-warning-500' : 'text-danger-500'}`}>
          {aiScore}/10
        </span>
      </div>
    )}
  </div>
</a>
