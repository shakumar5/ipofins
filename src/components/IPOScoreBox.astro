---
/**
 * IPOScoreBox — displays the IPOFins quantitative score, verdict, risk context,
 * and a TRANSPARENT factor breakdown showing exactly what drove the score.
 *
 * This is NOT an AI component. The score is a deterministic weighted formula
 * combining subscription demand, disclosed risk score, and listing data.
 * See /methodology for the full write-up.
 */
import type { IPORecord } from '../types/ipo';
import { ipoUpperPrice } from '../lib/ipo-list-sections';

interface Props {
  title?: string;
  summary: string;
  riskScore?: number;
  verdict?: 'apply' | 'avoid' | 'neutral';
  highlights?: string[];
  ipo?: IPORecord;
}

const {
  title = 'Investment Analysis',
  summary,
  riskScore,
  verdict,
  highlights = [],
  ipo,
} = Astro.props;

const verdictConfig = {
  apply: { label: 'Consider Applying', color: 'text-success-500', bg: 'bg-success-50 dark:bg-success-500/10', border: 'border-success-200 dark:border-success-500/20' },
  avoid: { label: 'Exercise Caution', color: 'text-danger-500', bg: 'bg-danger-50 dark:bg-danger-500/10', border: 'border-danger-200 dark:border-danger-500/20' },
  neutral: { label: 'Neutral', color: 'text-warning-500', bg: 'bg-warning-50 dark:bg-warning-500/10', border: 'border-warning-200 dark:border-warning-500/20' },
};

const verdictInfo = verdict ? verdictConfig[verdict] : null;

// Build transparent factor breakdown from IPO data when available
interface Factor { label: string; value: string; impact: 'positive' | 'negative' | 'neutral'; detail: string; }
const factors: Factor[] = [];

if (ipo) {
  // Factor 1: Risk Score
  const risk = Number.isFinite(ipo.riskScore) ? ipo.riskScore : 5;
  const riskImpact = risk <= 3 ? 'positive' : risk >= 7 ? 'negative' : 'neutral';
  const riskDelta = ((5 - risk) * 0.4).toFixed(1);
  factors.push({
    label: 'Disclosed Risk',
    value: `${risk}/10`,
    impact: riskImpact,
    detail: `${risk <= 3 ? 'Low' : risk <= 6 ? 'Moderate' : 'High'} risk from DRHP → score ${Number(riskDelta) >= 0 ? '+' : ''}${riskDelta}`,
  });

  // Factor 2: QIB / Institutional demand
  const qib = ipo.subscriptionDetails?.qib ?? null;
  const total = ipo.subscription ?? null;
  if (qib != null) {
    const qibImpact = qib >= 10 ? 'positive' : qib >= 3 ? 'positive' : qib < 1 ? 'negative' : 'neutral';
    const qibDelta = qib >= 10 ? '+2.0' : qib >= 3 ? '+1.0' : qib < 1 ? '−1.5' : '0';
    factors.push({
      label: 'QIB Demand',
      value: `${qib.toFixed(1)}×`,
      impact: qibImpact,
      detail: `Institutional subscription → score ${qibDelta}`,
    });
  } else if (total != null) {
    const totalImpact = total >= 10 ? 'positive' : total >= 3 ? 'positive' : total < 1 ? 'negative' : 'neutral';
    const totalDelta = total >= 10 ? '+1.5' : total >= 3 ? '+0.75' : total < 1 ? '−1.5' : '0';
    factors.push({
      label: 'Overall Subscription',
      value: `${total.toFixed(1)}×`,
      impact: totalImpact,
      detail: `Total demand signal → score ${totalDelta}`,
    });
  }

  // Factor 3: Retail demand
  const retail = ipo.subscriptionDetails?.retail ?? null;
  if (retail != null && retail >= 5) {
    factors.push({
      label: 'Retail Demand',
      value: `${retail.toFixed(1)}×`,
      impact: 'positive',
      detail: 'Strong retail interest → score +0.5',
    });
  }

  // Factor 4: Listing performance (for listed IPOs)
  const upper = ipoUpperPrice(ipo);
  if (ipo.listingPrice != null && upper != null && upper > 0) {
    const listingGainPct = ((ipo.listingPrice - upper) / upper) * 100;
    const listingImpact = listingGainPct >= 20 ? 'positive' : listingGainPct > 0 ? 'positive' : listingGainPct <= -10 ? 'negative' : 'negative';
    const listingDelta = listingGainPct >= 20 ? '+1.5' : listingGainPct > 0 ? '+0.5' : listingGainPct <= -10 ? '−1.5' : '−0.5';
    factors.push({
      label: 'Listing Performance',
      value: `${listingGainPct >= 0 ? '+' : ''}${listingGainPct.toFixed(1)}%`,
      impact: listingImpact,
      detail: `Actual listing outcome → score ${listingDelta}`,
    });
  }

  // Factor 5: SME adjustment
  if (ipo.type === 'sme') {
    factors.push({
      label: 'SME Liquidity Discount',
      value: 'SME',
      impact: 'negative',
      detail: 'SME IPOs have lower liquidity after listing → score −0.5',
    });
  }
}
---

<div class="card border-primary-100 dark:border-primary-900/50 bg-gradient-to-br from-primary-50/50 to-white dark:from-primary-950/20 dark:to-surface-800">
  <!-- Header -->
  <div class="flex items-center gap-2 mb-3">
    <div class="w-6 h-6 rounded-md bg-primary-100 dark:bg-primary-900/50 flex items-center justify-center">
      <svg class="w-3.5 h-3.5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
    </div>
    <h4 class="text-sm font-semibold text-surface-900 dark:text-white">{title}</h4>
    <span class="ml-auto badge bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 text-xs">
      Quantitative
    </span>
  </div>

  <!-- Summary -->
  <p class="text-sm text-surface-600 dark:text-surface-300 leading-relaxed mb-4">
    {summary}
  </p>

  <!-- Highlights -->
  {highlights.length > 0 && (
    <ul class="space-y-1.5 mb-4">
      {highlights.map((item) => (
        <li class="flex items-start gap-2 text-sm text-surface-600 dark:text-surface-300">
          <svg class="w-4 h-4 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  )}

  <!-- Transparent Factor Breakdown -->
  {factors.length > 0 && (
    <details class="mb-4 group">
      <summary class="cursor-pointer flex items-center gap-2 text-xs font-semibold text-primary-700 dark:text-primary-300 hover:text-primary-800 dark:hover:text-primary-200 select-none list-none">
        <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
        Score breakdown — what drove this verdict
      </summary>
      <div class="mt-3 space-y-2">
        {factors.map((f) => (
          <div class="flex items-start gap-2 p-2 rounded-lg bg-white dark:bg-surface-900/50 border border-surface-100 dark:border-surface-700">
            <span class={`mt-0.5 flex-shrink-0 text-xs font-bold ${
              f.impact === 'positive' ? 'text-success-600 dark:text-success-400' :
              f.impact === 'negative' ? 'text-danger-600 dark:text-danger-400' :
              'text-warning-600 dark:text-warning-400'
            }`} aria-hidden="true">
              {f.impact === 'positive' ? '▲' : f.impact === 'negative' ? '▼' : '●'}
            </span>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-medium text-surface-700 dark:text-surface-300">{f.label}</span>
                <span class={`text-xs font-bold font-mono flex-shrink-0 ${
                  f.impact === 'positive' ? 'text-success-600 dark:text-success-400' :
                  f.impact === 'negative' ? 'text-danger-600 dark:text-danger-400' :
                  'text-warning-600 dark:text-warning-400'
                }`}>{f.value}</span>
              </div>
              <p class="text-[11px] text-surface-500 dark:text-surface-400 mt-0.5">{f.detail}</p>
            </div>
          </div>
        ))}
        <p class="text-[11px] text-surface-400 dark:text-surface-500 mt-2">
          Base score: 5.0 · Final score = base + all factor adjustments, capped 1–10.
          <a href="/methodology" class="underline hover:text-primary-600">Full methodology →</a>
        </p>
      </div>
    </details>
  )}

  <!-- Bottom Metrics -->
  <div class="flex items-center gap-4 pt-3 border-t border-primary-100 dark:border-primary-900/30">
    {riskScore !== undefined && (
      <div class="flex items-center gap-1.5">
        <span class="text-xs text-surface-500 dark:text-surface-400">Risk:</span>
        <span class={`text-xs font-bold font-mono ${riskScore <= 3 ? 'text-success-500' : riskScore <= 6 ? 'text-warning-500' : 'text-danger-500'}`}>
          {riskScore}/10
        </span>
      </div>
    )}
    {verdictInfo && (
      <span class={`badge ${verdictInfo.bg} ${verdictInfo.color} border ${verdictInfo.border}`}>
        {verdictInfo.label}
      </span>
    )}
    <a href="/methodology" class="ml-auto text-[11px] text-surface-400 dark:text-surface-500 hover:text-primary-600 underline">
      How we score
    </a>
  </div>

  <!-- Disclaimer -->
  <p class="mt-3 text-[11px] leading-snug text-surface-400 dark:text-surface-500">
    IPOFins Score is a quantitative signal from subscription demand, disclosed risk, and listing data — not investment advice. Not SEBI-registered.
  </p>
</div>
