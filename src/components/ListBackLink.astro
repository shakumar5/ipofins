---
interface Variant {
  href: string;
  label: string;
}

interface Props {
  id: string;
  defaultHref: string;
  defaultLabel: string;
  variants?: Record<string, Variant>;
  class?: string;
}

const {
  id,
  defaultHref,
  defaultLabel,
  variants = {},
  class: className = 'text-sm text-primary-600 dark:text-primary-400 hover:underline mb-4 inline-flex items-center gap-1 back-link-pending',
} = Astro.props;

const variantsJson = JSON.stringify(variants);
---

<a id={id} href={defaultHref} class={className}>
  <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
  </svg>
  <span class="back-link-text">{defaultLabel}</span>
</a>

<style>
  .back-link-pending {
    opacity: 0;
  }
  .back-link-ready {
    opacity: 1;
    transition: opacity 0.12s ease;
  }
</style>

<script is:inline define:vars={{ id, defaultHref, defaultLabel, variantsJson }}>
  function resolveContextualBack(params, variants, fallbackHref, fallbackLabel) {
    const from = params.get('from');
    if (!from) {
      return { href: fallbackHref, label: fallbackLabel };
    }

    if (from === 'sector') {
      const sector = params.get('sector');
      if (sector) {
        const sectorLabel = params.get('sectorLabel');
        return {
          href: '/ipo/sector/' + sector,
          label: sectorLabel ? 'Back to ' + sectorLabel + ' IPOs' : 'Back to Sector IPOs',
        };
      }
    }

    if (from === 'fund') {
      const fundSlug = params.get('fundSlug');
      if (fundSlug) {
        const fundName = params.get('fundName');
        return {
          href: '/mutual-funds/fund/' + fundSlug,
          label: fundName ? 'Back to ' + fundName : 'Back to Fund Details',
        };
      }
    }

    if (from === 'fund-overlap') {
      const fundSlug = params.get('fundSlug');
      if (fundSlug) {
        const fundName = params.get('fundName');
        return {
          href: '/mutual-funds/fund-overlap/' + fundSlug,
          label: fundName ? 'Back to ' + fundName + ' overlap' : 'Back to Fund Overlap',
        };
      }
    }

    if (from === 'tracker-view') {
      const viewPath = params.get('viewPath');
      if (viewPath && viewPath.startsWith('/mutual-funds/smart-money/')) {
        const viewLabel = params.get('viewLabel');
        return {
          href: viewPath,
          label: viewLabel || 'Back to Smart Money Tracker',
        };
      }
    }

    if (from === 'signals') {
      const month = params.get('month');
      const category = params.get('category');
      let href = '/mutual-funds/smart-money/smart-money-signal';
      const q = new URLSearchParams();
      if (month) q.set('month', month);
      if (category && category !== 'All') q.set('category', category);
      const qs = q.toString();
      if (qs) href += '?' + qs;
      return { href: href, label: 'Back to Smart Money Signal' };
    }

    if (from === 'stock-signal') {
      const stockSlug = params.get('stockSlug');
      const stockName = params.get('stockName');
      const href = stockSlug
        ? '/mutual-funds/smart-money/stock-signal/' + encodeURIComponent(stockSlug)
        : '/mutual-funds/smart-money/stock-signal';
      return {
        href: href,
        label: stockName ? 'Back to ' + stockName : 'Back to Stock Signal',
      };
    }

    const match = variants[from];
    if (match) return match;

    return { href: fallbackHref, label: fallbackLabel };
  }

  function resolveReferrerBack(fallbackHref, fallbackLabel) {
    try {
      const ref = document.referrer;
      if (!ref || !ref.startsWith(window.location.origin)) {
        return { href: fallbackHref, label: fallbackLabel };
      }
      const refUrl = new URL(ref);
      const path = refUrl.pathname;
      if (!path.includes('/mutual-funds/smart-money')) {
        return { href: fallbackHref, label: fallbackLabel };
      }
      if (path.includes('/stock-signal')) {
        return { href: fallbackHref, label: fallbackLabel };
      }
      if (path.includes('/smart-money-signal')) {
        return { href: refUrl.pathname + refUrl.search, label: 'Back to Smart Money Signal' };
      }
      if (path.includes('/smart-money-tracker') || path.includes('/tracker')) {
        return { href: refUrl.pathname + refUrl.search, label: 'Back to Smart Money Tracker' };
      }
      return { href: refUrl.pathname + refUrl.search, label: 'Back to Smart Money' };
    } catch {
      return { href: fallbackHref, label: fallbackLabel };
    }
  }

  const variantMap = JSON.parse(variantsJson);
  const params = new URLSearchParams(window.location.search);
  const el = document.getElementById(id);
  const textEl = el && el.querySelector('.back-link-text');
  if (!el || !textEl) return;

  let resolved = resolveContextualBack(params, variantMap, defaultHref, defaultLabel);
  if (!params.get('from') && id === 'stock-signal-detail-back') {
    resolved = resolveReferrerBack(resolved.href, resolved.label);
  }

  el.href = resolved.href;
  textEl.textContent = resolved.label;
  el.classList.remove('back-link-pending');
  el.classList.add('back-link-ready');
</script>
