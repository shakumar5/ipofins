---
interface Props {
  date?: string;
}
const { date } = Astro.props;
---

<div class="flex items-center gap-3 py-3 border-t border-surface-200 dark:border-surface-700 mt-6">
  <div class="w-8 h-8 bg-gradient-to-br from-primary-500 to-primary-700 rounded-full flex items-center justify-center">
    <span class="text-white font-bold text-xs">F</span>
  </div>
  <div>
    <p class="text-sm font-medium text-surface-900 dark:text-white">IPOFins Team</p>
    <p class="text-xs text-surface-500 dark:text-surface-400">
      Finance Research & Data
      {date && <span> • {date}</span>}
    </p>
  </div>
</div>
