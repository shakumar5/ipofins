{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "ignoreCommand": "exit 0",
  "git": {
    "deploymentEnabled": false
  },
  "github": {
    "enabled": false,
    "silent": true
  },
  "rewrites": [
    {
      "source": "/mutual-funds/portfolio-overlap-checker/:comparison",
      "destination": "/mutual-funds/portfolio-overlap-checker/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/ipo/gmp-today",
      "destination": "/ipo/subscription-status",
      "permanent": true
    },
    {
      "source": "/ipo/gmp-today/",
      "destination": "/ipo/subscription-status",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "ipofins.vercel.app" }],
      "destination": "https://ipofins.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://pagead2.googlesyndication.com https://plausible.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://plausible.io https://pagead2.googlesyndication.com https://vercel.live https://*.vercel-insights.com; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://www.google.com" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/data/holdings-compare/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
